@page "/cost"
@* Interactive, not prerendered: the page reads the estate's spend when it opens and shows that it is waiting. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Policy = OperatorSignIn.CostPolicy)]
@using System.Globalization
@using Norvia.Agents
@using Norvia.HealthCheck.Application.Agents
@using Norvia.HealthCheck.Application.Cost
@using Norvia.HealthCheck.Application.Narrate
@using Microsoft.Extensions.Options
@inject IHealthCheckRequests Requests
@inject IOptions<AgentsOptions> Agents
@inject ILogger<CostPage> Logger
@implements IDisposable

<PageTitle>@PageTitles.Cost</PageTitle>

<h1>Spend</h1>
<p class="text-muted">
    What each resource of the estate cost per day, in EUR, next to the Transport Orders received that day. A resource's spend rising while
    the volume stays flat is a cost with no business reason behind it.
</p>

@if (_failed)
{
    <div role="alert" class="mt-3">
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">The estate's spend could not be read.</FluentMessageBar>
    </div>
}
else if (_view is null)
{
    <div role="status" class="mt-3">
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentProgressRing />
            <span>Reading the estate's spend…</span>
        </FluentStack>
    </div>
}
else if (_view.Days.Count == 0)
{
    <p data-testid="no-spend" class="mt-3">No spend to show yet. Cost Management has no whole day for the estate in the last @(_view.PeriodDays * 2) days.</p>
}
else
{
    <p role="note" class="text-muted">
        Cost Management settles a day's cost about a day late, so only whole past days are shown.
        @if (_view.HasProvisionalDays)
        {
            <text>Days marked <em>provisional</em> may still change, so they are left out of the comparison below.</text>
        }
    </p>

    <section aria-label="Change against the previous period">
        <h2 class="mt-6">Change against the previous @_view.PeriodDays days</h2>
        <p class="text-muted">Average per day over the last @_view.PeriodDays days, against the @_view.PeriodDays days before. The biggest riser is first.</p>
        <FluentDataGrid Items="@_rows" aria-label="Change against the previous period" GridTemplateColumns="2fr 1fr 1fr 1fr" TGridItem="PeriodChange" Class="changes-grid">
            <PropertyColumn Title="Resource" Property="@(row => row.Name)" />
            <TemplateColumn Title="Previous" Align="Align.End">@Figure(context.Previous, context)</TemplateColumn>
            <TemplateColumn Title="Current" Align="Align.End">@Figure(context.Current, context)</TemplateColumn>
            <TemplateColumn Title="Change" Align="Align.End"><span data-testid="change" data-kind="@context.Kind" data-resource="@context.Name">@Percent(context.Relative)</span></TemplateColumn>
        </FluentDataGrid>
    </section>

    @if (Agents.Value.Enabled)
    {
        <section aria-label="FinOps assistant's explanation" class="mt-6">
            <p>
                <FluentButton Appearance="Appearance.Outline" OnClick="ExplainAsync" Disabled="_explaining" data-testid="explain-spend">Explain the spend</FluentButton>
            </p>
            @if (_explaining)
            {
                <div role="status">
                    <FluentStack VerticalAlignment="VerticalAlignment.Center">
                        <FluentProgressRing />
                        <span>The assistant is reading the spend…</span>
                    </FluentStack>
                </div>
            }
            else if (_explainUnavailable)
            {
                @* Whatever went wrong, the operator sees this and nothing else changes: the spend above stays. *@
                <div role="alert">
                    <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">Assistant unavailable</FluentMessageBar>
                </div>
            }
            else if (_explanation is { } explanation)
            {
                @* Text only: what the assistant wrote is data, so it is encoded, never rendered as markup. *@
                <div class="narration" data-testid="spend-narration">
                    <h2>What the assistant found</h2>
                    <p data-testid="spend-narration-summary">@explanation.Summary</p>
                    <p class="text-muted">
                        The assistant names the resource and the toggle behind a rise from the cost tools' figures and the rising-spend Check's Findings. It never works out a number or changes a severity or a fix.
                    </p>
                    <ol>
                        @foreach (var item in explanation.Items)
                        {
                            <li data-testid="spend-narration-item">
                                <strong>@item.Id</strong>: @item.Impact <cite class="text-muted">[@item.ResultId, @item.ToolName]</cite>
                            </li>
                        }
                    </ol>
                </div>
            }
        </section>
    }

    <section aria-label="Spend per day">
        <h2 class="mt-6">Spend per day</h2>
        <div class="table-scroll">
            <FluentDataGrid Items="@_view.Days.AsQueryable()" TGridItem="CostDay" AutoFit="true" aria-label="Spend per resource in EUR and Transport Orders received, per day">
                <TemplateColumn Title="Day">
                    @context.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                    @if (context.Provisional)
                    {
                        <span class="text-muted"> (provisional)</span>
                    }
                </TemplateColumn>
                @foreach (var resource in _view.ResourceNames)
                {
                    var name = resource;
                    <TemplateColumn Title="@name" Align="Align.End">@Eur(context.SpendOn(name))</TemplateColumn>
                }
                <TemplateColumn Title="Total" Align="Align.End">@Eur(context.TotalEur)</TemplateColumn>
                <TemplateColumn Title="Transport Orders" Align="Align.End">@context.TransportOrders</TemplateColumn>
            </FluentDataGrid>
        </div>
    </section>
}

@code {
    private CostView? _view;
    private bool _failed;
    private bool _explaining;
    private bool _explainUnavailable;
    private Narration? _explanation;
    private IQueryable<PeriodChange> _rows = Enumerable.Empty<PeriodChange>().AsQueryable();
    private readonly CancellationTokenSource _lifetime = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Requests.CostAsync(new GetCostViewQuery(), _lifetime.Token);
            if (!result.IsSuccess)
            {
                _failed = true;
                return;
            }

            _view = result.Value;
            // Total and volume sit under the resources, so a rise in one reads against the other.
            _rows = new List<PeriodChange>([.. _view.Resources, _view.Total, _view.Volume]).AsQueryable();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _failed = true;
            PageLog.CostCrashed(Logger, exception);
        }
    }

    private async Task ExplainAsync()
    {
        _explaining = true;
        _explainUnavailable = false;
        _explanation = null;
        var correlationId = Guid.NewGuid().ToString("N");
        try
        {
            var result = await Requests.NarrateSpendAsync(new NarrateSpendQuery(correlationId), _lifetime.Token);
            if (result.IsSuccess)
            {
                _explanation = result.Value;
            }
            else
            {
                _explainUnavailable = true;
                PageLog.SpendNarrationFailed(Logger, correlationId, result.Errors.FirstOrDefault() ?? "AgentUnavailable");
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            _explainUnavailable = true;
            PageLog.SpendNarrationCrashed(Logger, exception, correlationId);
        }
        finally
        {
            _explaining = false;
        }
    }

    private RenderFragment Figure(decimal? value, PeriodChange row) => builder =>
        builder.AddContent(0, value is null ? "no data" : row.Kind == ChangeKind.Volume ? value.Value.ToString("0.#", CultureInfo.InvariantCulture) : Eur(value.Value));

    // Text, not a colour alone: a rise is "+", a fall is "−".
    private static string Percent(decimal? relative) =>
        relative is null ? "n/a" : (relative.Value > 0 ? "+" : relative.Value < 0 ? "−" : string.Empty) + (Math.Abs(relative.Value) * 100).ToString("0", CultureInfo.InvariantCulture) + "%";

    private static string Eur(decimal value) => value.ToString("0.00", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
