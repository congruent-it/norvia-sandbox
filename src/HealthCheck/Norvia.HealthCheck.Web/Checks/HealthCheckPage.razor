@page "/"
@* Interactive, not prerendered: the run starts from a button and the page waits for the checks and then the assistant. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Policy = OperatorSignIn.RunPolicy)]
@using Ardalis.Result
@using Microsoft.JSInterop
@using Microsoft.Extensions.Options
@using Norvia.Agents
@using Norvia.HealthCheck.Application.Agents
@using Norvia.HealthCheck.Application.Checks
@using Norvia.HealthCheck.Application.Narrate
@using Norvia.HealthCheck.Application.Report
@using Norvia.HealthCheck.Application.Run
@inject IHealthCheckRequests Requests
@inject IJSRuntime Js
@inject IOptions<AgentsOptions> Agents
@inject ILogger<HealthCheckPage> Logger
@implements IDisposable

<PageTitle>@PageTitles.Run</PageTitle>

<h1>Estate health check</h1>
<p class="text-muted">
    Runs the checklist over the estate's configuration and lists what is wrong, a Finding for each Check that fails. Severity and fix are the
    Check's own. @(Agents.Value.Enabled ? "The assistant then puts the Findings in order and explains what they mean for the business." : string.Empty)
</p>
<p role="note" class="text-muted">
    Locally the Findings come from a snapshot of the estate's configuration, not from the running estate. Nothing is changed or stored.
</p>

<FluentButton Appearance="Appearance.Accent" Disabled="_running" OnClick="RunAsync">Run health check</FluentButton>

@if (_running)
{
    <div role="status" class="mt-3">
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentProgressRing />
            <span>Running the checks…</span>
        </FluentStack>
    </div>
}
else if (_runFailed)
{
    <div role="alert" class="mt-3">
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">The health check could not be run.</FluentMessageBar>
    </div>
}

@if (_report is { } report)
{
    <section aria-label="Findings" data-testid="findings">
        <h2 class="mt-6">Findings</h2>
        @if (report.Findings.Count == 0)
        {
            <p data-testid="no-findings">No Findings. All @report.ChecksRun @(report.ChecksRun == 1 ? "Check" : "Checks") passed on the @report.Estate snapshot.</p>
        }
        else
        {
            <p class="text-muted">@report.Findings.Count @(report.Findings.Count == 1 ? "Finding" : "Findings") from @report.ChecksRun @(report.ChecksRun == 1 ? "Check" : "Checks"), on the @report.Estate snapshot.</p>
            @foreach (var group in SeverityGroup.By(report.Findings, _narration?.Items.Select(item => item.Id).ToList()))
            {
                <section aria-label="@group.Severity severity" data-testid="severity-group">
                    <h3 class="mt-6" data-testid="severity-heading">@group.Severity (@group.Findings.Count)</h3>
                    @foreach (var finding in group.Findings)
                    {
                        <FindingCard Finding="finding" Explained="ExplainedBy(finding)" Status="@StatusOf(finding)" AskAsync="Agents.Value.Enabled ? AskAsync : null" />
                    }
                </section>
            }
        }
    </section>

    @if (_comparison is { } comparison)
    {
        <section aria-label="Since the previous run" data-testid="comparison" class="mt-6">
            <h2>Since the previous run</h2>
            <p data-testid="comparison-summary">@comparison.New.Count new, @comparison.Fixed.Count fixed, @comparison.Unchanged.Count unchanged.</p>
            @if (comparison.Fixed.Count > 0)
            {
                <h3>Fixed</h3>
                <ul data-testid="fixed-findings">
                    @foreach (var fixedFinding in comparison.Fixed)
                    {
                        <li><strong>@fixedFinding.Id</strong> <span>@fixedFinding.Title</span></li>
                    }
                </ul>
            }
        </section>
    }

    <p class="mt-3">
        <FluentButton Appearance="Appearance.Outline" OnClick="ExportAsync" data-testid="export">Export as Markdown</FluentButton>
    </p>

    @if (Agents.Value.Enabled)
    {
        <section aria-label="Assistant's narration" class="mt-6">
            @if (_narrating)
            {
                <div role="status">
                    <FluentStack VerticalAlignment="VerticalAlignment.Center">
                        <FluentProgressRing />
                        <span>The assistant is reading the Findings…</span>
                    </FluentStack>
                </div>
            }
            else if (_unavailable)
            {
                @* Whatever went wrong, the operator sees this and nothing else changes: the Findings above stay. *@
                <div role="alert">
                    <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">Assistant unavailable</FluentMessageBar>
                </div>
            }
            else if (_narration is { } narration)
            {
                @* Text only: what the assistant wrote is data, so it is encoded, never rendered as markup. *@
                <div class="narration" data-testid="narration">
                    <h2>How the assistant ordered them</h2>
                    <p data-testid="narration-summary">@narration.Summary</p>
                    <p class="text-muted" data-testid="ordering-note">
                        The assistant puts the Findings in order within each severity and explains them. It never changes a severity, a fix or what was found: those are the Checks' own.
                    </p>
                    <ol>
                        @foreach (var item in narration.Items)
                        {
                            <li data-testid="narration-item">
                                <strong>@item.Id</strong>: @item.Impact <cite class="text-muted">[@item.ResultId, @item.ToolName]</cite>
                            </li>
                        }
                    </ol>
                    <p class="text-muted">The assistant can be wrong; the Findings above are the Checks' own.</p>
                </div>
            }
        </section>
    }
}

@code {
    private bool _running;
    private bool _runFailed;
    private bool _narrating;
    private bool _unavailable;
    private HealthCheckReport? _report;
    private Narration? _narration;
    private HealthCheckReport? _lastRun;
    private ReportComparison? _comparison;
    private string _correlationId = string.Empty;
    private readonly CancellationTokenSource _lifetime = new();

    private async Task RunAsync()
    {
        // The ID of this run: the assistant's tool calls carry it, so they join one Message trail.
        var correlationId = Guid.NewGuid().ToString("N");
        _correlationId = correlationId;
        // The previous result is held in the page session only, to show what a re-run changed. A run that fails keeps it.
        _running = true;
        _runFailed = false;
        _unavailable = false;
        _report = null;
        _comparison = null;
        _narration = null;
        try
        {
            var run = await Requests.RunAsync(new RunHealthCheckQuery(), _lifetime.Token);
            if (!run.IsSuccess)
            {
                _runFailed = true;
                return;
            }

            _report = run.Value;
            _comparison = _lastRun is null ? null : ReportComparison.Between(_lastRun, run.Value);
            _lastRun = run.Value;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            _runFailed = true;
            PageLog.RunCrashed(Logger, exception, correlationId);
            return;
        }
        finally
        {
            _running = false;
        }

        if (Agents.Value.Enabled)
        {
            await NarrateAsync(correlationId);
        }
    }

    private NarratedItem? ExplainedBy(Finding finding) => _narration?.Items.FirstOrDefault(item => item.Id == finding.Id);

    private string? StatusOf(Finding finding) =>
        _comparison is null ? null : _comparison.New.Any(candidate => candidate.Id == finding.Id) ? "New" : "Unchanged";

    private Task<Result<NarratedItem>> AskAsync(Finding finding, FindingQuestion question) =>
        Requests.ExplainAsync(new ExplainFindingQuery(_correlationId, finding.Id, question), _lifetime.Token);

    private async Task ExportAsync()
    {
        if (_report is null)
        {
            return;
        }

        var markdown = MarkdownReport.Render(_report, _narration, _comparison);
        await Js.InvokeVoidAsync("norviaDownloadText", $"estate-health-check-{_report.RanAt:yyyyMMdd-HHmm}.md", markdown, "text/markdown");
    }

    private async Task NarrateAsync(string correlationId)
    {
        _narrating = true;
        StateHasChanged();
        try
        {
            var result = await Requests.NarrateAsync(new NarrateHealthCheckQuery(correlationId), _lifetime.Token);
            if (result.IsSuccess)
            {
                _narration = result.Value;
            }
            else
            {
                _unavailable = true;
                PageLog.NarrationFailed(Logger, correlationId, result.Errors.FirstOrDefault() ?? "AgentUnavailable");
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            _unavailable = true;
            PageLog.NarrationCrashed(Logger, exception, correlationId);
        }
        finally
        {
            _narrating = false;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
