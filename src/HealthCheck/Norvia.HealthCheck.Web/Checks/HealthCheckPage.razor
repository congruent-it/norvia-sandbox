@page "/"
@* Interactive, not prerendered: the run starts from a button and the page waits for the checks and then the assistant. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Policy = OperatorSignIn.RunPolicy)]
@using Ardalis.Result
@using Microsoft.Extensions.Options
@using Norvia.Agents
@using Norvia.HealthCheck.Application.Agents
@using Norvia.HealthCheck.Application.Checks
@using Norvia.HealthCheck.Application.Narrate
@using Norvia.HealthCheck.Application.Run
@inject IHealthCheckRequests Requests
@inject IOptions<AgentsOptions> Agents
@inject ILogger<HealthCheckPage> Logger
@implements IDisposable

<PageTitle>@PageTitles.Run</PageTitle>

<h1>Estate health check</h1>
<p class="text-muted">
    Runs the checklist over the estate's configuration and lists what is wrong, a Finding for each Check that fails. Severity and fix are the
    Check's own. @(Agents.Value.Enabled ? "The assistant then puts the Findings in order and explains what they mean for the business." : string.Empty)
</p>
<p role="note" class="text-muted">
    Locally the Findings come from a snapshot of the estate's configuration, not from the running estate. Nothing is changed or stored.
</p>

<FluentButton Appearance="Appearance.Accent" Disabled="_running" OnClick="RunAsync">Run health check</FluentButton>

@if (_running)
{
    <div role="status" class="mt-3">
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentProgressRing />
            <span>Running the checks…</span>
        </FluentStack>
    </div>
}
else if (_runFailed)
{
    <div role="alert" class="mt-3">
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">The health check could not be run.</FluentMessageBar>
    </div>
}

@if (_report is { } report)
{
    <section aria-label="Findings" data-testid="findings">
        <h2 class="mt-6">Findings</h2>
        @if (report.Findings.Count == 0)
        {
            <p data-testid="no-findings">No Findings. All @report.ChecksRun @(report.ChecksRun == 1 ? "Check" : "Checks") passed on the @report.Estate snapshot.</p>
        }
        else
        {
            <p class="text-muted">@report.Findings.Count @(report.Findings.Count == 1 ? "Finding" : "Findings") from @report.ChecksRun @(report.ChecksRun == 1 ? "Check" : "Checks"), on the @report.Estate snapshot.</p>
            @foreach (var finding in report.Findings)
            {
                @* Text only: names in the evidence come from the estate, so they are encoded, never rendered as markup. *@
                <article class="finding" data-testid="finding" aria-label="@finding.Id">
                    <h3>
                        <span data-testid="finding-id">@finding.Id</span>
                        <span class="severity severity-@finding.Severity.ToString().ToLowerInvariant()" data-testid="finding-severity">@finding.Severity</span>
                        <span>@finding.Title</span>
                    </h3>
                    <p>@finding.Rule</p>
                    <ul data-testid="finding-evidence">
                        @foreach (var evidence in finding.Evidence)
                        {
                            <li><strong>@evidence.Subject</strong>: @evidence.Detail</li>
                        }
                    </ul>
                    <dl>
                        <dt>Check</dt>
                        <dd data-testid="finding-check">@finding.CheckId</dd>
                        <dt>As-found toggle</dt>
                        <dd><code>@finding.AsFoundToggle</code></dd>
                        <dt>Fix</dt>
                        <dd data-testid="finding-fix">@finding.Fix</dd>
                    </dl>
                </article>
            }
        }
    </section>

    @if (Agents.Value.Enabled)
    {
        <section aria-label="Assistant's narration" class="mt-6">
            @if (_narrating)
            {
                <div role="status">
                    <FluentStack VerticalAlignment="VerticalAlignment.Center">
                        <FluentProgressRing />
                        <span>The assistant is reading the Findings…</span>
                    </FluentStack>
                </div>
            }
            else if (_unavailable)
            {
                @* Whatever went wrong, the operator sees this and nothing else changes: the Findings above stay. *@
                <div role="alert">
                    <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">Assistant unavailable</FluentMessageBar>
                </div>
            }
            else if (_narration is { } narration)
            {
                @* Text only: what the assistant wrote is data, so it is encoded, never rendered as markup. *@
                <div class="narration" data-testid="narration">
                    <h2>Assistant's narration</h2>
                    <p data-testid="narration-summary">@narration.Summary</p>
                    <ol>
                        @foreach (var item in narration.Items)
                        {
                            <li data-testid="narration-item">
                                <strong>@item.Id</strong>: @item.Impact <cite class="text-muted">[@item.ResultId, @item.ToolName]</cite>
                            </li>
                        }
                    </ol>
                    <p class="text-muted">The assistant can be wrong; the Findings above are the Checks' own.</p>
                </div>
            }
        </section>
    }
}

@code {
    private bool _running;
    private bool _runFailed;
    private bool _narrating;
    private bool _unavailable;
    private HealthCheckReport? _report;
    private Narration? _narration;
    private readonly CancellationTokenSource _lifetime = new();

    private async Task RunAsync()
    {
        // The ID of this run: the assistant's tool calls carry it, so they join one Message trail.
        var correlationId = Guid.NewGuid().ToString("N");
        _running = true;
        _runFailed = false;
        _unavailable = false;
        _report = null;
        _narration = null;
        try
        {
            var run = await Requests.RunAsync(new RunHealthCheckQuery(), _lifetime.Token);
            if (!run.IsSuccess)
            {
                _runFailed = true;
                return;
            }

            _report = run.Value;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            _runFailed = true;
            PageLog.RunCrashed(Logger, exception, correlationId);
            return;
        }
        finally
        {
            _running = false;
        }

        if (Agents.Value.Enabled)
        {
            await NarrateAsync(correlationId);
        }
    }

    private async Task NarrateAsync(string correlationId)
    {
        _narrating = true;
        StateHasChanged();
        try
        {
            var result = await Requests.NarrateAsync(new NarrateHealthCheckQuery(correlationId), _lifetime.Token);
            if (result.IsSuccess)
            {
                _narration = result.Value;
            }
            else
            {
                _unavailable = true;
                PageLog.NarrationFailed(Logger, correlationId, result.Errors.FirstOrDefault() ?? "AgentUnavailable");
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            _unavailable = true;
            PageLog.NarrationCrashed(Logger, exception, correlationId);
        }
        finally
        {
            _narrating = false;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
