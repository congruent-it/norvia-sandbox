@page "/refused-at-the-edge"
@* Interactive, not prerendered: the page reads the telemetry itself and keeps refreshing for as long as the circuit is open. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Norvia.IntegrationConsole.Application.Refusals
@using Norvia.IntegrationConsole.Application.Refusals.List
@inject IRefusalRequests Refusals
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject ILogger<RefusedAtTheEdge> Logger
@implements IDisposable

<PageTitle>Integration console · Refused at the edge</PageTitle>

<h1>Refused at the edge</h1>
<p class="text-muted">
    Calls API Management refused with 401, 403 or 429 in the last 24 hours, newest first, before any Logic App ran.
    This page refreshes itself every few seconds; telemetry may be a few minutes behind.
</p>
<p role="note" class="text-muted mb-6">
    A refusal is the answer the caller was meant to get. Look for a caller refused again and again, such as an expired token or a missing role.
</p>

<form role="search" aria-label="Refused calls" class="mb-8 flex flex-wrap items-end gap-4">
    <FluentSelect TOption="string" Value="@(_status?.ToString() ?? string.Empty)" ValueChanged="FilterStatus" Label="Status">
        <FluentOption TOption="string" Value="@string.Empty">All statuses</FluentOption>
        @foreach (var status in RefusalStatus.All)
        {
            <FluentOption TOption="string" Value="@status.ToString()">@status</FluentOption>
        }
    </FluentSelect>
    <FluentSelect TOption="string" Value="@(_operation ?? string.Empty)" ValueChanged="FilterOperation" Label="Operation">
        <FluentOption TOption="string" Value="@string.Empty">All operations</FluentOption>
        @foreach (var operation in _result?.Operations ?? [])
        {
            <FluentOption TOption="string" Value="@operation">@operation</FluentOption>
        }
    </FluentSelect>
</form>

@if (_loading)
{
    <div role="status">
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentProgressRing />
            <span>Loading the refused calls…</span>
        </FluentStack>
    </div>
}
else if (_failed)
{
    <div role="alert">
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
            The refused calls couldn't be listed. The page tries again in a moment; if it keeps failing, the console may not
            reach the estate's telemetry.
        </FluentMessageBar>
    </div>
}
else if (_result is { Calls: { Count: 0 } })
{
    <p role="status">
        No refused calls between @ConsoleTime.Format(_result.From) and @ConsoleTime.Format(_result.To).
    </p>
}
else if (_result is { } found)
{
    <h2>By caller</h2>
    <FluentDataGrid Items="found.Groups.AsQueryable()" TGridItem="RefusalGroup" aria-label="Refusals by caller" GridTemplateColumns="minmax(12rem, 1fr) max-content max-content">
        <PropertyColumn Title="Caller" Property="@(group => group.Caller)" />
        <PropertyColumn Title="Status" Property="@(group => group.StatusCode)" />
        <PropertyColumn Title="Refused" Property="@(group => group.Count)" />
    </FluentDataGrid>

    <h2 class="mt-8">Refused calls</h2>
    @* Keys only: never a body, a token or a subscription key. *@
    <FluentDataGrid Items="found.Calls.AsQueryable()" TGridItem="RefusedCall" aria-label="Refused calls found" MultiLine="true"
                    GridTemplateColumns="max-content minmax(12rem, 1fr) max-content minmax(10rem, 1fr) minmax(10rem, 1fr) max-content">
        <PropertyColumn Title="Time" Property="@(call => ConsoleTime.Format(call.Time))" />
        <PropertyColumn Title="Operation" Property="@(call => call.Operation)" />
        <PropertyColumn Title="Status" Property="@(call => call.StatusCode)" />
        <PropertyColumn Title="Failure code" Property="@(call => call.FailureCode)" />
        <PropertyColumn Title="Caller" Property="@(call => call.Caller)" />
        <TemplateColumn Title="Correlation ID">
            @if (context.CorrelationId is { } correlationId)
            {
                <a href="@TrailLinks.Trail(correlationId)" class="font-mono text-xs">@correlationId</a>
            }
            else
            {
                <span class="text-muted">–</span>
            }
        </TemplateColumn>
    </FluentDataGrid>
}

@code {
    private static readonly TimeSpan RefreshEvery = TimeSpan.FromSeconds(5);

    private readonly CancellationTokenSource _open = new();
    private int? _status;
    private string? _operation;
    private bool _loading;
    private bool _failed;
    private RefusedCallList? _result;

    [SupplyParameterFromQuery(Name = "status")]
    private int? Status { get; set; }

    [SupplyParameterFromQuery(Name = "operation")]
    private string? Operation { get; set; }

    protected override void OnInitialized() => _ = RefreshAsync(_open.Token);

    protected override async Task OnParametersSetAsync()
    {
        _status = Status;
        _operation = Operation?.Trim();
        await LoadAsync(_open.Token);
    }

    private async Task LoadAsync(CancellationToken cancellation)
    {
        // The list stays while it refreshes; only the first load shows progress.
        _loading = _result is null;
        try
        {
            _result = await Refusals.ListAsync(new ListRefusedCallsQuery(_status, _operation), cancellation);
            _failed = false;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            RefusalPageLog.ListFailed(Logger, exception);
            _failed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync(CancellationToken cancellation)
    {
        using var timer = new PeriodicTimer(RefreshEvery, Time);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellation))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync(cancellation);
                    if (!cancellation.IsCancellationRequested)
                    {
                        StateHasChanged();
                    }
                });
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
    }

    private void FilterStatus(string status) => Filter(status, _operation);

    private void FilterOperation(string operation) => Filter(_status?.ToString(), operation);

    private void Filter(string? status, string? operation) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters("/refused-at-the-edge", new Dictionary<string, object?>
        {
            ["status"] = string.IsNullOrEmpty(status) ? null : status,
            ["operation"] = string.IsNullOrEmpty(operation) ? null : operation,
        }));

    public void Dispose()
    {
        _open.Cancel();
        _open.Dispose();
    }
}
