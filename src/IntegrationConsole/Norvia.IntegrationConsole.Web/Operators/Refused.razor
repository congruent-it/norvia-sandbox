@page "/refused"
@attribute [Authorize]

<PageTitle>Not allowed · Integration console</PageTitle>

<h1>You can't use the Integration console</h1>
<p>
    You're signed in as <strong>@_operatorName</strong>, but you don't hold the <code>@OperatorRoles.Read</code> role.
    Message trails show message bodies, and those hold personal data, so only Integration operators may see them.
</p>
<p>Ask whoever manages Norvia's Entra ID to assign you the role on the Integration console's app registration.</p>

@code {
    private string? _operatorName;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status403Forbidden;
        }

        _operatorName = AuthenticationState is null ? null : (await AuthenticationState).User.Identity?.Name;
    }
}
