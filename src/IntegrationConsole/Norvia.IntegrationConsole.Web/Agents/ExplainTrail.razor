@using Ardalis.Result
@using Microsoft.Extensions.Options
@using Norvia.Agents
@using Norvia.IntegrationConsole.Application.Agents
@using Norvia.IntegrationConsole.Application.Agents.Explain
@inject IExplainRequests Requests
@inject IOptions<AgentsOptions> Agents
@inject ILogger<ExplainTrail> Logger
@implements IDisposable

@* Off unless Agents:Enabled, and only for an operator with the Read role. An Agent is never on a critical path (ADR 0040). *@
@if (Agents.Value.Enabled)
{
    <AuthorizeView Policy="@OperatorSignIn.ReadPolicy">
        <section aria-label="Explanation" class="mb-6">
            <FluentButton Appearance="Appearance.Accent" Disabled="_asking" OnClick="ExplainAsync">Explain</FluentButton>

            @if (_asking)
            {
                <div role="status" class="mt-3">
                    <FluentStack VerticalAlignment="VerticalAlignment.Center">
                        <FluentProgressRing />
                        <span>The assistant is reading the Message trail…</span>
                    </FluentStack>
                </div>
            }
            else if (_unavailable)
            {
                @* Whatever went wrong, the operator sees this and nothing else changes. *@
                <div role="alert" class="mt-3">
                    <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">Assistant unavailable</FluentMessageBar>
                </div>
            }
            else if (_suggestion is { } suggestion)
            {
                @* Text only: what the assistant wrote is data, so it is encoded, never rendered as markup. *@
                <div class="mt-3" data-testid="explanation">
                    <h2 class="text-lg">Cause</h2>
                    <p>@suggestion.Cause</p>
                    <h2 class="text-lg">Evidence</h2>
                    <ul>
                        @foreach (var evidence in suggestion.Evidence)
                        {
                            <li>@evidence.Claim <cite class="text-muted">[@evidence.ResultId, @evidence.ToolName]</cite></li>
                        }
                    </ul>
                    <h2 class="text-lg">Suggested action</h2>
                    <p>@suggestion.SuggestedAction</p>
                    <p class="text-muted">Confidence: @suggestion.Confidence.ToString().ToLowerInvariant(). The assistant can be wrong; you decide.</p>
                </div>
            }
        </section>
    </AuthorizeView>
}

@code {
    private bool _asking;
    private bool _unavailable;
    private Suggestion? _suggestion;
    private readonly CancellationTokenSource _lifetime = new();

    [Parameter, EditorRequired]
    public string CorrelationId { get; set; } = string.Empty;

    private async Task ExplainAsync()
    {
        _asking = true;
        _unavailable = false;
        _suggestion = null;
        try
        {
            var result = await Requests.ExplainAsync(new ExplainTrailQuery(CorrelationId), _lifetime.Token);
            if (result.IsSuccess)
            {
                _suggestion = result.Value;
            }
            else
            {
                _unavailable = true;
                AgentPageLog.ExplainFailed(Logger, CorrelationId, result.Errors.FirstOrDefault() ?? "AgentUnavailable");
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            _unavailable = true;
            AgentPageLog.ExplainCrashed(Logger, exception, CorrelationId);
        }
        finally
        {
            _asking = false;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
