@using Ardalis.Result
@using Microsoft.Extensions.Options
@using Norvia.Agents
@using Norvia.IntegrationConsole.Application.Agents
@inject IOptions<AgentsOptions> Agents
@inject ILogger<ExplainItem> Logger
@implements IDisposable

@* One fixed question about one item of a panel: a failed run, a dead-lettered message, or the dead-letter queues as a whole. Off unless
   Agents:Enabled, and only for an operator with the Read role. An Agent is never on a critical path (ADR 0040). *@
@if (Agents.Value.Enabled)
{
    <AuthorizeView Policy="@OperatorSignIn.ReadPolicy">
        <div data-explain="@Subject">
            <FluentButton Appearance="@ButtonAppearance" Disabled="_asking" OnClick="ExplainAsync" aria-label="@(ButtonText + " " + Subject)">@ButtonText</FluentButton>

            @if (_asking)
            {
                <div role="status" class="mt-3">
                    <FluentStack VerticalAlignment="VerticalAlignment.Center">
                        <FluentProgressRing />
                        <span>The assistant is reading…</span>
                    </FluentStack>
                </div>
            }
            else if (_unavailable)
            {
                @* Whatever went wrong, the operator sees this and nothing else changes. *@
                <div role="alert" class="mt-3">
                    <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">Assistant unavailable</FluentMessageBar>
                </div>
            }
            else if (_suggestion is { } suggestion)
            {
                @* Text only: what the assistant wrote is data, so it is encoded, never rendered as markup. *@
                <div class="mt-3" data-testid="explanation">
                    <h2 class="text-lg">Cause</h2>
                    <p>@suggestion.Cause</p>
                    <h2 class="text-lg">Evidence</h2>
                    <ul>
                        @foreach (var evidence in suggestion.Evidence)
                        {
                            <li>@evidence.Claim <cite class="text-muted">[@evidence.ResultId, @evidence.ToolName]</cite></li>
                        }
                    </ul>
                    <h2 class="text-lg">Suggested action</h2>
                    <p>@suggestion.SuggestedAction</p>
                    <p class="text-muted">Confidence: @suggestion.Confidence.ToString().ToLowerInvariant(). The assistant can be wrong; you decide.</p>
                </div>
            }
        </div>
    </AuthorizeView>
}

@code {
    private bool _asking;
    private bool _unavailable;
    private Suggestion? _suggestion;
    private readonly CancellationTokenSource _lifetime = new();

    /// <summary>Puts this item's fixed question to the Agent.</summary>
    [Parameter, EditorRequired]
    public Func<CancellationToken, Task<Result<Suggestion>>> Ask { get; set; } = default!;

    /// <summary>What the question is about, in a few words, for the button's accessible name and the log.</summary>
    [Parameter, EditorRequired]
    public string Subject { get; set; } = string.Empty;

    [Parameter]
    public string ButtonText { get; set; } = "Explain";

    [Parameter]
    public Appearance ButtonAppearance { get; set; } = Appearance.Lightweight;

    private async Task ExplainAsync()
    {
        _asking = true;
        _unavailable = false;
        _suggestion = null;
        try
        {
            var result = await Ask(_lifetime.Token);
            if (result.IsSuccess)
            {
                _suggestion = result.Value;
            }
            else
            {
                _unavailable = true;
                AgentPageLog.ExplainItemFailed(Logger, Subject, result.Errors.FirstOrDefault() ?? "AgentUnavailable");
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            _unavailable = true;
            AgentPageLog.ExplainItemCrashed(Logger, exception, Subject);
        }
        finally
        {
            _asking = false;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
