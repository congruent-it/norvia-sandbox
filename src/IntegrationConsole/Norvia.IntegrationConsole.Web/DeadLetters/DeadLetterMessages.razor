@page "/dead-letter-queues/{*Entity}"
@* Interactive, not prerendered: the page peeks the Service Bus itself, and opening a message needs the circuit. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using Ardalis.Result
@using Microsoft.AspNetCore.Components.Authorization
@using Norvia.IntegrationConsole.Application.DeadLetters
@using Norvia.IntegrationConsole.Application.DeadLetters.Bulk
@using Norvia.IntegrationConsole.Application.DeadLetters.Discard
@using Norvia.IntegrationConsole.Application.DeadLetters.Messages
@using Norvia.IntegrationConsole.Application.DeadLetters.Resubmit
@using Norvia.IntegrationConsole.Application.Operators
@using Norvia.IntegrationConsole.Web.Operators
@using Norvia.IntegrationConsole.Web.Runs
@using Norvia.IntegrationConsole.Web.Trails
@inject IDeadLetterRequests DeadLetters
@inject ILogger<DeadLetterMessages> Logger
@inject AuthenticationStateProvider Authentication
@implements IDisposable

<PageTitle>Integration console · Dead-lettered messages of @Entity</PageTitle>

<h1>Dead-lettered messages of <span class="font-mono text-base">@Entity</span></h1>
<p class="text-muted mb-1"><a href="/dead-letter-queues">All dead-letter queues</a></p>
@* Peeked, never received: a message keeps its delivery count and lock state, and stays on the queue. *@
<p role="note" class="text-muted mb-6">
    The oldest first. Looking changes nothing: a message keeps its delivery count and stays on the queue, and its body shows
    only when you open it.
</p>

@if (_outcome is { } outcome)
{
    <div role="status">
        <FluentMessageBar Intent="outcome.Intent" AllowDismiss="false">@outcome.Text</FluentMessageBar>
    </div>
}

@if (_bulkOutcome is { } bulkOutcome)
{
    <section aria-label="Outcome per message" data-bulk-outcome class="mb-6">
        <h2 class="text-base font-bold">@bulkOutcome.Title</h2>
        <ul class="m-0 list-none p-0">
            @foreach (var message in bulkOutcome.Messages)
            {
                <li data-outcome="@message.Status.ToString().ToLowerInvariant()" data-message-outcome="@message.SequenceNumber">
                    Message @message.SequenceNumber: @BulkText(message)
                </li>
            }
        </ul>
    </section>
}

@if (_loading)
{
    <div role="status">
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentProgressRing />
            <span>Loading the dead-lettered messages…</span>
        </FluentStack>
    </div>
}
else if (_failed)
{
    <div role="alert">
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
            The dead-lettered messages couldn't be listed. Try again in a moment; if it keeps failing, the console may not
            reach the estate's Service Bus.
        </FluentMessageBar>
    </div>
}
else if (_problems is { Count: > 0 })
{
    <div role="alert">
        <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
            @string.Join(" ", _problems)
        </FluentMessageBar>
    </div>
}
else if (_missing)
{
    <p role="status">The Service Bus has no queue or subscription named @Entity.</p>
}
else if (_list is { Messages: { Count: 0 } })
{
    <p role="status">@Entity has no dead-lettered messages.</p>
}
else if (_list is { } found)
{
    @* The tracking contract's keys only, never a body: that shows when the operator opens a message. *@
    @* Only for the Resubmit role. The use cases refuse everyone else too. A selection is of this one queue or subscription. *@
    @if (_canBulk && _selected.Count > 0)
    {
        <div class="mb-2" data-selection>
            @if (_bulk == BulkAction.Discard)
            {
                <div role="alertdialog" aria-label="Confirm discard of the selection">
                    <p class="mb-2">
                        Discard @_selected.Count selected @(_selected.Count == 1 ? "message" : "messages") of <span class="font-mono">@Entity</span>? They leave the
                        dead-letter queue for good and nothing is sent. Your name and the reason are recorded on each.
                    </p>
                    <FluentTextArea Label="Reason for discarding the selection" aria-label="Reason for discarding the selection" @bind-Value="_reason" Immediate="true" Rows="3"
                                    Disabled="_busy" Style="width: 100%;" />
                    @if (_reasonMissing)
                    {
                        <p role="alert" data-reason-missing class="mt-1 text-sm">Give a reason for discarding the messages.</p>
                    }
                    <FluentStack class="mt-2">
                        <FluentButton Appearance="Appearance.Accent" Disabled="_busy" OnClick="DiscardSelectedAsync">Confirm discard of selection</FluentButton>
                        <FluentButton Disabled="_busy" OnClick="() => _bulk = BulkAction.None">Cancel</FluentButton>
                    </FluentStack>
                </div>
            }
            else if (_bulk == BulkAction.Resubmit)
            {
                <div role="alertdialog" aria-label="Confirm resubmit of the selection">
                    <p class="mb-2">
                        Resubmit @_selected.Count selected @(_selected.Count == 1 ? "message" : "messages") to <span class="font-mono">@Entity</span>, oldest first, in
                        the order they were enqueued? Each leaves the dead-letter queue as its copy is sent. Your name is recorded on each.
                    </p>
                    <FluentStack>
                        <FluentButton Appearance="Appearance.Accent" Disabled="_busy" OnClick="ResubmitSelectedAsync">Confirm resubmit of selection</FluentButton>
                        <FluentButton Disabled="_busy" OnClick="() => _bulk = BulkAction.None">Cancel</FluentButton>
                    </FluentStack>
                </div>
            }
            else
            {
                <FluentStack VerticalAlignment="VerticalAlignment.Center">
                    <span data-selected-count>@_selected.Count selected</span>
                    <FluentButton Appearance="Appearance.Accent" data-resubmit-selected OnClick="() => _bulk = BulkAction.Resubmit">Resubmit selected</FluentButton>
                    <FluentButton data-discard-selected OnClick="StartDiscardSelected">Discard selected</FluentButton>
                </FluentStack>
            }
        </div>
    }

    <FluentDataGrid Items="found.Messages.AsQueryable()" TGridItem="RecordedDeadLetter" aria-label="Dead-lettered messages" MultiLine="true"
                    GridTemplateColumns="@((_canBulk ? "max-content " : "") + "max-content max-content minmax(10rem, 1fr) max-content minmax(12rem, max-content) minmax(10rem, 1fr)")">
        @if (_canBulk)
        {
            <TemplateColumn Title="Select">
                <FluentCheckbox Value="_selected.Contains(context.SequenceNumber)" ValueChanged="(bool on) => Select(context.SequenceNumber, on)"
                                aria-label="@($"Select message {context.SequenceNumber}")" data-select="@context.SequenceNumber" Disabled="_busy" />
            </TemplateColumn>
        }
        <TemplateColumn Title="Enqueued">
            <FluentButton Appearance="Appearance.Lightweight" data-message="@context.SequenceNumber"
                          aria-expanded="@(_opened == context.SequenceNumber ? "true" : "false")" OnClick="() => OpenAsync(context.SequenceNumber)">
                @ConsoleTime.Format(context.EnqueuedAt)
            </FluentButton>
        </TemplateColumn>
        <TemplateColumn Title="Reason">
            <span class="font-mono text-xs">@DeadLetterText.Reason(context.Reason)</span>
        </TemplateColumn>
        <PropertyColumn Title="Description" Property="@(message => message.Description)" />
        <PropertyColumn Title="Deliveries" Property="@(message => message.DeliveryCount)" />
        <TemplateColumn Title="Correlation ID">
            @if (context.CorrelationId is { Length: > 0 } correlationId)
            {
                <a href="@TrailLinks.Trail(correlationId)" class="font-mono text-xs">@correlationId</a>
            }
        </TemplateColumn>
        <TemplateColumn Title="Business keys">
            @foreach (var key in context.BusinessKeys)
            {
                <div><a href="@TrailLinks.Search(key)">@TrailText.Of(key)</a></div>
            }
        </TemplateColumn>
    </FluentDataGrid>

    @if (found.HasMore)
    {
        <p role="note" class="text-muted mt-2">Showing the oldest @found.Messages.Count messages. The queue holds more.</p>
    }

    @if (_opened is { } sequenceNumber)
    {
        <section aria-label="Message @sequenceNumber" class="mt-8">
            <h2 class="font-mono">Message @sequenceNumber</h2>
            @if (_opening)
            {
                <div role="status">
                    <FluentStack VerticalAlignment="VerticalAlignment.Center">
                        <FluentProgressRing />
                        <span>Fetching message @sequenceNumber…</span>
                    </FluentStack>
                </div>
            }
            else if (_openFailed)
            {
                <div role="alert">
                    <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
                        The message couldn't be opened. Try again in a moment.
                    </FluentMessageBar>
                </div>
            }
            else if (_openProblems is { Count: > 0 })
            {
                <div role="alert">
                    <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
                        @string.Join(" ", _openProblems)
                    </FluentMessageBar>
                </div>
            }
            else if (_gone)
            {
                <p role="status">The message is no longer on the queue: it was resubmitted or discarded.</p>
            }
            else if (_message is { } message)
            {
                <h3 class="mt-4 mb-2 text-base font-bold">Body</h3>
                <pre class="bg-surface overflow-x-auto rounded-darkly p-4 font-mono text-xs whitespace-pre-wrap break-words">@RunText.Body(message.Body)</pre>
                <h3 class="mt-4 mb-2 text-base font-bold">Application properties</h3>
                @if (message.Properties.Count == 0)
                {
                    <p class="text-muted">No application properties.</p>
                }
                else
                {
                    <dl data-properties class="m-0 grid grid-cols-[max-content_1fr] gap-x-6 gap-y-1">
                        @foreach (var (name, value) in message.Properties.OrderBy(property => property.Key, StringComparer.Ordinal))
                        {
                            <dt class="font-mono text-xs">@name</dt>
                            <dd class="m-0 font-mono text-xs break-words">@value</dd>
                        }
                    </dl>
                }

                @* Only for the Resubmit role. The use case refuses everyone else too. There is no way to edit the body first. *@
                <AuthorizeView Policy="@OperatorSignIn.ResubmitPolicy">
                    <div class="mt-6">
                        @if (_discarding)
                        {
                            <div role="alertdialog" aria-label="Confirm discard">
                                <p class="mb-2">
                                    Discard message @sequenceNumber of <span class="font-mono">@Entity</span>? It leaves the dead-letter queue for good and
                                    nothing is sent. Your name and the reason are recorded.
                                </p>
                                <FluentTextArea Label="Reason for discarding" aria-label="Reason for discarding" @bind-Value="_reason" Immediate="true" Rows="3"
                                                Disabled="_busy" Style="width: 100%;" />
                                @if (_reasonMissing)
                                {
                                    <p role="alert" data-reason-missing class="mt-1 text-sm">Give a reason for discarding the message.</p>
                                }
                                <FluentStack class="mt-2">
                                    <FluentButton Appearance="Appearance.Accent" Disabled="_busy" OnClick="() => DiscardAsync(sequenceNumber)">Confirm discard</FluentButton>
                                    <FluentButton Disabled="_busy" OnClick="CancelDiscard">Cancel</FluentButton>
                                </FluentStack>
                            </div>
                        }
                        else if (_confirming)
                        {
                            <div role="alertdialog" aria-label="Confirm resubmit">
                                <p class="mb-2">
                                    Resubmit message @sequenceNumber to <span class="font-mono">@Entity</span>? @(Entity.Contains('/') ? "A copy goes to that subscription only" : "A copy goes back to the queue") with
                                    the same body and properties, and this message leaves the dead-letter queue. Your name is recorded.
                                </p>
                                <FluentStack>
                                    <FluentButton Appearance="Appearance.Accent" Disabled="_busy" OnClick="() => ResubmitAsync(sequenceNumber)">Confirm resubmit</FluentButton>
                                    <FluentButton Disabled="_busy" OnClick="() => _confirming = false">Cancel</FluentButton>
                                </FluentStack>
                            </div>
                        }
                        else
                        {
                            <FluentStack>
                                <FluentButton Appearance="Appearance.Accent" data-resubmit OnClick="() => _confirming = true">Resubmit</FluentButton>
                                <FluentButton data-discard OnClick="StartDiscard">Discard</FluentButton>
                            </FluentStack>
                        }
                    </div>
                </AuthorizeView>
            }
        </section>
    }
}

@code {
    private bool _loading;
    private bool _failed;
    private bool _missing;
    private IReadOnlyList<string>? _problems;
    private DeadLetteredMessageList? _list;
    private long? _opened;
    private bool _opening;
    private bool _openFailed;
    private bool _gone;
    private IReadOnlyList<string>? _openProblems;
    private RecordedDeadLetterBody? _message;
    private bool _confirming;
    private bool _discarding;
    private string _reason = string.Empty;
    private bool _reasonMissing;
    private bool _busy;
    private Outcome? _outcome;
    private bool _canBulk;
    private readonly HashSet<long> _selected = [];
    private BulkAction _bulk;
    private BulkResult? _bulkOutcome;
    // Cancel peeking when the operator leaves the page, opens another queue or another message.
    private CancellationTokenSource _peek = new();
    private CancellationTokenSource _fetch = new();

    [Parameter, EditorRequired]
    public string Entity { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _failed = false;
        _missing = false;
        _problems = null;
        _list = null;
        _outcome = null;
        _bulkOutcome = null;
        _selected.Clear();
        _bulk = BulkAction.None;
        _canBulk = (await Authentication.GetAuthenticationStateAsync()).User.IsInRole(OperatorRoles.Resubmit);
        await CloseMessageAsync();

        await _peek.CancelAsync();
        _peek.Dispose();
        _peek = new CancellationTokenSource();
        var cancellation = _peek.Token;
        _loading = true;
        try
        {
            var result = await DeadLetters.ListMessagesAsync(new ListDeadLetteredMessagesQuery(Entity), cancellation);
            if (result.IsSuccess)
            {
                _list = result.Value;
            }
            else if (result.Status == ResultStatus.NotFound)
            {
                _missing = true;
            }
            else
            {
                _problems = [.. result.ValidationErrors.Select(error => error.ErrorMessage)];
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            DeadLetterPageLog.MessagesFailed(Logger, exception, Entity);
            _failed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenAsync(long sequenceNumber)
    {
        await CloseMessageAsync();
        var cancellation = _fetch.Token;
        _opened = sequenceNumber;
        _opening = true;
        try
        {
            // Fetched only now, as the operator opens the message, and kept only as long as the page shows it.
            var result = await DeadLetters.OpenMessageAsync(new OpenDeadLetteredMessageQuery(Entity, sequenceNumber), cancellation);
            if (result.IsSuccess)
            {
                _message = result.Value;
            }
            else if (result.Status == ResultStatus.NotFound)
            {
                _gone = true;
            }
            else
            {
                _openProblems = [.. result.ValidationErrors.Select(error => error.ErrorMessage)];
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            DeadLetterPageLog.OpenFailed(Logger, exception, sequenceNumber, Entity);
            _openFailed = true;
        }
        finally
        {
            if (!cancellation.IsCancellationRequested)
            {
                _opening = false;
            }
        }
    }

    private async Task ResubmitAsync(long sequenceNumber)
    {
        _busy = true;
        try
        {
            var caller = (await Authentication.GetAuthenticationStateAsync()).User;
            var result = await DeadLetters.ResubmitAsync(new ResubmitDeadLetteredMessageCommand(caller, Entity, sequenceNumber), CancellationToken.None);
            switch (result.Status)
            {
                case ResultStatus.Ok:
                    _outcome = new Outcome(MessageIntent.Success, $"Resubmitted message {sequenceNumber} to {Entity}. The copy has message ID {result.Value.ResubmittedMessageId}.");
                    Remove(sequenceNumber);
                    break;
                case ResultStatus.NotFound:
                    _outcome = new Outcome(MessageIntent.Info, $"Message {sequenceNumber} is no longer on the queue: it was resubmitted or discarded.");
                    Remove(sequenceNumber);
                    break;
                case ResultStatus.Forbidden:
                    _outcome = new Outcome(MessageIntent.Warning, "You aren't allowed to resubmit messages. Nothing was sent.");
                    _confirming = false;
                    break;
                default:
                    _outcome = new Outcome(MessageIntent.Warning, string.Join(" ", result.ValidationErrors.Select(error => error.ErrorMessage)));
                    _confirming = false;
                    break;
            }
        }
        catch (Exception exception)
        {
            DeadLetterPageLog.ResubmitFailed(Logger, exception, sequenceNumber, Entity);
            _outcome = new Outcome(MessageIntent.Error, $"Message {sequenceNumber} couldn't be resubmitted. It is still on the dead-letter queue; try again in a moment.");
            _confirming = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartDiscard()
    {
        _discarding = true;
        _reason = string.Empty;
        _reasonMissing = false;
    }

    private void CancelDiscard() => _discarding = false;

    private async Task DiscardAsync(long sequenceNumber)
    {
        // The form refuses a missing reason before anything is sent; the use case refuses it too.
        if (string.IsNullOrWhiteSpace(_reason))
        {
            _reasonMissing = true;
            return;
        }

        _reasonMissing = false;
        _busy = true;
        try
        {
            var caller = (await Authentication.GetAuthenticationStateAsync()).User;
            var result = await DeadLetters.DiscardAsync(new DiscardDeadLetteredMessageCommand(caller, Entity, sequenceNumber, _reason), CancellationToken.None);
            switch (result.Status)
            {
                case ResultStatus.Ok:
                    _outcome = new Outcome(MessageIntent.Success, $"Discarded message {sequenceNumber} of {Entity}. It is off the dead-letter queue.");
                    Remove(sequenceNumber);
                    break;
                case ResultStatus.NotFound:
                    _outcome = new Outcome(MessageIntent.Info, $"Message {sequenceNumber} is no longer on the queue: it was resubmitted or discarded.");
                    Remove(sequenceNumber);
                    break;
                case ResultStatus.Forbidden:
                    _outcome = new Outcome(MessageIntent.Warning, "You aren't allowed to discard messages. Nothing was discarded.");
                    _discarding = false;
                    break;
                default:
                    _outcome = new Outcome(MessageIntent.Warning, string.Join(" ", result.ValidationErrors.Select(error => error.ErrorMessage)));
                    _discarding = false;
                    break;
            }
        }
        catch (Exception exception)
        {
            DeadLetterPageLog.DiscardFailed(Logger, exception, sequenceNumber, Entity);
            _outcome = new Outcome(MessageIntent.Error, $"Message {sequenceNumber} couldn't be discarded. It is still on the dead-letter queue; try again in a moment.");
            _discarding = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Select(long sequenceNumber, bool on)
    {
        if (on)
        {
            _selected.Add(sequenceNumber);
        }
        else
        {
            _selected.Remove(sequenceNumber);
        }

        _bulk = BulkAction.None;
    }

    private void StartDiscardSelected()
    {
        _bulk = BulkAction.Discard;
        _reason = string.Empty;
        _reasonMissing = false;
    }

    private Task ResubmitSelectedAsync() =>
        RunBulkAsync("Resubmit", (caller, messages) => DeadLetters.ResubmitManyAsync(new ResubmitDeadLetteredMessagesCommand(caller, messages), CancellationToken.None));

    private async Task DiscardSelectedAsync()
    {
        // The form refuses a missing reason before anything is sent; the use case refuses it too.
        if (string.IsNullOrWhiteSpace(_reason))
        {
            _reasonMissing = true;
            return;
        }

        _reasonMissing = false;
        await RunBulkAsync("Discard", (caller, messages) => DeadLetters.DiscardManyAsync(new DiscardDeadLetteredMessagesCommand(caller, messages, _reason), CancellationToken.None));
    }

    private async Task RunBulkAsync(string verb, Func<ClaimsPrincipal, IReadOnlyList<DeadLetterSelection>, Task<Result<BulkOutcome>>> send)
    {
        if (_list is not { } list)
        {
            return;
        }

        // Ordered by the use case, whatever order they were ticked in; the page only says which.
        var selection = list.Messages.Where(message => _selected.Contains(message.SequenceNumber))
            .Select(message => new DeadLetterSelection(Entity, message.SequenceNumber, message.EnqueuedAt)).ToList();
        _busy = true;
        try
        {
            var caller = (await Authentication.GetAuthenticationStateAsync()).User;
            var result = await send(caller, selection);
            switch (result.Status)
            {
                case ResultStatus.Ok:
                    var done = result.Value.Messages.Where(message => message.Status != MessageOutcomeStatus.Failed).Select(message => message.SequenceNumber).ToHashSet();
                    var failed = result.Value.Messages.Count(message => message.Status == MessageOutcomeStatus.Failed);
                    _bulkOutcome = new BulkResult($"{verb} of {result.Value.Messages.Count} selected messages of {Entity}: {result.Value.Messages.Count - failed} done, {failed} failed.", result.Value.Messages);
                    _list = list with { Messages = [.. list.Messages.Where(message => !done.Contains(message.SequenceNumber))] };
                    _selected.RemoveWhere(done.Contains);
                    break;
                case ResultStatus.Forbidden:
                    _outcome = new Outcome(MessageIntent.Warning, $"You aren't allowed to {verb.ToLowerInvariant()} messages. Nothing was changed.");
                    break;
                default:
                    _outcome = new Outcome(MessageIntent.Warning, string.Join(" ", result.ValidationErrors.Select(error => error.ErrorMessage)));
                    break;
            }
        }
        catch (Exception exception)
        {
            DeadLetterPageLog.BulkFailed(Logger, exception, verb, Entity);
            _outcome = new Outcome(MessageIntent.Error, "The selection couldn't be sent. Check the list for what is still on the dead-letter queue and try again in a moment.");
        }
        finally
        {
            _bulk = BulkAction.None;
            _busy = false;
        }
    }

    private static string BulkText(MessageOutcome message) => message.Status switch
    {
        MessageOutcomeStatus.Done => "done.",
        MessageOutcomeStatus.Gone => "no longer on the queue: it was resubmitted or discarded.",
        _ => $"failed. {message.Detail}",
    };

    private enum BulkAction { None, Resubmit, Discard }

    private sealed record BulkResult(string Title, IReadOnlyList<MessageOutcome> Messages);

    // The list shows what was peeked, so the message leaves it here rather than on the next peek.
    private void Remove(long sequenceNumber)
    {
        if (_list is { } list)
        {
            _list = list with { Messages = [.. list.Messages.Where(message => message.SequenceNumber != sequenceNumber)] };
        }

        _opened = null;
        _message = null;
        _confirming = false;
        _discarding = false;
    }

    private sealed record Outcome(MessageIntent Intent, string Text);

    private async Task CloseMessageAsync()
    {
        await _fetch.CancelAsync();
        _fetch.Dispose();
        _fetch = new CancellationTokenSource();
        _opened = null;
        _opening = false;
        _openFailed = false;
        _gone = false;
        _openProblems = null;
        _message = null;
        _confirming = false;
        _discarding = false;
    }

    public void Dispose()
    {
        _peek.Cancel();
        _peek.Dispose();
        _fetch.Cancel();
        _fetch.Dispose();
    }
}
