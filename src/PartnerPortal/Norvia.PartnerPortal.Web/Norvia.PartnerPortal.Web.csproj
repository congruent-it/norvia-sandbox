<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="Mediator.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Norvia.ServiceDefaults\Norvia.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Norvia.PartnerPortal.Application\Norvia.PartnerPortal.Application.csproj" />
    <ProjectReference Include="..\Norvia.PartnerPortal.Infrastructure\Norvia.PartnerPortal.Infrastructure.csproj" />
  </ItemGroup>
  <!-- The portal reads its Personas from the seed file, so the published image carries it (Seed:Path in Azure). -->
  <ItemGroup>
    <None Include="..\..\..\seed\norvia.seed.json" Link="seed\norvia.seed.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The sample CMR a presenter can attach to a Proof of delivery instead of a file of their own. -->
  <ItemGroup>
    <EmbeddedResource Include="CarrierShipments/sample-cmr.pdf" LogicalName="sample-cmr.pdf" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Norvia.PartnerPortal.Web.UnitTests" />
    <InternalsVisibleTo Include="Norvia.PartnerPortal.Web.IntegrationTests" />
  </ItemGroup>

  <!--
    The stylesheet is built with Tailwind CSS (ADR 0022), which needs Node.js. Tailwind and the Nunito Sans font come
    from npm; the build installs them, writes wwwroot/app.css and copies the fonts next to it. Both are build output,
    not source.
  -->
  <ItemGroup>
    <None Remove="node_modules/**" />
    <Content Remove="node_modules/**;package.json;package-lock.json" />
    <TailwindInput Include="Styles/**/*.css;**/*.razor" Exclude="node_modules/**;bin/**;obj/**" />
    <NunitoSansFont Include="node_modules/@fontsource/nunito-sans/files/nunito-sans-latin-400-normal.woff2;node_modules/@fontsource/nunito-sans/files/nunito-sans-latin-600-normal.woff2;node_modules/@fontsource/nunito-sans/files/nunito-sans-latin-700-normal.woff2" />
  </ItemGroup>

  <Target Name="InstallStylesheetTools" Inputs="package.json;package-lock.json" Outputs="node_modules/.install-stamp">
    <Exec Command="npm ci --no-audit --no-fund" />
    <Touch Files="node_modules/.install-stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="BuildStylesheet" DependsOnTargets="InstallStylesheetTools" Inputs="@(TailwindInput)" Outputs="wwwroot/app.css">
    <Exec Command="npm run build:css" />
  </Target>

  <!-- Before the static web assets are collected, so a first build already serves the stylesheet and the fonts. -->
  <Target Name="IncludeStylesheet" BeforeTargets="AssignTargetPaths;ResolveStaticWebAssetsConfiguration" DependsOnTargets="BuildStylesheet">
    <Copy SourceFiles="@(NunitoSansFont)" DestinationFolder="wwwroot/fonts" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Remove="wwwroot/app.css;wwwroot/fonts/*.woff2" />
      <Content Include="wwwroot/app.css;wwwroot/fonts/*.woff2" />
    </ItemGroup>
  </Target>
</Project>
