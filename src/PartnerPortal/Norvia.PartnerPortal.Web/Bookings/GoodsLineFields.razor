@* One goods line: its package type, how many, their weight together and, optionally, the size of one package. *@
<fieldset class="mb-4 border border-border p-4">
    <legend class="lux-label px-1">Goods line @Number</legend>
    <div class="grid items-start gap-4 sm:grid-cols-3 lg:grid-cols-7">
        <div>
            <FluentSelect TOption="string" Label="Package type" Items="PackageTypeNames" @bind-Value="Line.PackageType"
                          OptionText="@(name => name[..1].ToUpperInvariant() + name[1..])" />
            <DraftNote Field="@Field("packaging")" />
        </div>
        <div>
            <FluentNumberField TValue="int?" Label="Quantity" @bind-Value="Line.Quantity" />
            <DraftNote Field="@Field("count")" />
        </div>
        <div>
            <FluentNumberField TValue="decimal?" Label="Weight (kg)" @bind-Value="Line.WeightKg" />
            <FluentValidationMessage For="() => Line.WeightKg" />
            <DraftNote Field="@Field("weight")" />
        </div>
        <div>
            <FluentNumberField TValue="decimal?" Label="Length (cm)" @bind-Value="Line.LengthCm" />
            <FluentValidationMessage For="() => Line.LengthCm" />
            <DraftNote Field="@Field("dimensions")" />
        </div>
        <div>
            <FluentNumberField TValue="decimal?" Label="Width (cm)" @bind-Value="Line.WidthCm" />
            <FluentValidationMessage For="() => Line.WidthCm" />
        </div>
        <div>
            <FluentNumberField TValue="decimal?" Label="Height (cm)" @bind-Value="Line.HeightCm" />
            <FluentValidationMessage For="() => Line.HeightCm" />
        </div>
        @if (CanRemove)
        {
            <div class="self-end">
                <FluentButton Appearance="Appearance.Outline" OnClick="OnRemove" aria-label="@($"Remove goods line {Number}")">Remove</FluentButton>
            </div>
        }
    </div>
</fieldset>

@code {
    private static readonly IReadOnlyList<string> PackageTypeNames = [.. GoodsLineForm.PackageTypes.Select(GoodsLineForm.NameOf)];

    [Parameter, EditorRequired]
    public GoodsLineForm Line { get; set; } = null!;

    /// <summary>The line's number on the form, from 1.</summary>
    [Parameter, EditorRequired]
    public int Number { get; set; }

    private string Field(string name) => $"items.{Number - 1}.{name}";

    /// <summary>Whether the line may go: a booking keeps at least one.</summary>
    [Parameter]
    public bool CanRemove { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }
}
