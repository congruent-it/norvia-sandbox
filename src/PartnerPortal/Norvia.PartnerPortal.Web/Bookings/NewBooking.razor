@page "/personas/{PersonaId}/bookings/new"
@*
    Interactive: the form adds and removes goods lines, and shows Norvia's answer in place. Not prerendered: a prerendered
    form looks ready before it is, and what is typed or clicked in it then is lost.
*@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Diagnostics
@using Norvia.PartnerPortal.Application.Bookings.DraftFromText
@inject IPartnerPortal Portal
@inject BookingDraftHandoff Handoff
@inject NavigationManager Navigation
@inject ILogger<NewBooking> Logger
@implements IDisposable

<PageTitle>Partner portal · @(_persona?.DisplayName ?? PersonaId) · Book a transport</PageTitle>

<h1>Book a transport</h1>

@if (_loadFailed)
{
    <div role="alert">
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
            The booking form couldn't be loaded. Reload the page to try again.
        </FluentMessageBar>
    </div>
}
else if (_form is null)
{
    <FluentStack VerticalAlignment="VerticalAlignment.Center" role="status">
        <FluentProgressRing />
        <span>Loading the booking form…</span>
    </FluentStack>
}
else
{
    <p class="mb-8 max-w-3xl">
        As <strong>@_persona!.DisplayName</strong>, ask Norvia to move goods from A to B. Norvia answers straight away: with a
        Transport Order number, or with every reason it can't take the booking.
    </p>

    <p class="mb-6">
        <FluentAnchor Href="@PersonaChoice.FillFromEmailPath(PersonaId)" Appearance="Appearance.Lightweight">Fill from an email</FluentAnchor>
    </p>

    @if (_review is not null)
    {
        <div role="status" class="mb-6 max-w-3xl" data-testid="draft-review">
            <FluentMessageBar Intent="@(_review.CanSubmit ? MessageIntent.Success : MessageIntent.Warning)" AllowDismiss="false">
                The Intake agent filled in what the email gives, and under each value shows the words it came from. A field the email did not give is
                empty. You can send the booking once you have confirmed or edited each field below that is flagged.
                @if (_review.Unhandled.Count > 0)
                {
                    <ul class="list-disc pl-6" data-testid="draft-flags">
                        @foreach (var flag in _review.Unhandled)
                        {
                            <li><strong>@DraftFieldLabels.Of(flag.Field)</strong> (@flag.Title.ToLowerInvariant()): @flag.Reason</li>
                        }
                    </ul>
                }
                else
                {
                    <span class="block">Every flagged field is handled.</span>
                }
            </FluentMessageBar>
        </div>
        @if (_review.Ignored.Count > 0)
        {
            <section class="mb-6 max-w-3xl" aria-labelledby="draft-ignored-heading" data-testid="draft-ignored">
                <h2 id="draft-ignored-heading" class="lux-label">Text the Intake agent did not use</h2>
                <ul class="list-disc pl-6 text-sm">
                    @foreach (var text in _review.Ignored)
                    {
                        <li class="whitespace-pre-line">@text</li>
                    }
                </ul>
            </section>
        }
        <p class="mb-6">
            <FluentAnchor Href="@PersonaChoice.FillFromEmailPath(PersonaId)" Appearance="Appearance.Outline">Start again with other text</FluentAnchor>
        </p>
    }

    <CascadingValue Value="_review">
    <div @onfocusout="ObserveForm">
    <EditForm Model="_form" OnSubmit="HandleSubmitAsync" FormName="booking">
        <BookingFormValidator />

        <fieldset class="lux-fieldset">
            <legend>Booking</legend>
            <div class="max-w-md">
                <FluentTextField Label="Shipper reference" @bind-Value="_form.ShipperReference" />
                <FluentValidationMessage For="() => _form.ShipperReference" />
                <DraftNote Field="bookingRef" />
            </div>
        </fieldset>

        <fieldset class="lux-fieldset">
            <legend>Collection</legend>
            <div class="grid gap-4">
                <AddressFields Address="_form.Collection" Prefix="pickup" />
                <LocalTimeFields Id="collection" FromField="pickupFrom" UntilField="pickupUntil" FromLabel="Collect from" UntilLabel="Collect until"
                                 @bind-From="_form.CollectFrom" @bind-Until="_form.CollectUntil" />
            </div>
        </fieldset>

        <fieldset class="lux-fieldset">
            <legend>Delivery</legend>
            <div class="grid gap-4">
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                    <div>
                        <FluentTextField Label="Consignee" @bind-Value="_form.Consignee.Name" />
                        <DraftNote Field="receiverName" />
                    </div>
                    <div>
                        <FluentTextField Label="Contact name" @bind-Value="_form.Consignee.ContactName" />
                        <DraftNote Field="receiverContact" />
                    </div>
                    <div>
                        <FluentTextField Label="Phone" TextFieldType="TextFieldType.Tel" @bind-Value="_form.Consignee.Phone" />
                        <DraftNote Field="receiverPhone" />
                    </div>
                    <div>
                        <FluentTextField Label="Email" TextFieldType="TextFieldType.Email" @bind-Value="_form.Consignee.Email" />
                        <FluentValidationMessage For="() => _form.Consignee.Email" />
                        <DraftNote Field="receiverEmail" />
                    </div>
                </div>
                <AddressFields Address="_form.Delivery" Prefix="receiver" />
                <LocalTimeFields Id="delivery" FromField="deliverFrom" UntilField="deliverUntil" FromLabel="Deliver from (optional)" UntilLabel="Deliver until (optional)"
                                 @bind-From="_form.DeliverFrom" @bind-Until="_form.DeliverUntil" />
            </div>
        </fieldset>

        <fieldset class="lux-fieldset">
            <legend>Goods</legend>
            @for (var index = 0; index < _form.GoodsLines.Count; index++)
            {
                var line = _form.GoodsLines[index];
                <GoodsLineFields @key="line" Line="line" Number="index + 1" CanRemove="_form.GoodsLines.Count > 1"
                                 OnRemove="() => _form.RemoveGoodsLine(line)" />
            }
            <FluentButton Appearance="Appearance.Outline" OnClick="_form.AddGoodsLine">Add a goods line</FluentButton>
        </fieldset>

        <fieldset class="lux-fieldset">
            <legend>Instructions</legend>
            <div class="max-w-3xl">
                <FluentTextArea Label="Instructions for Norvia (optional)" @bind-Value="_form.Instructions" Rows="3" />
                <DraftNote Field="remarks" />
            </div>
        </fieldset>

        @if (_notConfirmed.Count > 0)
        {
            <div role="alert" class="mb-6" data-testid="draft-not-confirmed">
                <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
                    The booking is not sent yet. Confirm or edit these fields first:
                    <ul class="list-disc pl-6">
                        @foreach (var flag in _notConfirmed)
                        {
                            <li><strong>@DraftFieldLabels.Of(flag.Field)</strong>: @flag.Reason</li>
                        }
                    </ul>
                </FluentMessageBar>
            </div>
        }

        @if (_answer is not null)
        {
            <BookingAnswer Booking="_answer" TraceId="@_traceId" />
        }
        else if (_submitFailed)
        {
            <div role="alert" class="mb-6">
                <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
                    The booking couldn't be sent or recorded. Check My bookings before you send it again: sending it again under the same reference never books it twice.
                    @if (_traceId is not null)
                    {
                        <span class="block mt-2 text-xs">The portal's trace ID for this attempt: @_traceId</span>
                    }
                </FluentMessageBar>
            </div>
        }

        <div class="flex flex-wrap items-center gap-4">
            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="_sending">Book transport</FluentButton>
            <FluentButton Appearance="Appearance.Outline" OnClick="StartNewAsync" Disabled="_sending">Start a new booking</FluentButton>
            @if (_sending)
            {
                <FluentStack VerticalAlignment="VerticalAlignment.Center" role="status" Width="auto">
                    <FluentProgressRing />
                    <span>Sending the booking to Norvia…</span>
                </FluentStack>
            }
        </div>
    </EditForm>
    </div>
    </CascadingValue>
}

@code {
    private PersonaView? _persona;
    private BookingForm? _form;
    private BookingView? _answer;
    private bool _loadFailed;
    private bool _sending;
    private bool _submitFailed;
    private string? _traceId;
    private DraftReview? _review;
    private IReadOnlyList<DraftFlag> _notConfirmed = [];

    [Parameter]
    public string PersonaId { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _form = null;
        _answer = null;
        try
        {
            _persona = PersonaChoice.Find(PersonaId, await Portal.ListPersonasAsync(CancellationToken.None));
            if (_persona is null)
            {
                Navigation.NotFound();
                return;
            }

            await StartNewAsync();
        }
        catch (Exception exception)
        {
            PageLog.LoadFailed(Logger, exception, PersonaId);
            _loadFailed = true;
        }
    }

    private async Task StartNewAsync()
    {
        // A Booking draft from an email, once; otherwise the Persona's own address book. The draft is not part of the booking.
        if (Handoff.Take() is { Booking: { } fromEmail } emailDraft)
        {
            _form = BookingForm.From(fromEmail);
            SetReview(new DraftReview(emailDraft));
        }
        else
        {
            var draft = await Portal.DraftBookingAsync(new PersonaId(PersonaId), CancellationToken.None);
            _form = draft is null ? null : BookingForm.From(draft);
            SetReview(null);
        }

        _answer = null;
        _submitFailed = false;
        _notConfirmed = [];
    }

    private void SetReview(DraftReview? review)
    {
        _review?.Changed -= OnReviewChanged;
        _review = review;
        _review?.Changed += OnReviewChanged;
    }

    private void OnReviewChanged() => _ = InvokeAsync(() =>
    {
        _notConfirmed = [];
        StateHasChanged();
    });

    // A field edited since the draft counts as handled; the screen follows when the Shipper leaves the field.
    private void ObserveForm() => _review?.Observe(_form!.ToRequest());

    public void Dispose() => SetReview(null);

    // After any answer the form keeps what was entered, so after a rejection only what was wrong needs changing, and
    // sending it again after an acceptance shows that Norvia doesn't book it twice.
    private async Task HandleSubmitAsync(EditContext context)
    {
        // Both checks show at once: a flagged field nobody confirmed or edited holds the booking back, and the validator decides what is valid.
        _review?.Observe(_form!.ToRequest());
        _notConfirmed = _review?.Unhandled ?? [];
        var valid = context.Validate();
        if (_notConfirmed.Count > 0 || !valid)
        {
            return;
        }

        await SubmitAsync();
    }

    private async Task SubmitAsync()
    {
        _sending = true;
        _answer = null;
        _submitFailed = false;
        // The trace that ties the portal's, API Management's and the Logic App's telemetry of this attempt together.
        _traceId = Activity.Current?.TraceId.ToString();
        try
        {
            _answer = await Portal.SubmitBookingAsync(new PersonaId(PersonaId), _form!.ToRequest(), CancellationToken.None);
        }
        catch (Exception exception)
        {
            // Norvia unreachable is an answer, not this: here the portal itself failed, for example to keep its record.
            PageLog.SubmitFailed(Logger, exception, PersonaId);
            _submitFailed = true;
        }
        finally
        {
            _sending = false;
        }
    }
}
