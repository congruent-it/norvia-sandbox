@page "/presenter"
@* The presenter's faults: switches that make a hop of the demo fail, so the failure can be found. Each is off by default and, once on, expires by itself. Not part of any Persona. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IPartnerPortal Portal
@inject ILogger<PresenterPanel> Logger
@inject TimeProvider Time
@implements IAsyncDisposable
@using Norvia.PartnerPortal.Application.DriverSignIns

<PageTitle>Partner portal · Presenter panel</PageTitle>

<h1>Presenter panel</h1>

<section aria-label="Faults" class="mb-8 max-w-3xl">
    <h2 class="mt-0">Faults</h2>
    <p class="mt-0 text-sm">
        A fault makes one hop of the demo fail so the failure can be found. Every fault is off until it is switched on, and switches itself off when
        its time has run out. Each application checks that the presenter may switch its faults.
    </p>
    @if (_loadFailed)
    {
        <div role="alert">
            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
                The faults couldn't be loaded. Reload the page to try again.
            </FluentMessageBar>
        </div>
    }
    else if (_faults is null)
    {
        <div role="status">Loading the faults…</div>
    }
    else if (_faults.Count == 0)
    {
        <p role="status">No application owns a fault.</p>
    }
    else
    {
        @foreach (var fault in _faults)
        {
            var remaining = fault.RemainingAt(Time.GetUtcNow());
            <div role="group" aria-label="@fault.Name" class="mb-4 border border-border p-6">
                <h3 class="mt-0">@fault.Name</h3>
                <p class="mt-0 text-sm">@fault.Description</p>
                <dl class="text-sm">
                    <dt class="inline">Owner:</dt> <dd class="inline ml-0 mr-4">@fault.Owner</dd>
                </dl>
                <p role="status">
                    @if (remaining is { } left)
                    {
                        <strong>On</strong>
                        <span>, @Remaining(left) left</span>
                    }
                    else
                    {
                        <span>Off</span>
                    }
                </p>
                <div class="flex items-end gap-4">
                    <FluentSelect TOption="string" Label="Duration" Items="DurationSeconds" Value="@DurationOf(fault)"
                                  ValueChanged="@(seconds => _durations[fault.Name] = seconds)" OptionText="@(seconds => DurationText(int.Parse(seconds)))" OptionValue="@(seconds => seconds)" />
                    <FluentButton Appearance="Appearance.Accent" Disabled="_saving" aria-label="@($"Switch on {fault.Name}")"
                                  OnClick="@(() => SwitchAsync(fault, int.Parse(DurationOf(fault))))">
                        @(remaining is null ? "Switch on" : "Switch on again")
                    </FluentButton>
                    <FluentButton Disabled="@(_saving || remaining is null)" aria-label="@($"Switch off {fault.Name}")"
                                  OnClick="@(() => SwitchAsync(fault, null))">
                        Switch off
                    </FluentButton>
                </div>
            </div>
        }
        @if (_saveFailed)
        {
            <div role="alert" class="mt-4">
                <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
                    The fault couldn't be switched. Try again.
                </FluentMessageBar>
            </div>
        }
    }
</section>

<div role="group" aria-label="Driver sign-in" class="mb-8 max-w-3xl border border-border p-6">
    <h2 class="mt-0">Driver sign-in</h2>
    @if (_signInsLoadFailed)
    {
        <div role="alert">
            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
                The Drivers' sign-in details couldn't be loaded. Reload the page to try again.
            </FluentMessageBar>
        </div>
    }
    else if (_signIns is null)
    {
        <div role="status">Loading the Drivers…</div>
    }
    else if (_signIns.Password is null)
    {
        <p class="mt-0 text-sm">
            Locally the Driver app has no Entra ID. Its sign-in page stands in for it: open the Driver app and pick one of these Drivers.
        </p>
        <ul class="m-0 text-sm">
            @foreach (var driver in _signIns.Drivers)
            {
                <li>@driver.Name (@driver.DriverId)</li>
            }
        </ul>
    }
    else
    {
        <p class="mt-0 text-sm">
            Each seeded Driver signs in to the Driver app with their own Entra test user. The password is the same for all of them.
        </p>
        <table class="text-sm">
            <caption class="sr-only">Entra test users of the seeded Drivers</caption>
            <thead>
                <tr><th scope="col" class="pr-4 text-left">Driver</th><th scope="col" class="pr-4 text-left">Driver ID</th><th scope="col" class="text-left">User name</th></tr>
            </thead>
            <tbody>
                @foreach (var driver in _signIns.Drivers)
                {
                    <tr><td class="pr-4">@driver.Name</td><td class="pr-4">@driver.DriverId</td><td>@driver.UserName</td></tr>
                }
            </tbody>
        </table>
        <p class="mb-0 text-sm">Password: <code>@_signIns.Password</code></p>
    }
</div>

@code {
    // The durations the presenter picks from, in seconds. The application refuses any longer than it allows (a few minutes by default).
    private static readonly string[] DurationSeconds = ["60", "120", "300"];
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(1);
    private static readonly TimeSpan ReloadInterval = TimeSpan.FromSeconds(10);

    private readonly Dictionary<string, string> _durations = [];
    private readonly CancellationTokenSource _stopped = new();
    private Task? _refreshing;
    private DriverSignInsView? _signIns;
    private bool _signInsLoadFailed;
    private IReadOnlyList<FaultView>? _faults;
    private DateTimeOffset _loadedAt;
    private bool _loadFailed;
    private bool _saving;
    private bool _saveFailed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _signIns = await Portal.ListDriverSignInsAsync(CancellationToken.None);
        }
        catch (Exception exception)
        {
            PageLog.DriverSignInsLoadFailed(Logger, exception);
            _signInsLoadFailed = true;
        }

        try
        {
            _faults = await Portal.ListFaultsAsync(CancellationToken.None);
            _loadedAt = Time.GetUtcNow();
        }
        catch (Exception exception)
        {
            PageLog.FaultsLoadFailed(Logger, exception);
            _loadFailed = true;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _refreshing = RefreshUntilStoppedAsync(_stopped.Token);
        }
    }

    private string DurationOf(FaultView fault) => _durations.GetValueOrDefault(fault.Name, DurationSeconds[1]);

    private static string DurationText(int seconds) => seconds == 60 ? "1 minute" : $"{seconds / 60} minutes";

    private static string Remaining(TimeSpan left) => $"{(int)left.TotalMinutes}:{left.Seconds:00}";

    private async Task SwitchAsync(FaultView fault, int? seconds)
    {
        _saving = true;
        _saveFailed = false;
        try
        {
            var switched = await Portal.SwitchFaultAsync(fault.Owner, fault.Name, seconds is { } on ? TimeSpan.FromSeconds(on) : null, CancellationToken.None);
            _faults = [.. _faults!.Select(listed => listed.Name == switched.Name && listed.Owner == switched.Owner ? switched : listed)];
            _loadedAt = Time.GetUtcNow();
        }
        catch (Exception exception)
        {
            PageLog.FaultSwitchFailed(Logger, exception, fault.Name);
            _saveFailed = true;
        }
        finally
        {
            _saving = false;
        }
    }

    // The remaining time counts down on the page each second, and the faults are read again every few seconds, so a fault that ran out
    // shows Off. A refresh that fails keeps what the panel showed and tries again later.
    private async Task RefreshUntilStoppedAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(RefreshInterval, Time);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (_faults is null || _saving)
                {
                    continue;
                }

                if (Time.GetUtcNow() - _loadedAt >= ReloadInterval)
                {
                    try
                    {
                        _faults = await Portal.ListFaultsAsync(cancellationToken);
                        _loadedAt = Time.GetUtcNow();
                    }
                    catch (Exception exception) when (!cancellationToken.IsCancellationRequested)
                    {
                        PageLog.FaultsLoadFailed(Logger, exception);
                    }
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The page is gone.
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _stopped.CancelAsync();
        if (_refreshing is not null)
        {
            await _refreshing;
        }

        _stopped.Dispose();
    }
}
