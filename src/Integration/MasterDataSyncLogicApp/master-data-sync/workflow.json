{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_master_data_record_changed": {
        "type": "ApiConnection",
        "inputs": {
          "host": {
            "connection": {
              "referenceName": "servicebus"
            }
          },
          "method": "get",
          "path": "/@{encodeURIComponent(encodeURIComponent('master-data-events'))}/subscriptions/@{encodeURIComponent('master-data-sync')}/messages/head/peek",
          "queries": {
            "subscriptionType": "Main",
            "sessionId": "None"
          }
        },
        "recurrence": {
          "frequency": "Minute",
          "interval": 1
        },
        "correlation": {
          "clientTrackingId": "@{coalesce(if(equals(length(string(coalesce(triggerBody(), ''))), 0), json('{}'), triggerBody())?['Properties']?['correlationId'], '00000000-0000-0000-0000-000000000000')}"
        }
      }
    },
    "actions": {
      "Track_the_master_data_record": {
        "type": "Compose",
        "inputs": {
          "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
          "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?[if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'Carrier'), 'carrier', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'RateCard'), 'rateCard', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'CarrierRateCard'), 'carrierRateCard', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'Vehicle'), 'vehicle', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'Driver'), 'driver', 'shipper')))))]?['id']",
          "eventType": "@json(base64ToString(triggerBody()?['ContentData']))?['eventType']",
          "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']"
        },
        "runAfter": {},
        "trackedProperties": {
          "correlationId": "@action()?['inputs']?['correlationId']",
          "flow": "master-data",
          "partyId": "@action()?['inputs']?['partyId']",
          "sourceMessageId": "@action()?['inputs']?['sourceMessageId']"
        }
      },
      "Check_the_master_data_record": {
        "type": "If",
        "expression": {
          "equals": [
            "@and(equals(actions('Track_the_master_data_record')?['status'], 'Succeeded'), or(equals(actions('Track_the_master_data_record')?['outputs']?['eventType'], 'Shipper'), equals(actions('Track_the_master_data_record')?['outputs']?['eventType'], 'Carrier'), equals(actions('Track_the_master_data_record')?['outputs']?['eventType'], 'RateCard'), equals(actions('Track_the_master_data_record')?['outputs']?['eventType'], 'CarrierRateCard'), equals(actions('Track_the_master_data_record')?['outputs']?['eventType'], 'Vehicle'), equals(actions('Track_the_master_data_record')?['outputs']?['eventType'], 'Driver')), not(empty(actions('Track_the_master_data_record')?['outputs']?['correlationId'])), not(empty(actions('Track_the_master_data_record')?['outputs']?['partyId'])))",
            true
          ]
        },
        "actions": {
          "Replace_the_record_in_the_TMS": {
            "type": "Http",
            "inputs": {
              "method": "PUT",
              "uri": "@{parameters('tmsBaseUrl')}/v1/@{if(equals(outputs('Track_the_master_data_record')?['eventType'], 'Carrier'), 'carriers', if(equals(outputs('Track_the_master_data_record')?['eventType'], 'RateCard'), 'rate-cards', if(equals(outputs('Track_the_master_data_record')?['eventType'], 'CarrierRateCard'), 'carrier-rate-cards', if(equals(outputs('Track_the_master_data_record')?['eventType'], 'Vehicle'), 'vehicles', if(equals(outputs('Track_the_master_data_record')?['eventType'], 'Driver'), 'drivers', 'shippers')))))}/@{encodeUriComponent(outputs('Track_the_master_data_record')?['partyId'])}",
              "headers": {
                "Content-Type": "application/json",
                "X-Correlation-ID": "@{outputs('Track_the_master_data_record')?['correlationId']}"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "@parameters('masterDataSyncIdentityId')",
                "audience": "@parameters('tmsAudience')"
              },
              "body": "@removeProperty(json(base64ToString(triggerBody()?['ContentData']))?[if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'Carrier'), 'carrier', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'RateCard'), 'rateCard', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'CarrierRateCard'), 'carrierRateCard', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'Vehicle'), 'vehicle', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'Driver'), 'driver', 'shipper')))))], 'id')",
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT5S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT20S"
              }
            },
            "runAfter": {},
            "trackedProperties": {
              "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
              "flow": "master-data",
              "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?[if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'Carrier'), 'carrier', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'RateCard'), 'rateCard', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'CarrierRateCard'), 'carrierRateCard', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'Vehicle'), 'vehicle', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'Driver'), 'driver', 'shipper')))))]?['id']",
              "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']",
              "outcome": "@if(and(greaterOrEquals(coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
              "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0), 500)), 'TmsUnavailable', 'TmsCallRefused'))"
            }
          },
          "Settle_the_message": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "greaterOrEquals": [
                    "@coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0)",
                    200
                  ]
                },
                {
                  "less": [
                    "@coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0)",
                    300
                  ]
                }
              ]
            },
            "actions": {
              "Complete_the_message": {
                "type": "ApiConnection",
                "inputs": {
                  "host": {
                    "connection": {
                      "referenceName": "servicebus"
                    }
                  },
                  "method": "delete",
                  "path": "/@{encodeURIComponent(encodeURIComponent('master-data-events'))}/subscriptions/@{encodeURIComponent('master-data-sync')}/messages/complete",
                  "queries": {
                    "lockToken": "@triggerBody()?['LockToken']",
                    "subscriptionType": "Main",
                    "sessionId": ""
                  }
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {
                "Dead_letter_the_refused_record": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "referenceName": "servicebus"
                      }
                    },
                    "method": "post",
                    "path": "/@{encodeURIComponent(encodeURIComponent('master-data-events'))}/subscriptions/@{encodeURIComponent('master-data-sync')}/messages/deadletter",
                    "queries": {
                      "lockToken": "@triggerBody()?['LockToken']",
                      "sessionId": "",
                      "deadLetterReason": "@if(or(equals(coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0), 500)), 'TmsUnavailable', 'TmsCallRefused')",
                      "deadLetterErrorDescription": "@coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['body']?['detail'], actions('Replace_the_record_in_the_TMS')?['outputs']?['body']?['title'], if(or(equals(coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Replace_the_record_in_the_TMS')?['outputs']?['statusCode'], 0), 500)), 'The TMS API did not answer after the retries.', 'The TMS API refused the master-data record.'))"
                    }
                  },
                  "runAfter": {},
                  "trackedProperties": {
                    "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
                    "flow": "master-data",
                    "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?[if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'Carrier'), 'carrier', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'RateCard'), 'rateCard', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'CarrierRateCard'), 'carrierRateCard', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'Vehicle'), 'vehicle', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'Driver'), 'driver', 'shipper')))))]?['id']",
                    "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']",
                    "outcome": "DeadLettered",
                    "messageId": "@triggerBody()?['MessageId']",
                    "failureCode": "@action()?['inputs']?['parameters']?['deadLetterReason']"
                  }
                },
                "Fail_the_run_on_the_refused_record": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "MasterDataNotReplaced",
                      "message": "The TMS didn't replace the record, so the message was dead-lettered."
                    }
                  },
                  "runAfter": {
                    "Dead_letter_the_refused_record": [
                      "Succeeded",
                      "Failed"
                    ]
                  }
                }
              }
            },
            "runAfter": {
              "Replace_the_record_in_the_TMS": [
                "Succeeded",
                "Failed",
                "TimedOut"
              ]
            }
          }
        },
        "else": {
          "actions": {
            "Dead_letter_the_unreadable_record": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "referenceName": "servicebus"
                  }
                },
                "method": "post",
                "path": "/@{encodeURIComponent(encodeURIComponent('master-data-events'))}/subscriptions/@{encodeURIComponent('master-data-sync')}/messages/deadletter",
                "queries": {
                  "lockToken": "@triggerBody()?['LockToken']",
                  "sessionId": "",
                  "deadLetterReason": "MasterDataUnreadable",
                  "deadLetterErrorDescription": "The message isn't a master-data event the TMS can replace a record from, so nothing was sent to the TMS."
                }
              },
              "runAfter": {},
              "trackedProperties": {
                "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
                "flow": "master-data",
                "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?[if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'Carrier'), 'carrier', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'RateCard'), 'rateCard', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'CarrierRateCard'), 'carrierRateCard', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'Vehicle'), 'vehicle', if(equals(json(base64ToString(triggerBody()?['ContentData']))?['eventType'], 'Driver'), 'driver', 'shipper')))))]?['id']",
                "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']",
                "outcome": "DeadLettered",
                "messageId": "@triggerBody()?['MessageId']",
                "failureCode": "MasterDataUnreadable"
              }
            },
            "Fail_the_run_on_the_unreadable_record": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "MasterDataUnreadable",
                  "message": "The message isn't a master-data event the TMS can replace a record from, so it was dead-lettered."
                }
              },
              "runAfter": {
                "Dead_letter_the_unreadable_record": [
                  "Succeeded",
                  "Failed"
                ]
              }
            }
          }
        },
        "runAfter": {
          "Track_the_master_data_record": [
            "Succeeded",
            "Failed"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
