{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_Carrier_answers": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST"
        },
        "correlation": {
          "clientTrackingId": "@{triggerOutputs()?['headers']?['X-Correlation-ID']}"
        }
      }
    },
    "actions": {
      "Refuse_a_caller_other_than_API_Management": {
        "type": "If",
        "expression": {
          "and": [
            {
              "equals": [
                "@triggerOutputs()?['headers']?['X-MS-CLIENT-PRINCIPAL-ID']",
                "@parameters('apiManagementPrincipalId')"
              ]
            }
          ]
        },
        "actions": {},
        "else": {
          "actions": {
            "Refuse_the_caller": {
              "type": "Response",
              "kind": "Http",
              "inputs": {
                "statusCode": 403,
                "headers": {
                  "X-Correlation-ID": "@{triggerOutputs()?['headers']?['X-Correlation-ID']}"
                },
                "body": "Only API Management may call this workflow."
              },
              "runAfter": {},
              "trackedProperties": {
                "correlationId": "@action()?['inputs']?['headers']?['X-Correlation-ID']",
                "flow": "carrier-answer",
                "outcome": "Refused",
                "failureCode": "CallerNotApiManagement"
              }
            },
            "Fail_the_run_the_caller_is_not_API_Management": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "CallerNotApiManagement",
                  "message": "The workflow was called other than through API Management, so nothing was mapped or sent to the TMS."
                }
              },
              "runAfter": {
                "Refuse_the_caller": [
                  "Succeeded"
                ]
              }
            }
          }
        },
        "runAfter": {}
      },
      "Track_the_answer": {
        "type": "Compose",
        "inputs": {
          "correlationId": "@triggerOutputs()?['headers']?['X-Correlation-ID']",
          "partyId": "@triggerOutputs()?['headers']?['X-Carrier-ID']",
          "carrierBookingNumber": "@triggerBody()?['carrierBookingNumber']"
        },
        "runAfter": {
          "Refuse_a_caller_other_than_API_Management": [
            "Succeeded"
          ]
        },
        "trackedProperties": {
          "correlationId": "@action()?['inputs']?['correlationId']",
          "flow": "carrier-answer",
          "partyId": "@action()?['inputs']?['partyId']",
          "carrierBookingNumber": "@action()?['inputs']?['carrierBookingNumber']"
        }
      },
      "Map_the_answer": {
        "type": "InvokeFunction",
        "inputs": {
          "functionName": "MapCarrierAnswer",
          "parameters": {
            "carrierAnswer": "@{base64(triggerBody())}",
            "carrierId": "@{triggerOutputs()?['headers']?['X-Carrier-ID']}"
          }
        },
        "runAfter": {
          "Track_the_answer": [
            "Succeeded"
          ]
        }
      },
      "Record_the_answer_if_it_can_be_used": {
        "type": "If",
        "expression": {
          "and": [
            {
              "equals": [
                "@contains(json(body('Map_the_answer')), 'tmsRequest')",
                true
              ]
            }
          ]
        },
        "actions": {
          "Answer_to_the_TMS": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@{parameters('tmsBaseUrl')}/v1/carrier-bookings/@{json(body('Map_the_answer'))?['carrierBookingNumber']}/answer",
              "headers": {
                "Content-Type": "application/json",
                "X-Correlation-ID": "@{triggerOutputs()?['headers']?['X-Correlation-ID']}"
              },
              "body": "@json(body('Map_the_answer'))?['tmsRequest']",
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "@parameters('answerIdentityId')",
                "audience": "@parameters('tmsAudience')"
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT5S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT20S"
              }
            },
            "runAfter": {},
            "trackedProperties": {
              "correlationId": "@action()?['inputs']?['headers']?['X-Correlation-ID']",
              "flow": "carrier-answer",
              "partyId": "@action()?['inputs']?['body']?['carrierId']",
              "carrierBookingNumber": "@action()?['outputs']?['body']?['carrierBookingNumber']",
              "shipmentNumber": "@action()?['outputs']?['body']?['shipmentNumber']",
              "outcome": "@if(equals(action()?['outputs']?['statusCode'], 200), 'Succeeded', if(contains(createArray(403, 404, 409), action()?['outputs']?['statusCode']), 'Refused', 'Failed'))",
              "failureCode": "@if(equals(action()?['outputs']?['statusCode'], 200), null, if(equals(action()?['outputs']?['statusCode'], 403), 'CarrierNotAllowed', if(equals(action()?['outputs']?['statusCode'], 404), 'BookingNotFound', if(equals(action()?['outputs']?['statusCode'], 409), 'BookingNotOpen', if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 400), less(coalesce(action()?['outputs']?['statusCode'], 0), 500), not(contains(createArray(408, 429), action()?['outputs']?['statusCode']))), 'TmsCallRefused', 'TmsUnavailable')))))"
            }
          }
        },
        "else": {
          "actions": {}
        },
        "runAfter": {
          "Map_the_answer": [
            "Succeeded"
          ]
        }
      },
      "Relay_the_TMS_outcome": {
        "type": "InvokeFunction",
        "inputs": {
          "functionName": "RelayTmsAnswer",
          "parameters": {
            "mappedAnswer": "@{body('Map_the_answer')}",
            "tmsStatusCode": "@coalesce(actions('Answer_to_the_TMS')?['outputs']?['statusCode'], 0)",
            "tmsResponse": "@{coalesce(actions('Answer_to_the_TMS')?['outputs']?['body'], '')}",
            "correlationId": "@{triggerOutputs()?['headers']?['X-Correlation-ID']}"
          }
        },
        "runAfter": {
          "Record_the_answer_if_it_can_be_used": [
            "Succeeded",
            "Failed",
            "TimedOut",
            "Skipped"
          ]
        }
      },
      "Answer_the_Carrier": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": "@json(body('Relay_the_TMS_outcome'))?['statusCode']",
          "headers": {
            "Content-Type": "application/json",
            "X-Correlation-ID": "@{triggerOutputs()?['headers']?['X-Correlation-ID']}"
          },
          "body": "@json(body('Relay_the_TMS_outcome'))?['body']"
        },
        "runAfter": {
          "Relay_the_TMS_outcome": [
            "Succeeded"
          ]
        }
      },
      "End_the_run": {
        "type": "If",
        "expression": {
          "and": [
            {
              "not": {
                "equals": [
                  "@json(body('Relay_the_TMS_outcome'))?['failureCode']",
                  null
                ]
              }
            }
          ]
        },
        "actions": {
          "Fail_the_run_the_answer_was_not_recorded": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "@{json(body('Relay_the_TMS_outcome'))?['failureCode']}",
                "message": "The Carrier's answer was not recorded: the answer can't be used, or the TMS didn't take it in, so the Carrier was told so."
              }
            }
          }
        },
        "else": {
          "actions": {
            "End_the_run_the_Carrier_has_the_TMS_outcome": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              }
            }
          }
        },
        "runAfter": {
          "Answer_the_Carrier": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
