{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_Shipper_notification_is_requested": {
        "type": "ApiConnection",
        "inputs": {
          "host": {
            "connection": {
              "referenceName": "servicebus"
            }
          },
          "method": "get",
          "path": "/@{encodeURIComponent(encodeURIComponent('shipment-events'))}/subscriptions/@{encodeURIComponent('shipper-notification')}/messages/head/peek",
          "queries": {
            "subscriptionType": "Main",
            "sessionId": "None"
          }
        },
        "recurrence": {
          "frequency": "Minute",
          "interval": 1
        },
        "correlation": {
          "clientTrackingId": "@{coalesce(if(equals(length(string(coalesce(triggerBody(), ''))), 0), json('{}'), triggerBody())?['Properties']?['correlationId'], '00000000-0000-0000-0000-000000000000')}"
        }
      }
    },
    "actions": {
      "Track_the_notification": {
        "type": "Compose",
        "inputs": {
          "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
          "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['shipperId']",
          "shipmentNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['shipmentNumber']",
          "transportOrderNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['transportOrderNumber']",
          "notificationId": "@json(base64ToString(triggerBody()?['ContentData']))?['notificationId']",
          "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']"
        },
        "runAfter": {},
        "trackedProperties": {
          "correlationId": "@action()?['inputs']?['correlationId']",
          "flow": "shipper-notification",
          "partyId": "@action()?['inputs']?['partyId']",
          "shipmentNumber": "@action()?['inputs']?['shipmentNumber']",
          "transportOrderNumber": "@action()?['inputs']?['transportOrderNumber']",
          "sourceMessageId": "@action()?['inputs']?['sourceMessageId']"
        }
      },
      "Map_the_notification": {
        "type": "InvokeFunction",
        "inputs": {
          "functionName": "MapShipperNotificationRequested",
          "parameters": {
            "shipperNotificationRequested": "@{triggerBody()?['ContentData']}"
          }
        },
        "runAfter": {
          "Track_the_notification": [
            "Succeeded"
          ]
        },
        "trackedProperties": {
          "flow": "shipper-notification",
          "outcome": "@if(equals(action()?['status'], 'Failed'), 'Failed', null)",
          "failureCode": "@if(equals(action()?['status'], 'Failed'), 'ShipperNotificationRequestedUnreadable', null)"
        }
      },
      "Dead_letter_the_unreadable_notification": {
        "type": "ApiConnection",
        "inputs": {
          "host": {
            "connection": {
              "referenceName": "servicebus"
            }
          },
          "method": "post",
          "path": "/@{encodeURIComponent(encodeURIComponent('shipment-events'))}/subscriptions/@{encodeURIComponent('shipper-notification')}/messages/deadletter",
          "queries": {
            "lockToken": "@triggerBody()?['LockToken']",
            "sessionId": "",
            "deadLetterReason": "ShipperNotificationRequestedUnreadable",
            "deadLetterErrorDescription": "The message isn't a notification the Shipper can be told of, so nothing was sent to the Shipper."
          }
        },
        "runAfter": {
          "Map_the_notification": [
            "Failed"
          ]
        },
        "trackedProperties": {
          "flow": "shipper-notification",
          "outcome": "DeadLettered",
          "failureCode": "ShipperNotificationRequestedUnreadable"
        }
      },
      "Fail_the_run_on_the_unreadable_notification": {
        "type": "Terminate",
        "inputs": {
          "runStatus": "Failed",
          "runError": {
            "code": "ShipperNotificationRequestedUnreadable",
            "message": "The message isn't a notification the Shipper can be told of, so it was dead-lettered."
          }
        },
        "runAfter": {
          "Dead_letter_the_unreadable_notification": [
            "Succeeded",
            "Failed"
          ]
        }
      },
      "Complete_the_message": {
        "type": "ApiConnection",
        "inputs": {
          "host": {
            "connection": {
              "referenceName": "servicebus"
            }
          },
          "method": "delete",
          "path": "/@{encodeURIComponent(encodeURIComponent('shipment-events'))}/subscriptions/@{encodeURIComponent('shipper-notification')}/messages/complete",
          "queries": {
            "lockToken": "@triggerBody()?['LockToken']",
            "subscriptionType": "Main",
            "sessionId": ""
          }
        },
        "runAfter": {
          "Map_the_notification": [
            "Succeeded"
          ]
        }
      },
      "Get_the_Shipper_endpoint_credential": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "secretName": "shipper-endpoint-key-@{outputs('Track_the_notification')?['partyId']}"
          },
          "serviceProviderConfiguration": {
            "connectionName": "keyVault",
            "operationId": "getSecret",
            "serviceProviderId": "/serviceProviders/keyVault"
          }
        },
        "runAfter": {
          "Complete_the_message": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "secureData": {
            "properties": [
              "outputs"
            ]
          }
        }
      },
      "Send_to_the_Shipper": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('partnerPortalBaseUrl')}/shipper/v1/@{outputs('Track_the_notification')?['partyId']}/notifications",
          "headers": {
            "Content-Type": "application/json",
            "X-Correlation-ID": "@{outputs('Track_the_notification')?['correlationId']}",
            "X-Api-Key": "@{body('Get_the_Shipper_endpoint_credential')?['value']}"
          },
          "body": "@json(body('Map_the_notification'))",
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT5S",
            "minimumInterval": "PT5S",
            "maximumInterval": "PT20S"
          }
        },
        "runAfter": {
          "Get_the_Shipper_endpoint_credential": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "secureData": {
            "properties": [
              "inputs"
            ]
          }
        },
        "trackedProperties": {
          "flow": "shipper-notification"
        }
      },
      "Read_the_answer": {
        "type": "Compose",
        "inputs": {
          "outcome": "@if(and(greaterOrEquals(coalesce(actions('Send_to_the_Shipper')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Send_to_the_Shipper')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
          "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Send_to_the_Shipper')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Send_to_the_Shipper')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Send_to_the_Shipper')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Send_to_the_Shipper')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Send_to_the_Shipper')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Send_to_the_Shipper')?['outputs']?['statusCode'], 0), 500)), 'ShipperUnavailable', 'ShipperRefused'))",
          "statusCode": "@coalesce(actions('Send_to_the_Shipper')?['outputs']?['statusCode'], 0)"
        },
        "runAfter": {
          "Send_to_the_Shipper": [
            "Succeeded",
            "Failed",
            "TimedOut"
          ]
        }
      },
      "Track_the_answer": {
        "type": "Compose",
        "inputs": {
          "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
          "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['shipperId']",
          "shipmentNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['shipmentNumber']",
          "transportOrderNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['transportOrderNumber']",
          "outcome": "@outputs('Read_the_answer')?['outcome']",
          "failureCode": "@outputs('Read_the_answer')?['failureCode']"
        },
        "runAfter": {
          "Read_the_answer": [
            "Succeeded"
          ]
        },
        "trackedProperties": {
          "correlationId": "@action()?['inputs']?['correlationId']",
          "flow": "shipper-notification",
          "partyId": "@action()?['inputs']?['partyId']",
          "shipmentNumber": "@action()?['inputs']?['shipmentNumber']",
          "transportOrderNumber": "@action()?['inputs']?['transportOrderNumber']",
          "outcome": "@action()?['inputs']?['outcome']",
          "failureCode": "@action()?['inputs']?['failureCode']"
        }
      },
      "Report_the_outcome_to_the_TMS": {
        "type": "If",
        "expression": {
          "and": [
            {
              "greaterOrEquals": [
                "@coalesce(actions('Send_to_the_Shipper')?['outputs']?['statusCode'], 0)",
                200
              ]
            },
            {
              "less": [
                "@coalesce(actions('Send_to_the_Shipper')?['outputs']?['statusCode'], 0)",
                300
              ]
            }
          ]
        },
        "actions": {
          "Report_the_notification_sent": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@{parameters('tmsBaseUrl')}/v1/shipper-notifications/@{outputs('Track_the_notification')?['notificationId']}/report-sent",
              "headers": {
                "Content-Type": "application/json",
                "X-Correlation-ID": "@{outputs('Track_the_notification')?['correlationId']}"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "@parameters('shipperNotificationIdentityId')",
                "audience": "@parameters('tmsAudience')"
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT5S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT20S"
              }
            },
            "runAfter": {},
            "trackedProperties": {
              "correlationId": "@action()?['inputs']?['headers']?['X-Correlation-ID']",
              "flow": "shipper-notification",
              "outcome": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
              "failureCode": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(action()?['outputs']?['statusCode'], 0), 0), equals(coalesce(action()?['outputs']?['statusCode'], 0), 408), equals(coalesce(action()?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 500)), 'TmsUnavailable', 'TmsCallRefused'))"
            }
          }
        },
        "else": {
          "actions": {
            "Take_the_Shippers_answer": {
              "type": "Compose",
              "inputs": "@string(coalesce(actions('Send_to_the_Shipper')?['outputs']?['body'], actions('Send_to_the_Shipper')?['error']?['message'], 'The Shipper endpoint did not answer.'))",
              "runAfter": {}
            },
            "Report_the_notification_not_delivered": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@{parameters('tmsBaseUrl')}/v1/shipper-notifications/@{outputs('Track_the_notification')?['notificationId']}/report-not-delivered",
                "headers": {
                  "Content-Type": "application/json",
                  "X-Correlation-ID": "@{outputs('Track_the_notification')?['correlationId']}"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "identity": "@parameters('shipperNotificationIdentityId')",
                  "audience": "@parameters('tmsAudience')"
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT5S",
                  "minimumInterval": "PT5S",
                  "maximumInterval": "PT20S"
                },
                "body": {
                  "statusCode": "@if(equals(outputs('Read_the_answer')?['statusCode'], 0), null, outputs('Read_the_answer')?['statusCode'])",
                  "message": "@substring(outputs('Take_the_Shippers_answer'), 0, min(500, length(outputs('Take_the_Shippers_answer'))))"
                }
              },
              "runAfter": {
                "Take_the_Shippers_answer": [
                  "Succeeded"
                ]
              },
              "trackedProperties": {
                "correlationId": "@action()?['inputs']?['headers']?['X-Correlation-ID']",
                "flow": "shipper-notification",
                "outcome": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
                "failureCode": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(action()?['outputs']?['statusCode'], 0), 0), equals(coalesce(action()?['outputs']?['statusCode'], 0), 408), equals(coalesce(action()?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 500)), 'TmsUnavailable', 'TmsCallRefused'))"
              }
            }
          }
        },
        "runAfter": {
          "Track_the_answer": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
