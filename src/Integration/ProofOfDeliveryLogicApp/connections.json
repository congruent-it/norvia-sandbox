{
  "serviceProviderConnections": {
    "AzureBlob": {
      "displayName": "Inbound Proofs of delivery",
      "parameterValues": {
        "blobStorageEndpoint": "@appsetting('INBOUND_BLOB_ENDPOINT')",
        "authProvider": {
          "Type": "ManagedServiceIdentity",
          "Identity": "@appsetting('PROOF_OF_DELIVERY_IDENTITY_ID')"
        }
      },
      "serviceProvider": {
        "id": "/serviceProviders/AzureBlob"
      }
    }
  },
  "managedApiConnections": {
    "servicebus": {
      "api": {
        "id": "@appsetting('SERVICE_BUS_API_ID')"
      },
      "authentication": {
        "type": "ManagedServiceIdentity",
        "identity": "@appsetting('PROOF_OF_DELIVERY_IDENTITY_ID')"
      },
      "connection": {
        "id": "@appsetting('SERVICE_BUS_CONNECTION_ID')"
      },
      "connectionProperties": {
        "authentication": {
          "audience": "https://servicebus.azure.net",
          "type": "ManagedServiceIdentity",
          "identity": "@appsetting('PROOF_OF_DELIVERY_IDENTITY_ID')"
        }
      },
      "connectionRuntimeUrl": "@appsetting('SERVICE_BUS_CONNECTION_RUNTIME_URL')"
    }
  }
}
