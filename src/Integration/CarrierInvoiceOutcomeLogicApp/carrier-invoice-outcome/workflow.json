{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_Carrier_invoice_is_approved": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "topicName": "invoicing-events",
            "subscriptionName": "carrier-invoice-outcome",
            "isSessionsEnabled": false
          },
          "serviceProviderConfiguration": {
            "connectionName": "serviceBus",
            "operationId": "peekLockTopicMessagesV2",
            "serviceProviderId": "/serviceProviders/serviceBus"
          }
        },
        "correlation": {
          "clientTrackingId": "@{triggerOutputs()?['body']?['userProperties']?['correlationId']}"
        }
      }
    },
    "actions": {
      "Track_the_invoice": {
        "type": "Compose",
        "inputs": {
          "correlationId": "@json(base64ToString(triggerBody()?['contentData']))?['correlationId']",
          "partyId": "@json(base64ToString(triggerBody()?['contentData']))?['carrierId']",
          "documentNumber": "@json(base64ToString(triggerBody()?['contentData']))?['invoiceNumber']",
          "sourceMessageId": "@json(base64ToString(triggerBody()?['contentData']))?['eventId']"
        },
        "runAfter": {},
        "trackedProperties": {
          "correlationId": "@action()?['inputs']?['correlationId']",
          "flow": "carrier-invoices",
          "partyId": "@action()?['inputs']?['partyId']",
          "documentNumber": "@action()?['inputs']?['documentNumber']",
          "sourceMessageId": "@action()?['inputs']?['sourceMessageId']"
        }
      },
      "Map_the_invoice": {
        "type": "InvokeFunction",
        "inputs": {
          "functionName": "MapCarrierInvoiceOutcome",
          "parameters": {
            "message": "@{triggerBody()?['contentData']}"
          }
        },
        "runAfter": {
          "Track_the_invoice": [
            "Succeeded"
          ]
        },
        "trackedProperties": {
          "flow": "carrier-invoices",
          "outcome": "@if(equals(action()?['status'], 'Failed'), 'Failed', null)",
          "failureCode": "@if(equals(action()?['status'], 'Failed'), 'CarrierInvoiceApprovedUnreadable', null)"
        }
      },
      "Dead_letter_the_unreadable_invoice": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "topicName": "invoicing-events",
            "subscriptionName": "carrier-invoice-outcome",
            "lockToken": "@triggerBody()?['lockToken']",
            "deadLetterReason": "CarrierInvoiceApprovedUnreadable",
            "deadLetterErrorDescription": "The message isn't an approved Carrier invoice the Carrier can be told, so nothing was sent to the Carrier."
          },
          "serviceProviderConfiguration": {
            "connectionName": "serviceBus",
            "operationId": "deadLetterTopicMessageV2",
            "serviceProviderId": "/serviceProviders/serviceBus"
          }
        },
        "runAfter": {
          "Map_the_invoice": [
            "Failed"
          ]
        },
        "trackedProperties": {
          "flow": "carrier-invoices",
          "outcome": "DeadLettered",
          "failureCode": "CarrierInvoiceApprovedUnreadable"
        }
      },
      "Fail_the_run_on_the_unreadable_invoice": {
        "type": "Terminate",
        "inputs": {
          "runStatus": "Failed",
          "runError": {
            "code": "CarrierInvoiceApprovedUnreadable",
            "message": "The message isn't an approved Carrier invoice the Carrier can be told, so it was dead-lettered."
          }
        },
        "runAfter": {
          "Dead_letter_the_unreadable_invoice": [
            "Succeeded",
            "Failed"
          ]
        }
      },
      "Complete_the_message": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "topicName": "invoicing-events",
            "subscriptionName": "carrier-invoice-outcome",
            "lockToken": "@triggerBody()?['lockToken']"
          },
          "serviceProviderConfiguration": {
            "connectionName": "serviceBus",
            "operationId": "completeTopicMessageV2",
            "serviceProviderId": "/serviceProviders/serviceBus"
          }
        },
        "runAfter": {
          "Map_the_invoice": [
            "Succeeded"
          ]
        }
      },
      "Get_the_Carrier_endpoint_credential": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "secretName": "carrier-endpoint-key-@{outputs('Track_the_invoice')?['partyId']}"
          },
          "serviceProviderConfiguration": {
            "connectionName": "keyVault",
            "operationId": "getSecret",
            "serviceProviderId": "/serviceProviders/keyVault"
          }
        },
        "runAfter": {
          "Complete_the_message": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "secureData": {
            "properties": [
              "outputs"
            ]
          }
        }
      },
      "Send_to_the_Carrier": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('partnerPortalBaseUrl')}/carrier/v1/@{outputs('Track_the_invoice')?['partyId']}/invoice-outcomes",
          "headers": {
            "Content-Type": "application/json",
            "X-Correlation-ID": "@{outputs('Track_the_invoice')?['correlationId']}",
            "X-Api-Key": "@{body('Get_the_Carrier_endpoint_credential')?['value']}"
          },
          "body": "@json(body('Map_the_invoice'))",
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT5S",
            "minimumInterval": "PT5S",
            "maximumInterval": "PT20S"
          }
        },
        "runAfter": {
          "Get_the_Carrier_endpoint_credential": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "secureData": {
            "properties": [
              "inputs"
            ]
          }
        },
        "trackedProperties": {
          "flow": "carrier-invoices"
        }
      },
      "Read_the_answer": {
        "type": "Compose",
        "inputs": {
          "outcome": "@if(and(greaterOrEquals(coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
          "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0), 500)), 'CarrierUnavailable', 'CarrierRefused'))",
          "statusCode": "@coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0)"
        },
        "runAfter": {
          "Send_to_the_Carrier": [
            "Succeeded",
            "Failed",
            "TimedOut"
          ]
        }
      },
      "Track_the_answer": {
        "type": "Compose",
        "inputs": {
          "correlationId": "@json(base64ToString(triggerBody()?['contentData']))?['correlationId']",
          "partyId": "@json(base64ToString(triggerBody()?['contentData']))?['carrierId']",
          "documentNumber": "@json(base64ToString(triggerBody()?['contentData']))?['invoiceNumber']",
          "outcome": "@outputs('Read_the_answer')?['outcome']",
          "failureCode": "@outputs('Read_the_answer')?['failureCode']"
        },
        "runAfter": {
          "Read_the_answer": [
            "Succeeded"
          ]
        },
        "trackedProperties": {
          "correlationId": "@action()?['inputs']?['correlationId']",
          "flow": "carrier-invoices",
          "partyId": "@action()?['inputs']?['partyId']",
          "documentNumber": "@action()?['inputs']?['documentNumber']",
          "outcome": "@action()?['inputs']?['outcome']",
          "failureCode": "@action()?['inputs']?['failureCode']"
        }
      },
      "Report_the_outcome_to_the_ERP": {
        "type": "If",
        "expression": {
          "and": [
            {
              "greaterOrEquals": [
                "@coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0)",
                200
              ]
            },
            {
              "less": [
                "@coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0)",
                300
              ]
            }
          ]
        },
        "actions": {
          "Report_the_outcome_told": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@{parameters('erpBaseUrl')}/v1/carrier-invoices/@{encodeUriComponent(outputs('Track_the_invoice')?['partyId'])}/@{encodeUriComponent(outputs('Track_the_invoice')?['documentNumber'])}/report-told",
              "headers": {
                "Content-Type": "application/json",
                "X-Correlation-ID": "@{outputs('Track_the_invoice')?['correlationId']}"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "@parameters('carrierInvoiceOutcomeIdentityId')",
                "audience": "@parameters('erpAudience')"
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT5S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT20S"
              }
            },
            "runAfter": {},
            "trackedProperties": {
              "correlationId": "@action()?['inputs']?['headers']?['X-Correlation-ID']",
              "flow": "carrier-invoices",
              "outcome": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
              "failureCode": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(action()?['outputs']?['statusCode'], 0), 0), equals(coalesce(action()?['outputs']?['statusCode'], 0), 408), equals(coalesce(action()?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 500)), 'ErpUnavailable', 'ErpCallRefused'))"
            }
          }
        },
        "else": {
          "actions": {
            "Take_the_Carriers_answer": {
              "type": "Compose",
              "inputs": "@string(coalesce(actions('Send_to_the_Carrier')?['outputs']?['body'], actions('Send_to_the_Carrier')?['error']?['message'], 'The Carrier endpoint did not answer.'))",
              "runAfter": {}
            },
            "Report_the_outcome_not_delivered": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@{parameters('erpBaseUrl')}/v1/carrier-invoices/@{encodeUriComponent(outputs('Track_the_invoice')?['partyId'])}/@{encodeUriComponent(outputs('Track_the_invoice')?['documentNumber'])}/report-not-delivered",
                "headers": {
                  "Content-Type": "application/json",
                  "X-Correlation-ID": "@{outputs('Track_the_invoice')?['correlationId']}"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "identity": "@parameters('carrierInvoiceOutcomeIdentityId')",
                  "audience": "@parameters('erpAudience')"
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT5S",
                  "minimumInterval": "PT5S",
                  "maximumInterval": "PT20S"
                },
                "body": {
                  "statusCode": "@if(equals(outputs('Read_the_answer')?['statusCode'], 0), null, outputs('Read_the_answer')?['statusCode'])",
                  "message": "@substring(outputs('Take_the_Carriers_answer'), 0, min(500, length(outputs('Take_the_Carriers_answer'))))"
                }
              },
              "runAfter": {
                "Take_the_Carriers_answer": [
                  "Succeeded"
                ]
              },
              "trackedProperties": {
                "correlationId": "@action()?['inputs']?['headers']?['X-Correlation-ID']",
                "flow": "carrier-invoices",
                "outcome": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
                "failureCode": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(action()?['outputs']?['statusCode'], 0), 0), equals(coalesce(action()?['outputs']?['statusCode'], 0), 408), equals(coalesce(action()?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 500)), 'ErpUnavailable', 'ErpCallRefused'))"
              }
            }
          }
        },
        "runAfter": {
          "Track_the_answer": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
