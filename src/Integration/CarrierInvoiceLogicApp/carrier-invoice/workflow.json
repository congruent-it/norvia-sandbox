{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_Carrier_invoices": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST"
        },
        "correlation": {
          "clientTrackingId": "@{triggerOutputs()?['headers']?['X-Correlation-ID']}"
        }
      }
    },
    "actions": {
      "Refuse_a_caller_other_than_API_Management": {
        "type": "If",
        "expression": {
          "and": [
            {
              "equals": [
                "@triggerOutputs()?['headers']?['X-MS-CLIENT-PRINCIPAL-ID']",
                "@parameters('apiManagementPrincipalId')"
              ]
            }
          ]
        },
        "actions": {},
        "else": {
          "actions": {
            "Refuse_the_caller": {
              "type": "Response",
              "kind": "Http",
              "inputs": {
                "statusCode": 403,
                "headers": {
                  "X-Correlation-ID": "@{triggerOutputs()?['headers']?['X-Correlation-ID']}"
                },
                "body": "Only API Management may call this workflow."
              },
              "runAfter": {},
              "trackedProperties": {
                "correlationId": "@action()?['inputs']?['headers']?['X-Correlation-ID']",
                "flow": "carrier-invoice",
                "outcome": "Refused",
                "failureCode": "CallerNotApiManagement"
              }
            },
            "Fail_the_run_the_caller_is_not_API_Management": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "CallerNotApiManagement",
                  "message": "The workflow was called other than through API Management, so nothing was mapped or sent to the ERP."
                }
              },
              "runAfter": {
                "Refuse_the_caller": [
                  "Succeeded"
                ]
              }
            }
          }
        },
        "runAfter": {}
      },
      "Track_the_invoice": {
        "type": "Compose",
        "inputs": {
          "correlationId": "@triggerOutputs()?['headers']?['X-Correlation-ID']",
          "partyId": "@triggerOutputs()?['headers']?['X-Carrier-ID']",
          "documentNumber": "@triggerBody()?['invoiceNo']"
        },
        "runAfter": {
          "Refuse_a_caller_other_than_API_Management": [
            "Succeeded"
          ]
        },
        "trackedProperties": {
          "correlationId": "@action()?['inputs']?['correlationId']",
          "flow": "carrier-invoice",
          "partyId": "@action()?['inputs']?['partyId']",
          "documentNumber": "@action()?['inputs']?['documentNumber']"
        }
      },
      "Map_the_invoice": {
        "type": "InvokeFunction",
        "inputs": {
          "functionName": "MapCarrierInvoice",
          "parameters": {
            "carrierInvoice": "@{base64(triggerBody())}",
            "carrierId": "@{triggerOutputs()?['headers']?['X-Carrier-ID']}",
            "correlationId": "@{triggerOutputs()?['headers']?['X-Correlation-ID']}"
          }
        },
        "runAfter": {
          "Track_the_invoice": [
            "Succeeded"
          ]
        }
      },
      "Receive_the_invoice_if_it_can_be_used": {
        "type": "If",
        "expression": {
          "and": [
            {
              "equals": [
                "@contains(json(body('Map_the_invoice')), 'erpRequest')",
                true
              ]
            }
          ]
        },
        "actions": {
          "Receive_at_the_ERP": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@{parameters('erpBaseUrl')}/v1/carrier-invoices",
              "headers": {
                "Content-Type": "application/json",
                "X-Correlation-ID": "@{triggerOutputs()?['headers']?['X-Correlation-ID']}"
              },
              "body": "@json(body('Map_the_invoice'))?['erpRequest']",
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "@parameters('carrierInvoiceIdentityId')",
                "audience": "@parameters('erpAudience')"
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT5S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT20S"
              }
            },
            "runAfter": {},
            "trackedProperties": {
              "correlationId": "@action()?['inputs']?['headers']?['X-Correlation-ID']",
              "flow": "carrier-invoice",
              "partyId": "@action()?['inputs']?['body']?['carrierId']",
              "documentNumber": "@action()?['inputs']?['body']?['invoiceNumber']",
              "outcome": "@if(contains(createArray(200, 201), action()?['outputs']?['statusCode']), 'Succeeded', if(contains(createArray(400, 409, 422), action()?['outputs']?['statusCode']), 'Refused', 'Failed'))",
              "failureCode": "@if(contains(createArray(200, 201), action()?['outputs']?['statusCode']), null, if(equals(action()?['outputs']?['statusCode'], 400), 'CarrierInvoiceRefused', if(equals(action()?['outputs']?['statusCode'], 409), 'InvoiceNumberUsed', if(equals(action()?['outputs']?['statusCode'], 422), 'CarrierNotFound', if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 400), less(coalesce(action()?['outputs']?['statusCode'], 0), 500), not(contains(createArray(408, 429), action()?['outputs']?['statusCode']))), 'ErpCallRefused', 'ErpUnavailable')))))"
            }
          }
        },
        "else": {
          "actions": {}
        },
        "runAfter": {
          "Map_the_invoice": [
            "Succeeded"
          ]
        }
      },
      "Relay_the_ERP_outcome": {
        "type": "InvokeFunction",
        "inputs": {
          "functionName": "RelayErpInvoiceAnswer",
          "parameters": {
            "mappedInvoice": "@{body('Map_the_invoice')}",
            "erpStatusCode": "@coalesce(actions('Receive_at_the_ERP')?['outputs']?['statusCode'], 0)",
            "erpResponse": "@{coalesce(actions('Receive_at_the_ERP')?['outputs']?['body'], '')}",
            "correlationId": "@{triggerOutputs()?['headers']?['X-Correlation-ID']}"
          }
        },
        "runAfter": {
          "Receive_the_invoice_if_it_can_be_used": [
            "Succeeded",
            "Failed",
            "TimedOut",
            "Skipped"
          ]
        }
      },
      "Answer_the_Carrier": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": "@json(body('Relay_the_ERP_outcome'))?['statusCode']",
          "headers": {
            "Content-Type": "application/json",
            "X-Correlation-ID": "@{triggerOutputs()?['headers']?['X-Correlation-ID']}"
          },
          "body": "@json(body('Relay_the_ERP_outcome'))?['body']"
        },
        "runAfter": {
          "Relay_the_ERP_outcome": [
            "Succeeded"
          ]
        }
      },
      "End_the_run": {
        "type": "If",
        "expression": {
          "and": [
            {
              "not": {
                "equals": [
                  "@json(body('Relay_the_ERP_outcome'))?['failureCode']",
                  null
                ]
              }
            }
          ]
        },
        "actions": {
          "Fail_the_run_the_invoice_was_not_received": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "@{json(body('Relay_the_ERP_outcome'))?['failureCode']}",
                "message": "The Carrier's invoice was not received: the invoice can't be used, or the ERP didn't take it in, so the Carrier was told so."
              }
            }
          }
        },
        "else": {
          "actions": {
            "End_the_run_the_Carrier_has_the_ERP_outcome": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              }
            }
          }
        },
        "runAfter": {
          "Answer_the_Carrier": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
