{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_Transport_Order_is_billable": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "topicName": "transport-order-events",
            "subscriptionName": "billing",
            "isSessionsEnabled": false
          },
          "serviceProviderConfiguration": {
            "connectionName": "serviceBus",
            "operationId": "peekLockTopicMessagesV2",
            "serviceProviderId": "/serviceProviders/serviceBus"
          }
        },
        "correlation": {
          "clientTrackingId": "@{triggerOutputs()?['body']?['userProperties']?['correlationId']}"
        }
      }
    },
    "actions": {
      "Track_the_billable_line": {
        "type": "Compose",
        "inputs": {
          "correlationId": "@json(base64ToString(triggerBody()?['contentData']))?['correlationId']",
          "partyId": "@json(base64ToString(triggerBody()?['contentData']))?['shipperId']",
          "transportOrderNumber": "@json(base64ToString(triggerBody()?['contentData']))?['transportOrderNumber']",
          "shipmentNumber": "@json(base64ToString(triggerBody()?['contentData']))?['shipmentNumber']",
          "eventType": "@json(base64ToString(triggerBody()?['contentData']))?['eventType']",
          "sourceMessageId": "@json(base64ToString(triggerBody()?['contentData']))?['eventId']"
        },
        "runAfter": {},
        "trackedProperties": {
          "correlationId": "@action()?['inputs']?['correlationId']",
          "flow": "billing",
          "partyId": "@action()?['inputs']?['partyId']",
          "transportOrderNumber": "@action()?['inputs']?['transportOrderNumber']",
          "shipmentNumber": "@action()?['inputs']?['shipmentNumber']",
          "sourceMessageId": "@action()?['inputs']?['sourceMessageId']"
        }
      },
      "Check_the_billable_line": {
        "type": "If",
        "expression": {
          "equals": [
            "@and(equals(actions('Track_the_billable_line')?['status'], 'Succeeded'), equals(actions('Track_the_billable_line')?['outputs']?['eventType'], 'TransportOrderBillable'), not(empty(actions('Track_the_billable_line')?['outputs']?['correlationId'])), not(empty(actions('Track_the_billable_line')?['outputs']?['transportOrderNumber'])), not(empty(actions('Track_the_billable_line')?['outputs']?['partyId'])))",
            true
          ]
        },
        "actions": {
          "Record_the_billable_line": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@{parameters('erpBaseUrl')}/v1/billable-lines",
              "headers": {
                "Content-Type": "application/json",
                "X-Correlation-ID": "@{outputs('Track_the_billable_line')?['correlationId']}"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "@parameters('billingIdentityId')",
                "audience": "@parameters('erpAudience')"
              },
              "body": "@json(base64ToString(triggerBody()?['contentData']))",
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT5S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT20S"
              }
            },
            "runAfter": {},
            "trackedProperties": {
              "correlationId": "@json(base64ToString(triggerBody()?['contentData']))?['correlationId']",
              "flow": "billing",
              "partyId": "@json(base64ToString(triggerBody()?['contentData']))?['shipperId']",
              "transportOrderNumber": "@json(base64ToString(triggerBody()?['contentData']))?['transportOrderNumber']",
              "shipmentNumber": "@json(base64ToString(triggerBody()?['contentData']))?['shipmentNumber']",
              "sourceMessageId": "@json(base64ToString(triggerBody()?['contentData']))?['eventId']",
              "outcome": "@if(and(greaterOrEquals(coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
              "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0), 500)), 'ErpUnavailable', coalesce(actions('Record_the_billable_line')?['outputs']?['body']?['code'], 'ErpCallRefused')))"
            }
          },
          "Settle_the_message": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "greaterOrEquals": [
                    "@coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0)",
                    200
                  ]
                },
                {
                  "less": [
                    "@coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0)",
                    300
                  ]
                }
              ]
            },
            "actions": {
              "Complete_the_message": {
                "type": "ServiceProvider",
                "inputs": {
                  "parameters": {
                    "topicName": "transport-order-events",
                    "subscriptionName": "billing",
                    "lockToken": "@triggerBody()?['lockToken']"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "serviceBus",
                    "operationId": "completeTopicMessageV2",
                    "serviceProviderId": "/serviceProviders/serviceBus"
                  }
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {
                "Dead_letter_the_refused_billable_line": {
                  "type": "ServiceProvider",
                  "inputs": {
                    "parameters": {
                      "topicName": "transport-order-events",
                      "subscriptionName": "billing",
                      "lockToken": "@triggerBody()?['lockToken']",
                      "deadLetterReason": "@if(or(equals(coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0), 500)), 'ErpUnavailable', coalesce(actions('Record_the_billable_line')?['outputs']?['body']?['code'], 'ErpCallRefused'))",
                      "deadLetterErrorDescription": "@coalesce(actions('Record_the_billable_line')?['outputs']?['body']?['detail'], actions('Record_the_billable_line')?['outputs']?['body']?['title'], if(or(equals(coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Record_the_billable_line')?['outputs']?['statusCode'], 0), 500)), 'The ERP billing API did not answer after the retries.', 'The ERP billing API refused the Billable line.'))"
                    },
                    "serviceProviderConfiguration": {
                      "connectionName": "serviceBus",
                      "operationId": "deadLetterTopicMessageV2",
                      "serviceProviderId": "/serviceProviders/serviceBus"
                    }
                  },
                  "runAfter": {},
                  "trackedProperties": {
                    "correlationId": "@json(base64ToString(triggerBody()?['contentData']))?['correlationId']",
                    "flow": "billing",
                    "partyId": "@json(base64ToString(triggerBody()?['contentData']))?['shipperId']",
                    "transportOrderNumber": "@json(base64ToString(triggerBody()?['contentData']))?['transportOrderNumber']",
                    "shipmentNumber": "@json(base64ToString(triggerBody()?['contentData']))?['shipmentNumber']",
                    "sourceMessageId": "@json(base64ToString(triggerBody()?['contentData']))?['eventId']",
                    "outcome": "DeadLettered",
                    "messageId": "@triggerBody()?['messageId']",
                    "failureCode": "@action()?['inputs']?['parameters']?['deadLetterReason']"
                  }
                },
                "Fail_the_run_on_the_refused_billable_line": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "BillableLineNotRecorded",
                      "message": "The ERP didn't record the Billable line, so the message was dead-lettered."
                    }
                  },
                  "runAfter": {
                    "Dead_letter_the_refused_billable_line": [
                      "Succeeded",
                      "Failed"
                    ]
                  }
                }
              }
            },
            "runAfter": {
              "Record_the_billable_line": [
                "Succeeded",
                "Failed",
                "TimedOut"
              ]
            }
          }
        },
        "else": {
          "actions": {
            "Dead_letter_the_unreadable_billable_line": {
              "type": "ServiceProvider",
              "inputs": {
                "parameters": {
                  "topicName": "transport-order-events",
                  "subscriptionName": "billing",
                  "lockToken": "@triggerBody()?['lockToken']",
                  "deadLetterReason": "BillableLineUnreadable",
                  "deadLetterErrorDescription": "The message isn't a TransportOrderBillable the ERP can record, so nothing was sent to the ERP."
                },
                "serviceProviderConfiguration": {
                  "connectionName": "serviceBus",
                  "operationId": "deadLetterTopicMessageV2",
                  "serviceProviderId": "/serviceProviders/serviceBus"
                }
              },
              "runAfter": {},
              "trackedProperties": {
                "correlationId": "@json(base64ToString(triggerBody()?['contentData']))?['correlationId']",
                "flow": "billing",
                "partyId": "@json(base64ToString(triggerBody()?['contentData']))?['shipperId']",
                "transportOrderNumber": "@json(base64ToString(triggerBody()?['contentData']))?['transportOrderNumber']",
                "shipmentNumber": "@json(base64ToString(triggerBody()?['contentData']))?['shipmentNumber']",
                "sourceMessageId": "@json(base64ToString(triggerBody()?['contentData']))?['eventId']",
                "outcome": "DeadLettered",
                "messageId": "@triggerBody()?['messageId']",
                "failureCode": "BillableLineUnreadable"
              }
            },
            "Fail_the_run_on_the_unreadable_billable_line": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "BillableLineUnreadable",
                  "message": "The message isn't a TransportOrderBillable the ERP can record, so it was dead-lettered."
                }
              },
              "runAfter": {
                "Dead_letter_the_unreadable_billable_line": [
                  "Succeeded",
                  "Failed"
                ]
              }
            }
          }
        },
        "runAfter": {
          "Track_the_billable_line": [
            "Succeeded",
            "Failed"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
