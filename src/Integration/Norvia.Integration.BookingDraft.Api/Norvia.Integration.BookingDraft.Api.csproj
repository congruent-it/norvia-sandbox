<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The Intake agent's Booking draft operation in Azure (ADR 0040): a Container App that API Management calls for POST /partner/v1/booking-drafts and
    that asks the Agent published in the Foundry project norvia-intake, as its own managed identity. Locally the Partner API stand-in
    (LocalPartnerApi) plays the same operation in process with the scripted fake model, so nothing here is started by the AppHost outside Azure.
  -->
  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Norvia.ServiceDefaults\Norvia.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Norvia.Integration.BookingDraft\Norvia.Integration.BookingDraft.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Norvia.Integration.BookingDraft.Api.UnitTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
