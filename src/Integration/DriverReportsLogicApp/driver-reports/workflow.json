                            "connection": {
                              "referenceName": "servicebus"
                            }
                          },
                          "method": "post",
                          "path": "/@{encodeURIComponent(encodeURIComponent('driver-app-events'))}/subscriptions/@{encodeURIComponent('driver-reports')}/messages/deadletter",
                          "queries": {
                            "lockToken": "@triggerBody()?['LockToken']",
                            "sessionId": "@triggerBody()?['SessionId']",
                            "deadLetterReason": "@coalesce(outputs('Read_the_TMS_answer')?['body']?['code'], 'TmsCallRefused')",
                            "deadLetterErrorDescription": "@substring(string(coalesce(outputs('Read_the_TMS_answer')?['body']?['detail'], outputs('Read_the_TMS_answer')?['body']?['title'], 'The TMS refused the report.')), 0, min(1000, length(string(coalesce(outputs('Read_the_TMS_answer')?['body']?['detail'], outputs('Read_the_TMS_answer')?['body']?['title'], 'The TMS refused the report.')))))"
                          }
                        },
                        "runAfter": {},
                        "trackedProperties": {
                          "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
                          "flow": "trip-execution",
                          "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['driverId']",
                          "tripNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['tripNumber']",
                          "shipmentNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['shipmentNumber']",
                          "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']",
                          "outcome": "DeadLettered",
                          "messageId": "@triggerBody()?['MessageId']",
                          "failureCode": "@action()?['inputs']?['parameters']?['deadLetterReason']"
                        }
                      },
                      "Close_the_session_after_dead_lettering_the_refused_report": {
                        "type": "ApiConnection",
                        "description": "Releases the session as soon as its message is settled, so the next message is not held back until the session's lock expires.",
                        "inputs": {
                          "host": {
                            "connection": {
                              "referenceName": "servicebus"
                            }
                          },
                          "method": "delete",
                          "path": "/@{encodeURIComponent(encodeURIComponent('driver-app-events'))}/subscriptions/@{encodeURIComponent('driver-reports')}/sessions/@{encodeURIComponent(encodeURIComponent(triggerBody()?['SessionId']))}/close"
                        },
                        "runAfter": {
                          "Dead_letter_the_refused_report": [
                            "Succeeded"
                          ]
                        }
                      },
                      "Report_refused": {
                        "type": "Http",
                        "inputs": {
                          "method": "POST",
                          "uri": "@{parameters('driverAppBaseUrl')}/v1/report-outcomes",
                          "headers": {
                            "Content-Type": "application/json",
                            "X-Correlation-ID": "@{outputs('Track_the_report')?['correlationId']}"
                          },
                          "authentication": {
                            "type": "ManagedServiceIdentity",
                            "identity": "@parameters('driverReportsIdentityId')",
                            "audience": "@parameters('driverAppAudience')"
                          },
                          "retryPolicy": {
                            "type": "exponential",
                            "count": 3,
                            "interval": "PT5S",
                            "minimumInterval": "PT5S",
                            "maximumInterval": "PT20S"
                          },
                          "body": {
                            "driverAppEventId": "@outputs('Track_the_report')?['sourceMessageId']",
                            "tripNumber": "@outputs('Track_the_report')?['tripNumber']",
