                            "Failed"
                          ]
                        },
                        "trackedProperties": {
                          "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
                          "flow": "trip-execution",
                          "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['driverId']",
                          "tripNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['tripNumber']",
                          "shipmentNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['shipmentNumber']",
                          "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']",
                          "outcome": "@if(and(greaterOrEquals(coalesce(actions('Report_refused')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_refused')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
                          "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Report_refused')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_refused')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Report_refused')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Report_refused')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Report_refused')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Report_refused')?['outputs']?['statusCode'], 0), 500)), 'DriverAppUnavailable', 'DriverAppRefused'))"
                        }
                      }
                    }
                  },
                  "runAfter": {}
