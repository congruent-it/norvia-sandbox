                      }
                    },
                    "Report_not_recorded": {
                      "type": "Http",
                      "inputs": {
                        "method": "POST",
                        "uri": "@{parameters('driverAppBaseUrl')}/v1/report-outcomes",
                        "headers": {
                          "Content-Type": "application/json",
                          "X-Correlation-ID": "@{outputs('Track_the_report')?['correlationId']}"
                        },
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "identity": "@parameters('driverReportsIdentityId')",
                          "audience": "@parameters('driverAppAudience')"
                        },
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 3,
                          "interval": "PT5S",
                          "minimumInterval": "PT5S",
                          "maximumInterval": "PT20S"
                        },
                        "body": {
                          "driverAppEventId": "@outputs('Track_the_report')?['sourceMessageId']",
                          "tripNumber": "@outputs('Track_the_report')?['tripNumber']",
                          "correlationId": "@outputs('Track_the_report')?['correlationId']",
                          "outcome": "NotRecorded",
                          "failureCode": "TmsUnavailable",
                          "message": "@concat('The TMS ', if(equals(coalesce(outputs('Read_the_TMS_answer')?['statusCode'], 0), 0), 'didn''t answer', concat('answered ', string(coalesce(outputs('Read_the_TMS_answer')?['statusCode'], 0)))), ' (', string(add(length(coalesce(outputs('Read_the_TMS_answer')?['retryHistory'], json('[]'))), 1)), if(equals(add(length(coalesce(outputs('Read_the_TMS_answer')?['retryHistory'], json('[]'))), 1), 1), ' attempt', ' attempts'), ').')"
                        }
                      },
                      "runAfter": {
