        },
        "else": {
          "actions": {
            "Dead_letter_the_unreadable_report": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "referenceName": "servicebus"
                  }
                },
                "method": "post",
                "path": "/@{encodeURIComponent(encodeURIComponent('driver-app-events'))}/subscriptions/@{encodeURIComponent('driver-reports')}/messages/deadletter",
                "queries": {
                  "lockToken": "@triggerBody()?['LockToken']",
                  "sessionId": "@triggerBody()?['SessionId']",
                  "deadLetterReason": "DriverReportUnreadable",
                  "deadLetterErrorDescription": "The message isn't a Trip start, a Trip end, a Stop report or a Proof of delivery the Driver app made, so nothing was sent to the TMS."
                }
              },
              "runAfter": {},
              "trackedProperties": {
                "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
                "flow": "trip-execution",
                "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['driverId']",
                "tripNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['tripNumber']",
                "shipmentNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['shipmentNumber']",
                "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']",
                "outcome": "DeadLettered",
                "messageId": "@triggerBody()?['MessageId']",
                "failureCode": "DriverReportUnreadable"
              }
            },
            "Close_the_session_after_dead_lettering_the_unreadable_report": {
              "type": "ApiConnection",
              "description": "Releases the session as soon as its message is settled, so the next message is not held back until the session's lock expires.",
              "inputs": {
                "host": {
                  "connection": {
                    "referenceName": "servicebus"
                  }
                },
                "method": "delete",
                "path": "/@{encodeURIComponent(encodeURIComponent('driver-app-events'))}/subscriptions/@{encodeURIComponent('driver-reports')}/sessions/@{encodeURIComponent(encodeURIComponent(triggerBody()?['SessionId']))}/close"
              },
              "runAfter": {
                "Dead_letter_the_unreadable_report": [
