{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_Driver_report_is_available": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "topicName": "driver-app-events",
            "subscriptionName": "driver-reports"
          },
          "serviceProviderConfiguration": {
            "connectionName": "serviceBus",
            "operationId": "onSingleNewMessageFromTopicSession",
            "serviceProviderId": "/serviceProviders/serviceBus"
          }
        },
        "correlation": {
          "clientTrackingId": "@{triggerOutputs()?['body']?['userProperties']?['correlationId']}"
        }
      }
    },
    "actions": {
      "Track_the_report": {
        "type": "Compose",
        "inputs": {
          "correlationId": "@json(base64ToString(triggerBody()?['contentData']))?['correlationId']",
          "partyId": "@json(base64ToString(triggerBody()?['contentData']))?['driverId']",
          "tripNumber": "@json(base64ToString(triggerBody()?['contentData']))?['tripNumber']",
          "eventType": "@json(base64ToString(triggerBody()?['contentData']))?['eventType']",
          "sourceMessageId": "@json(base64ToString(triggerBody()?['contentData']))?['eventId']"
        },
        "runAfter": {},
        "trackedProperties": {
          "correlationId": "@action()?['inputs']?['correlationId']",
          "flow": "trip-execution",
          "partyId": "@action()?['inputs']?['partyId']",
          "tripNumber": "@action()?['inputs']?['tripNumber']",
          "sourceMessageId": "@action()?['inputs']?['sourceMessageId']"
        }
      },
      "Check_the_report": {
        "type": "If",
        "expression": {
          "equals": [
            "@and(equals(actions('Track_the_report')?['status'], 'Succeeded'), equals(outputs('Track_the_report')?['eventType'], 'TripStartReported'), not(empty(outputs('Track_the_report')?['correlationId'])), not(empty(outputs('Track_the_report')?['tripNumber'])), not(empty(outputs('Track_the_report')?['partyId'])), not(empty(outputs('Track_the_report')?['sourceMessageId'])))",
            true
          ]
        },
        "actions": {
          "Start_the_Trip_in_the_TMS": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@{parameters('tmsBaseUrl')}/v1/trips/@{outputs('Track_the_report')?['tripNumber']}/start",
              "headers": {
                "Content-Type": "application/json",
                "X-Correlation-ID": "@{outputs('Track_the_report')?['correlationId']}"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "@parameters('driverReportsIdentityId')",
                "audience": "@parameters('tmsAudience')"
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT5S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT20S"
              },
              "body": {
                "driverId": "@outputs('Track_the_report')?['partyId']",
                "driverAppEventId": "@outputs('Track_the_report')?['sourceMessageId']"
              }
            },
            "runAfter": {},
            "trackedProperties": {
              "correlationId": "@outputs('Track_the_report')?['correlationId']",
              "flow": "trip-execution",
              "partyId": "@outputs('Track_the_report')?['partyId']",
              "tripNumber": "@outputs('Track_the_report')?['tripNumber']",
              "sourceMessageId": "@outputs('Track_the_report')?['sourceMessageId']",
              "outcome": "@if(and(greaterOrEquals(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
              "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0), 500)), 'TmsUnavailable', 'TmsCallRefused'))"
            }
          },
          "Settle_the_report_and_tell_the_Driver_app": {
            "type": "If",
            "expression": {
              "equals": [
                "@and(greaterOrEquals(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0), 300))",
                true
              ]
            },
            "actions": {
              "Complete_the_message": {
                "type": "ServiceProvider",
                "inputs": {
                  "serviceProviderConfiguration": {
                    "connectionName": "serviceBus",
                    "operationId": "completeMessageInSession",
                    "serviceProviderId": "/serviceProviders/serviceBus"
                  },
                  "parameters": {
                    "messageId": "@triggerBody()?['messageId']",
                    "lockToken": "@triggerBody()?['lockToken']"
                  }
                },
                "runAfter": {}
              },
              "Report_recorded": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@{parameters('driverAppBaseUrl')}/v1/report-outcomes",
                  "headers": {
                    "Content-Type": "application/json",
                    "X-Correlation-ID": "@{outputs('Track_the_report')?['correlationId']}"
                  },
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "identity": "@parameters('driverReportsIdentityId')",
                    "audience": "@parameters('driverAppAudience')"
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT5S",
                    "minimumInterval": "PT5S",
                    "maximumInterval": "PT20S"
                  },
                  "body": {
                    "driverAppEventId": "@outputs('Track_the_report')?['sourceMessageId']",
                    "tripNumber": "@outputs('Track_the_report')?['tripNumber']",
                    "correlationId": "@outputs('Track_the_report')?['correlationId']",
                    "outcome": "Recorded"
                  }
                },
                "runAfter": {
                  "Complete_the_message": [
                    "Succeeded"
                  ]
                },
                "trackedProperties": {
                  "correlationId": "@outputs('Track_the_report')?['correlationId']",
                  "flow": "trip-execution",
                  "partyId": "@outputs('Track_the_report')?['partyId']",
                  "tripNumber": "@outputs('Track_the_report')?['tripNumber']",
                  "sourceMessageId": "@outputs('Track_the_report')?['sourceMessageId']",
                  "outcome": "@if(and(greaterOrEquals(coalesce(actions('Report_recorded')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_recorded')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
                  "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Report_recorded')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_recorded')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Report_recorded')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Report_recorded')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Report_recorded')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Report_recorded')?['outputs']?['statusCode'], 0), 500)), 'DriverAppUnavailable', 'DriverAppRefused'))"
                }
              }
            },
            "else": {
              "actions": {
                "Check_whether_the_TMS_was_unavailable": {
                  "type": "If",
                  "expression": {
                    "equals": [
                      "@or(equals(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0), 500))",
                      true
                    ]
                  },
                  "actions": {
                    "Dead_letter_the_report_the_TMS_could_not_take": {
                      "type": "ServiceProvider",
                      "inputs": {
                        "serviceProviderConfiguration": {
                          "connectionName": "serviceBus",
                          "operationId": "deadLetterMessageInSession",
                          "serviceProviderId": "/serviceProviders/serviceBus"
                        },
                        "parameters": {
                          "messageId": "@triggerBody()?['messageId']",
                          "lockToken": "@triggerBody()?['lockToken']",
                          "deadLetterReason": "TmsUnavailable",
                          "deadLetterErrorDescription": "@concat('The TMS ', if(equals(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0), 0), 'didn''t answer', concat('answered ', string(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0)))), ' (', string(add(length(coalesce(actions('Start_the_Trip_in_the_TMS')?['retryHistory'], json('[]'))), 1)), if(equals(add(length(coalesce(actions('Start_the_Trip_in_the_TMS')?['retryHistory'], json('[]'))), 1), 1), ' attempt', ' attempts'), ').')"
                        }
                      },
                      "runAfter": {},
                      "trackedProperties": {
                        "correlationId": "@outputs('Track_the_report')?['correlationId']",
                        "flow": "trip-execution",
                        "partyId": "@outputs('Track_the_report')?['partyId']",
                        "tripNumber": "@outputs('Track_the_report')?['tripNumber']",
                        "sourceMessageId": "@outputs('Track_the_report')?['sourceMessageId']",
                        "outcome": "DeadLettered",
                        "failureCode": "TmsUnavailable"
                      }
                    },
                    "Report_not_recorded": {
                      "type": "Http",
                      "inputs": {
                        "method": "POST",
                        "uri": "@{parameters('driverAppBaseUrl')}/v1/report-outcomes",
                        "headers": {
                          "Content-Type": "application/json",
                          "X-Correlation-ID": "@{outputs('Track_the_report')?['correlationId']}"
                        },
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "identity": "@parameters('driverReportsIdentityId')",
                          "audience": "@parameters('driverAppAudience')"
                        },
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 3,
                          "interval": "PT5S",
                          "minimumInterval": "PT5S",
                          "maximumInterval": "PT20S"
                        },
                        "body": {
                          "driverAppEventId": "@outputs('Track_the_report')?['sourceMessageId']",
                          "tripNumber": "@outputs('Track_the_report')?['tripNumber']",
                          "correlationId": "@outputs('Track_the_report')?['correlationId']",
                          "outcome": "NotRecorded",
                          "failureCode": "TmsUnavailable",
                          "message": "@concat('The TMS ', if(equals(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0), 0), 'didn''t answer', concat('answered ', string(coalesce(actions('Start_the_Trip_in_the_TMS')?['outputs']?['statusCode'], 0)))), ' (', string(add(length(coalesce(actions('Start_the_Trip_in_the_TMS')?['retryHistory'], json('[]'))), 1)), if(equals(add(length(coalesce(actions('Start_the_Trip_in_the_TMS')?['retryHistory'], json('[]'))), 1), 1), ' attempt', ' attempts'), ').')"
                        }
                      },
                      "runAfter": {
                        "Dead_letter_the_report_the_TMS_could_not_take": [
                          "Succeeded"
                        ]
                      },
                      "trackedProperties": {
                        "correlationId": "@outputs('Track_the_report')?['correlationId']",
                        "flow": "trip-execution",
                        "partyId": "@outputs('Track_the_report')?['partyId']",
                        "tripNumber": "@outputs('Track_the_report')?['tripNumber']",
                        "sourceMessageId": "@outputs('Track_the_report')?['sourceMessageId']",
                        "outcome": "@if(and(greaterOrEquals(coalesce(actions('Report_not_recorded')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_not_recorded')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
                        "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Report_not_recorded')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_not_recorded')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Report_not_recorded')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Report_not_recorded')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Report_not_recorded')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Report_not_recorded')?['outputs']?['statusCode'], 0), 500)), 'DriverAppUnavailable', 'DriverAppRefused'))"
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Dead_letter_the_refused_report": {
                        "type": "ServiceProvider",
                        "inputs": {
                          "serviceProviderConfiguration": {
                            "connectionName": "serviceBus",
                            "operationId": "deadLetterMessageInSession",
                            "serviceProviderId": "/serviceProviders/serviceBus"
                          },
                          "parameters": {
                            "messageId": "@triggerBody()?['messageId']",
                            "lockToken": "@triggerBody()?['lockToken']",
                            "deadLetterReason": "@coalesce(outputs('Start_the_Trip_in_the_TMS')?['body']?['code'], 'TmsCallRefused')",
                            "deadLetterErrorDescription": "@substring(string(coalesce(outputs('Start_the_Trip_in_the_TMS')?['body']?['detail'], outputs('Start_the_Trip_in_the_TMS')?['body']?['title'], 'The TMS refused the report.')), 0, min(1000, length(string(coalesce(outputs('Start_the_Trip_in_the_TMS')?['body']?['detail'], outputs('Start_the_Trip_in_the_TMS')?['body']?['title'], 'The TMS refused the report.')))))"
                          }
                        },
                        "runAfter": {},
                        "trackedProperties": {
                          "correlationId": "@outputs('Track_the_report')?['correlationId']",
                          "flow": "trip-execution",
                          "partyId": "@outputs('Track_the_report')?['partyId']",
                          "tripNumber": "@outputs('Track_the_report')?['tripNumber']",
                          "sourceMessageId": "@outputs('Track_the_report')?['sourceMessageId']",
                          "outcome": "DeadLettered",
                          "failureCode": "@coalesce(outputs('Start_the_Trip_in_the_TMS')?['body']?['code'], 'TmsCallRefused')"
                        }
                      },
                      "Report_refused": {
                        "type": "Http",
                        "inputs": {
                          "method": "POST",
                          "uri": "@{parameters('driverAppBaseUrl')}/v1/report-outcomes",
                          "headers": {
                            "Content-Type": "application/json",
                            "X-Correlation-ID": "@{outputs('Track_the_report')?['correlationId']}"
                          },
                          "authentication": {
                            "type": "ManagedServiceIdentity",
                            "identity": "@parameters('driverReportsIdentityId')",
                            "audience": "@parameters('driverAppAudience')"
                          },
                          "retryPolicy": {
                            "type": "exponential",
                            "count": 3,
                            "interval": "PT5S",
                            "minimumInterval": "PT5S",
                            "maximumInterval": "PT20S"
                          },
                          "body": {
                            "driverAppEventId": "@outputs('Track_the_report')?['sourceMessageId']",
                            "tripNumber": "@outputs('Track_the_report')?['tripNumber']",
                            "correlationId": "@outputs('Track_the_report')?['correlationId']",
                            "outcome": "Refused",
                            "failureCode": "@coalesce(outputs('Start_the_Trip_in_the_TMS')?['body']?['code'], 'TmsCallRefused')",
                            "message": "@substring(string(coalesce(outputs('Start_the_Trip_in_the_TMS')?['body']?['detail'], outputs('Start_the_Trip_in_the_TMS')?['body']?['title'], 'The TMS refused the report.')), 0, min(1000, length(string(coalesce(outputs('Start_the_Trip_in_the_TMS')?['body']?['detail'], outputs('Start_the_Trip_in_the_TMS')?['body']?['title'], 'The TMS refused the report.')))))"
                          }
                        },
                        "runAfter": {
                          "Dead_letter_the_refused_report": [
                            "Succeeded"
                          ]
                        },
                        "trackedProperties": {
                          "correlationId": "@outputs('Track_the_report')?['correlationId']",
                          "flow": "trip-execution",
                          "partyId": "@outputs('Track_the_report')?['partyId']",
                          "tripNumber": "@outputs('Track_the_report')?['tripNumber']",
                          "sourceMessageId": "@outputs('Track_the_report')?['sourceMessageId']",
                          "outcome": "@if(and(greaterOrEquals(coalesce(actions('Report_refused')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_refused')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
                          "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Report_refused')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_refused')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Report_refused')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Report_refused')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Report_refused')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Report_refused')?['outputs']?['statusCode'], 0), 500)), 'DriverAppUnavailable', 'DriverAppRefused'))"
                        }
                      }
                    }
                  },
                  "runAfter": {}
                }
              }
            },
            "runAfter": {
              "Start_the_Trip_in_the_TMS": [
                "Succeeded",
                "Failed",
                "TimedOut"
              ]
            }
          }
        },
        "else": {
          "actions": {
            "Dead_letter_the_unreadable_report": {
              "type": "ServiceProvider",
              "inputs": {
                "serviceProviderConfiguration": {
                  "connectionName": "serviceBus",
                  "operationId": "deadLetterMessageInSession",
                  "serviceProviderId": "/serviceProviders/serviceBus"
                },
                "parameters": {
                  "messageId": "@triggerBody()?['messageId']",
                  "lockToken": "@triggerBody()?['lockToken']",
                  "deadLetterReason": "DriverReportUnreadable",
                  "deadLetterErrorDescription": "The message isn't a Trip start the Driver app reported, so nothing was sent to the TMS."
                }
              },
              "runAfter": {},
              "trackedProperties": {
                "correlationId": "@outputs('Track_the_report')?['correlationId']",
                "flow": "trip-execution",
                "partyId": "@outputs('Track_the_report')?['partyId']",
                "tripNumber": "@outputs('Track_the_report')?['tripNumber']",
                "sourceMessageId": "@outputs('Track_the_report')?['sourceMessageId']",
                "outcome": "DeadLettered",
                "failureCode": "DriverReportUnreadable"
              }
            },
            "Fail_the_run_on_the_unreadable_report": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "DriverReportUnreadable",
                  "message": "The message isn't a Trip start the Driver app reported, so it was dead-lettered."
                }
              },
              "runAfter": {
                "Dead_letter_the_unreadable_report": [
                  "Succeeded",
                  "Failed"
                ]
              }
            }
          }
        },
        "runAfter": {
          "Track_the_report": [
            "Succeeded",
            "Failed"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
