                            "message": "@substring(string(coalesce(outputs('Read_the_TMS_answer')?['body']?['detail'], outputs('Read_the_TMS_answer')?['body']?['title'], 'The TMS refused the report.')), 0, min(1000, length(string(coalesce(outputs('Read_the_TMS_answer')?['body']?['detail'], outputs('Read_the_TMS_answer')?['body']?['title'], 'The TMS refused the report.')))))"
                          }
