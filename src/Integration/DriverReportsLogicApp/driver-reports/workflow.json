{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_Driver_report_is_available": {
        "type": "ApiConnection",
        "inputs": {
          "host": {
            "connection": {
              "referenceName": "servicebus"
            }
          },
          "method": "get",
          "path": "/@{encodeURIComponent(encodeURIComponent('driver-app-events'))}/subscriptions/@{encodeURIComponent('driver-reports')}/messages/head/peek",
          "queries": {
            "subscriptionType": "Main",
            "sessionId": "Next Available"
          }
        },
        "recurrence": {
          "frequency": "Minute",
          "interval": 1
        },
        "correlation": {
          "clientTrackingId": "@{coalesce(if(equals(length(string(coalesce(triggerBody(), ''))), 0), json('{}'), triggerBody())?['Properties']?['correlationId'], '00000000-0000-0000-0000-000000000000')}"
        }
      }
    },
    "actions": {
      "Track_the_report": {
        "type": "Compose",
        "inputs": {
          "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
          "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['driverId']",
          "tripNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['tripNumber']",
          "eventType": "@json(base64ToString(triggerBody()?['ContentData']))?['eventType']",
          "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']",
          "occurredAt": "@json(base64ToString(triggerBody()?['ContentData']))?['occurredAt']",
          "version": "@json(base64ToString(triggerBody()?['ContentData']))?['version']",
          "shipmentNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['shipmentNumber']",
          "stop": "@json(base64ToString(triggerBody()?['ContentData']))?['stop']",
          "trackingEventType": "@json(base64ToString(triggerBody()?['ContentData']))?['trackingEventType']",
          "location": "@json(base64ToString(triggerBody()?['ContentData']))?['location']",
          "remark": "@json(base64ToString(triggerBody()?['ContentData']))?['remark']",
          "documentId": "@json(base64ToString(triggerBody()?['ContentData']))?['documentId']",
          "receivedBy": "@json(base64ToString(triggerBody()?['ContentData']))?['receivedBy']",
          "deliveryTime": "@json(base64ToString(triggerBody()?['ContentData']))?['deliveryTime']",
          "condition": "@json(base64ToString(triggerBody()?['ContentData']))?['condition']",
          "files": "@json(base64ToString(triggerBody()?['ContentData']))?['files']"
        },
        "runAfter": {},
        "trackedProperties": {
          "correlationId": "@action()?['inputs']?['correlationId']",
          "flow": "trip-execution",
          "partyId": "@action()?['inputs']?['partyId']",
          "tripNumber": "@action()?['inputs']?['tripNumber']",
          "shipmentNumber": "@action()?['inputs']?['shipmentNumber']",
          "sourceMessageId": "@action()?['inputs']?['sourceMessageId']"
        }
      },
      "Initialize_the_file_parts": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "fileParts",
              "type": "array",
              "value": []
            }
          ]
        },
        "runAfter": {
          "Track_the_report": [
            "Succeeded",
            "Failed"
          ]
        }
      },
      "Check_the_report": {
        "type": "If",
        "expression": {
          "equals": [
            "@and(equals(actions('Track_the_report')?['status'], 'Succeeded'), not(empty(outputs('Track_the_report')?['correlationId'])), not(empty(outputs('Track_the_report')?['tripNumber'])), not(empty(outputs('Track_the_report')?['partyId'])), not(empty(outputs('Track_the_report')?['sourceMessageId'])), or(equals(outputs('Track_the_report')?['eventType'], 'TripStartReported'), equals(outputs('Track_the_report')?['eventType'], 'TripEndReported'), and(equals(outputs('Track_the_report')?['eventType'], 'StopCompletedReported'), not(empty(outputs('Track_the_report')?['shipmentNumber'])), not(empty(outputs('Track_the_report')?['trackingEventType'])), not(equals(outputs('Track_the_report')?['version'], null)), not(empty(outputs('Track_the_report')?['occurredAt'])), not(empty(outputs('Track_the_report')?['location']?['place'])), not(empty(outputs('Track_the_report')?['location']?['postcode'])), not(empty(outputs('Track_the_report')?['location']?['countryCode']))), and(equals(outputs('Track_the_report')?['eventType'], 'ProofOfDeliveryCaptured'), not(empty(outputs('Track_the_report')?['shipmentNumber'])), not(equals(outputs('Track_the_report')?['version'], null)), not(empty(outputs('Track_the_report')?['documentId'])), not(empty(outputs('Track_the_report')?['receivedBy'])), not(empty(outputs('Track_the_report')?['deliveryTime'])), not(empty(outputs('Track_the_report')?['condition'])), not(empty(outputs('Track_the_report')?['location']?['place'])), not(empty(outputs('Track_the_report')?['location']?['postcode'])), not(empty(outputs('Track_the_report')?['location']?['countryCode'])), greater(length(coalesce(outputs('Track_the_report')?['files'], json('[]'))), 0))))",
            true
          ]
        },
        "actions": {
          "Build_the_Trip_start": {
            "type": "Compose",
            "inputs": {
              "driverId": "@outputs('Track_the_report')?['partyId']",
              "driverAppEventId": "@outputs('Track_the_report')?['sourceMessageId']"
            },
            "runAfter": {}
          },
          "Build_the_Trip_end": {
            "type": "Compose",
            "inputs": {
              "driverId": "@outputs('Track_the_report')?['partyId']"
            },
            "runAfter": {
              "Build_the_Trip_start": [
                "Succeeded"
              ]
            }
          },
          "Build_the_Tracking_event": {
            "type": "Compose",
            "inputs": {
              "eventId": "@outputs('Track_the_report')?['sourceMessageId']",
              "source": {
                "type": "OwnFleet",
                "driverId": "@outputs('Track_the_report')?['partyId']"
              },
              "tripNumber": "@outputs('Track_the_report')?['tripNumber']",
              "shipmentNumber": "@outputs('Track_the_report')?['shipmentNumber']",
              "tripVersion": "@outputs('Track_the_report')?['version']",
              "type": "@outputs('Track_the_report')?['trackingEventType']",
              "eventTime": "@outputs('Track_the_report')?['occurredAt']",
              "location": {
                "place": "@outputs('Track_the_report')?['location']?['place']",
                "postcode": "@outputs('Track_the_report')?['location']?['postcode']",
                "countryCode": "@outputs('Track_the_report')?['location']?['countryCode']"
              }
            },
            "runAfter": {
              "Build_the_Trip_end": [
                "Succeeded"
              ]
            }
          },
          "Fetch_the_files": {
            "type": "Foreach",
            "foreach": "@coalesce(outputs('Track_the_report')?['files'], json('[]'))",
            "actions": {
              "Read_the_file": {
                "type": "ServiceProvider",
                "inputs": {
                  "parameters": {
                    "containerName": "@parameters('driverProofsContainer')",
                    "blobName": "@{items('Fetch_the_files')?['blobReference']}"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "AzureBlob",
                    "operationId": "readBlob",
                    "serviceProviderId": "/serviceProviders/AzureBlob"
                  }
                },
                "runAfter": {}
              },
              "Append_the_file_part": {
                "type": "AppendToArrayVariable",
                "inputs": {
                  "name": "fileParts",
                  "value": {
                    "headers": {
                      "Content-Disposition": "form-data; name=\"files\"; filename=\"@{items('Fetch_the_files')?['name']}\"",
                      "Content-Type": "@{items('Fetch_the_files')?['contentType']}"
                    },
                    "body": "@outputs('Read_the_file')?['content']"
                  }
                },
                "runAfter": {
                  "Read_the_file": [
                    "Succeeded"
                  ]
                }
              }
            },
            "runAfter": {
              "Build_the_Tracking_event": [
                "Succeeded"
              ]
            },
            "runtimeConfiguration": {
              "concurrency": {
                "repetitions": 1
              }
            }
          },
          "Select_the_file_descriptions": {
            "type": "Select",
            "inputs": {
              "from": "@coalesce(outputs('Track_the_report')?['files'], json('[]'))",
              "select": {
                "name": "@item()?['name']",
                "contentType": "@item()?['contentType']"
              }
            },
            "runAfter": {
              "Fetch_the_files": [
                "Succeeded"
              ]
            }
          },
          "Build_the_Proof_of_delivery": {
            "type": "Compose",
            "inputs": {
              "documentId": "@outputs('Track_the_report')?['documentId']",
              "source": {
                "type": "OwnFleet",
                "driverId": "@outputs('Track_the_report')?['partyId']"
              },
              "tripNumber": "@outputs('Track_the_report')?['tripNumber']",
              "shipmentNumber": "@outputs('Track_the_report')?['shipmentNumber']",
              "tripVersion": "@outputs('Track_the_report')?['version']",
              "receivedBy": "@outputs('Track_the_report')?['receivedBy']",
              "deliveryTime": "@outputs('Track_the_report')?['deliveryTime']",
              "location": {
                "place": "@outputs('Track_the_report')?['location']?['place']",
                "postcode": "@outputs('Track_the_report')?['location']?['postcode']",
                "countryCode": "@outputs('Track_the_report')?['location']?['countryCode']"
              },
              "condition": "@outputs('Track_the_report')?['condition']",
              "files": "@body('Select_the_file_descriptions')"
            },
            "runAfter": {
              "Select_the_file_descriptions": [
                "Succeeded"
              ]
            }
          },
          "Dead_letter_the_report_whose_files_are_gone": {
            "type": "ApiConnection",
            "inputs": {
              "host": {
                "connection": {
                  "referenceName": "servicebus"
                }
              },
              "method": "post",
              "path": "/@{encodeURIComponent(encodeURIComponent('driver-app-events'))}/subscriptions/@{encodeURIComponent('driver-reports')}/messages/deadletter",
              "queries": {
                "lockToken": "@triggerBody()?['LockToken']",
                "sessionId": "@triggerBody()?['SessionId']",
                "deadLetterReason": "ProofOfDeliveryFilesGone",
                "deadLetterErrorDescription": "The Proof of delivery's files could not be read from the Driver app's transit container, so nothing was sent to the TMS."
              }
            },
            "runAfter": {
              "Fetch_the_files": [
                "Failed",
                "TimedOut"
              ]
            },
            "trackedProperties": {
              "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
              "flow": "trip-execution",
              "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['driverId']",
              "tripNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['tripNumber']",
              "shipmentNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['shipmentNumber']",
              "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']",
              "outcome": "DeadLettered",
              "messageId": "@triggerBody()?['MessageId']",
              "failureCode": "ProofOfDeliveryFilesGone"
            }
          },
          "Close_the_session_after_the_files_are_gone": {
            "type": "ApiConnection",
            "description": "Releases the session as soon as its message is settled, so the next message is not held back until the session's lock expires.",
            "inputs": {
              "host": {
                "connection": {
                  "referenceName": "servicebus"
                }
              },
              "method": "delete",
              "path": "/@{encodeURIComponent(encodeURIComponent('driver-app-events'))}/subscriptions/@{encodeURIComponent('driver-reports')}/sessions/@{encodeURIComponent(encodeURIComponent(triggerBody()?['SessionId']))}/close"
            },
            "runAfter": {
              "Dead_letter_the_report_whose_files_are_gone": [
                "Succeeded"
              ]
            }
          },
          "Report_the_files_are_gone": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@{parameters('driverAppBaseUrl')}/v1/report-outcomes",
              "headers": {
                "Content-Type": "application/json",
                "X-Correlation-ID": "@{outputs('Track_the_report')?['correlationId']}"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "@parameters('driverReportsIdentityId')",
                "audience": "@parameters('driverAppAudience')"
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT5S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT20S"
              },
              "body": {
                "driverAppEventId": "@outputs('Track_the_report')?['sourceMessageId']",
                "tripNumber": "@outputs('Track_the_report')?['tripNumber']",
                "correlationId": "@outputs('Track_the_report')?['correlationId']",
                "outcome": "NotRecorded",
                "failureCode": "ProofOfDeliveryFilesGone",
                "message": "The Proof of delivery's files could not be read from the Driver app's transit container, so nothing was sent to the TMS."
              }
            },
            "runAfter": {
              "Close_the_session_after_the_files_are_gone": [
                "Succeeded",
                "Failed"
              ]
            },
            "trackedProperties": {
              "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
              "flow": "trip-execution",
              "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['driverId']",
              "tripNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['tripNumber']",
              "shipmentNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['shipmentNumber']",
              "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']",
              "outcome": "@if(and(greaterOrEquals(coalesce(actions('Report_the_files_are_gone')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_the_files_are_gone')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
              "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Report_the_files_are_gone')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_the_files_are_gone')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Report_the_files_are_gone')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Report_the_files_are_gone')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Report_the_files_are_gone')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Report_the_files_are_gone')?['outputs']?['statusCode'], 0), 500)), 'DriverAppUnavailable', 'DriverAppRefused'))"
            }
          },
          "Fail_the_run_on_the_files_that_are_gone": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "ProofOfDeliveryFilesGone",
                "message": "The Proof of delivery's files could not be read from the Driver app's transit container, so nothing was sent to the TMS. The message was dead-lettered and the Driver app told it was not recorded."
              }
            },
            "runAfter": {
              "Report_the_files_are_gone": [
                "Succeeded",
                "Failed"
              ]
            }
          },
          "Send_the_report": {
            "type": "If",
            "expression": {
              "equals": [
                "@outputs('Track_the_report')?['eventType']",
                "ProofOfDeliveryCaptured"
              ]
            },
            "actions": {
              "Send_the_Proof_of_delivery_to_the_TMS": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@{parameters('tmsBaseUrl')}/v1/proofs-of-delivery",
                  "headers": {
                    "X-Correlation-ID": "@{outputs('Track_the_report')?['correlationId']}"
                  },
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "identity": "@parameters('driverReportsIdentityId')",
                    "audience": "@parameters('tmsAudience')"
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT5S",
                    "minimumInterval": "PT5S",
                    "maximumInterval": "PT20S"
                  },
                  "body": {
                    "$content-type": "multipart/form-data",
                    "$multipart": "@union(createArray(addProperty(addProperty(json('{}'), 'headers', addProperty(json('{}'), 'Content-Disposition', 'form-data; name=\"metadata\"')), 'body', if(empty(outputs('Track_the_report')?['remark']), outputs('Build_the_Proof_of_delivery'), addProperty(outputs('Build_the_Proof_of_delivery'), 'remark', outputs('Track_the_report')?['remark'])))), variables('fileParts'))"
                  }
                },
                "runAfter": {},
                "trackedProperties": {
                  "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
                  "flow": "trip-execution",
                  "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['driverId']",
                  "tripNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['tripNumber']",
                  "shipmentNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['shipmentNumber']",
                  "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']",
                  "outcome": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
                  "failureCode": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(action()?['outputs']?['statusCode'], 0), 0), equals(coalesce(action()?['outputs']?['statusCode'], 0), 408), equals(coalesce(action()?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 500)), 'TmsUnavailable', 'TmsCallRefused'))"
                }
              }
            },
            "else": {
              "actions": {
                "Send_the_report_to_the_TMS": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{parameters('tmsBaseUrl')}/v1/@{if(equals(outputs('Track_the_report')?['eventType'], 'StopCompletedReported'), 'tracking-events', if(equals(outputs('Track_the_report')?['eventType'], 'TripEndReported'), concat('trips/', outputs('Track_the_report')?['tripNumber'], '/end'), concat('trips/', outputs('Track_the_report')?['tripNumber'], '/start')))}",
                    "headers": {
                      "X-Correlation-ID": "@{outputs('Track_the_report')?['correlationId']}"
                    },
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "identity": "@parameters('driverReportsIdentityId')",
                      "audience": "@parameters('tmsAudience')"
                    },
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 3,
                      "interval": "PT5S",
                      "minimumInterval": "PT5S",
                      "maximumInterval": "PT20S"
                    },
                    "body": "@if(equals(outputs('Track_the_report')?['eventType'], 'StopCompletedReported'), if(empty(outputs('Track_the_report')?['remark']), outputs('Build_the_Tracking_event'), addProperty(outputs('Build_the_Tracking_event'), 'remark', outputs('Track_the_report')?['remark'])), if(equals(outputs('Track_the_report')?['eventType'], 'TripEndReported'), outputs('Build_the_Trip_end'), outputs('Build_the_Trip_start')))"
                  },
                  "runAfter": {},
                  "trackedProperties": {
                    "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
                    "flow": "trip-execution",
                    "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['driverId']",
                    "tripNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['tripNumber']",
                    "shipmentNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['shipmentNumber']",
                    "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']",
                    "outcome": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
                    "failureCode": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(action()?['outputs']?['statusCode'], 0), 0), equals(coalesce(action()?['outputs']?['statusCode'], 0), 408), equals(coalesce(action()?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 500)), 'TmsUnavailable', 'TmsCallRefused'))"
                  }
                }
              }
            },
            "runAfter": {
              "Build_the_Proof_of_delivery": [
                "Succeeded"
              ]
            }
          },
          "Read_the_TMS_answer": {
            "type": "Compose",
            "inputs": {
              "statusCode": "@coalesce(actions('Send_the_Proof_of_delivery_to_the_TMS')?['outputs']?['statusCode'], actions('Send_the_report_to_the_TMS')?['outputs']?['statusCode'], 0)",
              "body": "@coalesce(actions('Send_the_Proof_of_delivery_to_the_TMS')?['outputs']?['body'], actions('Send_the_report_to_the_TMS')?['outputs']?['body'])",
              "retryHistory": "@coalesce(actions('Send_the_Proof_of_delivery_to_the_TMS')?['retryHistory'], actions('Send_the_report_to_the_TMS')?['retryHistory'], json('[]'))"
            },
            "runAfter": {
              "Send_the_report": [
                "Succeeded",
                "Failed",
                "TimedOut"
              ]
            }
          },
          "Settle_the_report_and_tell_the_Driver_app": {
            "type": "If",
            "expression": {
              "equals": [
                "@and(greaterOrEquals(coalesce(outputs('Read_the_TMS_answer')?['statusCode'], 0), 200), less(coalesce(outputs('Read_the_TMS_answer')?['statusCode'], 0), 300))",
                true
              ]
            },
            "actions": {
              "Complete_the_message": {
                "type": "ApiConnection",
                "inputs": {
                  "host": {
                    "connection": {
                      "referenceName": "servicebus"
                    }
                  },
                  "method": "delete",
                  "path": "/@{encodeURIComponent(encodeURIComponent('driver-app-events'))}/subscriptions/@{encodeURIComponent('driver-reports')}/messages/complete",
                  "queries": {
                    "lockToken": "@triggerBody()?['LockToken']",
                    "subscriptionType": "Main",
                    "sessionId": "@triggerBody()?['SessionId']"
                  }
                },
                "runAfter": {}
              },
              "Close_the_session_after_completing": {
                "type": "ApiConnection",
                "description": "Releases the session as soon as its message is settled, so the next message is not held back until the session's lock expires.",
                "inputs": {
                  "host": {
                    "connection": {
                      "referenceName": "servicebus"
                    }
                  },
                  "method": "delete",
                  "path": "/@{encodeURIComponent(encodeURIComponent('driver-app-events'))}/subscriptions/@{encodeURIComponent('driver-reports')}/sessions/@{encodeURIComponent(encodeURIComponent(triggerBody()?['SessionId']))}/close"
                },
                "runAfter": {
                  "Complete_the_message": [
                    "Succeeded"
                  ]
                }
              },
              "Report_recorded": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@{parameters('driverAppBaseUrl')}/v1/report-outcomes",
                  "headers": {
                    "Content-Type": "application/json",
                    "X-Correlation-ID": "@{outputs('Track_the_report')?['correlationId']}"
                  },
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "identity": "@parameters('driverReportsIdentityId')",
                    "audience": "@parameters('driverAppAudience')"
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT5S",
                    "minimumInterval": "PT5S",
                    "maximumInterval": "PT20S"
                  },
                  "body": {
                    "driverAppEventId": "@outputs('Track_the_report')?['sourceMessageId']",
                    "tripNumber": "@outputs('Track_the_report')?['tripNumber']",
                    "correlationId": "@outputs('Track_the_report')?['correlationId']",
                    "outcome": "Recorded"
                  }
                },
                "runAfter": {
                  "Close_the_session_after_completing": [
                    "Succeeded",
                    "Failed"
                  ]
                },
                "trackedProperties": {
                  "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
                  "flow": "trip-execution",
                  "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['driverId']",
                  "tripNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['tripNumber']",
                  "shipmentNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['shipmentNumber']",
                  "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']",
                  "outcome": "@if(and(greaterOrEquals(coalesce(actions('Report_recorded')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_recorded')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
                  "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Report_recorded')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_recorded')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Report_recorded')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Report_recorded')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Report_recorded')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Report_recorded')?['outputs']?['statusCode'], 0), 500)), 'DriverAppUnavailable', 'DriverAppRefused'))"
                }
              },
              "Delete_the_files": {
                "type": "Foreach",
                "foreach": "@coalesce(outputs('Track_the_report')?['files'], json('[]'))",
                "actions": {
