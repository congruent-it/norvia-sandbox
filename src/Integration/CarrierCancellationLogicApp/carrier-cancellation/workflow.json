{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_Carrier_booking_is_cancelled_or_withdrawn": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "topicName": "shipment-events",
            "subscriptionName": "carrier-cancellation",
            "isSessionsEnabled": false
          },
          "serviceProviderConfiguration": {
            "connectionName": "serviceBus",
            "operationId": "peekLockTopicMessages",
            "serviceProviderId": "/serviceProviders/serviceBus"
          }
        },
        "correlation": {
          "clientTrackingId": "@{triggerOutputs()?['body']?['userProperties']?['correlationId']}"
        }
      }
    },
    "actions": {
      "Track_the_cancellation": {
        "type": "Compose",
        "inputs": {
          "correlationId": "@json(base64ToString(triggerBody()?['contentData']))?['correlationId']",
          "partyId": "@json(base64ToString(triggerBody()?['contentData']))?['carrierId']",
          "shipmentNumber": "@json(base64ToString(triggerBody()?['contentData']))?['shipmentNumber']",
          "carrierBookingNumber": "@json(base64ToString(triggerBody()?['contentData']))?['carrierBookingNumber']",
          "sourceMessageId": "@json(base64ToString(triggerBody()?['contentData']))?['eventId']"
        },
        "runAfter": {},
        "trackedProperties": {
          "correlationId": "@action()?['inputs']?['correlationId']",
          "flow": "carrier-cancellation",
          "partyId": "@action()?['inputs']?['partyId']",
          "shipmentNumber": "@action()?['inputs']?['shipmentNumber']",
          "carrierBookingNumber": "@action()?['inputs']?['carrierBookingNumber']",
          "sourceMessageId": "@action()?['inputs']?['sourceMessageId']"
        }
      },
      "Map_the_cancellation": {
        "type": "InvokeFunction",
        "inputs": {
          "functionName": "MapCarrierCancellation",
          "parameters": {
            "carrierCancellationEvent": "@{triggerBody()?['contentData']}"
          }
        },
        "runAfter": {
          "Track_the_cancellation": [
            "Succeeded"
          ]
        },
        "trackedProperties": {
          "correlationId": "@outputs('Track_the_cancellation')?['correlationId']",
          "flow": "carrier-cancellation",
          "outcome": "@if(equals(action()?['status'], 'Failed'), 'Failed', null)",
          "failureCode": "@if(equals(action()?['status'], 'Failed'), 'CarrierCancellationUnreadable', null)"
        }
      },
      "Dead_letter_the_unreadable_cancellation": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "topicName": "shipment-events",
            "subscriptionName": "carrier-cancellation",
            "lockToken": "@triggerBody()?['lockToken']",
            "deadLetterReason": "CarrierCancellationUnreadable",
            "deadLetterErrorDescription": "The message isn't a cancellation the Carrier can be told of, so nothing was sent to the Carrier."
          },
          "serviceProviderConfiguration": {
            "connectionName": "serviceBus",
            "operationId": "deadLetterTopicMessage",
            "serviceProviderId": "/serviceProviders/serviceBus"
          }
        },
        "runAfter": {
          "Map_the_cancellation": [
            "Failed"
          ]
        },
        "trackedProperties": {
          "correlationId": "@outputs('Track_the_cancellation')?['correlationId']",
          "flow": "carrier-cancellation",
          "partyId": "@outputs('Track_the_cancellation')?['partyId']",
          "carrierBookingNumber": "@outputs('Track_the_cancellation')?['carrierBookingNumber']",
          "shipmentNumber": "@outputs('Track_the_cancellation')?['shipmentNumber']",
          "sourceMessageId": "@outputs('Track_the_cancellation')?['sourceMessageId']",
          "outcome": "DeadLettered",
          "failureCode": "CarrierCancellationUnreadable"
        }
      },
      "Fail_the_run_on_the_unreadable_cancellation": {
        "type": "Terminate",
        "inputs": {
          "runStatus": "Failed",
          "runError": {
            "code": "CarrierCancellationUnreadable",
            "message": "The message isn't a cancellation the Carrier can be told of, so it was dead-lettered."
          }
        },
        "runAfter": {
          "Dead_letter_the_unreadable_cancellation": [
            "Succeeded",
            "Failed"
          ]
        }
      },
      "Complete_the_message": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "topicName": "shipment-events",
            "subscriptionName": "carrier-cancellation",
            "lockToken": "@triggerBody()?['lockToken']"
          },
          "serviceProviderConfiguration": {
            "connectionName": "serviceBus",
            "operationId": "completeTopicMessage",
            "serviceProviderId": "/serviceProviders/serviceBus"
          }
        },
        "runAfter": {
          "Map_the_cancellation": [
            "Succeeded"
          ]
        }
      },
      "Get_the_Carrier_endpoint_credential": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "secretName": "carrier-endpoint-key-@{outputs('Track_the_cancellation')?['partyId']}"
          },
          "serviceProviderConfiguration": {
            "connectionName": "keyVault",
            "operationId": "getSecret",
            "serviceProviderId": "/serviceProviders/keyVault"
          }
        },
        "runAfter": {
          "Complete_the_message": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "secureData": {
            "properties": [
              "outputs"
            ]
          }
        }
      },
      "Send_to_the_Carrier": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('partnerPortalBaseUrl')}/carrier/v1/@{outputs('Track_the_cancellation')?['partyId']}/cancellations",
          "headers": {
            "Content-Type": "application/json",
            "X-Correlation-ID": "@{outputs('Track_the_cancellation')?['correlationId']}",
            "X-Api-Key": "@{body('Get_the_Carrier_endpoint_credential')?['value']}"
          },
          "body": "@json(body('Map_the_cancellation'))",
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT5S",
            "minimumInterval": "PT5S",
            "maximumInterval": "PT20S"
          }
        },
        "runAfter": {
          "Get_the_Carrier_endpoint_credential": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "secureData": {
            "properties": [
              "inputs"
            ]
          }
        },
        "trackedProperties": {
          "correlationId": "@outputs('Track_the_cancellation')?['correlationId']",
          "flow": "carrier-cancellation",
          "partyId": "@outputs('Track_the_cancellation')?['partyId']",
          "shipmentNumber": "@outputs('Track_the_cancellation')?['shipmentNumber']",
          "outcome": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
          "failureCode": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(action()?['outputs']?['statusCode'], 0), 0), equals(coalesce(action()?['outputs']?['statusCode'], 0), 408), equals(coalesce(action()?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 500)), 'CarrierUnavailable', 'CarrierRefused'))",
          "carrierBookingNumber": "@outputs('Track_the_cancellation')?['carrierBookingNumber']"
        }
      },
      "Report_the_outcome_to_the_TMS": {
        "type": "If",
        "expression": {
          "and": [
            {
              "greaterOrEquals": [
                "@coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0)",
                200
              ]
            },
            {
              "less": [
                "@coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0)",
                300
              ]
            }
          ]
        },
        "actions": {
          "Report_the_cancellation_told": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@{parameters('tmsBaseUrl')}/v1/carrier-bookings/@{outputs('Track_the_cancellation')?['carrierBookingNumber']}/report-cancellation-told",
              "headers": {
                "Content-Type": "application/json",
                "X-Correlation-ID": "@{outputs('Track_the_cancellation')?['correlationId']}"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "@parameters('carrierCancellationIdentityId')",
                "audience": "@parameters('tmsAudience')"
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT5S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT20S"
              }
            },
            "runAfter": {},
            "trackedProperties": {
              "correlationId": "@outputs('Track_the_cancellation')?['correlationId']",
              "flow": "carrier-cancellation",
              "partyId": "@outputs('Track_the_cancellation')?['partyId']",
              "shipmentNumber": "@outputs('Track_the_cancellation')?['shipmentNumber']",
              "outcome": "@if(and(greaterOrEquals(coalesce(actions('Report_the_cancellation_told')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_the_cancellation_told')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
              "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Report_the_cancellation_told')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_the_cancellation_told')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Report_the_cancellation_told')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Report_the_cancellation_told')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Report_the_cancellation_told')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Report_the_cancellation_told')?['outputs']?['statusCode'], 0), 500)), 'TmsUnavailable', 'TmsCallRefused'))",
              "carrierBookingNumber": "@outputs('Track_the_cancellation')?['carrierBookingNumber']"
            }
          }
        },
        "else": {
          "actions": {
            "Take_the_Carriers_answer": {
              "type": "Compose",
              "inputs": "@string(coalesce(actions('Send_to_the_Carrier')?['outputs']?['body'], actions('Send_to_the_Carrier')?['error']?['message'], 'The Carrier endpoint did not answer.'))",
              "runAfter": {}
            },
            "Report_the_cancellation_not_delivered": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@{parameters('tmsBaseUrl')}/v1/carrier-bookings/@{outputs('Track_the_cancellation')?['carrierBookingNumber']}/report-cancellation-not-delivered",
                "headers": {
                  "Content-Type": "application/json",
                  "X-Correlation-ID": "@{outputs('Track_the_cancellation')?['correlationId']}"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "identity": "@parameters('carrierCancellationIdentityId')",
                  "audience": "@parameters('tmsAudience')"
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT5S",
                  "minimumInterval": "PT5S",
                  "maximumInterval": "PT20S"
                },
                "body": {
                  "statusCode": "@coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0)",
                  "message": "@substring(outputs('Take_the_Carriers_answer'), 0, min(500, length(outputs('Take_the_Carriers_answer'))))"
                }
              },
              "runAfter": {
                "Take_the_Carriers_answer": [
                  "Succeeded"
                ]
              },
              "trackedProperties": {
                "correlationId": "@outputs('Track_the_cancellation')?['correlationId']",
                "flow": "carrier-cancellation",
                "partyId": "@outputs('Track_the_cancellation')?['partyId']",
                "shipmentNumber": "@outputs('Track_the_cancellation')?['shipmentNumber']",
                "outcome": "@if(and(greaterOrEquals(coalesce(actions('Report_the_cancellation_not_delivered')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_the_cancellation_not_delivered')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
                "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Report_the_cancellation_not_delivered')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_the_cancellation_not_delivered')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Report_the_cancellation_not_delivered')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Report_the_cancellation_not_delivered')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Report_the_cancellation_not_delivered')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Report_the_cancellation_not_delivered')?['outputs']?['statusCode'], 0), 500)), 'TmsUnavailable', 'TmsCallRefused'))",
                "carrierBookingNumber": "@outputs('Track_the_cancellation')?['carrierBookingNumber']"
              }
            }
          }
        },
        "runAfter": {
          "Send_to_the_Carrier": [
            "Succeeded",
            "Failed",
            "TimedOut"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
