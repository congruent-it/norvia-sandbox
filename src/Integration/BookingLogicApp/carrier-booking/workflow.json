{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_Shipment_is_released": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "topicName": "shipment-events",
            "subscriptionName": "carrier-booking",
            "isSessionsEnabled": false
          },
          "serviceProviderConfiguration": {
            "connectionName": "serviceBus",
            "operationId": "receiveTopicMessages",
            "serviceProviderId": "/serviceProviders/serviceBus"
          }
        },
        "correlation": {
          "clientTrackingId": "@{triggerOutputs()?['body']?['correlationId']}"
        }
      }
    },
    "actions": {
      "Track_the_booking": {
        "type": "Compose",
        "inputs": {
          "correlationId": "@json(base64ToString(triggerBody()?['contentData']))?['correlationId']",
          "partyId": "@json(base64ToString(triggerBody()?['contentData']))?['carrierId']",
          "shipmentNumber": "@json(base64ToString(triggerBody()?['contentData']))?['shipmentNumber']",
          "carrierBookingNumber": "@json(base64ToString(triggerBody()?['contentData']))?['carrierBookingNumber']",
          "sourceMessageId": "@json(base64ToString(triggerBody()?['contentData']))?['eventId']"
        },
        "runAfter": {},
        "trackedProperties": {
          "correlationId": "@action()?['inputs']?['correlationId']",
          "flow": "carrier-booking",
          "partyId": "@action()?['inputs']?['partyId']",
          "shipmentNumber": "@action()?['inputs']?['shipmentNumber']",
          "carrierBookingNumber": "@action()?['inputs']?['carrierBookingNumber']",
          "sourceMessageId": "@action()?['inputs']?['sourceMessageId']"
        }
      },
      "Map_the_release": {
        "type": "InvokeFunction",
        "inputs": {
          "functionName": "MapShipmentReleased",
          "parameters": {
            "shipmentReleased": "@{triggerBody()?['contentData']}"
          }
        },
        "runAfter": {
          "Track_the_booking": [
            "Succeeded"
          ]
        },
        "trackedProperties": {
          "correlationId": "@outputs('Track_the_booking')?['correlationId']",
          "flow": "carrier-booking",
          "outcome": "@if(equals(action()?['status'], 'Failed'), 'Failed', null)",
          "failureCode": "@if(equals(action()?['status'], 'Failed'), 'ShipmentReleasedUnreadable', null)"
        }
      },
      "Get_the_Carrier_endpoint_credential": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "secretName": "carrier-endpoint-key-@{outputs('Track_the_booking')?['partyId']}"
          },
          "serviceProviderConfiguration": {
            "connectionName": "keyVault",
            "operationId": "getSecret",
            "serviceProviderId": "/serviceProviders/keyVault"
          }
        },
        "runAfter": {
          "Map_the_release": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "secureData": {
            "properties": [
              "outputs"
            ]
          }
        }
      },
      "Send_to_the_Carrier": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('partnerPortalBaseUrl')}/carrier/v1/@{outputs('Track_the_booking')?['partyId']}/bookings",
          "headers": {
            "Content-Type": "application/json",
            "X-Correlation-ID": "@{outputs('Track_the_booking')?['correlationId']}",
            "X-Api-Key": "@{body('Get_the_Carrier_endpoint_credential')?['value']}"
          },
          "body": "@json(body('Map_the_release'))",
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT5S",
            "minimumInterval": "PT5S",
            "maximumInterval": "PT20S"
          }
        },
        "runAfter": {
          "Get_the_Carrier_endpoint_credential": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "secureData": {
            "properties": [
              "inputs"
            ]
          }
        },
        "trackedProperties": {
          "correlationId": "@outputs('Track_the_booking')?['correlationId']",
          "flow": "carrier-booking",
          "partyId": "@outputs('Track_the_booking')?['partyId']",
          "shipmentNumber": "@outputs('Track_the_booking')?['shipmentNumber']",
          "carrierBookingNumber": "@outputs('Track_the_booking')?['carrierBookingNumber']",
          "outcome": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
          "failureCode": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(action()?['outputs']?['statusCode'], 0), 0), equals(coalesce(action()?['outputs']?['statusCode'], 0), 408), equals(coalesce(action()?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 500)), 'CarrierUnavailable', 'CarrierRefused'))"
        }
      },
      "Report_the_outcome_to_the_TMS": {
        "type": "If",
        "expression": {
          "and": [
            {
              "greaterOrEquals": [
                "@coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0)",
                200
              ]
            },
            {
              "less": [
                "@coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0)",
                300
              ]
            }
          ]
        },
        "actions": {
          "Report_the_booking_sent": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@{parameters('tmsBaseUrl')}/v1/carrier-bookings/@{outputs('Track_the_booking')?['carrierBookingNumber']}/report-sent",
              "headers": {
                "Content-Type": "application/json",
                "X-Correlation-ID": "@{outputs('Track_the_booking')?['correlationId']}"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "@parameters('bookingIdentityId')",
                "audience": "@parameters('tmsAudience')"
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT5S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT20S"
              }
            },
            "runAfter": {},
            "trackedProperties": {
              "correlationId": "@outputs('Track_the_booking')?['correlationId']",
              "flow": "carrier-booking",
              "partyId": "@outputs('Track_the_booking')?['partyId']",
              "shipmentNumber": "@outputs('Track_the_booking')?['shipmentNumber']",
              "carrierBookingNumber": "@outputs('Track_the_booking')?['carrierBookingNumber']",
              "outcome": "@if(and(greaterOrEquals(coalesce(actions('Report_the_booking_sent')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_the_booking_sent')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
              "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Report_the_booking_sent')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_the_booking_sent')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Report_the_booking_sent')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Report_the_booking_sent')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Report_the_booking_sent')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Report_the_booking_sent')?['outputs']?['statusCode'], 0), 500)), 'TmsUnavailable', 'TmsCallRefused'))"
            }
          }
        },
        "else": {
          "actions": {
            "Take_the_Carriers_answer": {
              "type": "Compose",
              "inputs": "@string(coalesce(actions('Send_to_the_Carrier')?['outputs']?['body'], actions('Send_to_the_Carrier')?['error']?['message'], 'The Carrier endpoint did not answer.'))",
              "runAfter": {}
            },
            "Report_the_booking_not_delivered": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@{parameters('tmsBaseUrl')}/v1/carrier-bookings/@{outputs('Track_the_booking')?['carrierBookingNumber']}/report-not-delivered",
                "headers": {
                  "Content-Type": "application/json",
                  "X-Correlation-ID": "@{outputs('Track_the_booking')?['correlationId']}"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "identity": "@parameters('bookingIdentityId')",
                  "audience": "@parameters('tmsAudience')"
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT5S",
                  "minimumInterval": "PT5S",
                  "maximumInterval": "PT20S"
                },
                "body": {
                  "statusCode": "@coalesce(actions('Send_to_the_Carrier')?['outputs']?['statusCode'], 0)",
                  "message": "@substring(outputs('Take_the_Carriers_answer'), 0, min(500, length(outputs('Take_the_Carriers_answer'))))"
                }
              },
              "runAfter": {
                "Take_the_Carriers_answer": [
                  "Succeeded"
                ]
              },
              "trackedProperties": {
                "correlationId": "@outputs('Track_the_booking')?['correlationId']",
                "flow": "carrier-booking",
                "partyId": "@outputs('Track_the_booking')?['partyId']",
                "shipmentNumber": "@outputs('Track_the_booking')?['shipmentNumber']",
                "carrierBookingNumber": "@outputs('Track_the_booking')?['carrierBookingNumber']",
                "outcome": "@if(and(greaterOrEquals(coalesce(actions('Report_the_booking_not_delivered')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_the_booking_not_delivered')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
                "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Report_the_booking_not_delivered')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Report_the_booking_not_delivered')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Report_the_booking_not_delivered')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Report_the_booking_not_delivered')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Report_the_booking_not_delivered')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Report_the_booking_not_delivered')?['outputs']?['statusCode'], 0), 500)), 'TmsUnavailable', 'TmsCallRefused'))"
              }
            }
          }
        },
        "runAfter": {
          "Send_to_the_Carrier": [
            "Succeeded",
            "Failed",
            "TimedOut"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
