{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_Shipper_books": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST"
        },
        "correlation": {
          "clientTrackingId": "@{triggerOutputs()?['headers']?['X-Correlation-ID']}"
        },
        "trackedProperties": {
          "correlationId": "@trigger()?['outputs']?['headers']?['X-Correlation-ID']",
          "flow": "transport-order-intake",
          "partyId": "@trigger()?['outputs']?['headers']?['X-Shipper-ID']"
        }
      }
    },
    "actions": {
      "Map_the_booking": {
        "type": "InvokeFunction",
        "inputs": {
          "functionName": "MapPartnerBooking",
          "parameters": {
            "partnerBooking": "@{triggerBody()}",
            "shipperId": "@{triggerOutputs()?['headers']?['X-Shipper-ID']}"
          }
        },
        "runAfter": {}
      },
      "Submit_to_the_TMS": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{parameters('tmsBaseUrl')}/v1/transport-orders",
          "headers": {
            "Content-Type": "application/json",
            "X-Correlation-ID": "@{triggerOutputs()?['headers']?['X-Correlation-ID']}"
          },
          "body": "@json(body('Map_the_booking'))",
          "authentication": {
            "type": "ManagedServiceIdentity",
            "identity": "@parameters('intakeIdentityId')",
            "audience": "@parameters('tmsAudience')"
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT5S",
            "minimumInterval": "PT5S",
            "maximumInterval": "PT20S"
          }
        },
        "runAfter": {
          "Map_the_booking": [
            "Succeeded"
          ]
        },
        "trackedProperties": {
          "correlationId": "@action()?['inputs']?['headers']?['X-Correlation-ID']",
          "flow": "transport-order-intake",
          "partyId": "@action()?['inputs']?['body']?['shipperId']",
          "transportOrderNumber": "@action()?['outputs']?['body']?['transportOrderNumber']",
          "outcome": "@if(contains(createArray(200, 201), action()?['outputs']?['statusCode']), 'Succeeded', if(equals(action()?['outputs']?['statusCode'], 422), 'Refused', 'Failed'))",
          "failureCode": "@if(contains(createArray(200, 201), action()?['outputs']?['statusCode']), null, if(equals(action()?['outputs']?['statusCode'], 422), 'TransportOrderRejected', if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 400), less(coalesce(action()?['outputs']?['statusCode'], 0), 500), not(contains(createArray(408, 429), action()?['outputs']?['statusCode']))), 'TmsCallRefused', 'TmsUnavailable')))"
        }
      },
      "Relay_the_TMS_outcome": {
        "type": "InvokeFunction",
        "inputs": {
          "functionName": "RelayTmsOutcome",
          "parameters": {
            "tmsStatusCode": "@coalesce(actions('Submit_to_the_TMS')?['outputs']?['statusCode'], 0)",
            "tmsResponse": "@{coalesce(actions('Submit_to_the_TMS')?['outputs']?['body'], '')}",
            "correlationId": "@{triggerOutputs()?['headers']?['X-Correlation-ID']}",
            "partnerBooking": "@{triggerBody()}"
          }
        },
        "runAfter": {
          "Submit_to_the_TMS": [
            "Succeeded",
            "Failed",
            "TimedOut",
            "Skipped"
          ]
        }
      },
      "Answer_the_Shipper": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": "@json(body('Relay_the_TMS_outcome'))?['statusCode']",
          "headers": {
            "Content-Type": "application/json",
            "X-Correlation-ID": "@{triggerOutputs()?['headers']?['X-Correlation-ID']}"
          },
          "body": "@json(body('Relay_the_TMS_outcome'))?['body']"
        },
        "runAfter": {
          "Relay_the_TMS_outcome": [
            "Succeeded"
          ]
        }
      },
      "End_the_run": {
        "type": "If",
        "expression": {
          "and": [
            {
              "equals": [
                "@json(body('Relay_the_TMS_outcome'))?['body']?['result']",
                "NOT_RECEIVED"
              ]
            }
          ]
        },
        "actions": {
          "Fail_the_run_the_booking_was_not_received": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "@{json(body('Relay_the_TMS_outcome'))?['failureCode']}",
                "message": "The booking was not received: the TMS didn't take it in, so the Shipper was told to send it again."
              }
            }
          }
        },
        "else": {
          "actions": {
            "End_the_run_the_Shipper_has_the_TMS_outcome": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              }
            }
          }
        },
        "runAfter": {
          "Answer_the_Shipper": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
