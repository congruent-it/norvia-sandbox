{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_Carrier_cost_is_incurred": {
        "type": "ApiConnection",
        "inputs": {
          "host": {
            "connection": {
              "referenceName": "servicebus"
            }
          },
          "method": "get",
          "path": "/@{encodeURIComponent(encodeURIComponent('shipment-events'))}/subscriptions/@{encodeURIComponent('carrier-cost')}/messages/head/peek",
          "queries": {
            "subscriptionType": "Main",
            "sessionId": "None"
          }
        },
        "recurrence": {
          "frequency": "Minute",
          "interval": 1
        },
        "correlation": {
          "clientTrackingId": "@{coalesce(if(equals(length(string(coalesce(triggerBody(), ''))), 0), json('{}'), triggerBody())?['Properties']?['correlationId'], '00000000-0000-0000-0000-000000000000')}"
        }
      }
    },
    "actions": {
      "Track_the_carrier_cost": {
        "type": "Compose",
        "inputs": {
          "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
          "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['carrierId']",
          "transportOrderNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['transportOrderNumber']",
          "carrierBookingNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['carrierBookingNumber']",
          "shipmentNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['shipmentNumber']",
          "eventType": "@json(base64ToString(triggerBody()?['ContentData']))?['eventType']",
          "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']"
        },
        "runAfter": {},
        "trackedProperties": {
          "correlationId": "@action()?['inputs']?['correlationId']",
          "flow": "carrier-costs",
          "partyId": "@action()?['inputs']?['partyId']",
          "transportOrderNumber": "@action()?['inputs']?['transportOrderNumber']",
          "carrierBookingNumber": "@action()?['inputs']?['carrierBookingNumber']",
          "shipmentNumber": "@action()?['inputs']?['shipmentNumber']",
          "sourceMessageId": "@action()?['inputs']?['sourceMessageId']"
        }
      },
      "Check_the_carrier_cost": {
        "type": "If",
        "expression": {
          "equals": [
            "@and(equals(actions('Track_the_carrier_cost')?['status'], 'Succeeded'), equals(actions('Track_the_carrier_cost')?['outputs']?['eventType'], 'CarrierCostIncurred'), not(empty(actions('Track_the_carrier_cost')?['outputs']?['correlationId'])), not(empty(actions('Track_the_carrier_cost')?['outputs']?['carrierBookingNumber'])), not(empty(actions('Track_the_carrier_cost')?['outputs']?['partyId'])))",
            true
          ]
        },
        "actions": {
          "Record_the_carrier_cost": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@{parameters('erpBaseUrl')}/v1/carrier-costs",
              "headers": {
                "Content-Type": "application/json",
                "X-Correlation-ID": "@{outputs('Track_the_carrier_cost')?['correlationId']}"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "@parameters('carrierCostIdentityId')",
                "audience": "@parameters('erpAudience')"
              },
              "body": "@json(base64ToString(triggerBody()?['ContentData']))",
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT5S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT20S"
              }
            },
            "runAfter": {},
            "trackedProperties": {
              "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
              "flow": "carrier-costs",
              "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['carrierId']",
              "transportOrderNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['transportOrderNumber']",
              "carrierBookingNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['carrierBookingNumber']",
              "shipmentNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['shipmentNumber']",
              "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']",
              "outcome": "@if(and(greaterOrEquals(coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
              "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0), 500)), 'ErpUnavailable', coalesce(actions('Record_the_carrier_cost')?['outputs']?['body']?['code'], 'ErpCallRefused')))"
            }
          },
          "Settle_the_message": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "greaterOrEquals": [
                    "@coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0)",
                    200
                  ]
                },
                {
                  "less": [
                    "@coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0)",
                    300
                  ]
                }
              ]
            },
            "actions": {
              "Complete_the_message": {
                "type": "ApiConnection",
                "inputs": {
                  "host": {
                    "connection": {
                      "referenceName": "servicebus"
                    }
                  },
                  "method": "delete",
                  "path": "/@{encodeURIComponent(encodeURIComponent('shipment-events'))}/subscriptions/@{encodeURIComponent('carrier-cost')}/messages/complete",
                  "queries": {
                    "lockToken": "@triggerBody()?['LockToken']",
                    "subscriptionType": "Main",
                    "sessionId": ""
                  }
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {
                "Dead_letter_the_refused_carrier_cost": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "referenceName": "servicebus"
                      }
                    },
                    "method": "post",
                    "path": "/@{encodeURIComponent(encodeURIComponent('shipment-events'))}/subscriptions/@{encodeURIComponent('carrier-cost')}/messages/deadletter",
                    "queries": {
                      "lockToken": "@triggerBody()?['LockToken']",
                      "sessionId": "",
                      "deadLetterReason": "@if(or(equals(coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0), 500)), 'ErpUnavailable', coalesce(actions('Record_the_carrier_cost')?['outputs']?['body']?['code'], 'ErpCallRefused'))",
                      "deadLetterErrorDescription": "@coalesce(actions('Record_the_carrier_cost')?['outputs']?['body']?['detail'], actions('Record_the_carrier_cost')?['outputs']?['body']?['title'], if(or(equals(coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Record_the_carrier_cost')?['outputs']?['statusCode'], 0), 500)), 'The ERP billing API did not answer after the retries.', 'The ERP billing API refused the Carrier cost.'))"
                    }
                  },
                  "runAfter": {},
                  "trackedProperties": {
                    "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
                    "flow": "carrier-costs",
                    "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['carrierId']",
                    "transportOrderNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['transportOrderNumber']",
                    "carrierBookingNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['carrierBookingNumber']",
                    "shipmentNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['shipmentNumber']",
                    "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']",
                    "outcome": "DeadLettered",
                    "messageId": "@triggerBody()?['MessageId']",
                    "failureCode": "@action()?['inputs']?['parameters']?['deadLetterReason']"
                  }
                },
                "Fail_the_run_on_the_refused_carrier_cost": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "CarrierCostNotRecorded",
                      "message": "The ERP didn't record the Carrier cost, so the message was dead-lettered."
                    }
                  },
                  "runAfter": {
                    "Dead_letter_the_refused_carrier_cost": [
                      "Succeeded",
                      "Failed"
                    ]
                  }
                }
              }
            },
            "runAfter": {
              "Record_the_carrier_cost": [
                "Succeeded",
                "Failed",
                "TimedOut"
              ]
            }
          }
        },
        "else": {
          "actions": {
            "Dead_letter_the_unreadable_carrier_cost": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "referenceName": "servicebus"
                  }
                },
                "method": "post",
                "path": "/@{encodeURIComponent(encodeURIComponent('shipment-events'))}/subscriptions/@{encodeURIComponent('carrier-cost')}/messages/deadletter",
                "queries": {
                  "lockToken": "@triggerBody()?['LockToken']",
                  "sessionId": "",
                  "deadLetterReason": "CarrierCostUnreadable",
                  "deadLetterErrorDescription": "The message isn't a CarrierCostIncurred the ERP can record, so nothing was sent to the ERP."
                }
              },
              "runAfter": {},
              "trackedProperties": {
                "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
                "flow": "carrier-costs",
                "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['carrierId']",
                "transportOrderNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['transportOrderNumber']",
                "carrierBookingNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['carrierBookingNumber']",
                "shipmentNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['shipmentNumber']",
                "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']",
                "outcome": "DeadLettered",
                "messageId": "@triggerBody()?['MessageId']",
                "failureCode": "CarrierCostUnreadable"
              }
            },
            "Fail_the_run_on_the_unreadable_carrier_cost": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "CarrierCostUnreadable",
                  "message": "The message isn't a CarrierCostIncurred the ERP can record, so it was dead-lettered."
                }
              },
              "runAfter": {
                "Dead_letter_the_unreadable_carrier_cost": [
                  "Succeeded",
                  "Failed"
                ]
              }
            }
          }
        },
        "runAfter": {
          "Track_the_carrier_cost": [
            "Succeeded",
            "Failed"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
