{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_Trip_is_dispatched": {
        "type": "ApiConnection",
        "description": "Peeks the next TripDispatched message with a lock, which the workflow completes or dead-letters itself.",
        "inputs": {
          "host": {
            "connection": {
              "referenceName": "servicebus"
            }
          },
          "method": "get",
          "path": "/@{encodeURIComponent(encodeURIComponent('trip-events'))}/subscriptions/@{encodeURIComponent('trip-dispatch')}/messages/head/peek",
          "queries": {
            "subscriptionType": "Main",
            "sessionId": "None"
          }
        },
        "recurrence": {
          "frequency": "Minute",
          "interval": 1
        },
        "correlation": {
          "clientTrackingId": "@{coalesce(if(equals(length(string(coalesce(triggerBody(), ''))), 0), json('{}'), triggerBody())?['Properties']?['correlationId'], '00000000-0000-0000-0000-000000000000')}"
        }
      }
    },
    "actions": {
      "Track_the_trip": {
        "type": "Compose",
        "inputs": {
          "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
          "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['driver']?['driverId']",
          "tripNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['tripNumber']",
          "version": "@json(base64ToString(triggerBody()?['ContentData']))?['version']",
          "eventType": "@json(base64ToString(triggerBody()?['ContentData']))?['eventType']",
          "sourceMessageId": "@json(base64ToString(triggerBody()?['ContentData']))?['eventId']"
        },
        "runAfter": {},
        "trackedProperties": {
          "correlationId": "@action()?['inputs']?['correlationId']",
          "flow": "trip-dispatch",
          "partyId": "@action()?['inputs']?['partyId']",
          "tripNumber": "@action()?['inputs']?['tripNumber']",
          "sourceMessageId": "@action()?['inputs']?['sourceMessageId']"
        }
      },
      "Check_the_Trip_version": {
        "type": "If",
        "expression": {
          "equals": [
            "@and(equals(actions('Track_the_trip')?['status'], 'Succeeded'), equals(actions('Track_the_trip')?['outputs']?['eventType'], 'TripDispatched'), not(empty(actions('Track_the_trip')?['outputs']?['correlationId'])), not(empty(actions('Track_the_trip')?['outputs']?['tripNumber'])), not(empty(actions('Track_the_trip')?['outputs']?['partyId'])), greater(int(coalesce(actions('Track_the_trip')?['outputs']?['version'], 0)), 0))",
            true
          ]
        },
        "actions": {
          "Complete_the_message": {
            "type": "ApiConnection",
            "inputs": {
              "host": {
                "connection": {
                  "referenceName": "servicebus"
                }
              },
              "method": "delete",
              "path": "/@{encodeURIComponent(encodeURIComponent('trip-events'))}/subscriptions/@{encodeURIComponent('trip-dispatch')}/messages/complete",
              "queries": {
                "lockToken": "@triggerBody()?['LockToken']",
                "subscriptionType": "Main",
                "sessionId": ""
              }
            },
            "runAfter": {}
          },
          "Get_the_Driver_app_endpoint_credential": {
            "type": "ServiceProvider",
            "inputs": {
              "parameters": {
                "secretName": "driver-app-endpoint-key"
              },
              "serviceProviderConfiguration": {
                "connectionName": "keyVault",
                "operationId": "getSecret",
                "serviceProviderId": "/serviceProviders/keyVault"
              }
            },
            "runAfter": {
              "Complete_the_message": [
                "Succeeded"
              ]
            },
            "runtimeConfiguration": {
              "secureData": {
                "properties": [
                  "outputs"
                ]
              }
            }
          },
          "Send_to_the_Driver_app": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@{parameters('driverAppBaseUrl')}/v1/trips",
              "headers": {
                "Content-Type": "application/json",
                "X-Correlation-ID": "@{outputs('Track_the_trip')?['correlationId']}",
                "X-Api-Key": "@{body('Get_the_Driver_app_endpoint_credential')?['value']}"
              },
              "body": "@json(base64ToString(triggerBody()?['ContentData']))",
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT5S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT20S"
              }
            },
            "runAfter": {
              "Get_the_Driver_app_endpoint_credential": [
                "Succeeded"
              ]
            },
            "runtimeConfiguration": {
              "secureData": {
                "properties": [
                  "inputs"
                ]
              }
            },
            "trackedProperties": {
              "flow": "trip-dispatch"
            }
          },
          "Read_the_answer": {
            "type": "Compose",
            "inputs": {
              "outcome": "@if(and(greaterOrEquals(coalesce(actions('Send_to_the_Driver_app')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Send_to_the_Driver_app')?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
              "failureCode": "@if(and(greaterOrEquals(coalesce(actions('Send_to_the_Driver_app')?['outputs']?['statusCode'], 0), 200), less(coalesce(actions('Send_to_the_Driver_app')?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(actions('Send_to_the_Driver_app')?['outputs']?['statusCode'], 0), 0), equals(coalesce(actions('Send_to_the_Driver_app')?['outputs']?['statusCode'], 0), 408), equals(coalesce(actions('Send_to_the_Driver_app')?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(actions('Send_to_the_Driver_app')?['outputs']?['statusCode'], 0), 500)), 'DriverAppUnavailable', 'DriverAppRefused'))",
              "statusCode": "@coalesce(actions('Send_to_the_Driver_app')?['outputs']?['statusCode'], 0)",
              "retryHistory": "@coalesce(actions('Send_to_the_Driver_app')?['retryHistory'], json('[]'))"
            },
            "runAfter": {
              "Send_to_the_Driver_app": [
                "Succeeded",
                "Failed",
                "TimedOut"
              ]
            }
          },
          "Track_the_answer": {
            "type": "Compose",
            "inputs": {
              "correlationId": "@json(base64ToString(triggerBody()?['ContentData']))?['correlationId']",
              "partyId": "@json(base64ToString(triggerBody()?['ContentData']))?['driver']?['driverId']",
              "tripNumber": "@json(base64ToString(triggerBody()?['ContentData']))?['tripNumber']",
              "outcome": "@outputs('Read_the_answer')?['outcome']",
              "failureCode": "@outputs('Read_the_answer')?['failureCode']"
            },
            "runAfter": {
              "Read_the_answer": [
                "Succeeded"
              ]
            },
            "trackedProperties": {
              "correlationId": "@action()?['inputs']?['correlationId']",
              "flow": "trip-dispatch",
              "partyId": "@action()?['inputs']?['partyId']",
              "tripNumber": "@action()?['inputs']?['tripNumber']",
              "outcome": "@action()?['inputs']?['outcome']",
              "failureCode": "@action()?['inputs']?['failureCode']"
            }
          },
          "Report_the_outcome_to_the_TMS": {
            "type": "If",
            "expression": {
              "and": [
                {
                  "greaterOrEquals": [
                    "@coalesce(actions('Send_to_the_Driver_app')?['outputs']?['statusCode'], 0)",
                    200
                  ]
                },
                {
                  "less": [
                    "@coalesce(actions('Send_to_the_Driver_app')?['outputs']?['statusCode'], 0)",
                    300
                  ]
                }
              ]
            },
            "actions": {
              "Report_the_version_delivered": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@{parameters('tmsBaseUrl')}/v1/trips/@{outputs('Track_the_trip')?['tripNumber']}/versions/@{outputs('Track_the_trip')?['version']}/report-delivered",
                  "headers": {
                    "Content-Type": "application/json",
                    "X-Correlation-ID": "@{outputs('Track_the_trip')?['correlationId']}"
                  },
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "identity": "@parameters('tripDispatchIdentityId')",
                    "audience": "@parameters('tmsAudience')"
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT5S",
                    "minimumInterval": "PT5S",
                    "maximumInterval": "PT20S"
                  }
                },
                "runAfter": {},
                "trackedProperties": {
                  "correlationId": "@action()?['inputs']?['headers']?['X-Correlation-ID']",
                  "flow": "trip-dispatch",
                  "outcome": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
                  "failureCode": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(action()?['outputs']?['statusCode'], 0), 0), equals(coalesce(action()?['outputs']?['statusCode'], 0), 408), equals(coalesce(action()?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 500)), 'TmsUnavailable', 'TmsCallRefused'))"
                }
              }
            },
            "else": {
              "actions": {
                "Take_the_Driver_apps_answer": {
                  "type": "Compose",
                  "inputs": "@string(coalesce(actions('Send_to_the_Driver_app')?['outputs']?['body'], actions('Send_to_the_Driver_app')?['error']?['message'], 'The Driver app did not answer.'))",
                  "runAfter": {}
                },
                "Report_the_version_not_delivered": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{parameters('tmsBaseUrl')}/v1/trips/@{outputs('Track_the_trip')?['tripNumber']}/versions/@{outputs('Track_the_trip')?['version']}/report-not-delivered",
                    "headers": {
                      "Content-Type": "application/json",
                      "X-Correlation-ID": "@{outputs('Track_the_trip')?['correlationId']}"
                    },
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "identity": "@parameters('tripDispatchIdentityId')",
                      "audience": "@parameters('tmsAudience')"
                    },
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 3,
                      "interval": "PT5S",
                      "minimumInterval": "PT5S",
                      "maximumInterval": "PT20S"
                    },
                    "body": {
                      "cause": "@concat('The Driver app ', if(equals(outputs('Read_the_answer')?['statusCode'], 0), 'didn''t answer', concat('answered ', string(outputs('Read_the_answer')?['statusCode']))), ': ', substring(outputs('Take_the_Driver_apps_answer'), 0, min(500, length(outputs('Take_the_Driver_apps_answer')))), ' (', string(add(length(outputs('Read_the_answer')?['retryHistory']), 1)), if(equals(add(length(outputs('Read_the_answer')?['retryHistory']), 1), 1), ' attempt', ' attempts'), ').')"
                    }
                  },
                  "runAfter": {
                    "Take_the_Driver_apps_answer": [
                      "Succeeded"
                    ]
                  },
                  "trackedProperties": {
                    "correlationId": "@action()?['inputs']?['headers']?['X-Correlation-ID']",
                    "flow": "trip-dispatch",
                    "outcome": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), 'Succeeded', 'Failed')",
                    "failureCode": "@if(and(greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 200), less(coalesce(action()?['outputs']?['statusCode'], 0), 300)), null, if(or(equals(coalesce(action()?['outputs']?['statusCode'], 0), 0), equals(coalesce(action()?['outputs']?['statusCode'], 0), 408), equals(coalesce(action()?['outputs']?['statusCode'], 0), 429), greaterOrEquals(coalesce(action()?['outputs']?['statusCode'], 0), 500)), 'TmsUnavailable', 'TmsCallRefused'))"
                  }
                }
              }
            },
            "runAfter": {
              "Track_the_answer": [
                "Succeeded"
              ]
            }
          }
        },
        "else": {
          "actions": {
            "Dead_letter_the_unreadable_trip": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "referenceName": "servicebus"
                  }
                },
                "method": "post",
                "path": "/@{encodeURIComponent(encodeURIComponent('trip-events'))}/subscriptions/@{encodeURIComponent('trip-dispatch')}/messages/deadletter",
                "queries": {
                  "lockToken": "@triggerBody()?['LockToken']",
                  "sessionId": "",
                  "deadLetterReason": "TripDispatchUnreadable",
                  "deadLetterErrorDescription": "The message isn't a Trip version the Driver app can be sent, so nothing was sent to the Driver app."
                }
              },
              "runAfter": {},
              "trackedProperties": {
                "flow": "trip-dispatch",
                "outcome": "DeadLettered",
                "failureCode": "TripDispatchUnreadable"
              }
            },
            "Fail_the_run_on_the_unreadable_trip": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "TripDispatchUnreadable",
                  "message": "The message isn't a Trip version the Driver app can be sent, so it was dead-lettered."
                }
              },
              "runAfter": {
                "Dead_letter_the_unreadable_trip": [
                  "Succeeded",
                  "Failed"
                ]
              }
            }
          }
        },
        "runAfter": {
          "Track_the_trip": [
            "Succeeded",
            "Failed"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
