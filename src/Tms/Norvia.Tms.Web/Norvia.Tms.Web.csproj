<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Mediator.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Norvia.ServiceDefaults\Norvia.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Norvia.Branding\Norvia.Branding.csproj" />
    <ProjectReference Include="..\Norvia.Tms.Application\Norvia.Tms.Application.csproj" />
    <ProjectReference Include="..\Norvia.Tms.Infrastructure\Norvia.Tms.Infrastructure.csproj" />
  </ItemGroup>
  <!-- The TMS reads its Shippers from the seed file, so the published image carries it (Seed:Path in Azure). -->
  <ItemGroup>
    <None Include="..\..\..\seed\norvia.seed.json" Link="seed\norvia.seed.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Norvia.Tms.Web.UnitTests" />
    <!-- The integration tests read the Planner home page's counts through the TMS UI's own adapter. -->
    <InternalsVisibleTo Include="Norvia.Tms.TestSupport" />
    <!-- NSubstitute substitutes the internal token port. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!--
    The stylesheet is built with Tailwind CSS (ADR 0018), which needs Node.js. Tailwind and the Lato font come from npm;
    the build installs them, writes wwwroot/app.css and copies the fonts next to it. Both are build output, not source.
  -->
  <ItemGroup>
    <None Remove="node_modules/**" />
    <Content Remove="node_modules/**;package.json;package-lock.json" />
    <TailwindInput Include="Styles/**/*.css;**/*.razor" Exclude="node_modules/**;bin/**;obj/**" />
    <LatoFont Include="node_modules/@fontsource/lato/files/lato-latin-400-normal.woff2;node_modules/@fontsource/lato/files/lato-latin-700-normal.woff2" />
  </ItemGroup>

  <Target Name="InstallStylesheetTools" Inputs="package.json;package-lock.json" Outputs="node_modules/.install-stamp">
    <Exec Command="npm ci --no-audit --no-fund" />
    <Touch Files="node_modules/.install-stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="BuildStylesheet" DependsOnTargets="InstallStylesheetTools" Inputs="@(TailwindInput)" Outputs="wwwroot/app.css">
    <Exec Command="npm run build:css" />
  </Target>

  <!-- Before the static web assets are collected, so a first build already serves the stylesheet and the fonts. -->
  <Target Name="IncludeStylesheet" BeforeTargets="AssignTargetPaths;ResolveStaticWebAssetsConfiguration" DependsOnTargets="BuildStylesheet">
    <Copy SourceFiles="@(LatoFont)" DestinationFolder="wwwroot/fonts" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Remove="wwwroot/app.css;wwwroot/fonts/*.woff2" />
      <Content Include="wwwroot/app.css;wwwroot/fonts/*.woff2" />
    </ItemGroup>
  </Target>
</Project>
