@using Ardalis.Result
@using Microsoft.Extensions.Options
@using Norvia.Agents
@using Norvia.Tms.Application.Agents
@using Norvia.Tms.Application.Agents.Planner
@using Norvia.Tms.Application.Exceptions.ListOpen
@using Norvia.Tms.Web.Agents
@using Norvia.Tms.Domain.Exceptions
@using Norvia.Tms.Domain.ShipperNotifications
@using Norvia.Tms.Web.TransportOrders
@implements IDisposable
@inject ITransportOrderQueries Queries
@inject ITransportOrderCommands Commands
@inject ILogger<ExceptionActionPanel> Logger
@inject IOptions<AgentsOptions> Agents
@inject IExplainRequests Requests

@* One Planner action on one open Exception, as a form under the list. It asks the TMS API to do it and says what came of it. *@
<section role="group" aria-label="@Title" class="mb-6 rounded-flatly border border-border p-4">
    <h2 class="!mb-3 !text-xl">@Title</h2>

    @if (_failure is { } failure)
    {
        <div role="alert" class="mb-4">
            <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">@failure</FluentMessageBar>
        </div>
    }

    @if (!_ready)
    {
        <FluentStack VerticalAlignment="VerticalAlignment.Center" role="status">
            <FluentProgressRing />
            <span>Loading the message…</span>
        </FluentStack>
    }
    else
    {
        <div class="flex flex-col gap-4">
            @switch (Kind)
            {
                case ExceptionActionKind.NotifyShipper:
                    @* The Planner notification agent can offer an adjusted wording from the template and what the Shipper sees, and nothing else
                       (ADR 0011). The draft only replaces this box: nothing is sent until the Planner sends it, and it names the Agent run only then.
                       Off unless Agents:Enabled, and only in the Planner role view (ADR 0040). *@
                    @if (Agents.Value.Enabled && ForPlanner)
                    {
                        <div>
                            <FluentButton Appearance="Appearance.Outline" Disabled="_drafting || _working" OnClick="DraftNotificationAsync"
                                          aria-label="@($"Draft message for {OpenException.ExceptionNumber}")">Draft message</FluentButton>
                        </div>
                        @if (_drafting)
                        {
                            <FluentStack VerticalAlignment="VerticalAlignment.Center" role="status">
                                <FluentProgressRing />
                                <span>The assistant is drafting…</span>
                            </FluentStack>
                        }
                        else if (_unavailable)
                        {
                            <div role="alert">
                                <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">Assistant unavailable</FluentMessageBar>
                            </div>
                        }
                        else if (_draftRun is not null)
                        {
                            <p class="!mb-0 text-muted">This is a draft written from the template and what the Shipper sees of the order. Edit it, then send the notification yourself: nothing is sent until you do.@(_draftCut ? " The draft was too long for a notification and has been shortened: check how it ends." : string.Empty)</p>
                        }
                    }
                    <FluentTextArea @bind-Value="_text" Immediate="true" Label="Message to the Shipper" Rows="5" Style="width: 100%;" />
                    break;
                case ExceptionActionKind.CancelCarrierBooking:
                    <FluentTextArea @bind-Value="_text" Immediate="true" Label="Reason" Rows="3" Style="width: 100%;" />
                    break;
                case ExceptionActionKind.AddNote:
                    @* The Planner agent can draft the note from the Exception's timeline. The draft only fills this box: nothing is saved until the
                       Planner adds the note, and it names the Agent run only then. Off unless Agents:Enabled, and only in the Planner role view (ADR 0040). *@
                    @if (Agents.Value.Enabled && ForPlanner)
                    {
                        <div>
                            <FluentButton Appearance="Appearance.Outline" Disabled="_drafting || _working" OnClick="DraftAsync"
                                          aria-label="@($"Draft note for {OpenException.ExceptionNumber}")">Draft note</FluentButton>
                        </div>
                        @if (_drafting)
                        {
                            <FluentStack VerticalAlignment="VerticalAlignment.Center" role="status">
                                <FluentProgressRing />
                                <span>The assistant is drafting…</span>
                            </FluentStack>
                        }
                        else if (_unavailable)
                        {
                            <div role="alert">
                                <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">Assistant unavailable</FluentMessageBar>
                            </div>
                        }
                        else if (_draftRun is not null)
                        {
                            <p class="!mb-0 text-muted">This is a draft written from the Exception's timeline. Edit it, then add the note yourself: nothing is saved until you do.</p>
                        }
                    }
                    <FluentTextArea @bind-Value="_text" Immediate="true" Label="Note" Rows="3" Style="width: 100%;" />
                    break;
                case ExceptionActionKind.AgreeDeliveryWindow:
                    <FluentTextField @bind-Value="_earliest" Immediate="true" Label="Earliest" Placeholder="@NorviaTime.InputFormat" />
                    <FluentTextField @bind-Value="_latest" Immediate="true" Label="Latest" Placeholder="@NorviaTime.InputFormat" />
                    <p class="!mb-0 text-muted">Times as Rotterdam reads them, such as 2026-10-08 14:30. The Carrier isn't sent the window: you agreed it with them already.</p>
                    break;
                case ExceptionActionKind.Resolve:
                    <FluentSelect TOption="string" @bind-Value="_outcome" Label="Outcome" Width="100%">
                        <FluentOption TOption="string" Value="">Choose an outcome</FluentOption>
                        @foreach (var outcome in Enum.GetValues<ExceptionOutcome>())
                        {
                            <FluentOption TOption="string" Value="@outcome.ToString()">@ExceptionText.Outcome(outcome)</FluentOption>
                        }
                    </FluentSelect>
                    <FluentTextArea @bind-Value="_text" Immediate="true" Label="Remark" Rows="3" Style="width: 100%;" />
                    break;
            }

            <div class="flex gap-4">
                <FluentButton Appearance="Appearance.Accent" OnClick="SubmitAsync" Disabled="_working">@SubmitText</FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="Close" Disabled="_working">Cancel</FluentButton>
            </div>
        </div>
    }
</section>

@code {
    private readonly CancellationTokenSource _closed = new();
    private string _text = string.Empty;
    private string _earliest = string.Empty;
    private string _latest = string.Empty;
    private string _outcome = string.Empty;
    private string? _failure;
    private bool _ready;
    private bool _working;
    private bool _drafting;
    private bool _unavailable;
    private bool _draftCut;
    private AgentRun? _draftRun;

    [Parameter, EditorRequired]
    public OpenExceptionSummary OpenException { get; set; } = null!;

    [Parameter, EditorRequired]
    public ExceptionActionKind Kind { get; set; }

    /// <summary>Whether the page is the Planner role's view. The Draft note button shows nowhere else.</summary>
    [Parameter]
    public bool ForPlanner { get; set; }

    /// <summary>Raised when the Planner closes the form without acting.</summary>
    [Parameter, EditorRequired]
    public EventCallback OnClosed { get; set; }

    /// <summary>Raised once the TMS did what the Planner asked, with what to tell them.</summary>
    [Parameter, EditorRequired]
    public EventCallback<string> OnDone { get; set; }

    private string Title => Kind switch
    {
        ExceptionActionKind.NotifyShipper => $"Notify Shipper of {OpenException.ExceptionNumber}",
        ExceptionActionKind.CancelCarrierBooking => $"Cancel Carrier booking of {OpenException.ExceptionNumber}",
        ExceptionActionKind.AgreeDeliveryWindow => $"Agree delivery window for {OpenException.ExceptionNumber}",
        ExceptionActionKind.AddNote => $"Add note to {OpenException.ExceptionNumber}",
        ExceptionActionKind.Resolve => $"Resolve {OpenException.ExceptionNumber}",
        _ => throw new InvalidOperationException($"Unknown action {Kind}."),
    };

    private string SubmitText => Kind switch
    {
        ExceptionActionKind.NotifyShipper => "Send notification",
        ExceptionActionKind.CancelCarrierBooking => "Cancel Carrier booking",
        ExceptionActionKind.AgreeDeliveryWindow => "Agree window",
        ExceptionActionKind.AddNote => "Add note",
        ExceptionActionKind.Resolve => "Resolve Exception",
        _ => throw new InvalidOperationException($"Unknown action {Kind}."),
    };

    protected override async Task OnInitializedAsync()
    {
        if (Kind != ExceptionActionKind.NotifyShipper)
        {
            _ready = true;
            return;
        }

        // The message starts from the template for the Exception's type, which the Planner can edit.
        try
        {
            _text = await Queries.FindShipperNotificationTemplateAsync(OpenException.ExceptionNumber, _closed.Token) ?? string.Empty;
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Reading the Shipper notification template of Exception {ExceptionNumber} failed", OpenException.ExceptionNumber);
            _failure = "The message couldn't be prefilled, so write it yourself.";
        }

        _ready = true;
    }

    private async Task SubmitAsync()
    {
        if (_working)
        {
            return;
        }

        if (Invalid() is { } problem)
        {
            _failure = problem;
            return;
        }

        _working = true;
        _failure = null;
        try
        {
            var number = OpenException.ExceptionNumber;
            var answer = await ActAsync(number);
            switch (answer)
            {
                case ExceptionAnswer.Done:
                    await OnDone.InvokeAsync(DoneText);
                    break;
                case ExceptionAnswer.Refused refused:
                    _failure = $"Exception {number} wasn't changed: {refused.Reason}";
                    break;
            }
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            // The page closed while the TMS was answering.
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "{Action} on Exception {ExceptionNumber} failed", Kind, OpenException.ExceptionNumber);
            _failure = $"Exception {OpenException.ExceptionNumber} couldn't be changed. Try again.";
        }
        finally
        {
            _working = false;
        }
    }

    private Task<ExceptionAnswer> ActAsync(string number) => Kind switch
    {
        ExceptionActionKind.NotifyShipper => Commands.NotifyShipperAsync(number, _text.Trim(), _draftRun, _closed.Token),
        ExceptionActionKind.CancelCarrierBooking => Commands.CancelCarrierBookingAsync(number, _text.Trim(), _closed.Token),
        ExceptionActionKind.AgreeDeliveryWindow => AgreeAsync(number),
        ExceptionActionKind.AddNote => Commands.AddNoteAsync(number, _text.Trim(), _draftRun, _closed.Token),
        ExceptionActionKind.Resolve => Commands.ResolveAsync(number, Enum.Parse<ExceptionOutcome>(_outcome), _text.Trim(), _closed.Token),
        _ => throw new InvalidOperationException($"Unknown action {Kind}."),
    };

    private Task<ExceptionAnswer> AgreeAsync(string number)
    {
        NorviaTime.TryParse(_earliest, out var earliest);
        NorviaTime.TryParse(_latest, out var latest);
        return Commands.AgreeDeliveryWindowAsync(number, earliest, latest, _closed.Token);
    }

    // What the TMS would refuse anyway, said before asking.
    private string? Invalid() => Kind switch
    {
        ExceptionActionKind.NotifyShipper when string.IsNullOrWhiteSpace(_text) => "Write the message to the Shipper.",
        ExceptionActionKind.CancelCarrierBooking when string.IsNullOrWhiteSpace(_text) => "Give the reason for cancelling the Carrier booking.",
        ExceptionActionKind.AddNote when string.IsNullOrWhiteSpace(_text) => "Write the note.",
        ExceptionActionKind.Resolve when !Enum.TryParse<ExceptionOutcome>(_outcome, out _) => "Choose the outcome.",
        ExceptionActionKind.Resolve when string.IsNullOrWhiteSpace(_text) => "Give a remark: what you did or concluded.",
        ExceptionActionKind.AgreeDeliveryWindow when !NorviaTime.TryParse(_earliest, out _) || !NorviaTime.TryParse(_latest, out _) =>
            $"Give the earliest and the latest time as {NorviaTime.InputFormat}.",
        ExceptionActionKind.AgreeDeliveryWindow when NorviaTime.TryParse(_earliest, out var earliest) && NorviaTime.TryParse(_latest, out var latest) && earliest > latest =>
            "The earliest time can't be after the latest.",
        _ => null,
    };

    private string DoneText => Kind switch
    {
        ExceptionActionKind.NotifyShipper => $"The Shipper is being notified of {OpenException.ExceptionNumber}.",
        ExceptionActionKind.CancelCarrierBooking => $"The Carrier booking of {OpenException.ExceptionNumber} is cancelled, and Shipment {OpenException.ShipmentNumber} is back in the Shipments to release.",
        ExceptionActionKind.AgreeDeliveryWindow => $"The delivery window for {OpenException.ExceptionNumber} is agreed.",
        ExceptionActionKind.AddNote => $"The note is added to {OpenException.ExceptionNumber}.",
        ExceptionActionKind.Resolve => $"{OpenException.ExceptionNumber} is resolved.",
        _ => throw new InvalidOperationException($"Unknown action {Kind}."),
    };

    // Fills the note box with the assistant's draft. Saving is the Planner's own Add note, which names the run because it came from the draft.
    private async Task DraftAsync()
    {
        _drafting = true;
        _unavailable = false;
        try
        {
            var result = await Requests.DraftNoteAsync(new DraftExceptionNoteQuery(OpenException.ExceptionNumber), _closed.Token);
            if (result.IsSuccess)
            {
                // A note is at most ExceptionNote.MaxTextLength characters, so a longer draft is cut rather than refused when the Planner saves it.
                _text = result.Value.Cause.Length > ExceptionNote.MaxTextLength ? result.Value.Cause[..ExceptionNote.MaxTextLength] : result.Value.Cause;
                _draftRun = result.Value.Run;
            }
            else
            {
                _unavailable = true;
                AgentPageLog.NoteDraftFailed(Logger, OpenException.ExceptionNumber, result.Errors.FirstOrDefault() ?? "AgentUnavailable");
            }
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            _unavailable = true;
            AgentPageLog.NoteDraftCrashed(Logger, exception, OpenException.ExceptionNumber);
        }
        finally
        {
            _drafting = false;
        }
    }

    // Replaces the message with the assistant's draft. Sending is the Planner's own Notify Shipper, which names the run because it came from the draft.
    private async Task DraftNotificationAsync()
    {
        _drafting = true;
        _unavailable = false;
        try
        {
            var result = await Requests.DraftNotificationAsync(new DraftShipperNotificationQuery(OpenException.ExceptionNumber), _closed.Token);
            if (result.IsSuccess)
            {
                // A message is at most ShipperNotification.MaxMessageLength characters, so a longer draft is cut rather than refused when the Planner sends it.
                _draftCut = result.Value.Cause.Length > ShipperNotification.MaxMessageLength;
                _text = _draftCut ? result.Value.Cause[..ShipperNotification.MaxMessageLength] : result.Value.Cause;
                _draftRun = result.Value.Run;
            }
            else
            {
                _unavailable = true;
                AgentPageLog.NotificationDraftFailed(Logger, OpenException.ExceptionNumber, result.Errors.FirstOrDefault() ?? "AgentUnavailable");
            }
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            _unavailable = true;
            AgentPageLog.NotificationDraftCrashed(Logger, exception, OpenException.ExceptionNumber);
        }
        finally
        {
            _drafting = false;
        }
    }

    private Task Close() => OnClosed.InvokeAsync();

    public void Dispose()
    {
        _closed.Cancel();
        _closed.Dispose();
    }
}
