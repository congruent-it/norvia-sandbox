@using Ardalis.Result
@using Microsoft.Extensions.Options
@using Norvia.Agents
@using Norvia.Tms.Application.Agents
@using Norvia.Tms.Application.Agents.Explain
@inject IOptions<AgentsOptions> Agents
@inject IExplainRequests Requests
@inject ILogger<RecommendRelease> Logger
@implements IDisposable

@* One fixed question about one row of the not-yet-billable list: should the order be released without a Proof of delivery? The TMS decides
   eligibility; the assistant weighs the rest. It never writes the remark, and a Release only pre-selects the order for staff. Off unless
   Agents:Enabled, and only in the Customer service role view. An Agent is never on a critical path (ADR 0040). *@
@if (Agents.Value.Enabled && ForCustomerService)
{
    <div data-explain="release">
        <FluentButton Appearance="Appearance.Outline" Disabled="_asking" OnClick="RecommendAsync" aria-label="@($"Recommend for {TransportOrderNumber}")">Recommend</FluentButton>

        @if (_asking)
        {
            <div role="status" class="mt-3">
                <FluentStack VerticalAlignment="VerticalAlignment.Center">
                    <FluentProgressRing />
                    <span>The assistant is reading…</span>
                </FluentStack>
            </div>
        }
        else if (_unavailable)
        {
            <div role="alert" class="mt-3">
                <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">Assistant unavailable</FluentMessageBar>
            </div>
        }
        else if (_suggestion is { } suggestion)
        {
            @* Text only: what the assistant wrote is data, so it is encoded, never rendered as markup. *@
            <div class="mt-3" data-testid="recommendation">
                <h2 class="text-lg">Recommendation: <span data-testid="action-kind">@Kind(suggestion.Action)</span></h2>
                <p>@suggestion.Cause</p>
                <h2 class="text-lg">Evidence</h2>
                <ul>
                    @foreach (var evidence in suggestion.Evidence)
                    {
                        <li>@evidence.Claim <cite class="text-muted">[@evidence.ResultId, @evidence.ToolName]</cite></li>
                    }
                </ul>
                <h2 class="text-lg">What you can do</h2>
                <p>@suggestion.SuggestedAction</p>
                @* Only a Release with a run to name opens the release form, which still asks staff for the remark. Nothing is released here. *@
                @if (suggestion.Action == SuggestedActionKind.Release && suggestion.Run is { } run)
                {
                    <FluentButton Appearance="Appearance.Accent" OnClick="() => OnReview.InvokeAsync(run)"
                                  aria-label="@($"Review release of {TransportOrderNumber}")">Review release</FluentButton>
                }
                <p class="text-muted">Confidence: @suggestion.Confidence.ToString().ToLowerInvariant(). The assistant can be wrong; you decide, and you write the remark.</p>
            </div>
        }
    </div>
}

@code {
    private bool _asking;
    private bool _unavailable;
    private Suggestion? _suggestion;
    private readonly CancellationTokenSource _lifetime = new();

    [Parameter, EditorRequired]
    public string TransportOrderNumber { get; set; } = string.Empty;

    /// <summary>Whether the page is the Customer service role's view. The button shows nowhere else.</summary>
    [Parameter]
    public bool ForCustomerService { get; set; }

    /// <summary>Raised when Customer service chooses to review a Release suggestion: the page pre-selects the order and remembers the run.</summary>
    [Parameter, EditorRequired]
    public EventCallback<AgentRun> OnReview { get; set; }

    private static string Kind(SuggestedActionKind action) => action switch
    {
        SuggestedActionKind.Release => "Release",
        SuggestedActionKind.Wait => "Wait",
        _ => "Needs a person",
    };

    private async Task RecommendAsync()
    {
        _asking = true;
        _unavailable = false;
        _suggestion = null;
        try
        {
            var result = await Requests.RecommendAsync(new RecommendReleaseQuery(TransportOrderNumber), _lifetime.Token);
            if (result.IsSuccess)
            {
                _suggestion = result.Value;
            }
            else
            {
                _unavailable = true;
                AgentPageLog.RecommendFailed(Logger, TransportOrderNumber, result.Errors.FirstOrDefault() ?? "AgentUnavailable");
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            _unavailable = true;
            AgentPageLog.RecommendCrashed(Logger, exception, TransportOrderNumber);
        }
        finally
        {
            _asking = false;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
