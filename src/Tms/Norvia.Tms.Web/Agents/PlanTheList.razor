@using Ardalis.Result
@using Microsoft.Extensions.Options
@using Norvia.Agents
@using Norvia.Tms.Application.Agents
@using Norvia.Tms.Application.Agents.Planner
@inject IOptions<AgentsOptions> Agents
@inject IExplainRequests Requests
@inject ILogger<PlanTheList> Logger
@implements IDisposable

@* One fixed question about the whole waiting-for-planning list: how should these orders be planned? The assistant works through the orders in
   the list's order, one at a time, with the orders it has already suggested for Own fleet counted by the TMS, and gives a Suggestion per order.
   The Planner accepts them one at a time (an accepted Suggestion pre-selects as a single Suggest does) or ignores them; accepting one accepts
   none of the others, and nothing is assigned until the Planner confirms. Off unless Agents:Enabled, and only in the Planner role view. An
   Agent is never on a critical path (ADR 0040). *@
@if (Agents.Value.Enabled && ForPlanner)
{
    <div data-explain="plan-the-list">
        <FluentButton Appearance="Appearance.Outline" Disabled="_asking" OnClick="PlanAsync">Plan the list</FluentButton>

        @if (_asking)
        {
            <div role="status" class="mt-3">
                <FluentStack VerticalAlignment="VerticalAlignment.Center">
                    <FluentProgressRing />
                    <span>The assistant is working through the list…</span>
                </FluentStack>
            </div>
        }
        else if (_unavailable)
        {
            <div role="alert" class="mt-3">
                <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">Assistant unavailable</FluentMessageBar>
            </div>
        }
        else if (_plan is { } plan)
        {
            @* Text only: what the assistant wrote is data, so it is encoded, never rendered as markup. *@
            <div class="mt-3" data-testid="plan">
                @if (plan.Stopped is { } stopped)
                {
                    <div role="alert" data-testid="plan-stopped">
                        <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
                            @PlanStopText.Of(plan, stopped)
                        </FluentMessageBar>
                    </div>
                }
                @if (plan.Suggestions.Count == 0 && plan.Stopped is null)
                {
                    <p>No Transport Orders are waiting for planning.</p>
                }
                <ul aria-label="Suggestions for the list" class="list-none space-y-3 p-0">
                    @foreach (var listed in plan.Suggestions.Where(listed => !_ignored.Contains(listed.TransportOrderNumber)))
                    {
                        var number = listed.TransportOrderNumber;
                        <li data-testid="plan-suggestion" data-order="@number">
                            <h2 class="text-lg">@number</h2>
                            @if (Stale.Contains(number))
                            {
                                <div role="alert">
                                    <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">This suggestion is out of date: the TMS refused the assignment.</FluentMessageBar>
                                </div>
                            }
                            <p data-testid="suggested-action">@listed.Suggestion.SuggestedAction</p>
                            <p>@listed.Suggestion.Cause</p>
                            <p class="text-muted">Confidence: @listed.Suggestion.Confidence.ToString().ToLowerInvariant().</p>
                            <FluentStack>
                                <FluentButton Appearance="Appearance.Accent" Disabled="!CanAccept(listed)" OnClick="() => AcceptAsync(listed)"
                                              aria-label="@($"Accept the suggestion for {number}")">Accept</FluentButton>
                                <FluentButton Appearance="Appearance.Outline" OnClick="() => Ignore(number)"
                                              aria-label="@($"Ignore the suggestion for {number}")">Ignore</FluentButton>
                            </FluentStack>
                        </li>
                    }
                </ul>
                <p class="text-muted">The assistant can be wrong; you decide, and nothing is assigned until you do. Accepting a suggestion selects that order only.</p>
            </div>
        }
    </div>
}

@code {
    private bool _asking;
    private bool _unavailable;
    private PlannedList? _plan;
    private readonly HashSet<string> _ignored = [];
    private readonly CancellationTokenSource _lifetime = new();

    /// <summary>Whether the page is the Planner role's view. The button shows nowhere else.</summary>
    [Parameter]
    public bool ForPlanner { get; set; }

    /// <summary>The orders whose assignment the TMS has refused since their Suggestion was made, so the Suggestion no longer holds.</summary>
    [Parameter]
    public IReadOnlyCollection<string> Stale { get; set; } = [];

    /// <summary>Raised when the Planner accepts one Suggestion: only that order, so the page can pre-select it. Nothing executes.</summary>
    [Parameter]
    public EventCallback<ListedSuggestion> OnAccepted { get; set; }

    // A Suggestion that names no option to assign (needs a person) has nothing to accept.
    private bool CanAccept(ListedSuggestion listed) => SuggestedAssignment.From(listed.TransportOrderNumber, listed.Suggestion) is not null;

    private async Task AcceptAsync(ListedSuggestion listed) => await OnAccepted.InvokeAsync(listed);

    private void Ignore(string number) => _ignored.Add(number);

    private async Task PlanAsync()
    {
        _asking = true;
        _unavailable = false;
        _plan = null;
        _ignored.Clear();
        try
        {
            var result = await Requests.PlanAsync(new PlanTheListQuery(), _lifetime.Token);
            if (result.IsSuccess)
            {
                _plan = result.Value;
            }
            else
            {
                _unavailable = true;
                AgentPageLog.PlanFailed(Logger, result.Errors.FirstOrDefault() ?? "AgentUnavailable");
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            _unavailable = true;
            AgentPageLog.PlanCrashed(Logger, exception);
        }
        finally
        {
            _asking = false;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
