@page "/shipments/{ShipmentNumber}"
@* Interactive like the Transport Order detail: Fluent UI's components don't survive static streaming rendering. *@
@rendermode InteractiveServer
@using Norvia.Tms.Application.CarrierBookings
@using Norvia.Tms.Application.Shipments
@using Norvia.Tms.Application.TrackingEvents.Timeline
@implements IDisposable
@inject ITransportOrderQueries Queries
@inject ILogger<ShipmentDetail> Logger

<PageTitle>@ShipmentNumber · Norvia TMS</PageTitle>

<p class="mb-2"><a href="/transport-orders">← Back to the Transport Orders waiting for planning</a></p>

<h1>Shipment @ShipmentNumber</h1>

@if (_failed)
{
    <div role="alert">
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
            Shipment @ShipmentNumber couldn't be loaded. Reload the page to try again.
        </FluentMessageBar>
    </div>
}
else if (!_loaded)
{
    <FluentStack VerticalAlignment="VerticalAlignment.Center" role="status" Class="text-muted">
        <FluentProgressRing />
        <span>Loading Shipment @ShipmentNumber…</span>
    </FluentStack>
}
else if (_shipment is null)
{
    <div role="status">
        <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
            There is no Shipment @ShipmentNumber.
        </FluentMessageBar>
    </div>
}
else
{
    <div class="mb-4 grid gap-4 md:grid-cols-3">
        <TransportOrderSection Heading="Shipment">
            <dl class="detail-list">
                <dt>Status</dt>
                <dd>@_shipment.Status</dd>
                <dt>Carried by</dt>
                <dd>@PlanningText.CarriedBy(_shipment.CarriedBy)</dd>
                <dt>Transport Order</dt>
                <dd><a href="/transport-orders/@_shipment.TransportOrderNumber">@_shipment.TransportOrderNumber</a></dd>
                <dt>Shipper</dt>
                <dd>@(_shipment.Shipper.Name ?? _shipment.Shipper.Id)</dd>
                <dt>Planned</dt>
                <dd>@NorviaTime.Format(_shipment.PlannedAt)</dd>
                <dt>Correlation ID</dt>
                <dd>@_shipment.CorrelationId</dd>
            </dl>
        </TransportOrderSection>

        @* The planning first, then each reassignment, each on its own Message trail. The correlation ID is sized to fit
           whole, as the Shipment card shows it, and wraps rather than being cut off on a narrow screen. *@
        <div class="md:col-span-2">
            <TransportOrderSection Heading="Assignments">
                <FluentDataGrid Items="_shipment.Assignments.AsQueryable()" TGridItem="ShipmentAssignmentView" Class="flatly-table" aria-label="Assignments"
                                GridTemplateColumns="1fr 1fr auto" MultiLine="true">
                    <PropertyColumn Title="Carried by" Property="@(assignment => PlanningText.CarriedBy(assignment.CarriedBy))" />
                    <PropertyColumn Title="Assigned" Property="@(assignment => NorviaTime.Format(assignment.AssignedAt))" />
                    <PropertyColumn Title="Correlation ID" Property="@(assignment => assignment.CorrelationId)" />
                </FluentDataGrid>
            </TransportOrderSection>
        </div>

        @* Only a Carrier Shipment gets a Carrier booking (P4), in the order they were requested. *@
        @if (_shipment.CarrierBookings.Count > 0)
        {
            <div class="md:col-span-3">
                <TransportOrderSection Heading="Carrier bookings">
                    <FluentDataGrid Items="_shipment.CarrierBookings.AsQueryable()" TGridItem="CarrierBookingView" Class="flatly-table" aria-label="Carrier bookings"
                                    GridTemplateColumns="1fr 1.2fr 1fr 1.2fr 1.2fr 2fr" MultiLine="true">
                        <PropertyColumn Title="Carrier booking number" Property="@(booking => booking.CarrierBookingNumber)" />
                        <PropertyColumn Title="Carrier" Property="@(booking => PlanningText.Carrier(booking.Carrier))" />
                        <PropertyColumn Title="Status" Property="@(booking => booking.Status)" />
                        <PropertyColumn Title="Requested" Property="@(booking => NorviaTime.Format(booking.RequestedAt))" />
                        <PropertyColumn Title="Sent" Property="@(booking => CarrierBookingText.Sent(booking.SentAt))" />
                        <PropertyColumn Title="Outcome" Property="@(booking => CarrierBookingText.Detail(booking))" />
                    </FluentDataGrid>
                </TransportOrderSection>
            </div>
        }

        @* What the Carriers reported, in event-time order, each with when it arrived and whether it moved the status. *@
        <div class="md:col-span-3">
            <TransportOrderSection Heading="Tracking timeline">
                @if (_timelineFailed)
                {
                    <div role="alert">
                        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
                            The Tracking timeline couldn't be loaded. Reload the page to try again.
                        </FluentMessageBar>
                    </div>
                }
                else if (_timeline is not { Count: > 0 })
                {
                    <p class="!mb-0" role="status">No Tracking events have been reported for this Shipment.</p>
                }
                else
                {
                    <FluentDataGrid Items="_timeline.AsQueryable()" TGridItem="TrackingTimelineEntry" Class="flatly-table" aria-label="Tracking timeline"
                                    GridTemplateColumns="1fr 1.2fr 1.4fr 1.2fr auto 1.2fr 1.6fr" MultiLine="true">
                        <PropertyColumn Title="Event" Property="@(entry => TrackingText.Type(entry.Type))" />
                        <PropertyColumn Title="Happened" Property="@(entry => NorviaTime.Format(entry.EventTime))" />
                        <PropertyColumn Title="Place" Property="@(entry => TrackingText.Place(entry.Place, entry.Postcode, entry.CountryCode))" />
                        <PropertyColumn Title="Arrived" Property="@(entry => NorviaTime.Format(entry.ReceivedAt))" />
                        <PropertyColumn Title="Moved the status" Property="@(entry => entry.MovedShipment ? "Yes" : "No")" />
                        <PropertyColumn Title="ETA" Property="@(entry => NorviaTime.Format(entry.Eta))" />
                        <PropertyColumn Title="Remark" Property="@(entry => entry.Remark ?? string.Empty)" />
                    </FluentDataGrid>
                }
            </TransportOrderSection>
        </div>
    </div>
}

@code {
    private bool _loaded;
    private bool _failed;
    private readonly CancellationTokenSource _closed = new();
    private ShipmentView? _shipment;
    private IReadOnlyList<TrackingTimelineEntry>? _timeline;
    private bool _timelineFailed;

    [Parameter, EditorRequired]
    public string ShipmentNumber { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _loaded = _failed = _timelineFailed = false;
        _shipment = null;
        _timeline = null;
        try
        {
            _shipment = await Queries.FindShipmentAsync(ShipmentNumber, _closed.Token);
            if (_shipment is not null)
            {
                await LoadTimelineAsync();
            }

            _loaded = true;
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            // The page closed while it was reading.
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Reading Shipment {ShipmentNumber} failed", ShipmentNumber);
            _failed = true;
        }
    }

    // Apart from the Shipment itself: a timeline that can't be read doesn't hide the Shipment.
    private async Task LoadTimelineAsync()
    {
        try
        {
            _timeline = await Queries.FindTrackingTimelineAsync(ShipmentNumber, _closed.Token);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Reading the Tracking timeline of Shipment {ShipmentNumber} failed", ShipmentNumber);
            _timelineFailed = true;
        }
    }

    public void Dispose()
    {
        _closed.Cancel();
        _closed.Dispose();
    }
}
