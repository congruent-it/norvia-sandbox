@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Norvia.Tms.Domain.CarrierBookings
@using Norvia.Tms.Web.TransportOrders
@implements IDisposable
@inject ITransportOrderCommands Commands
@inject ILogger<ReleaseWithSpotPricePanel> Logger

@* The Planner releases one Shipment its Carrier's Carrier Rate Card couldn't price at a Spot price, as a form under the list. The amount and the remark are required. *@
<section role="group" aria-label="@Title" class="mb-6 rounded-flatly border border-border p-4">
    <h2 class="!mb-3 !text-xl">@Title</h2>

    @if (_failure is { } failure)
    {
        <div role="alert" class="mb-4">
            <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">@failure</FluentMessageBar>
        </div>
    }

    <EditForm Model="_form" OnValidSubmit="SubmitAsync" class="flex flex-col gap-4">
        <DataAnnotationsValidator />
        <div>
            <FluentTextField @bind-Value="_form.Amount" Immediate="true" Label="Amount (EUR, without VAT)" Style="width: 100%;" />
            <FluentValidationMessage For="() => _form.Amount" />
        </div>
        <div>
            <FluentTextArea @bind-Value="_form.Remark" Immediate="true" Label="Remark" Rows="3" Style="width: 100%;" />
            <FluentValidationMessage For="() => _form.Remark" />
        </div>
        <p class="!mb-0 text-muted">Where the price comes from, such as "agreed with Van Dijk by phone, €480". It is frozen on the Carrier booking with the amount.</p>

        <div class="flex gap-4">
            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="_working">Release with Spot price</FluentButton>
            <FluentButton Appearance="Appearance.Outline" OnClick="Close" Disabled="_working">Cancel</FluentButton>
        </div>
    </EditForm>
</section>

@code {
    private readonly CancellationTokenSource _closed = new();
    private readonly SpotPriceForm _form = new();
    private string? _failure;
    private bool _working;

    [Parameter, EditorRequired]
    public string ShipmentNumber { get; set; } = string.Empty;

    /// <summary>Raised when the Planner closes the form without releasing.</summary>
    [Parameter, EditorRequired]
    public EventCallback OnClosed { get; set; }

    /// <summary>Raised once the TMS released the Shipment.</summary>
    [Parameter, EditorRequired]
    public EventCallback OnReleased { get; set; }

    // The amount is above zero and in whole cents, and the remark is required and as long as the TMS accepts; a blank remark is as good as none.
    private sealed class SpotPriceForm : IValidatableObject
    {
        public string Amount { get; set; } = string.Empty;

        public string Remark { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!TryParseAmount(Amount, out var amount))
            {
                yield return new("Give an amount in EUR, such as 480.50.", [nameof(Amount)]);
            }
            else if (amount <= 0m)
            {
                yield return new("The amount must be above zero.", [nameof(Amount)]);
            }
            else if (amount != Math.Round(amount, 2))
            {
                yield return new("The amount is in whole cents, such as 480.50.", [nameof(Amount)]);
            }

            if (string.IsNullOrWhiteSpace(Remark))
            {
                yield return new("Give a remark: where the price comes from.", [nameof(Remark)]);
            }
            else if (Remark.Trim().Length > CarrierCostSource.MaxRemarkLength)
            {
                yield return new($"A remark is at most {CarrierCostSource.MaxRemarkLength} characters.", [nameof(Remark)]);
            }
        }

        public static bool TryParseAmount(string text, out decimal amount) =>
            decimal.TryParse(text.Trim(), NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out amount);
    }

    private string Title => $"Release {ShipmentNumber} with Spot price";

    private async Task SubmitAsync()
    {
        if (_working || !SpotPriceForm.TryParseAmount(_form.Amount, out var amount))
        {
            return;
        }

        var remark = _form.Remark.Trim();

        _working = true;
        _failure = null;
        try
        {
            switch (await Commands.ReleaseWithSpotPriceAsync(ShipmentNumber, amount, remark, _closed.Token))
            {
                case ReleaseAnswer.Released:
                    await OnReleased.InvokeAsync();
                    break;
                case ReleaseAnswer.Refused refused:
                    _failure = $"Shipment {ShipmentNumber} wasn't released: {refused.Reason}";
                    break;
            }
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            // The page closed while the TMS was answering.
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Releasing Shipment {ShipmentNumber} with a Spot price failed", ShipmentNumber);
            _failure = $"Shipment {ShipmentNumber} couldn't be released. Try again.";
        }
        finally
        {
            _working = false;
        }
    }

    private Task Close() => OnClosed.InvokeAsync();

    public void Dispose()
    {
        _closed.Cancel();
        _closed.Dispose();
    }
}
