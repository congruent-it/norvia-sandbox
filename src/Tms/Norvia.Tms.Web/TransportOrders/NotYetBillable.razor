@page "/not-yet-billable"
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@using Norvia.Tms.Web.Agents
@using Norvia.Tms.Application.Billing.ListNotYetBillable
@implements IAsyncDisposable
@inject ITransportOrderQueries Queries
@inject TimeProvider Time
@inject IOptions<LiveListOptions> Options
@inject ILogger<LiveTransportOrderList<TransportOrderNotYetBillableSummary>> Logger

<PageTitle>Not yet billable · Norvia TMS</PageTitle>

<h1>Not yet billable</h1>

@if (_done is { } done)
{
    <div role="status" class="mb-4">
        <FluentMessageBar Intent="MessageIntent.Success" AllowDismiss="false">@done</FluentMessageBar>
    </div>
}

@if (_releasing is { } releasing)
{
    @* Keyed by the order, so a new choice starts a new form. *@
    <ReleaseWithoutProofOfDeliveryPanel @key="releasing" TransportOrderNumber="@releasing" OnClosed="CloseRelease" OnDone="Done" />
}

<LiveListStates Items="_list.Items" LastReadFailed="_list.LastReadFailed" Name="Transport Orders not yet billable"
                Empty="@("No delivered Transport Order is waiting to become billable. An order appears here once its Shipment is Delivered and something still blocks billing.")" Context="orders">
    @* Oldest delivery first, as the query gives them: what has waited longest is followed up first. *@
    <FluentDataGrid Items="orders.AsQueryable()" TGridItem="TransportOrderNotYetBillableSummary" Class="flatly-table" aria-label="Transport Orders not yet billable"
                    GridTemplateColumns="1.4fr 1.2fr 1.3fr 1.4fr 2.2fr 1.3fr 2fr 2fr" MultiLine="true">
        <TemplateColumn Title="Transport Order">
            <a href="/transport-orders/@context.TransportOrderNumber">@context.TransportOrderNumber</a>
        </TemplateColumn>
        <PropertyColumn Title="Shipper" Property="@(order => order.Shipper.Name ?? order.Shipper.Id)" />
        <PropertyColumn Title="Shipper reference" Property="@(order => SubmittedTransportOrder.Given(order.ShipperReference))" />
        <PropertyColumn Title="Delivered" Property="@(order => NorviaTime.Format(order.DeliveredAt))" />
        <PropertyColumn Title="Blocking reasons" Property="@(order => string.Join(", ", order.BlockingReasons.Select(BillingText.Reason)))" />
        <TemplateColumn Title="Shipment">
            <a href="/shipments/@context.ShipmentNumber">@context.ShipmentNumber</a>
        </TemplateColumn>
        <TemplateColumn Title="Explain">
            <ExplainOrderHold TransportOrderNumber="@context.TransportOrderNumber" Kind="ExplainOrderHold.HoldKind.NotYetBillable" ForCustomerService="RoleKey == NorviaRole.CustomerService.Key" />
        </TemplateColumn>
        @* Only what can lift a blocking reason is offered: the rating exception when the order isn't rated, and the release when the Proof of delivery is missing. *@
        <TemplateColumn Title="Actions">
            <div class="flex flex-col items-start gap-2">
                @if (context.BlockingReasons.Contains(BillingBlockingReason.NotRated))
                {
                    <a href="/transport-orders/@context.TransportOrderNumber" aria-label="@($"Open the rating exception of {context.TransportOrderNumber}")">Rating exception</a>
                }
                @if (context.BlockingReasons.Contains(BillingBlockingReason.NoProofOfDelivery))
                {
                    <FluentButton Appearance="Appearance.Outline" OnClick="() => _releasing = context.TransportOrderNumber"
                                  aria-label="@($"Release {context.TransportOrderNumber} without Proof of delivery")">
                        Release without Proof of delivery
                    </FluentButton>
                }
            </div>
        </TemplateColumn>
    </FluentDataGrid>
</LiveListStates>

@code {
    private LiveTransportOrderList<TransportOrderNotYetBillableSummary> _list = null!;
    private string? _releasing;
    private string? _done;

    // The role comes from the request's cookie. The page is interactive, so it reads the role while it prerenders and carries it into the
    // circuit; a page that couldn't read it shows no Explain button.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [PersistentState]
    public string? RoleKey { get; set; }

    protected override void OnInitialized()
    {
        RoleKey ??= HttpContext is null ? null : NorviaRole.Current(HttpContext.Request).Key;
        _list = new LiveTransportOrderList<TransportOrderNotYetBillableSummary>(
            Queries.ListNotYetBillableAsync, "the Transport Orders not yet billable", Time, Options.Value.RefreshInterval, Logger);
        _list.Changed += () => InvokeAsync(StateHasChanged);
        _list.Start();
    }

    private void CloseRelease() => _releasing = null;

    // The list isn't changed here: it reads again shortly, and then drops the order if it became Billable.
    private void Done(string text)
    {
        _releasing = null;
        _done = text;
    }

    public async ValueTask DisposeAsync() => await _list.DisposeAsync();
}
