@page "/transport-orders/all"
@* Interactive like the other lists: Fluent UI's components don't survive static streaming rendering. *@
@rendermode InteractiveServer
@using Norvia.Tms.Application.Shipments
@using Norvia.Tms.Application.TransportOrders.Browse
@using Norvia.Tms.Domain.Shipments
@using Norvia.Tms.Web.Shipments
@using Norvia.Tms.Domain.TransportOrders
@implements IDisposable
@inject ITransportOrderQueries Queries
@inject ILogger<TransportOrderList> Logger

<PageTitle>Transport Orders · Norvia TMS</PageTitle>

<h1>Transport Orders</h1>

<div role="search" aria-label="Filter Transport Orders" class="mb-4 flex flex-wrap items-end gap-4">
    <div class="flex flex-col">
        <FluentSelect TOption="string" Label="Status" aria-label="Status" Value="@_status" ValueChanged="StatusChangedAsync" Width="12rem">
            <FluentOption TOption="string" Value="">All</FluentOption>
            <FluentOption TOption="string" Value="@nameof(TransportOrderStatus.Accepted)">Accepted</FluentOption>
            <FluentOption TOption="string" Value="@nameof(TransportOrderStatus.Planned)">Planned</FluentOption>
        </FluentSelect>
    </div>
    <div class="flex flex-col">
        <FluentSelect TOption="string" Label="Shipper" aria-label="Shipper" Value="@_shipperId" ValueChanged="ShipperChangedAsync" Width="16rem">
            <FluentOption TOption="string" Value="">All</FluentOption>
            @foreach (var shipper in _shippers)
            {
                <FluentOption TOption="string" Value="@shipper.Id">@(shipper.Name ?? shipper.Id)</FluentOption>
            }
        </FluentSelect>
    </div>
    <div class="flex flex-col">
        <FluentSelect TOption="string" Label="Carried by" aria-label="Carried by" Value="@_carriedBy" ValueChanged="CarriedByChangedAsync" Width="14rem">
            <FluentOption TOption="string" Value="">All</FluentOption>
            <FluentOption TOption="string" Value="@ListAllTransportOrdersQuery.OwnFleet">@PlanningText.OwnFleet</FluentOption>
            @foreach (var carrier in _carriers)
            {
                <FluentOption TOption="string" Value="@carrier.Id">@PlanningText.Carrier(carrier)</FluentOption>
            }
        </FluentSelect>
    </div>
    <div class="flex flex-col">
        <FluentSelect TOption="string" Label="Shipment status" aria-label="Shipment status" Value="@_shipmentStatus" ValueChanged="ShipmentStatusChangedAsync" Width="14rem">
            <FluentOption TOption="string" Value="">All</FluentOption>
            @foreach (var shipmentStatus in Enum.GetValues<ShipmentStatus>())
            {
                <FluentOption TOption="string" Value="@shipmentStatus.ToString()">@TrackingText.Status(shipmentStatus)</FluentOption>
            }
        </FluentSelect>
    </div>
    @* Applied when the Planner presses Enter or leaves the box: the database searches, so each search is a read. *@
    <div class="flex flex-col">
        <FluentTextField Label="Search" aria-label="Search" Value="@_search" ValueChanged="SearchChangedAsync" Placeholder="Number, Shipper reference or Shipment" Style="width: 18rem;" />
    </div>
</div>

@if (_failed)
{
    <div role="alert">
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
            The Transport Orders couldn't be loaded. Change the search or a filter to try again.
        </FluentMessageBar>
    </div>
}
else if (_page is null)
{
    <FluentStack VerticalAlignment="VerticalAlignment.Center" role="status">
        <FluentProgressRing />
        <span>Loading the Transport Orders…</span>
    </FluentStack>
}
else if (_page.Items.Count == 0 && _page.TotalCount == 0)
{
    <div role="status">
        <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
            @(Filtering ? "No Transport Orders match the search and filters." : "There are no Transport Orders yet. A Transport Order appears here as soon as it is accepted.")
        </FluentMessageBar>
    </div>
}
else
{
    @* Newest first, as the query gives them. *@
    <FluentDataGrid Items="_page.Items.AsQueryable()" TGridItem="TransportOrderListItem" Class="flatly-table" aria-label="Transport Orders"
                    GridTemplateColumns="1.2fr 1.4fr 1.2fr 1fr 1.2fr 1.2fr 1.8fr 1.2fr 1fr 1.2fr" MultiLine="true">
        <TemplateColumn Title="Transport Order">
            <a href="/transport-orders/@context.TransportOrderNumber">@context.TransportOrderNumber</a>
        </TemplateColumn>
        <PropertyColumn Title="Shipper" Property="@(transportOrder => transportOrder.Shipper.Name ?? transportOrder.Shipper.Id)" />
        <PropertyColumn Title="Shipper reference" Property="@(transportOrder => SubmittedTransportOrder.Given(transportOrder.ShipperReference))" />
        <PropertyColumn Title="Status" Property="@(transportOrder => transportOrder.Status.ToString())" />
        <PropertyColumn Title="Collection" Property="@(transportOrder => PlanningText.Place(transportOrder.CollectionPlace))" />
        <PropertyColumn Title="Delivery" Property="@(transportOrder => PlanningText.Place(transportOrder.DeliveryPlace))" />
        <PropertyColumn Title="Collection window" Property="@(transportOrder => NorviaTime.FormatWindow(transportOrder.CollectionEarliest, transportOrder.CollectionLatest))" />
        <TemplateColumn Title="Shipment">
            @if (context.ShipmentNumber is { } shipmentNumber)
            {
                <a href="/shipments/@shipmentNumber">@shipmentNumber</a>
            }
            else
            {
                <span>—</span>
            }
        </TemplateColumn>
        <PropertyColumn Title="Shipment status" Property="@(transportOrder => ShipmentStatusText(transportOrder))" />
        <PropertyColumn Title="Carried by" Property="@(transportOrder => CarriedByText(transportOrder))" />
    </FluentDataGrid>

    <nav aria-label="Pages" class="mt-4 flex items-center gap-4">
        <FluentButton Appearance="Appearance.Outline" Disabled="@(_page.Page <= 1)" OnClick="@(() => GoToAsync(_page.Page - 1))">Previous</FluentButton>
        <span role="status">Page @_page.Page of @Math.Max(_page.PageCount, 1) · @_page.TotalCount Transport Orders</span>
        <FluentButton Appearance="Appearance.Outline" Disabled="@(_page.Page >= _page.PageCount)" OnClick="@(() => GoToAsync(_page.Page + 1))">Next</FluentButton>
    </nav>
}

@code {
    private readonly CancellationTokenSource _closed = new();
    private IReadOnlyList<ShipperView> _shippers = [];
    private IReadOnlyList<CarrierView> _carriers = [];
    private TransportOrderPage? _page;
    private bool _failed;
    private string? _status = string.Empty;
    private string? _shipperId = string.Empty;
    private string? _carriedBy = string.Empty;
    private string? _shipmentStatus = string.Empty;
    private string? _search = string.Empty;
    // The latest read wins: a slow read of an earlier search must not replace the page the Planner asked for since.
    private int _reads;

    private static string ShipmentStatusText(TransportOrderListItem transportOrder) => transportOrder.ShipmentStatus is { } status ? TrackingText.Status(status) : "—";

    private static string CarriedByText(TransportOrderListItem transportOrder) => transportOrder.CarriedBy is { } carriedBy ? PlanningText.CarriedBy(carriedBy) : "—";

    private bool Filtering => !string.IsNullOrEmpty(_status) || !string.IsNullOrEmpty(_shipperId) || !string.IsNullOrEmpty(_carriedBy) || !string.IsNullOrEmpty(_shipmentStatus) || !string.IsNullOrWhiteSpace(_search);

    protected override async Task OnInitializedAsync()
    {
        // The Shippers are only the filter's choices: the list still works without them.
        try
        {
            _shippers = await Queries.ListShippersAsync(_closed.Token);
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Reading the Shippers failed");
        }

        // Likewise the Carriers: without them the Planner can still filter on the Own fleet.
        try
        {
            _carriers = await Queries.ListActiveCarriersAsync(_closed.Token);
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Reading the Carriers failed");
        }

        await LoadAsync(1);
    }

    private Task CarriedByChangedAsync(string? carriedBy)
    {
        _carriedBy = carriedBy;
        return LoadAsync(1);
    }

    private Task ShipmentStatusChangedAsync(string? shipmentStatus)
    {
        _shipmentStatus = shipmentStatus;
        return LoadAsync(1);
    }

    private Task StatusChangedAsync(string? status)
    {
        _status = status;
        return LoadAsync(1);
    }

    private Task ShipperChangedAsync(string? shipperId)
    {
        _shipperId = shipperId;
        return LoadAsync(1);
    }

    private Task SearchChangedAsync(string? search)
    {
        _search = search;
        return LoadAsync(1);
    }

    private Task GoToAsync(int page) => LoadAsync(page);

    private async Task LoadAsync(int page)
    {
        var read = ++_reads;
        _failed = false;
        try
        {
            var status = Enum.TryParse<TransportOrderStatus>(_status, out var parsed) ? parsed : (TransportOrderStatus?)null;
            var shipmentStatus = Enum.TryParse<ShipmentStatus>(_shipmentStatus, out var parsedShipmentStatus) ? parsedShipmentStatus : (ShipmentStatus?)null;
            var loaded = await Queries.ListTransportOrdersAsync(
                status, string.IsNullOrEmpty(_shipperId) ? null : _shipperId, string.IsNullOrEmpty(_carriedBy) ? null : _carriedBy, shipmentStatus, string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(), page, _closed.Token);
            if (read == _reads)
            {
                _page = loaded;
            }
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            // The page closed while it was reading.
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Reading the Transport Orders failed");
            if (read == _reads)
            {
                _failed = true;
            }
        }
    }

    public void Dispose()
    {
        _closed.Cancel();
        _closed.Dispose();
    }
}
