@* What a Shipper submitted, as it was received: where from, where to, the goods and the instructions. The page puts its
   own summary card first, beside collection and delivery. *@
@using Norvia.Tms.Application.CanonicalModel

<div class="mb-4 grid gap-4 md:grid-cols-3">
    @Summary

    <TransportOrderSection Heading="Collection">
        <dl class="detail-list">
            <dt>Address</dt>
            <dd>@FormatAddress(Submitted.Collection?.Address)</dd>
            <dt>Window</dt>
            <dd>@NorviaTime.FormatWindow(Submitted.Collection?.Window?.Earliest, Submitted.Collection?.Window?.Latest)</dd>
        </dl>
    </TransportOrderSection>

    <TransportOrderSection Heading="Delivery">
        <dl class="detail-list">
            <dt>Address</dt>
            <dd>@FormatAddress(Submitted.Delivery?.Address)</dd>
            <dt>Consignee</dt>
            <dd>@Given(Submitted.Delivery?.Consignee?.Name)</dd>
            <dt>Contact</dt>
            <dd>@Given(Submitted.Delivery?.Consignee?.ContactName)</dd>
            <dt>Phone</dt>
            <dd>@Given(Submitted.Delivery?.Consignee?.Phone)</dd>
            <dt>Email</dt>
            <dd>@Given(Submitted.Delivery?.Consignee?.Email)</dd>
            <dt>Window</dt>
            <dd>@NorviaTime.FormatWindow(Submitted.Delivery?.Window?.Earliest, Submitted.Delivery?.Window?.Latest)</dd>
        </dl>
    </TransportOrderSection>
</div>

<TransportOrderSection Heading="Goods">
    @if (Submitted.GoodsLines is not { Count: > 0 } goodsLines)
    {
        <p class="m-0">No goods lines were given.</p>
    }
    else
    {
        <FluentDataGrid Items="goodsLines.AsQueryable()" TGridItem="CanonicalGoodsLine" Class="flatly-table" aria-label="Goods lines">
            <PropertyColumn Title="Package type" Property="@(line => Given(line.PackageType))" />
            <PropertyColumn Title="Quantity" Property="@(line => FormatNumber(line.Quantity))" />
            <PropertyColumn Title="Weight (kg)" Property="@(line => FormatNumber(line.WeightKg))" />
            <PropertyColumn Title="Dimensions (cm, L × W × H)" Property="@(line => FormatDimensions(line.DimensionsCm))" />
        </FluentDataGrid>
    }
</TransportOrderSection>

<div class="h-4"></div>

<TransportOrderSection Heading="Instructions">
    <p class="m-0 whitespace-pre-line">@Given(Submitted.Instructions)</p>
</TransportOrderSection>

@code {
    [Parameter, EditorRequired]
    public CanonicalTransportOrder Submitted { get; set; } = null!;

    /// <summary>The page's own summary card, shown first: the Transport Order, or the Rejected booking.</summary>
    [Parameter, EditorRequired]
    public RenderFragment? Summary { get; set; }
}
