@page "/transport-orders/{TransportOrderNumber}"
@* Interactive like the list: Fluent UI's components don't survive static streaming rendering. *@
@rendermode InteractiveServer
@using Norvia.Tms.Application.TransportOrders.GetDetail
@using Norvia.Tms.Application.Shipments
@using Norvia.Tms.Domain.Shipments
@using Norvia.Tms.Domain.Trips
@using Norvia.Tms.Web.Capacity
@using Norvia.Tms.Web.Shipments
@using Norvia.Tms.Web.Trips
@implements IDisposable
@inject ITransportOrderQueries Queries
@inject ILogger<TransportOrderDetail> Logger

<PageTitle>@TransportOrderNumber · Norvia TMS</PageTitle>

<p class="mb-2"><a href="/transport-orders/all">← Back to the Transport Orders</a> · <a href="/transport-orders">Waiting for planning</a></p>

<h1>Transport Order @TransportOrderNumber</h1>

@if (_failed)
{
    <div role="alert">
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
            Transport Order @TransportOrderNumber couldn't be loaded. Reload the page to try again.
        </FluentMessageBar>
    </div>
}
else if (!_loaded)
{
    <FluentStack VerticalAlignment="VerticalAlignment.Center" role="status" Class="text-muted">
        <FluentProgressRing />
        <span>Loading Transport Order @TransportOrderNumber…</span>
    </FluentStack>
}
else if (_transportOrder is null)
{
    <div role="status">
        <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
            There is no Transport Order @TransportOrderNumber.
        </FluentMessageBar>
    </div>
}
else
{
    @if (_transportOrder.RatingResult is { } ratingResult)
    {
        <div class="mb-4">
            <TransportOrderRating Result="ratingResult" FreightCharge="_transportOrder.FreightCharge" Failure="_transportOrder.RatingFailure" />
        </div>
    }

    @* A Transport Order has one Shipment (ADR 0007) and a Shipment is on at most one Trip, so each is a card. *@
    <div class="mb-4 grid gap-4 md:grid-cols-2">
        <TransportOrderSection Heading="Shipment">
            @if (_detail?.Shipment is { } shipment)
            {
                <dl class="detail-list">
                    <dt>Shipment</dt>
                    <dd><a href="/shipments/@shipment.ShipmentNumber">@shipment.ShipmentNumber</a></dd>
                    <dt>Status</dt>
                    <dd>@shipment.Status</dd>
                    <dt>Carried by</dt>
                    <dd>@PlanningText.CarriedBy(shipment.CarriedBy)</dd>
                    @if (shipment.CarrierBooking is { } booking)
                    {
                        <dt>Carrier booking</dt>
                        <dd>@booking.Status</dd>
                    }
                </dl>
            }
            else
            {
                <p>No Shipment yet: this Transport Order isn't planned. <a href="/transport-orders">Transport Orders waiting for planning</a></p>
            }
        </TransportOrderSection>

        <TransportOrderSection Heading="Trip">
            @if (_detail?.Trip is { } trip)
            {
                <dl class="detail-list">
                    <dt>Trip</dt>
                    <dd><a href="/trips/@trip.TripNumber">@trip.TripNumber</a></dd>
                    <dt>Day</dt>
                    <dd>@FleetText.Day(trip.Day)</dd>
                    <dt>Status</dt>
                    <dd>@trip.Status</dd>
                </dl>
                <TripStopsTable Stops="trip.Stops" ShowOutcomes="true" />
            }
            else if (_detail?.Shipment is { CarriedBy.AssignedTo: AssignedTo.OwnFleet })
            {
                <p>Not on a Trip yet. <a href="/trips/shipments">Shipments to put on Trips</a></p>
            }
            else if (_detail?.Shipment is not null)
            {
                <p>Not on a Trip: a Carrier carries this Shipment.</p>
            }
            else
            {
                <p>No Trip: there is no Shipment yet.</p>
            }
        </TransportOrderSection>
    </div>

    <SubmittedTransportOrder Submitted="_transportOrder.TransportOrder">
        <Summary>
            <TransportOrderSection Heading="Transport Order">
                <dl class="detail-list">
                    <dt>Status</dt>
                    <dd>@_transportOrder.Status</dd>
                    @if (_transportOrder.ShipmentNumber is { } shipmentNumber)
                    {
                        <dt>Shipment</dt>
                        <dd><a href="/shipments/@shipmentNumber">@shipmentNumber</a></dd>
                    }
                    <dt>Shipper</dt>
                    <dd>@(_transportOrder.Shipper.Name ?? _transportOrder.Shipper.Id)</dd>
                    <dt>Shipper reference</dt>
                    <dd>@SubmittedTransportOrder.Given(_transportOrder.TransportOrder.ShipperReference)</dd>
                    <dt>Received</dt>
                    <dd>@NorviaTime.Format(_transportOrder.ReceivedAt)</dd>
                    <dt>Correlation ID</dt>
                    <dd>@_transportOrder.CorrelationId</dd>
                </dl>
            </TransportOrderSection>
        </Summary>
    </SubmittedTransportOrder>
}

@code {
    private bool _loaded;
    private bool _failed;
    private readonly CancellationTokenSource _closed = new();
    private TransportOrderDetailView? _detail;

    private TransportOrderView? _transportOrder => _detail?.TransportOrder;

    [Parameter, EditorRequired]
    public string TransportOrderNumber { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _loaded = _failed = false;
        _detail = null;
        try
        {
            _detail = await Queries.FindAsync(TransportOrderNumber, _closed.Token);
            _loaded = true;
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            // The page closed while it was reading.
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Reading Transport Order {TransportOrderNumber} failed", TransportOrderNumber);
            _failed = true;
        }
    }

    public void Dispose()
    {
        _closed.Cancel();
        _closed.Dispose();
    }
}
