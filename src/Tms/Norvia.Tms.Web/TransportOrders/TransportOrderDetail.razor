@page "/transport-orders/{TransportOrderNumber}"
@* Interactive like the list: Fluent UI's components don't survive static streaming rendering. *@
@rendermode InteractiveServer
@implements IDisposable
@inject ITransportOrderQueries Queries
@inject ILogger<TransportOrderDetail> Logger

<PageTitle>@TransportOrderNumber · Norvia TMS</PageTitle>

<p class="mb-2"><a href="/transport-orders">← Back to the Transport Orders waiting for planning</a></p>

<h1>Transport Order @TransportOrderNumber</h1>

@if (_failed)
{
    <div role="alert">
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
            Transport Order @TransportOrderNumber couldn't be loaded. Reload the page to try again.
        </FluentMessageBar>
    </div>
}
else if (!_loaded)
{
    <FluentStack VerticalAlignment="VerticalAlignment.Center" role="status" Class="text-muted">
        <FluentProgressRing />
        <span>Loading Transport Order @TransportOrderNumber…</span>
    </FluentStack>
}
else if (_transportOrder is null)
{
    <div role="status">
        <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
            There is no Transport Order @TransportOrderNumber.
        </FluentMessageBar>
    </div>
}
else
{
    <SubmittedTransportOrder Submitted="_transportOrder.TransportOrder">
        <Summary>
            <TransportOrderSection Heading="Transport Order">
                <dl class="detail-list">
                    <dt>Status</dt>
                    <dd>@_transportOrder.Status</dd>
                    <dt>Shipper</dt>
                    <dd>@(_transportOrder.Shipper.Name ?? _transportOrder.Shipper.Id)</dd>
                    <dt>Shipper reference</dt>
                    <dd>@SubmittedTransportOrder.Given(_transportOrder.TransportOrder.ShipperReference)</dd>
                    <dt>Received</dt>
                    <dd>@NorviaTime.Format(_transportOrder.ReceivedAt)</dd>
                    <dt>Correlation ID</dt>
                    <dd>@_transportOrder.CorrelationId</dd>
                </dl>
            </TransportOrderSection>
        </Summary>
    </SubmittedTransportOrder>
}

@code {
    private bool _loaded;
    private bool _failed;
    private readonly CancellationTokenSource _closed = new();
    private TransportOrderView? _transportOrder;

    [Parameter, EditorRequired]
    public string TransportOrderNumber { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _loaded = _failed = false;
        _transportOrder = null;
        try
        {
            _transportOrder = await Queries.FindAsync(TransportOrderNumber, _closed.Token);
            _loaded = true;
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            // The page closed while it was reading.
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Reading Transport Order {TransportOrderNumber} failed", TransportOrderNumber);
            _failed = true;
        }
    }

    public void Dispose()
    {
        _closed.Cancel();
        _closed.Dispose();
    }
}
