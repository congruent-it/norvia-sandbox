@page "/rejected-bookings"
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@implements IAsyncDisposable
@inject ITransportOrderQueries Queries
@inject TimeProvider Time
@inject IOptions<LiveListOptions> Options
@inject ILogger<LiveTransportOrderList> Logger

<PageTitle>Rejected bookings · Norvia TMS</PageTitle>

<h1>Rejected bookings</h1>

@if (_list.TransportOrders is not { } bookings)
{
    @if (_list.LastReadFailed)
    {
        <div role="alert" class="mb-4">
            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
                The rejected bookings couldn't be loaded. Trying again…
            </FluentMessageBar>
        </div>
    }
    else
    {
        <FluentStack VerticalAlignment="VerticalAlignment.Center" role="status">
            <FluentProgressRing />
            <span>Loading the rejected bookings…</span>
        </FluentStack>
    }
}
else
{
    @if (_list.LastReadFailed)
    {
        <div role="alert" class="mb-4">
            <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
                The list couldn't be refreshed and may be out of date. Trying again…
            </FluentMessageBar>
        </div>
    }

    @if (bookings.Count == 0)
    {
        <div role="status">
            <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
                No bookings have been rejected. A rejected booking appears here as soon as it is received.
            </FluentMessageBar>
        </div>
    }
    else
    {
        @* The latest first: a Shipper usually calls about the booking it just sent. *@
        <FluentDataGrid Items="bookings.OrderByDescending(booking => booking.ReceivedAt).AsQueryable()" TGridItem="TransportOrderSummary" Class="flatly-table" aria-label="Rejected bookings">
            @* A Rejected booking has no Transport Order number, and may have no Shipper reference, so it opens from when it was received. *@
            <TemplateColumn Title="Received">
                <a href="/rejected-bookings/@context.Id">@NorviaTime.Format(context.ReceivedAt)</a>
            </TemplateColumn>
            <PropertyColumn Title="Shipper" Property="@(booking => booking.Shipper.Name ?? booking.Shipper.Id)" />
            <PropertyColumn Title="Shipper reference" Property="@(booking => SubmittedTransportOrder.Given(booking.ShipperReference))" />
        </FluentDataGrid>
    }
}

@code {
    private LiveTransportOrderList _list = null!;

    protected override void OnInitialized()
    {
        _list = new LiveTransportOrderList(Queries.ListRejectedAsync, "the Rejected bookings", Time, Options.Value.RefreshInterval, Logger);
        _list.Changed += () => InvokeAsync(StateHasChanged);
        _list.Start();
    }

    public ValueTask DisposeAsync() => _list.DisposeAsync();
}
