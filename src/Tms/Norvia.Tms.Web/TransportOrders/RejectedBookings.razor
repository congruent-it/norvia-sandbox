@page "/rejected-bookings"
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@implements IAsyncDisposable
@inject ITransportOrderQueries Queries
@inject TimeProvider Time
@inject IOptions<LiveListOptions> Options
@inject ILogger<LiveTransportOrderList<TransportOrderSummary>> Logger

<PageTitle>Rejected bookings · Norvia TMS</PageTitle>

<h1>Rejected bookings</h1>

<LiveListStates Items="_list.Items" LastReadFailed="_list.LastReadFailed" Name="rejected bookings"
                Empty="No bookings have been rejected. A rejected booking appears here as soon as it is received." Context="bookings">
    @* The latest first: a Shipper usually calls about the booking it just sent. *@
    <FluentDataGrid Items="bookings.OrderByDescending(booking => booking.ReceivedAt).AsQueryable()" TGridItem="TransportOrderSummary" Class="flatly-table" aria-label="Rejected bookings">
        @* A Rejected booking has no Transport Order number, and may have no Shipper reference, so it opens from when it was received. *@
        <TemplateColumn Title="Received">
            @* A full page load, not a navigation inside the circuit: the detail page reads the role from the request while it prerenders, and Explain shows only for Customer service. *@
            <a href="/rejected-bookings/@context.Id" target="_top">@NorviaTime.Format(context.ReceivedAt)</a>
        </TemplateColumn>
        <PropertyColumn Title="Shipper" Property="@(booking => booking.Shipper.Name ?? booking.Shipper.Id)" />
        <PropertyColumn Title="Shipper reference" Property="@(booking => SubmittedTransportOrder.Given(booking.ShipperReference))" />
    </FluentDataGrid>
</LiveListStates>

@code {
    private LiveTransportOrderList<TransportOrderSummary> _list = null!;

    protected override void OnInitialized()
    {
        _list = new LiveTransportOrderList<TransportOrderSummary>(Queries.ListRejectedAsync, "the Rejected bookings", Time, Options.Value.RefreshInterval, Logger);
        _list.Changed += () => InvokeAsync(StateHasChanged);
        _list.Start();
    }

    public ValueTask DisposeAsync() => _list.DisposeAsync();
}
