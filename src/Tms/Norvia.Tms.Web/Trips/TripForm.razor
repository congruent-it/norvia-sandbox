@using Norvia.Tms.Application.Trips.Choices
@using Norvia.Tms.Web.Capacity
@implements IDisposable
@inject ITransportOrderQueries Queries
@inject ILogger<TripForm> Logger

@* Creates a Draft Trip, or picks the Vehicle and Driver of one. The Vehicles and Drivers offered are the day's available ones that hold no other Trip. *@
<section role="group" aria-label="@Title" class="mb-6 rounded-flatly border border-border p-4">
    <h2 class="!mb-3 !text-xl">@Title</h2>

    @if (_failure is { } failure)
    {
        <div role="alert" class="mb-4">
            <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">@failure</FluentMessageBar>
        </div>
    }
    @if (_done is { } done)
    {
        <div role="status" class="mb-4">
            <FluentMessageBar Intent="MessageIntent.Success" AllowDismiss="false">@done</FluentMessageBar>
        </div>
    }

    <div class="flex flex-wrap items-end gap-4">
        @if (Days is not null)
        {
            <div class="flex items-center gap-2">
                <FluentSelect TOption="string" Label="Day" aria-label="Day" Value="@_day" ValueChanged="DayChangedAsync" Width="12rem">
                    <FluentOption TOption="string" Value="">Choose a day</FluentOption>
                    @foreach (var day in Days)
                    {
                        <FluentOption TOption="string" Value="@Iso(day)">@FleetText.Day(day)</FluentOption>
                    }
                </FluentSelect>
            </div>
        }
        <div class="flex items-center gap-2">
            <FluentSelect TOption="string" Label="Vehicle" aria-label="Vehicle" @bind-Value="_vehicleId" Width="14rem">
                <FluentOption TOption="string" Value="">No Vehicle yet</FluentOption>
                @foreach (var vehicle in _choices.Vehicles)
                {
                    <FluentOption TOption="string" Value="@vehicle.Id">@vehicle.Registration</FluentOption>
                }
            </FluentSelect>
        </div>
        <div class="flex items-center gap-2">
            <FluentSelect TOption="string" Label="Driver" aria-label="Driver" @bind-Value="_driverId" Width="14rem">
                <FluentOption TOption="string" Value="">No Driver yet</FluentOption>
                @foreach (var driver in _choices.Drivers)
                {
                    <FluentOption TOption="string" Value="@driver.Id">@driver.Name</FluentOption>
                }
            </FluentSelect>
        </div>
        <div class="flex items-center gap-2">
            <FluentTextField Label="Planned start" aria-label="Planned start" @bind-Value="_start" Immediate="true" Placeholder="07:30" />
        </div>
        <div class="flex items-center gap-2">
            <FluentTextField Label="Driving time (h:mm)" aria-label="Driving time" @bind-Value="_duration" Immediate="true" Placeholder="6:30" />
        </div>
        <FluentButton Appearance="Appearance.Accent" OnClick="SubmitAsync" Disabled="_working">@SubmitText</FluentButton>
        @if (OnCancel.HasDelegate)
        {
            <FluentButton Appearance="Appearance.Outline" OnClick="OnCancel">Cancel</FluentButton>
        }
    </div>
</section>

@code {
    private readonly CancellationTokenSource _closed = new();
    private string _day = string.Empty;
    private string _vehicleId = string.Empty;
    private string _driverId = string.Empty;
    private string _start = string.Empty;
    private string _duration = string.Empty;
    private TripChoices _choices = new([], []);
    private string? _failure;
    private string? _done;
    private bool _working;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string SubmitText { get; set; } = string.Empty;

    /// <summary>The open days to choose from when creating a Trip; null when the form changes a Trip, whose day is <see cref="FixedDay"/>.</summary>
    [Parameter]
    public IReadOnlyList<DateOnly>? Days { get; set; }

    /// <summary>The day of the Trip being changed.</summary>
    [Parameter]
    public DateOnly? FixedDay { get; set; }

    /// <summary>The number of the Trip being changed, whose Vehicle and Driver stay on offer.</summary>
    [Parameter]
    public string? ForTrip { get; set; }

    [Parameter]
    public string? InitialVehicleId { get; set; }

    [Parameter]
    public string? InitialDriverId { get; set; }

    [Parameter]
    public TimeOnly? InitialStart { get; set; }

    [Parameter]
    public TimeSpan? InitialDrivingDuration { get; set; }

    /// <summary>Sends the entry to the TMS and answers what it said.</summary>
    [Parameter, EditorRequired]
    public Func<TripEntry, CancellationToken, Task<TripAnswer>> Submit { get; set; } = null!;

    /// <summary>Raised when the TMS took the entry, so a page can close the form or read its list again.</summary>
    [Parameter]
    public EventCallback OnDone { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _vehicleId = InitialVehicleId ?? string.Empty;
        _driverId = InitialDriverId ?? string.Empty;
        _start = InitialStart is { } start ? TripTimes.Start(start) : string.Empty;
        _duration = InitialDrivingDuration is { } duration ? TripTimes.Duration(duration) : string.Empty;
        if (FixedDay is { } day)
        {
            _day = Iso(day);
            await LoadChoicesAsync(day);
        }
    }

    private const string DayFormat = "yyyy-MM-dd";

    private static string Iso(DateOnly day) => day.ToString(DayFormat, System.Globalization.CultureInfo.InvariantCulture);

    private static bool TryParseDay(string text, out DateOnly day) =>
        DateOnly.TryParseExact(text, DayFormat, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out day);

    private async Task DayChangedAsync(string value)
    {
        _day = value;
        _vehicleId = string.Empty;
        _driverId = string.Empty;
        _choices = new TripChoices([], []);
        if (TryParseDay(value, out var day))
        {
            await LoadChoicesAsync(day);
        }
    }

    private async Task LoadChoicesAsync(DateOnly day)
    {
        try
        {
            _choices = await Queries.ListTripChoicesAsync(day, ForTrip, _closed.Token);
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            // The page closed.
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Reading the choices for a Trip on {Day} failed", day);
            _failure = "The Vehicles and Drivers couldn't be loaded. Choose the day again.";
        }
    }

    private async Task SubmitAsync()
    {
        if (_working)
        {
            return;
        }

        _failure = null;
        _done = null;
        if (!TryParseDay(_day, out var day))
        {
            _failure = "Choose a day.";
            return;
        }

        TimeOnly? plannedStart = null;
        if (_start.Trim().Length > 0)
        {
            if (!TripTimes.TryParseStart(_start, out var parsedStart))
            {
                _failure = "Enter the planned start as hours and minutes, such as 07:30.";
                return;
            }

            plannedStart = parsedStart;
        }

        TimeSpan? drivingDuration = null;
        if (_duration.Trim().Length > 0)
        {
            if (!TripTimes.TryParseDuration(_duration, out var parsedDuration))
            {
                _failure = "Enter the driving time as hours and minutes, such as 6:30, of more than nothing and at most 24 hours.";
                return;
            }

            drivingDuration = parsedDuration;
        }

        _working = true;
        try
        {
            var entry = new TripEntry(day, _vehicleId.Length == 0 ? null : _vehicleId, _driverId.Length == 0 ? null : _driverId, plannedStart, drivingDuration);
            switch (await Submit(entry, _closed.Token))
            {
                case TripAnswer.Refused refused:
                    _failure = $"Not saved: {refused.Reason}";
                    break;
                case TripAnswer.Created created:
                    _done = $"Draft Trip {created.Number} created for {FleetText.Day(day)}.";
                    _start = string.Empty;
                    _duration = string.Empty;
                    await DayChangedAsync(_day);
                    await OnDone.InvokeAsync();
                    break;
                default:
                    _done = $"Trip saved for {FleetText.Day(day)}.";
                    await OnDone.InvokeAsync();
                    break;
            }
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            // The page closed while the TMS was answering.
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "{Title} failed", Title);
            _failure = "The TMS couldn't save that. Try again.";
        }
        finally
        {
            _working = false;
        }
    }

    public void Dispose()
    {
        _closed.Cancel();
        _closed.Dispose();
    }
}
