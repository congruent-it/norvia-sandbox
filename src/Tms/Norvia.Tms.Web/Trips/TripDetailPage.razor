@page "/trips/{Number}"
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@using Norvia.Tms.Application.Trips.GetByNumber
@using Norvia.Tms.Application.Trips.ReorderStops
@using Norvia.Tms.Domain.Trips
@using Norvia.Tms.Web.Capacity
@implements IAsyncDisposable
@inject ITransportOrderQueries Queries
@inject ITransportOrderCommands Commands
@inject TimeProvider Time
@inject IOptions<LiveListOptions> Options
@inject ILogger<LiveTransportOrderList<TripDetailView>> ReadLogger
@inject ILogger<TripDetailPage> Logger

<PageTitle>Trip @Number · Norvia TMS</PageTitle>

<p class="mb-2"><a href="/trips">All Trips</a></p>
<h1>Trip @Number</h1>

<LiveListStates Items="_detail.Items" LastReadFailed="_detail.LastReadFailed" Name="Trip"
                Empty="@($"There is no Trip {Number}.")" Context="details">
    @{ var detail = details[0]; var trip = detail.Trip; }
    <dl aria-label="Trip" class="mb-4 grid grid-cols-[max-content_1fr] gap-x-6 gap-y-1">
        <dt>Status</dt><dd>@trip.Status</dd>
        <dt>Day</dt><dd>@FleetText.Day(trip.Day)</dd>
        <dt>Vehicle</dt><dd>@(trip.VehicleRegistration ?? "—")</dd>
        <dt>Driver</dt><dd>@(trip.DriverName ?? "—")</dd>
        <dt>Planned start</dt><dd>@TripTimes.StartOrDash(trip.PlannedStart)</dd>
        <dt>Planned driving</dt><dd>@TripTimes.DurationOrDash(trip.PlannedDrivingDuration)</dd>
        <dt>Load</dt><dd>@TripText.Load(trip)</dd>
        @if (trip.Status == TripStatus.Dispatched)
        {
            <dt>Delivery</dt><dd>@TripText.Delivery(trip.LatestDelivery)</dd>
        }
    </dl>

    @if (_notice is { } notice)
    {
        <div role="status" class="mb-4">
            <FluentMessageBar Intent="MessageIntent.Success" AllowDismiss="false">@notice</FluentMessageBar>
        </div>
    }

    @if (trip.Status == TripStatus.Draft)
    {
        <p class="mb-4">
            <FluentButton Appearance="Appearance.Accent" Disabled="_working" OnClick="DispatchAsync"
                          aria-label="@($"Dispatch {Number}")">Dispatch</FluentButton>
        </p>
    }

    @if (_refusal is { } refusal)
    {
        <div role="alert" class="mb-4">
            <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">@refusal</FluentMessageBar>
        </div>
    }

    @if (detail.Failures.Count > 0)
    {
        <ul aria-label="Rule failures" role="alert" class="mb-4 list-none space-y-2 p-0">
            @foreach (var failure in detail.Failures)
            {
                <li><FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false"><strong>@failure.Code</strong>: @failure.Message</FluentMessageBar></li>
            }
        </ul>
    }

    @if (detail.Warnings.Count > 0)
    {
        <ul aria-label="Warnings" role="status" class="mb-4 list-none space-y-2 p-0">
            @foreach (var warning in detail.Warnings)
            {
                <li><FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">@warning.Message</FluentMessageBar></li>
            }
        </ul>
    }

    @if (detail.Versions.Count > 0)
    {
        <h2>Versions</h2>
        <table aria-label="Versions" class="flatly-table mb-4">
            <thead><tr><th>Version</th><th>Delivery</th><th>Cause</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var version in detail.Versions)
                {
                    <tr>
                        <td>@version.Version</td>
                        <td>@TripText.Delivery(version.State)</td>
                        <td>@(version.Cause ?? "—")</td>
                        <td>
                            @if (version.CanSendAgain)
                            {
                                <FluentButton Appearance="Appearance.Outline" Disabled="_working" OnClick="@(() => SendAgainAsync(version.Version))"
                                              aria-label="@($"Send version {version.Version} again")">Send again</FluentButton>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (detail.Stops.Count == 0)
    {
        <div role="status">
            <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
                This Trip has no Stops yet. Put Shipments on it from <a href="/trips/shipments">Shipments to put on Trips</a>.
            </FluentMessageBar>
        </div>
    }
    else
    {
        <h2>Stops</h2>
        @if (trip.Status.CanBeAmended())
        {
            <p class="mb-2">Drag a Stop to where it should go, or use its arrows.@(trip.Status == TripStatus.Dispatched ? " A new order goes to the Driver as the next version." : "")</p>
        }
        <TripStopsTable Stops="detail.Stops" Reorderable="@(trip.Status.CanBeAmended())" Disabled="_working" OnReorder="ReorderAsync" />
    }
</LiveListStates>

@code {
    private LiveTransportOrderList<TripDetailView> _detail = null!;
    private readonly CancellationTokenSource _closed = new();
    private string? _refusal;
    private string? _notice;
    private bool _working;

    [Parameter]
    public string Number { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        _detail = new LiveTransportOrderList<TripDetailView>(ReadAsync, $"Trip {Number}", Time, Options.Value.RefreshInterval, ReadLogger);
        _detail.Changed += () => InvokeAsync(StateHasChanged);
        _detail.Start();
    }

    // The list of the one Trip, or an empty one when there is none, which says so.
    private async Task<IReadOnlyList<TripDetailView>> ReadAsync(CancellationToken cancellationToken) =>
        await Queries.FindTripAsync(Number, cancellationToken) is { } detail ? [detail] : [];

    // The TMS checks the order; a refusal leaves the Stops as they were, and the reason is shown until the next move.
    private async Task ReorderAsync(IReadOnlyList<TripStopView> order)
    {
        _working = true;
        _refusal = null;
        try
        {
            var answer = await Commands.ReorderTripStopsAsync(Number, [.. order.Select(stop => new StopReference(stop.ShipmentNumber, stop.Kind))], _closed.Token);
            if (answer is TripAnswer.Refused refused)
            {
                _refusal = $"The Stops were not reordered: {refused.Reason}";
            }
            else
            {
                await _detail.RefreshAsync();
            }
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            // The page closed while the TMS was answering.
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Reordering the Stops of Trip {Number} failed", Number);
            _refusal = "The TMS couldn't reorder the Stops. Try again.";
        }
        finally
        {
            _working = false;
        }
    }

    // The TMS checks every rule again; a refusal leaves the Trip a Draft, and the reason is shown until the next action.
    private async Task DispatchAsync()
    {
        _working = true;
        _refusal = null;
        _notice = null;
        try
        {
            var answer = await Commands.DispatchTripAsync(Number, _closed.Token);
            if (answer is TripAnswer.Dispatched dispatched)
            {
                _notice = $"Trip {Number} dispatched as version {dispatched.Version}.";
                await _detail.RefreshAsync();
            }
            else if (answer is TripAnswer.Refused refused)
            {
                _refusal = $"The Trip was not dispatched: {refused.Reason}";
            }
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            // The page closed while the TMS was answering.
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Dispatching Trip {Number} failed", Number);
            _refusal = "The TMS couldn't dispatch the Trip. Try again.";
        }
        finally
        {
            _working = false;
        }
    }

    // The TMS checks that the version is still the latest and still Not delivered; a refusal leaves it as it was, and the reason is shown until the next action.
    private async Task SendAgainAsync(int version)
    {
        _working = true;
        _refusal = null;
        _notice = null;
        try
        {
            var answer = await Commands.SendTripAgainAsync(Number, version, _closed.Token);
            if (answer is TripAnswer.SentAgain sent)
            {
                _notice = $"Trip {Number} sent again as version {sent.Version}.";
                await _detail.RefreshAsync();
            }
            else if (answer is TripAnswer.Refused refused)
            {
                _refusal = $"The Trip was not sent again: {refused.Reason}";
            }
        }
        catch (OperationCanceledException) when (_closed.IsCancellationRequested)
        {
            // The page closed while the TMS was answering.
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Sending Trip {Number} again failed", Number);
            _refusal = "The TMS couldn't send the Trip again. Try again.";
        }
        finally
        {
            _working = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _closed.CancelAsync();
        _closed.Dispose();
        await _detail.DisposeAsync();
    }
}
