@page "/trips"
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@using Norvia.Tms.Application.Trips
@using Norvia.Tms.Domain.Trips
@using Norvia.Tms.Web.Capacity
@implements IAsyncDisposable
@inject ITransportOrderQueries Queries
@inject ITransportOrderCommands Commands
@inject TimeProvider Time
@inject IOptions<LiveListOptions> Options
@inject ILogger<LiveTransportOrderList<TripView>> TripsLogger
@inject ILogger<LiveTransportOrderList<DateOnly>> DaysLogger
@inject ILogger<TripsPage> Logger

<PageTitle>Trips · Norvia TMS</PageTitle>

<h1>Trips</h1>

<TripForm Title="Create a Draft Trip" SubmitText="Create Trip" Days="OpenDays" Submit="@((entry, token) => Commands.CreateDraftTripAsync(entry, token))" />

@if (_notice is { } notice)
{
    <div role="@(notice.Failed ? "alert" : "status")" class="mb-4">
        <FluentMessageBar Intent="@(notice.Failed ? MessageIntent.Warning : MessageIntent.Success)" AllowDismiss="false">@notice.Text</FluentMessageBar>
    </div>
}

@if (_changing is { } changing)
{
    @* Keyed by the Trip, so picking for another Trip starts a form of its own. *@
    <TripForm @key="changing.Number" Title="@($"Plan {changing.Number}")" SubmitText="Save" FixedDay="changing.Day" ForTrip="@changing.Number"
              InitialVehicleId="@changing.VehicleId" InitialDriverId="@changing.DriverId"
              InitialStart="@changing.PlannedStart" InitialDrivingDuration="@changing.PlannedDrivingDuration"
              Submit="@((entry, token) => Commands.ChangeDraftTripAsync(changing.Number, entry, token))"
              OnDone="@(() => { _changing = null; })" OnCancel="@(() => { _changing = null; })" />
}

<LiveListStates Items="_trips.Items" LastReadFailed="_trips.LastReadFailed" Name="Trips"
                Empty="There are no Trips yet." Context="trips">
    <FluentDataGrid Items="trips.AsQueryable()" TGridItem="TripView" Class="flatly-table" aria-label="Trips"
                    GridTemplateColumns="1.2fr 1.2fr 1fr 1.6fr 1.8fr 1fr 1.2fr 0.8fr 2.4fr 2fr" MultiLine="true">
        <TemplateColumn Title="Trip">
            <a href="/trips/@context.Number">@context.Number</a>
        </TemplateColumn>
        <PropertyColumn Title="Day" Property="@(trip => FleetText.Day(trip.Day))" />
        <PropertyColumn Title="Status" Property="@(trip => trip.Status.ToString())" />
        <PropertyColumn Title="Vehicle" Property="@(trip => trip.VehicleRegistration ?? "—")" />
        <PropertyColumn Title="Driver" Property="@(trip => trip.DriverName ?? "—")" />
        <PropertyColumn Title="Start" Property="@(trip => TripTimes.StartOrDash(trip.PlannedStart))" />
        <PropertyColumn Title="Driving" Property="@(trip => TripTimes.DurationOrDash(trip.PlannedDrivingDuration))" />
        <PropertyColumn Title="Stops" Property="@(trip => trip.StopCount)" />
        <PropertyColumn Title="Load" Property="@(trip => TripText.Load(trip))" />
        <TemplateColumn Title="Actions">
            @if (context.Status == TripStatus.Draft)
            {
                <FluentButton Appearance="Appearance.Outline" OnClick="@(() => { _changing = context; _notice = null; })"
                              aria-label="@($"Plan {context.Number}")">Plan</FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="@(() => DiscardAsync(context))"
                              aria-label="@($"Discard {context.Number}")">Discard</FluentButton>
            }
        </TemplateColumn>
    </FluentDataGrid>
</LiveListStates>

@code {
    private LiveTransportOrderList<TripView> _trips = null!;
    private LiveTransportOrderList<DateOnly> _days = null!;
    private TripView? _changing;
    private Notice? _notice;

    private sealed record Notice(string Text, bool Failed);

    private IReadOnlyList<DateOnly> OpenDays => _days.Items ?? [];

    private async Task DiscardAsync(TripView trip)
    {
        try
        {
            _notice = await Commands.DiscardDraftTripAsync(trip.Number, CancellationToken.None) switch
            {
                TripAnswer.Refused refused => new Notice($"Not discarded: {refused.Reason}", Failed: true),
                _ => new Notice($"Draft Trip {trip.Number} discarded.", Failed: false),
            };
            if (_changing?.Number == trip.Number)
            {
                _changing = null;
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Discarding Trip {TripNumber} failed", trip.Number);
            _notice = new Notice("The TMS couldn't discard the Trip. Try again.", Failed: true);
        }
    }

    protected override void OnInitialized()
    {
        // Both lists exist before either starts: a read that finishes at once renders the page, which reads both.
        _trips = new LiveTransportOrderList<TripView>(Queries.ListTripsAsync, "the Trips", Time, Options.Value.RefreshInterval, TripsLogger);
        _days = new LiveTransportOrderList<DateOnly>(OpenDaysAsync, "the open days", Time, Options.Value.RefreshInterval, DaysLogger);
        _trips.Changed += () => InvokeAsync(StateHasChanged);
        _days.Changed += () => InvokeAsync(StateHasChanged);
        _trips.Start();
        _days.Start();
    }

    private async Task<IReadOnlyList<DateOnly>> OpenDaysAsync(CancellationToken cancellationToken) =>
        [.. (await Queries.ListPlanningDaysAsync(cancellationToken)).Select(day => day.Date)];

    public async ValueTask DisposeAsync()
    {
        await _trips.DisposeAsync();
        await _days.DisposeAsync();
    }
}
