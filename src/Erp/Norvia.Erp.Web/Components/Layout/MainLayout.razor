@inherits LayoutComponentBase

@* Fluent UI's own components take Cerulean's sky blue as their accent, and stay light as Cerulean is. *@
<FluentDesignTheme Mode="DesignThemeModes.Light" CustomColor="#2fa4e7" />

@* Cerulean's navbar: sky blue, with the brand and the main navigation in white. *@
<header class="bg-primary text-white">
    @* The layout renders statically, so it only shows the open view when the page loads in full: enhanced navigation would leave the previous view highlighted. *@
    <nav aria-label="Main" data-enhance-nav="false" class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-8 gap-y-2 px-4 py-4">
        <span class="text-xl font-bold">Norvia ERP</span>
        @foreach (var (path, title, match) in Views)
        {
            <NavLink href="@path" Match="match" class="text-white/75 no-underline hover:text-white" ActiveClass="!text-white">@title</NavLink>
        }
        @if (_userName is not null)
        {
            <span class="ml-auto">@_userName</span>
        }
    </nav>
</header>

<main class="mx-auto max-w-7xl px-4 py-8">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
        Something went wrong. <a href="" class="reload text-white">Reload</a>
    </FluentMessageBar>
</div>

@code {
    private static readonly (string Path, string Title, NavLinkMatch Match)[] Views =
    [
        ("/billable-lines", "Waiting billable lines", NavLinkMatch.Prefix),
        ("/shipper-invoices", "Shipper invoices", NavLinkMatch.Prefix),
        ("/carrier-costs", "Open carrier costs", NavLinkMatch.Prefix),
        ("/", "Shippers", NavLinkMatch.All),
        ("/carriers", "Carriers", NavLinkMatch.Prefix),
        ("/rate-cards", "Rate Cards", NavLinkMatch.Prefix),
        ("/carrier-rate-cards", "Carrier Rate Cards", NavLinkMatch.Prefix),
    ];

    private string? _userName;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var identity = AuthenticationState is null ? null : (await AuthenticationState).User.Identity;
        _userName = identity is { IsAuthenticated: true } ? identity.Name : null;
    }
}
