@page "/carrier-rate-cards"
@attribute [Authorize(Policy = FinanceSignIn.FinancePolicy)]
@using Mediator
@using Norvia.Erp.Application.MasterData.RateCards
@using Norvia.Erp.Application.MasterData.RateCards.ListCarrier
@inject IMediator Mediator
@inject ILogger<CarrierRateCardsPage> Logger

<PageTitle>Carrier Rate Cards · Norvia ERP</PageTitle>

<h1>Carrier Rate Cards</h1>
<p>The ERP loads them from the seed file with the TMS's IDs; <a href="/carrier-rate-cards/new">New Carrier Rate Card</a>.</p>

<MasterDataStates Name="Carrier Rate Cards" Loaded="_loaded" Failed="_failed" Empty="_cards.Count == 0">
    <RateCardList Cards="_cards" PartyKind="Carrier" EditPath="/carrier-rate-cards" />
</MasterDataStates>

@code {
    private IReadOnlyList<RateCardView> _cards = [];
    private bool _loaded;
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _cards = await Mediator.Send(new ListCarrierRateCardsQuery());
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogError(exception, "The Carrier Rate Cards couldn't be read");
            _failed = true;
        }

        _loaded = true;
    }
}
