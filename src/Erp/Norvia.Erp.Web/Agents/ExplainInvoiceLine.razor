@using Ardalis.Result
@using Microsoft.Extensions.Options
@using Norvia.Agents
@using Norvia.Erp.Application.Agents
@using Norvia.Erp.Application.Agents.Explain
@using Norvia.Erp.Domain.Carriers
@inject IOptions<AgentsOptions> Agents
@inject IExplainRequests Requests
@inject ILogger<ExplainInvoiceLine> Logger
@implements IDisposable

@* One fixed question about one Carrier invoice line that is To decide. Off unless Agents:Enabled, and only in Finance's view (the whole
   ERP UI is Finance's). An Agent is never on a critical path (ADR 0040). *@
@if (Agents.Value.Enabled)
{
    <div data-explain="invoice-line" class="mb-4">
        <FluentButton Appearance="Appearance.Neutral" Disabled="_asking" OnClick="ExplainAsync" aria-label="@($"Explain {CarrierBookingReference}")">Explain</FluentButton>

        @if (_asking)
        {
            <div role="status" class="mt-3">
                <FluentStack VerticalAlignment="VerticalAlignment.Center">
                    <FluentProgressRing />
                    <span>The assistant is reading…</span>
                </FluentStack>
            </div>
        }
        else if (_unavailable)
        {
            @* Whatever went wrong, Finance sees this and nothing else changes. *@
            <div role="alert" class="mt-3">
                <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">Assistant unavailable</FluentMessageBar>
            </div>
        }
        else if (_suggestion is { } suggestion)
        {
            @* Text only: what the assistant wrote is data, so it is encoded, never rendered as markup. *@
            <div class="mt-3" data-testid="@($"explanation-{CarrierBookingReference}")">
                <h4>Why it did not match</h4>
                <p>@suggestion.Cause</p>
                <h4>Evidence</h4>
                <ul>
                    @foreach (var evidence in suggestion.Evidence)
                    {
                        <li>@evidence.Claim <cite class="text-muted">[@evidence.ResultId, @evidence.ToolName]</cite></li>
                    }
                </ul>
                <h4>What you could do</h4>
                <p>@suggestion.SuggestedAction</p>
                <p class="text-muted">Confidence: @suggestion.Confidence.ToString().ToLowerInvariant(). The assistant can be wrong; you decide.</p>
            </div>
        }
    </div>
}

@code {
    private bool _asking;
    private bool _unavailable;
    private Suggestion? _suggestion;
    private readonly CancellationTokenSource _lifetime = new();

    [Parameter, EditorRequired]
    public string CarrierId { get; set; } = "";

    [Parameter, EditorRequired]
    public string InvoiceNumber { get; set; } = "";

    [Parameter, EditorRequired]
    public string CarrierBookingReference { get; set; } = "";

    private async Task ExplainAsync()
    {
        _asking = true;
        _unavailable = false;
        _suggestion = null;
        try
        {
            var result = await Requests.ExplainAsync(new ExplainInvoiceLineQuery(new CarrierId(CarrierId), InvoiceNumber, CarrierBookingReference), _lifetime.Token);
            if (result.IsSuccess)
            {
                _suggestion = result.Value;
            }
            else
            {
                _unavailable = true;
                AgentPageLog.ExplainFailed(Logger, CarrierBookingReference, InvoiceNumber, result.Errors.FirstOrDefault() ?? "AgentUnavailable");
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            _unavailable = true;
            AgentPageLog.ExplainCrashed(Logger, exception, CarrierBookingReference, InvoiceNumber);
        }
        finally
        {
            _asking = false;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
