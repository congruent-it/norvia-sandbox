<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Ardalis.Specification.EntityFrameworkCore" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Norvia.Simulator.Application\Norvia.Simulator.Application.csproj" />
    <!-- The personas agent runs in process here (ADR 0041); only Infrastructure knows the Agents' library. -->
    <ProjectReference Include="..\..\Norvia.Agents\Norvia.Agents.csproj" />
  </ItemGroup>
  <!-- The personas agent's definition, which the in-process runner reads as the Foundry deployment script reads it (ADR 0040), and the built-in pools. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\agents\simulator-personas.agent.yaml" LogicalName="agents/%(Filename)%(Extension)" />
    <!-- WithCulture off: ".en", ".nl" and ".de" in a file name would otherwise make MSBuild treat it as a satellite resource. -->
    <EmbeddedResource Include="Personas\Pools\*.txt" WithCulture="false" LogicalName="pools/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Norvia.Simulator.Infrastructure.UnitTests" />
    <!-- NSubstitute substitutes the internal ports the client depends on. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
