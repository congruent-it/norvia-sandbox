@page "/refused"
@attribute [Authorize]

<PageTitle>Not allowed · Simulator</PageTitle>

<h1>You can't use the Simulator</h1>
<p>
    You're signed in as <strong>@_operatorName</strong>, but you don't hold the role this page needs: <code>@OperatorRoles.Run</code>
    to configure and start runs, <code>@OperatorRoles.Read</code> to see them.
</p>
<p>Ask whoever manages Norvia's Entra ID to assign you the role on the Simulator's app registration.</p>

@code {
    private string? _operatorName;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status403Forbidden;
        }

        _operatorName = AuthenticationState is null ? null : (await AuthenticationState).User.Identity?.Name;
    }
}
