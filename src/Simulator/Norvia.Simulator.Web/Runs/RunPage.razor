@page "/runs/{Id:guid}"
@* Interactive, not prerendered: the log is read live, and prerendering would read it twice. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Policy = OperatorSignIn.ReadPolicy)]
@using Ardalis.Result
@using Microsoft.JSInterop
@using Norvia.Simulator.Application.Log.List
@using Norvia.Simulator.Application.Runs.Open
@using Norvia.Simulator.Domain.Log
@using Norvia.Simulator.Domain.Runs
@inject ISimulatorRequests Requests
@inject ConsoleLinks Console
@inject TimeProvider Time
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Run @_run?.Run.Number · Simulator</PageTitle>

@if (_failed)
{
    <div role="alert">
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
            The run couldn't be read. Try again in a moment; if it keeps failing, the Simulator's database may not be reachable.
        </FluentMessageBar>
    </div>
}
else if (_notFound)
{
    <h1>No such run</h1>
    <p>There is no run with this address. It may have been cleared with the history. <a href="/">Go to Configure</a>.</p>
}
else if (_run is null)
{
    <div role="status">
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentProgressRing />
            <span>Loading…</span>
        </FluentStack>
    </div>
}
else
{
    var run = _run.Run;
    <h1>Run @run.Number</h1>
    <p role="status" class="mb-2">
        <strong data-status="@run.Status">@SimulatorText.Of(run.Status)</strong>:
        @run.Sent of @run.Planned bookings sent@(run.ToAssign > 0 ? $", {run.Assigned} of {run.ToAssign} Transport Orders planned" : ""), @SimulatorText.Of(run.Mode, TimeSpan.Zero).ToLowerInvariant(), seed @run.Seed.
        Started @SimulatorText.DateAndTime(run.StartedAt) by @run.StartedBy@(run.FinishedAt is { } done ? $", finished {SimulatorText.DateAndTime(done)}" : "").
    </p>
    <p class="text-muted">
        @foreach (var outcome in _run.Outcomes)
        {
            <span class="mr-4" data-outcome="@outcome.Outcome">@SimulatorText.Of(outcome.Outcome): @outcome.Count</span>
        }
    </p>

    @if (_problem is not null)
    {
        <div role="alert" class="mb-4">
            <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">@_problem</FluentMessageBar>
        </div>
    }

    <AuthorizeView Policy="@OperatorSignIn.RunPolicy">
        @if (run.IsActive)
        {
            <div class="mb-6">
                <FluentButton OnClick="Cancel">Cancel run</FluentButton>
            </div>
        }
    </AuthorizeView>

    <EditForm Model="_filter" OnSubmit="ApplyFilter" role="search" aria-label="Filter the log" class="mb-6 flex flex-wrap items-end gap-4">
        <FluentSelect TOption="string" Label="Actor" @bind-Value="_filter.Actor" @bind-Value:after="ApplyFilter">
            <FluentOption TOption="string" Value="">All actors</FluentOption>
            @foreach (var actor in _run.Actors)
            {
                <FluentOption TOption="string" Value="@actor">@actor</FluentOption>
            }
        </FluentSelect>
        <FluentSelect TOption="string" Label="Outcome" @bind-Value="_filter.Outcome" @bind-Value:after="ApplyFilter">
            <FluentOption TOption="string" Value="">All outcomes</FluentOption>
            @foreach (var outcome in Enum.GetValues<LogOutcome>())
            {
                <FluentOption TOption="string" Value="@outcome.ToString()">@SimulatorText.Of(outcome)</FluentOption>
            }
        </FluentSelect>
        <FluentTextField @bind-Value="_filter.Text" Label="Correlation ID, reference, order or Shipment number" Class="min-w-80 grow" />
        <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">Filter</FluentButton>
    </EditForm>

    @if (_log.Count == 0)
    {
        <p class="text-muted" role="status">No log lines match.</p>
    }
    else
    {
        <div role="log" aria-label="Log" aria-live="polite">
            <FluentDataGrid Items="_log.AsQueryable()" TGridItem="LogLine" MultiLine="true" aria-label="Log lines">
                <PropertyColumn Title="Time" Property="@(line => SimulatorText.Time(line.At))" />
                <PropertyColumn Title="Actor" Property="@(line => line.Actor)" />
                <PropertyColumn Title="Action" Property="@(line => line.Action)" />
                <TemplateColumn Title="Outcome">
                    <span data-outcome="@context.Outcome" class="@OutcomeClass(context.Outcome)">@SimulatorText.Of(context.Outcome)</span>
                </TemplateColumn>
                <TemplateColumn Title="Correlation ID">
                    @if (context.CorrelationId is { } correlationId)
                    {
                        <span class="font-mono text-xs">@correlationId</span>
                        <FluentButton Appearance="Appearance.Lightweight" aria-label="@($"Copy correlation ID {correlationId}")" OnClick="@(() => Copy(correlationId))">Copy</FluentButton>
                        @if (Console.Trail(correlationId) is { } trail)
                        {
                            <a href="@trail" target="_blank" rel="noopener" aria-label="@($"Open the Message trail of {correlationId} in the Integration console")">Message trail</a>
                        }
                    }
                </TemplateColumn>
                <PropertyColumn Title="Shipper reference" Property="@(line => line.ShipperReference)" />
                <PropertyColumn Title="Transport Order" Property="@(line => line.TransportOrderNumber)" />
                <PropertyColumn Title="Shipment" Property="@(line => line.ShipmentNumber)" />
                <PropertyColumn Title="Trip" Property="@(line => line.TripNumber)" />
                <PropertyColumn Title="Detail" Property="@(line => line.Detail)" />
            </FluentDataGrid>
        </div>
    }
}

@code {
    private static readonly TimeSpan PollEvery = TimeSpan.FromSeconds(1.5);

    private RunDetail? _run;
    private IReadOnlyList<LogLine> _log = [];
    private bool _notFound;
    private bool _failed;
    private readonly CancellationTokenSource _cancellation = new();
    private string? _problem;
    private readonly LogFilterForm _filter = new();
    private ITimer? _poll;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        if (_run is { Run.IsActive: true })
        {
            // Live while the run is sending; once it has finished the last refresh is the whole log.
            _poll = Time.CreateTimer(_ => _ = InvokeAsync(PollAsync), state: null, PollEvery, PollEvery);
        }
    }

    private async Task PollAsync()
    {
        await RefreshAsync();
        if (_run is not { Run.IsActive: true })
        {
            _poll?.Dispose();
            _poll = null;
        }

        StateHasChanged();
    }

    private async Task RefreshAsync()
    {
        try
        {
            var runId = new SimulationRunId(Id);
            var run = await Requests.GetRunAsync(runId, _cancellation.Token);
            if (!run.IsSuccess)
            {
                _notFound = true;
                return;
            }

            _run = run.Value;
            _log = await Requests.ListLogAsync(runId, Filter(), _cancellation.Token);
            _failed = false;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            // Polling goes on: the next refresh may reach the database again.
            _failed = true;
        }
    }

    private LogFilter Filter() => new(
        string.IsNullOrEmpty(_filter.Actor) ? null : _filter.Actor,
        Enum.TryParse<LogOutcome>(_filter.Outcome, out var outcome) ? outcome : null,
        _filter.Text);

    private async Task ApplyFilter() => _log = await Requests.ListLogAsync(new SimulationRunId(Id), Filter(), _cancellation.Token);

    private async Task Cancel()
    {
        var result = await Requests.CancelAsync(new SimulationRunId(Id), _cancellation.Token);
        _problem = result.IsSuccess ? null : string.Join(" ", result.Errors);
        await RefreshAsync();
    }

    private async Task Copy(string correlationId) => await Js.InvokeVoidAsync("navigator.clipboard.writeText", correlationId);

    private static string OutcomeClass(LogOutcome outcome) => outcome switch
    {
        LogOutcome.Rejected or LogOutcome.Refused or LogOutcome.NotReceived or LogOutcome.PlanningRefused or LogOutcome.PlanningNotReceived or LogOutcome.CarrierRefused or LogOutcome.CarrierNotReceived or LogOutcome.DriverRefused or LogOutcome.DriverNotReceived => "font-bold text-danger",
        LogOutcome.AlreadyBooked or LogOutcome.Declined or LogOutcome.NoAnswer or LogOutcome.ExceptionFound => "text-warning",
        LogOutcome.Accepted or LogOutcome.Planned or LogOutcome.Reassigned or LogOutcome.Released or LogOutcome.Confirmed or LogOutcome.TrackingSent or LogOutcome.ProofOfDeliverySent or LogOutcome.BookingCancelled or LogOutcome.ExceptionResolved or LogOutcome.TripBuilt or LogOutcome.TripDispatched or LogOutcome.DriverReported or LogOutcome.TripCompleted => "text-success",
        _ => "text-muted",
    };

    public void Dispose()
    {
        _poll?.Dispose();
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
