@page "/plan"
@* Interactive, not prerendered: the preview is made once, for the operator who asked for it. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Policy = OperatorSignIn.RunPolicy)]
@using Ardalis.Result
@using Norvia.Simulator.Application.Plans.Preview
@using Norvia.Simulator.Domain.Personas
@using Norvia.Simulator.Domain.Plans
@using Norvia.Simulator.Domain.Runs
@inject ISimulatorRequests Requests
@inject NavigationManager Navigation
@inject AuthenticationStateProvider Authentication
@implements IDisposable

<PageTitle>Simulator · Plan preview</PageTitle>

<h1>Plan preview</h1>

@if (_settings is null)
{
    <div role="alert">
        <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
            There are no settings to preview. <a href="/" class="text-white">Configure a run</a> first.
        </FluentMessageBar>
    </div>
}
else if (_failed)
{
    <div role="alert">
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
            The plan couldn't be made. Try again in a moment; if it keeps failing, its database may not be reachable.
        </FluentMessageBar>
    </div>
}
else if (_problems.Count > 0)
{
    <div role="alert">
        <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
            @string.Join(" ", _problems) <a href="/" class="text-white">Back to Configure</a>
        </FluentMessageBar>
    </div>
}
else if (_preview is null)
{
    <div role="status">
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentProgressRing />
            <span>Making the plan…</span>
        </FluentStack>
    </div>
}
else
{
    <p class="text-muted" role="status">
        Run @_preview.RunNumber would send @_preview.Rows.Count bookings, @_preview.BadBookings of them bad, @SimulatorText.Of(_preview.Settings.Mode, _preview.Settings.Window).ToLowerInvariant(),
        from seed @_preview.Settings.Seed. This is exactly what Start run sends.
    </p>
    <p class="text-muted" data-testid="planner-funnel">
        Then the Planner assigns @_preview.Planner.Assigned of the @_preview.Planner.Orders orders Norvia is expected to accept
        (@_preview.Settings.AssignedPercent%): @_preview.Planner.TryOwnFleet to Own fleet where it fits, @_preview.Planner.Carrier to a Carrier.
        It reassigns @_preview.Planner.Reassigned (@_preview.Settings.ReassignPercent%).
    </p>

    <p class="text-muted" data-testid="carrier-funnel">
        Of the @_preview.Carriers.Shipments Shipments meant for a Carrier, the Planner releases @_preview.Carriers.Counts.Released (@_preview.Settings.Carriers.ReleasePercent%).
        The Carriers confirm @_preview.Carriers.Counts.Confirmed, decline @_preview.Carriers.Counts.Declined and leave @_preview.Carriers.Counts.NoAnswer unanswered.
        They track @_preview.Carriers.Counts.Tracked, @_preview.Carriers.Counts.Exceptions of which hit an Exception, and deliver @_preview.Carriers.Counts.Delivered,
        @_preview.Carriers.Counts.ProofsOfDelivery with a Proof of delivery. The Planner cancels @_preview.Carriers.Counts.Cancelled failed collections.
        These are the most a run can reach: what goes to Own fleet, and what the estate refuses, is known only when it runs.
    </p>

    <p class="text-muted" data-testid="driver-funnel">
        The Planner puts @_preview.Settings.TripPercent% of the Shipments that stay with the Own fleet on Trips and dispatches them. Of the @_preview.Drivers.Shipments Shipments meant for Own fleet that collect today,
        the Drivers deliver @_preview.Drivers.Counts.Delivered (@_preview.Drivers.Counts.WithReservations with reservations), fail @_preview.Drivers.Counts.CollectionsFailed collections and
        @_preview.Drivers.Counts.DeliveriesFailed deliveries, and report damage on @_preview.Drivers.Counts.Damaged. Trips for later days stay Dispatched.
    </p>

    <p class="text-muted" data-testid="invoicing-funnel">
        Once Shipments are delivered, Finance runs Invoice now for @_preview.Invoicing.Counts.Invoiced of the @_preview.Invoicing.Shippers Shippers whose bookings are accepted (@_preview.Settings.Invoicing.InvoicePercent%)
        and credits part of one line on @_preview.Invoicing.Counts.Credited of the invoices (@_preview.Settings.Invoicing.CreditNotePercent%). The invoice and the Credit note then show in the Shipper's invoices inbox.
        A Shipper none of whose orders were delivered gets no invoice.
    </p>

    <p class="text-muted" data-testid="carrier-invoicing-funnel">
        Each Carrier that delivers then sends an invoice for its delivered bookings, with one edited amount on @_preview.Settings.Invoicing.EditedCarrierInvoicePercent% of the invoices, and Finance rejects
        @_preview.Settings.Invoicing.RejectedCarrierLinePercent% of the lines left to decide and accepts the rest at the agreed amount. The outcome of each line then shows on the Carrier's invoices page.
    </p>

    @if (_preview.Pools.Count > 0 || _preview.PoolNotes.Count > 0)
    {
        <section aria-labelledby="pools-heading" data-testid="pools">
            <h2 id="pools-heading">Carrier texts</h2>
            <p class="text-muted">
                A decline with the reason Other and a failed delivery carry a text a Carrier writes in its own words. The plan draws each one by the seed from the pool
                below, so Start run sends exactly these, and a recorded plan replays them with no model.
            </p>
            @foreach (var note in _preview.PoolNotes)
            {
                <div role="status" class="mb-2">
                    <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">@note</FluentMessageBar>
                </div>
            }
            @foreach (var pool in _preview.Pools)
            {
                <div class="mb-4" data-testid="pool">
                    <h3>@pool.ProfileId · @TextKind(pool.Category) · @pool.Language</h3>
                    <p class="text-muted">
                        Source: @pool.Source. @pool.Count texts, written by @string.Join(", ", pool.CarrierIds). A sample:
                    </p>
                    <ul>
                        @foreach (var sample in pool.Samples)
                        {
                            <li>@sample</li>
                        }
                    </ul>
                </div>
            }
        </section>
    }

    @if (_startProblems.Count > 0)
    {
        <div role="alert" class="mb-4">
            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
                @string.Join(" ", _startProblems)
            </FluentMessageBar>
        </div>
    }

    <div class="mb-6 flex gap-4">
        <FluentButton Appearance="Appearance.Accent" OnClick="Start" Disabled="@_starting">Start run</FluentButton>
        <FluentButton OnClick="@(() => Navigation.NavigateTo("/"))">Back to Configure</FluentButton>
    </div>

    <h2>Per Shipper</h2>
    <FluentDataGrid Items="_preview.PerShipper.AsQueryable()" TGridItem="ShipperShare" GridTemplateColumns="minmax(14rem, 3fr) 1fr 1fr" aria-label="Bookings per Shipper">
        <PropertyColumn Title="Shipper" Property="@(share => share.ShipperName)" />
        <PropertyColumn Title="Bookings" Property="@(share => share.Bookings)" />
        <PropertyColumn Title="Bad" Property="@(share => share.BadBookings)" />
    </FluentDataGrid>

    <h2 class="mt-10">Bookings</h2>
    <div class="overflow-x-auto">
    <FluentDataGrid Items="_preview.Rows.AsQueryable()" TGridItem="PlanRow" Pagination="_pagination" GridTemplateColumns="4rem 10rem minmax(14rem, 1.5fr) minmax(18rem, 1.5fr) 8rem 8rem 12rem 10rem minmax(22rem, 2fr)" aria-label="Planned bookings">
        <PropertyColumn Title="#" Property="@(row => row.Step)" />
        <PropertyColumn Title="Shipper reference" Property="@(row => row.Reference)" />
        <PropertyColumn Title="Sent as" Property="@(row => row.Actor)" />
        <PropertyColumn Title="Route" Property="@(row => row.Route)" />
        <PropertyColumn Title="Collected" Property="@(row => row.DayOffset == 0 ? "today" : $"in {row.DayOffset} days")" />
        <PropertyColumn Title="Weight (kg)" Property="@(row => row.WeightKg)" />
        <PropertyColumn Title="Kind" Property="@(row => KindOf(row))" />
        <PropertyColumn Title="Expected answer" Property="@(row => SimulatorText.Of(row.Expected))" />
        <PropertyColumn Title="Planner" Property="@(row => SimulatorText.Of(row.Planner, row.Reassign))" />
    </FluentDataGrid>
    </div>
    <FluentPaginator State="_pagination" />
}

@code {
    private static string TextKind(string category) => category switch
    {
        nameof(TextCategory.DeclineReason) => "Decline reason",
        nameof(TextCategory.DeliveryFailedRemark) => "Delivery failed remark",
        _ => category,
    };

    private readonly PaginationState _pagination = new() { ItemsPerPage = 25 };

    private SimulationSettings? _settings;
    private PlanPreview? _preview;
    private List<string> _problems = [];
    private List<string> _startProblems = [];
    private bool _starting;
    private bool _failed;
    private readonly CancellationTokenSource _cancellation = new();

    [SupplyParameterFromQuery(Name = "orders")]
    private int? Orders { get; set; }

    [SupplyParameterFromQuery(Name = "bad")]
    private int? Bad { get; set; }

    [SupplyParameterFromQuery(Name = "today")]
    private int? Today { get; set; }

    [SupplyParameterFromQuery(Name = "seed")]
    private int? Seed { get; set; }

    [SupplyParameterFromQuery(Name = "mode")]
    private string? Mode { get; set; }

    [SupplyParameterFromQuery(Name = "window")]
    private int? Window { get; set; }

    [SupplyParameterFromQuery(Name = "preset")]
    private string? Preset { get; set; }

    [SupplyParameterFromQuery(Name = "assigned")]
    private int? Assigned { get; set; }

    [SupplyParameterFromQuery(Name = "ownfleet")]
    private int? OwnFleet { get; set; }

    [SupplyParameterFromQuery(Name = "reassign")]
    private int? Reassign { get; set; }

    [SupplyParameterFromQuery(Name = "release")]
    private int? Release { get; set; }

    [SupplyParameterFromQuery(Name = "confirm")]
    private int? Confirm { get; set; }

    [SupplyParameterFromQuery(Name = "decline")]
    private int? Decline { get; set; }

    [SupplyParameterFromQuery(Name = "tracked")]
    private int? Tracked { get; set; }

    [SupplyParameterFromQuery(Name = "exception")]
    private int? ExceptionShare { get; set; }

    [SupplyParameterFromQuery(Name = "delivered")]
    private int? Delivered { get; set; }

    [SupplyParameterFromQuery(Name = "pod")]
    private int? ProofOfDelivery { get; set; }

    [SupplyParameterFromQuery(Name = "cancel")]
    private int? CancelShare { get; set; }

    [SupplyParameterFromQuery(Name = "trips")]
    private int? Trips { get; set; }

    [SupplyParameterFromQuery(Name = "collfail")]
    private int? CollectionFailed { get; set; }

    [SupplyParameterFromQuery(Name = "delfail")]
    private int? DeliveryFailed { get; set; }

    [SupplyParameterFromQuery(Name = "damaged")]
    private int? Damaged { get; set; }

    [SupplyParameterFromQuery(Name = "reservations")]
    private int? Reservations { get; set; }

    [SupplyParameterFromQuery(Name = "invoiced")]
    private int? Invoiced { get; set; }

    [SupplyParameterFromQuery(Name = "credited")]
    private int? Credited { get; set; }

    [SupplyParameterFromQuery(Name = "editedinvoices")]
    private int? EditedInvoices { get; set; }

    [SupplyParameterFromQuery(Name = "rejectedlines")]
    private int? RejectedLines { get; set; }

    private static string KindOf(PlanRow row) => row.Bad is { } bad ? SimulatorText.Of(bad) : "Good";

    protected override async Task OnParametersSetAsync()
    {
        _settings = PlanLinks.Settings(
            Orders, Bad, Today, Seed, Mode, Window, Preset, Assigned, OwnFleet, Reassign,
            Release, Confirm, Decline, Tracked, ExceptionShare, Delivered, ProofOfDelivery, CancelShare,
            CollectionFailed, DeliveryFailed, Damaged, Reservations, Trips, Invoiced, Credited, EditedInvoices, RejectedLines);
        if (_settings is null)
        {
            return;
        }

        Result<PlanPreview> result;
        try
        {
            result = await Requests.PreviewAsync(_settings, _cancellation.Token);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _failed = true;
            return;
        }

        if (result.IsSuccess)
        {
            _preview = result.Value;
            _problems = [];
        }
        else
        {
            _problems = [.. result.ValidationErrors.Select(error => error.ErrorMessage).Concat(result.Errors)];
        }
    }

    private async Task Start()
    {
        _starting = true;
        _startProblems = [];
        var operatorName = (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";
        var result = await Requests.StartAsync(_settings!, operatorName, _cancellation.Token);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo(PlanLinks.Run(result.Value.Id));
            return;
        }

        _startProblems = [.. result.ValidationErrors.Select(error => error.ErrorMessage).Concat(result.Errors)];
        _starting = false;
    }

    public void Dispose()
    {
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
