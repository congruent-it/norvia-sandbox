@page "/"
@* Interactive, not prerendered: the Presets fill the form, and the seed offered is random. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Policy = OperatorSignIn.RunPolicy)]
@using Norvia.Simulator.Application.Configure
@using Norvia.Simulator.Application.Reset
@using Norvia.Simulator.Application.Runs
@using Norvia.Simulator.Domain.Runs
@inject ISimulatorRequests Requests
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Configure · Simulator</PageTitle>

<h1>Configure a run</h1>
<p class="text-muted">
    A run books for the estate's Shippers through the Norvia Partner API, as each Shipper's Persona, plans what Norvia
    accepted through the TMS API, as the Planner, and then has the Carriers answer, track and deliver what went to them, as their
    Personas. What stays with the Own fleet goes on Trips the Planner dispatches, and the Drivers work the Trips of today through the Driver app,
    as themselves. Once the deliveries are in, Finance runs Invoice now in the ERP and credits part of a line, and the invoices reach the Shippers' inboxes. Every booking, assignment, Carrier message, Driver report and invoice has a real Message trail. Choose a Preset or
    set the numbers yourself, then preview the plan: the same seed always gives the same plan.
</p>

@if (_failed)
{
    <div role="alert">
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
            The Simulator couldn't load its settings or runs. Try again in a moment; if it keeps failing, its database may not be reachable.
        </FluentMessageBar>
    </div>
}
else if (_view is null)
{
    <div role="status">
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentProgressRing />
            <span>Loading…</span>
        </FluentStack>
    </div>
}
else
{
    @if (_active is { } active)
    {
        <div role="status" class="mb-4">
            <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
                Run @active.Number is still sending. <a href="@PlanLinks.Run(active.Id)" class="text-white">Open it</a>. A second run can't start meanwhile.
            </FluentMessageBar>
        </div>
    }

    <EditForm Model="_form" OnValidSubmit="Preview" OnInvalidSubmit="StateHasChanged" FormName="run-settings" Context="editContext">
        <DataAnnotationsValidator />
        @if (editContext.GetValidationMessages().Any())
        {
            <div role="alert" class="mb-4">
                <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
                    @string.Join(" ", editContext.GetValidationMessages())
                </FluentMessageBar>
            </div>
        }

        <div aria-label="Run settings" role="group" class="mb-8">
        <FluentAccordion ExpandMode="AccordionExpandMode.Multi">
            <FluentAccordionItem Heading="Start from" Expanded="true">
                <p class="text-muted mb-4 text-sm">A Preset fills every number below; change any of them and the run becomes Custom.</p>
                <div class="grid grid-cols-[repeat(auto-fill,minmax(17rem,1fr))] gap-4 [&_fluent-number-field]:w-full [&_fluent-select]:w-full [&_fluent-select]:min-w-0">
                <div class="flex flex-col gap-1">
                    <FluentSelect TOption="string" Label="Preset" @bind-Value="_form.Preset" @bind-Value:after="PresetChanged">
                        <FluentOption TOption="string" Value="@RunForm.CustomPreset">Custom</FluentOption>
                        @foreach (var preset in _view.Presets)
                        {
                            <FluentOption TOption="string" Value="@preset.Name">@preset.Name</FluentOption>
                        }
                    </FluentSelect>
                </div>
                </div>
            </FluentAccordionItem>
            <FluentAccordionItem Heading="Shippers" Expanded="true">
                <p class="text-muted mb-4 text-sm">What the Shippers book through the Partner API.</p>
                <div class="grid grid-cols-[repeat(auto-fill,minmax(17rem,1fr))] gap-4 [&_fluent-number-field]:w-full [&_fluent-select]:w-full [&_fluent-select]:min-w-0">
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.Orders" Label="Orders" Min="1" Max="@_view.Limits.MaxOrdersPerRun.ToString()" /></div>
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.BadPercent" Label="Bad bookings (%)" Min="0" Max="100" /></div>
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.TodayPercent" Label="Collected today (%)" Min="0" Max="100" /></div>
                </div>
            </FluentAccordionItem>
            <FluentAccordionItem Heading="Planner" Expanded="true">
                <p class="text-muted mb-4 text-sm">What the Planner does with the orders Norvia accepted, through the TMS API.</p>
                <div class="grid grid-cols-[repeat(auto-fill,minmax(17rem,1fr))] gap-4 [&_fluent-number-field]:w-full [&_fluent-select]:w-full [&_fluent-select]:min-w-0">
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.AssignedPercent" Label="Assigned by the Planner (%)" Min="0" Max="100" /></div>
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.OwnFleetPercent" Label="To Own fleet where it fits (%)" Min="0" Max="100" /></div>
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.ReassignPercent" Label="Reassigned (%)" Min="0" Max="100" /></div>
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.ReleasePercent" Label="Released by the Planner (%)" Min="0" Max="100" /></div>
                </div>
            </FluentAccordionItem>
            <FluentAccordionItem Heading="Carriers" Expanded="true">
                <p class="text-muted mb-4 text-sm">Each step is a share of the step before it.</p>
                <div class="grid grid-cols-[repeat(auto-fill,minmax(17rem,1fr))] gap-4 [&_fluent-number-field]:w-full [&_fluent-select]:w-full [&_fluent-select]:min-w-0">
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.ConfirmPercent" Label="Confirmed by the Carrier (%)" Min="0" Max="100" /></div>
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.DeclinePercent" Label="Declined by the Carrier (%)" Min="0" Max="100" /></div>
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.TrackedPercent" Label="Tracked (%)" Min="0" Max="100" /></div>
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.ExceptionPercent" Label="Exceptions on the way (%)" Min="0" Max="100" /></div>
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.DeliveredPercent" Label="Delivered (%)" Min="0" Max="100" /></div>
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.ProofOfDeliveryPercent" Label="With a Proof of delivery (%)" Min="0" Max="100" /></div>
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.CancelPercent" Label="Failed collections cancelled (%)" Min="0" Max="100" /></div>
                </div>
            </FluentAccordionItem>
            <FluentAccordionItem Heading="Own fleet and Drivers" Expanded="true">
                <p class="text-muted mb-4 text-sm">The Trips the Planner builds and what the Drivers report on the day.</p>
                <div class="grid grid-cols-[repeat(auto-fill,minmax(17rem,1fr))] gap-4 [&_fluent-number-field]:w-full [&_fluent-select]:w-full [&_fluent-select]:min-w-0">
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.TripPercent" Label="Own fleet put on Trips (%)" Min="0" Max="100" /></div>
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.CollectionFailedPercent" Label="Collections that fail (%)" Min="0" Max="100" /></div>
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.DeliveryFailedPercent" Label="Deliveries that fail (%)" Min="0" Max="100" /></div>
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.DamagedPercent" Label="Damage reported (%)" Min="0" Max="100" /></div>
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.ReservationsPercent" Label="Delivered with reservations (%)" Min="0" Max="100" /></div>
                </div>
            </FluentAccordionItem>
            <FluentAccordionItem Heading="Finance and invoicing" Expanded="true">
                <p class="text-muted mb-4 text-sm">Once the deliveries are in, Finance runs Invoice now in the ERP and credits part of a line. The invoices reach the Shippers' inboxes.</p>
                <div class="grid grid-cols-[repeat(auto-fill,minmax(17rem,1fr))] gap-4 [&_fluent-number-field]:w-full [&_fluent-select]:w-full [&_fluent-select]:min-w-0">
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.InvoicePercent" Label="Shippers invoiced (%)" Min="0" Max="100" /></div>
                <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.CreditNotePercent" Label="Invoices credited in part (%)" Min="0" Max="100" /></div>
                </div>
            </FluentAccordionItem>
            <FluentAccordionItem Heading="How it is sent" Expanded="true">
                <p class="text-muted mb-4 text-sm">How fast the plan goes out, and the seed that makes the same plan every time.</p>
                <div class="grid grid-cols-[repeat(auto-fill,minmax(17rem,1fr))] items-end gap-4 [&_fluent-number-field]:w-full [&_fluent-select]:w-full [&_fluent-select]:min-w-0">
                    <div class="flex flex-col gap-1">
                        <FluentSelect TOption="string" Label="Sending" @bind-Value="_form.Mode">
                            <FluentOption TOption="string" Value="@nameof(RunMode.Burst)">Burst, as fast as the estate accepts</FluentOption>
                            <FluentOption TOption="string" Value="@nameof(RunMode.Paced)">Paced, spread over a window</FluentOption>
                        </FluentSelect>
                    </div>
                    @if (_form.IsPaced)
                    {
                        <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.WindowMinutes" Label="Window (minutes)" Min="1" Max="@SimulationSettings.MaxWindowMinutes.ToString()" /></div>
                    }
                    <div class="flex flex-col gap-1"><FluentNumberField TValue="int" @bind-Value="_form.Seed" Label="Seed" /></div>
                    <div><FluentButton Type="ButtonType.Button" OnClick="NewSeed">New seed</FluentButton></div>
                </div>
            </FluentAccordionItem>

        </FluentAccordion>
        </div>

        <div class="sticky bottom-0 -mx-4 mb-4 border-t border-border bg-body px-4 py-3">
            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">Preview plan</FluentButton>
        </div>
    </EditForm>

    <p class="text-muted">
        At most @_view.Limits.MaxOrdersPerRun orders per run and @_view.Limits.MaxConcurrentRequests requests at once. The next run is number @_view.NextRunNumber:
        its Shipper references are <code>SIM-@_view.NextRunNumber-1</code>, <code>SIM-@_view.NextRunNumber-2</code> and so on.
    </p>

    @if (_clearProblem is not null)
    {
        <div role="alert" class="mb-4">
            <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">@_clearProblem</FluentMessageBar>
        </div>
    }

    <h2>Runs</h2>
    @if (_runs.Count == 0)
    {
        <p class="text-muted" role="status">No runs yet.</p>
    }
    else
    {
        <FluentDataGrid Items="_runs.AsQueryable()" TGridItem="RunSummary" aria-label="Runs">
            <TemplateColumn Title="Run">
                <a href="@PlanLinks.Run(context.Id)">Run @context.Number</a>
            </TemplateColumn>
            <PropertyColumn Title="Status" Property="@(run => SimulatorText.Of(run.Status))" />
            <PropertyColumn Title="Started" Property="@(run => SimulatorText.DateAndTime(run.StartedAt))" />
            <PropertyColumn Title="Sent" Property="@(run => $"{run.Sent} of {run.Planned}")" />
            <PropertyColumn Title="Sending" Property="@(run => SimulatorText.Of(run.Mode, TimeSpan.Zero))" />
            <PropertyColumn Title="Preset" Property="@(run => run.PresetName ?? "Custom")" />
            <PropertyColumn Title="Seed" Property="@(run => run.Seed)" />
        </FluentDataGrid>
        <div class="mt-4">
            <FluentButton OnClick="ClearHistory" Disabled="@(_active is not null)">Clear history</FluentButton>
        </div>
    }

    <h2>Reset estate</h2>
    <p class="text-muted">
        Clear history removes only the Simulator's own runs and logs. Reset estate returns the whole estate to a clean sheet, so the next demo starts from nothing:
        what a run or a person created is deleted, whoever created it, in the TMS, the Partner portal, the Driver app and here.
    </p>
    @if (_resetReason is not null)
    {
        <p class="text-muted" role="status">@_resetReason</p>
    }
    <FluentButton OnClick="AskToReset" Disabled="@(_resetReason is not null || _resetting)">Reset estate</FluentButton>

    @if (_confirmingReset)
    {
        <div role="alertdialog" aria-label="Confirm reset" class="my-4">
            <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
                <p>This deletes, and can't be undone:</p>
                <ul class="list-disc pl-6">
                    <li>In the TMS: every Transport Order, Shipment, Trip, Exception, Carrier booking, Tracking event, Proof of delivery and Message, and the Planner's changes to Rosters, Absences and Off the road days.</li>
                    <li>In the Partner portal: every booking, Carrier booking request and notification, and the Personas' answer and tracking modes.</li>
                    <li>In the Driver app: every Trip and Driver report.</li>
                    <li>In the Simulator: every run and log line. The next run is number 1, with the Shipper references <code>SIM-1-1</code>, <code>SIM-1-2</code> and so on.</li>
                </ul>
                <p>The Shippers, Carriers, Drivers, Vehicles, Rate Cards and Personas stay.</p>
            </FluentMessageBar>
            <div class="mt-2 flex gap-2">
                <FluentButton Appearance="Appearance.Accent" OnClick="ResetEstate">Delete everything and reset</FluentButton>
                <FluentButton OnClick="KeepEverything">Keep everything</FluentButton>
            </div>
        </div>
    }

    @if (_resetting)
    {
        <div role="status" class="my-4">
            <FluentStack VerticalAlignment="VerticalAlignment.Center">
                <FluentProgressRing />
                <span>Resetting the estate…</span>
            </FluentStack>
        </div>
    }

    @if (_resetProblem is not null)
    {
        <div role="alert" class="my-4">
            <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">@_resetProblem</FluentMessageBar>
        </div>
    }

    @if (_resetReport is { } report)
    {
        <div role="status" aria-label="Reset result" class="my-4">
            <FluentMessageBar Intent="@(report.Complete ? MessageIntent.Success : MessageIntent.Warning)" AllowDismiss="false">
                @if (report.Complete)
                {
                    <p>The estate is a clean sheet.</p>
                }
                else
                {
                    <p>Not everything was reset. What was deleted stays deleted, the Simulator's runs and logs were kept to show what happened, and the reset can be run again.</p>
                }
                <ul class="list-disc pl-6">
                    @foreach (var app in report.Apps)
                    {
                        <li>@EstateApps.NameOf(app.App): @(app.Succeeded ? Deleted(app.Deleted) : $"refused. {app.Refusal}")</li>
                    }
                    @if (report.Complete)
                    {
                        <li>Simulator: @Deleted(report.Simulator)</li>
                    }
                </ul>
            </FluentMessageBar>
        </div>
    }
}

@code {
    private ConfigureView? _view;
    private IReadOnlyList<RunSummary> _runs = [];
    private RunSummary? _active;
    private readonly RunForm _form = new();
    private bool _failed;
    private string? _clearProblem;
    private string? _resetReason;
    private string? _resetProblem;
    private EstateResetReport? _resetReport;
    private bool _confirmingReset;
    private bool _resetting;
    private readonly CancellationTokenSource _cancellation = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _view = await Requests.GetConfigureAsync(_cancellation.Token);
            _form.Seed = _view.NewSeed;
            _form.Limits = _view.Limits;
            if (!FillFromAddress())
            {
                _form.Fill(_view.Presets[0]);
            }

            Navigation.LocationChanged += OnLocationChanged;
            await LoadRunsAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _failed = true;
        }
    }

    // "Run again" from a run's page: its settings, with its seed or a new one.
    private bool FillFromAddress()
    {
        if (_view is null || PlanLinks.ConfigureSettings(new Uri(Navigation.Uri), _view.NewSeed) is not { } earlier)
        {
            return false;
        }

        _form.Fill(earlier, _view.Presets);
        return true;
    }

    // An address with a run's settings opened while Configure is showing refills the form.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (FillFromAddress())
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        _cancellation.Cancel();
        _cancellation.Dispose();
    }

    private async Task LoadRunsAsync()
    {
        _runs = await Requests.ListRunsAsync(_cancellation.Token);
        _active = _runs.FirstOrDefault(run => run.IsActive);
        await LoadResetReadinessAsync();
    }

    private async Task LoadResetReadinessAsync()
    {
        try
        {
            _resetReason = (await Requests.GetResetReadinessAsync(_cancellation.Token)).Reason;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _resetReason = "The Simulator couldn't check whether the estate would take a reset.";
        }
    }

    private void PresetChanged()
    {
        if (Presets.Find(_form.Preset) is { } preset)
        {
            _form.Fill(preset);
        }
    }

    // The application hands out seeds, so a seed never comes from chance in the page.
    private async Task NewSeed() => _form.Seed = (await Requests.GetConfigureAsync(_cancellation.Token)).NewSeed;

    private void Preview() => Navigation.NavigateTo(PlanLinks.Plan(_form.ToSettings()));

    private async Task ClearHistory()
    {
        var result = await Requests.ClearHistoryAsync(_cancellation.Token);
        _clearProblem = result.IsSuccess ? null : string.Join(" ", result.Errors);
        await LoadRunsAsync();
    }

    private void AskToReset()
    {
        _resetReport = null;
        _resetProblem = null;
        _confirmingReset = true;
    }

    private void KeepEverything() => _confirmingReset = false;

    private async Task ResetEstate()
    {
        _confirmingReset = false;
        _resetting = true;
        _resetProblem = null;
        _resetReport = null;
        try
        {
            var result = await Requests.ResetEstateAsync(_cancellation.Token);
            if (result.IsSuccess)
            {
                _resetReport = result.Value;
            }
            else
            {
                _resetProblem = string.Join(" ", result.Errors);
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _resetProblem = "The Simulator couldn't reset the estate. What was deleted stays deleted; try again in a moment.";
        }
        finally
        {
            _resetting = false;
        }

        try
        {
            _view = await Requests.GetConfigureAsync(_cancellation.Token);
            await LoadRunsAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _failed = true;
        }
    }

    private static string Deleted(IReadOnlyList<DeletedKind> deleted) =>
        deleted.Count == 0 ? "nothing to delete." : "deleted " + string.Join(", ", deleted.Select(kind => $"{kind.Count} {kind.Kind}")) + ".";
}
