@page "/settings"
@using Norvia.DriverApp.Application.Settings.GetCurrent
@inject Mediator.IMediator Mediator

<PageTitle>Demo settings</PageTitle>

<h1>Demo settings</h1>

<form method="post" action="/settings/unavailable" aria-label="Driver app unavailable">
    <AntiforgeryToken />
    <p>
        While the Driver app is unavailable it refuses every Trip the Trip dispatch Logic App sends, with a 503. The Planner
        then sees the Trip as Not delivered.
    </p>
    @if (_settings.Unavailable)
    {
        <p role="status"><strong>The Driver app is unavailable.</strong></p>
        <button type="submit" name="unavailable" value="false" class="primary-button">Make the Driver app available</button>
    }
    else
    {
        <p role="status">The Driver app is available.</p>
        <button type="submit" name="unavailable" value="true" class="primary-button">Make the Driver app unavailable</button>
    }
</form>

@code {
    private DriverAppSettingsView _settings = new(false);

    protected override async Task OnInitializedAsync() => _settings = await Mediator.Send(new GetSettingsQuery());
}
