@page "/"
@using Norvia.DriverApp.Application.Trips.GetForDriver
@using Norvia.DriverApp.Web.Drivers
@inject Mediator.IMediator Mediator
@inject ILogger<Trips> Logger

<PageTitle>My Trips</PageTitle>

<div class="trips-heading">
    <h1>@_name</h1>
    @if (_signedInWithEntra)
    {
        @* Easy Auth's endpoint, which signs the browser out of the Driver app and Entra ID. *@
        <a href="@EasyAuthHandler.SignOutPath">Not you? Sign out</a>
    }
    else
    {
        <form method="post" action="@DriverSignIn.StandInSignOutPath">
            <button type="submit" class="link-button">Not you? Sign out</button>
        </form>
    }
</div>

@if (_loadFailed)
{
    <div role="alert">
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
            Your Trips couldn't be loaded. Reload the page to try again.
        </FluentMessageBar>
    </div>
}
else if (_trips.Count == 0)
{
    <p role="status">No Trips have been sent to you yet.</p>
}

@foreach (var day in _trips.GroupBy(trip => trip.Day).OrderBy(day => day.Key))
{
    <section aria-label="@TripText.Day(day.Key)">
        <h2>@TripText.Day(day.Key)</h2>
        @foreach (var trip in day.OrderBy(trip => trip.PlannedStart).ThenBy(trip => trip.TripNumber, StringComparer.Ordinal))
        {
            <TripCard Trip="trip" />
        }
    </section>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string _name = "My Trips";
    private bool _signedInWithEntra;
    private IReadOnlyList<DriverTripView> _trips = [];
    private bool _loadFailed;

    protected override async Task OnInitializedAsync()
    {
        // The Driver ID comes from the token, never from the request (ADR 0005). The route already required it.
        var user = HttpContext!.User;
        var driverId = user.FindFirst(DriverClaims.DriverId)!.Value;
        _name = user.Identity?.Name ?? driverId;
        _signedInWithEntra = DriverSignIn.SignedInWithEntra(user);

        try
        {
            _trips = await Mediator.Send(new GetDriverTripsQuery(driverId));
        }
#pragma warning disable CA1031 // Whatever fails to load, the Driver gets a message rather than an error page.
        catch (Exception ex)
#pragma warning restore CA1031
        {
            Logger.LogError(ex, "The Trips of Driver {DriverId} couldn't be loaded", driverId);
            _loadFailed = true;
        }
    }
}
