@* One Trip with its Stops in order: what the Driver reads. The Driver reports on a Stop on its own screen. *@
<FluentCard Class="trip" role="region" aria-label="@($"Trip {Trip.TripNumber}")">
    <h3>
        @Trip.TripNumber
        <FluentBadge Appearance="Appearance.Accent">@Trip.Status</FluentBadge>
        <FluentBadge>Version @Trip.Version</FluentBadge>
    </h3>
    <dl class="trip-facts">
        <dt>Planned start</dt>
        <dd>@TripText.Time(Trip.PlannedStart)</dd>
        <dt>Driving</dt>
        <dd>@TripText.Duration(Trip.PlannedDrivingDuration)</dd>
        <dt>Vehicle</dt>
        <dd>@Trip.Vehicle.Registration (@TripText.VehicleType(Trip.Vehicle.VehicleType))</dd>
    </dl>

    @if (Trip.CanStart)
    {
        <form method="post" action="@($"/trips/{Uri.EscapeDataString(Trip.TripNumber)}/start")" aria-label="@($"Start Trip {Trip.TripNumber}")">
            <AntiforgeryToken />
            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">Start Trip</FluentButton>
        </form>
    }

    @if (Trip.Reports.Count > 0)
    {
        <ul class="reports" aria-label="@($"Reports on Trip {Trip.TripNumber}")">
            @foreach (var report in Trip.Reports)
            {
                <ReportItem Report="report" />
            }
        </ul>
    }

    @if (Trip.Stops.Count == 0)
    {
        <div role="status">
            <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
                This Trip has no Stops: its Shipments were taken off.
            </FluentMessageBar>
        </div>
    }
    else
    {
        <ol class="stops">
            @foreach (var stop in Trip.Stops)
            {
                <StopItem TripNumber="@Trip.TripNumber" Stop="stop" />
            }
        </ol>
    }
</FluentCard>

@code {
    [Parameter, EditorRequired]
    public DriverTripView Trip { get; set; } = null!;
}
