{
  "name": "Norvia sandbox (Kubernetes tools)",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "mounts": [
    "source=claude-code-config,target=/home/vscode/.claude,type=volume"
  ],
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "FORGEJO_TOKEN": "${localEnv:FORGEJO_TOKEN}"
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude && gh auth setup-git",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-dotnettools.csdevkit",
        "ms-vscode.powershell",
        "ms-kubernetes-tools.vscode-kubernetes-tools"
      ]
    }
  }
}
