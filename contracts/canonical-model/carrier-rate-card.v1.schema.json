{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://norvia.example/canonical-model/carrier-rate-card.v1.schema.json",
  "title": "CarrierRateCard",
  "description": "The ERP created or edited a Carrier's Carrier Rate Card (Canonical Model event, version 1, E3). Published on the master-data events topic through the ERP's transactional outbox, in the transaction that saved the change, under a correlation ID created for the change. It carries the whole Carrier Rate Card with its full list of dated versions and its Master-data revision, so the TMS replaces its list and needs nothing more.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "correlationId",
    "carrierRateCard"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "description": "The event's own ID, a UUID."
    },
    "eventType": {
      "const": "CarrierRateCard"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "carrierRateCard": {
      "type": "object",
      "required": [
        "id",
        "carrierId",
        "revision",
        "versions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "The ID both applications use, such as CRC-0001."
        },
        "carrierId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "The Carrier the card pays, such as CAR-0001."
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "The Master-data revision: 1 as loaded from the seed file, raised by every edit. The TMS applies only a revision higher than the one it holds."
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "description": "The card's whole list of dated versions. The TMS replaces its list with this one. Versions must not overlap in time: a version with no validTo is valid for ever, so no later version may start after it.",
          "items": {
            "type": "object",
            "required": [
              "version",
              "validFrom",
              "validTo",
              "zones",
              "lanes"
            ],
            "additionalProperties": false,
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "validFrom": {
                "type": "string",
                "format": "date",
                "description": "The first day the version is valid."
              },
              "validTo": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date",
                "description": "The last day the version is valid, or null when it has no end yet."
              },
              "zones": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "country",
                    "postcodePrefixes"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "country": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 2,
                      "description": "ISO 3166-1 alpha-2 country code."
                    },
                    "postcodePrefixes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": "No two Zones of a version may claim the same prefix in the same country."
                    }
                  }
                }
              },
              "lanes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "origin",
                    "destination",
                    "minimumCharge",
                    "weightBreaks"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "origin": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The name of a Zone of this version."
                    },
                    "destination": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The name of a Zone of this version."
                    },
                    "minimumCharge": {
                      "type": "number",
                      "minimum": 0
                    },
                    "weightBreaks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "upToKg",
                          "pricePer100Kg"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "upToKg": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "pricePer100Kg": {
                            "type": "number",
                            "minimum": 0
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
