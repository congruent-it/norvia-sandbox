<policies>
  <inbound>
    <base />
    <set-variable name="correlationId" value="@(Guid.NewGuid().ToString())" />
    <validate-azure-ad-token tenant-id="__TENANT_ID__" output-token-variable-name="agentToken">
      <audiences>
        <audience>__AUDIENCE__</audience>
      </audiences>
    </validate-azure-ad-token>
    <set-variable name="agentId" value="@{
      var claims = ((Jwt)context.Variables[&quot;agentToken&quot;]).Claims;
      return claims.GetValueOrDefault(&quot;azp&quot;, claims.GetValueOrDefault(&quot;appid&quot;, &quot;&quot;));
    }" />
    <choose>
      <when condition="@(!((Jwt)context.Variables[&quot;agentToken&quot;]).Claims.GetValueOrDefault(&quot;roles&quot;, &quot;&quot;).Split(',').Contains(&quot;__ROLE__&quot;))">
        <trace source="norvia-agent-mcp" severity="information">
          <message>This agent may not use this server.</message>
          <metadata name="correlationId" value="@((string)context.Variables[&quot;correlationId&quot;])" />
          <metadata name="flow" value="agent-mcp-__SERVER__" />
          <metadata name="agentId" value="@((string)context.Variables[&quot;agentId&quot;])" />
          <metadata name="outcome" value="Refused" />
          <metadata name="failureCode" value="AgentRoleMissing" />
        </trace>
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="X-Correlation-ID" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
          </set-header>
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@(new JObject(
            new JProperty("messageId", (string)context.Variables["correlationId"]),
            new JProperty("text", "This agent may not use this server.")).ToString())</set-body>
        </return-response>
      </when>
    </choose>
    <choose>
      <when condition="@(string.IsNullOrEmpty((string)context.Variables[&quot;agentId&quot;]))">
        <trace source="norvia-agent-mcp" severity="information">
          <message>The token names no calling application.</message>
          <metadata name="correlationId" value="@((string)context.Variables[&quot;correlationId&quot;])" />
          <metadata name="flow" value="agent-mcp-__SERVER__" />
          <metadata name="outcome" value="Refused" />
          <metadata name="failureCode" value="NoAgentIdentity" />
        </trace>
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="X-Correlation-ID" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
          </set-header>
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@(new JObject(
            new JProperty("messageId", (string)context.Variables["correlationId"]),
            new JProperty("text", "The token names no calling application.")).ToString())</set-body>
        </return-response>
      </when>
    </choose>
    <rate-limit-by-key calls="__RATE_LIMIT_CALLS__" renewal-period="__RATE_LIMIT_PERIOD__" counter-key="@((string)context.Variables[&quot;agentId&quot;])" />
    <!-- The MCP message's method, and the tool a tools/call names; both are "none" when there is no body or no tool: API Management refuses a variable or header whose value is empty (a 500, ExpressionValueValidationFailure). -->
    <set-variable name="mcpMethod" value="@{
      if (context.Request.Body == null) { return &quot;none&quot;; }
      return (string)context.Request.Body.As&lt;JObject&gt;(preserveContent: true)[&quot;method&quot;] ?? &quot;none&quot;;
    }" />
    <set-variable name="toolName" value="@{
      if ((string)context.Variables[&quot;mcpMethod&quot;] != &quot;tools/call&quot;) { return &quot;none&quot;; }
      return (string)context.Request.Body.As&lt;JObject&gt;(preserveContent: true)[&quot;params&quot;]?[&quot;name&quot;] ?? &quot;none&quot;;
    }" />
    <!-- The run the caller says it is on (the Agent's structured input, which Foundry sends as X-Correlation-ID). It is not the trail's correlation ID, which this
         policy makes itself, so an Agent cannot write into another trail; it is recorded as the runId, when it is a plain identifier, and "none" when it is not. -->
    <set-variable name="runId" value="@{
      var sent = context.Request.Headers.GetValueOrDefault(&quot;X-Correlation-ID&quot;, &quot;&quot;);
      return System.Text.RegularExpressions.Regex.IsMatch(sent, &quot;^[A-Za-z0-9._-]{1,100}$&quot;) ? sent : &quot;none&quot;;
    }" />
    <choose>
      <when condition="@((string)context.Variables[&quot;mcpMethod&quot;] == &quot;tools/call&quot; &amp;&amp; !&quot;__TOOLS__&quot;.Split('|').Contains((string)context.Variables[&quot;toolName&quot;]))">
        <trace source="norvia-agent-mcp" severity="information">
          <message>The tool is not on this server's list.</message>
          <metadata name="correlationId" value="@((string)context.Variables[&quot;correlationId&quot;])" />
          <metadata name="flow" value="agent-mcp-__SERVER__" />
          <metadata name="agentId" value="@((string)context.Variables[&quot;agentId&quot;])" />
          <metadata name="toolName" value="@((string)context.Variables[&quot;toolName&quot;])" />
          <metadata name="outcome" value="Refused" />
          <metadata name="failureCode" value="ToolNotOnList" />
        </trace>
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="X-Correlation-ID" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
          </set-header>
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@(new JObject(
            new JProperty("messageId", (string)context.Variables["correlationId"]),
            new JProperty("text", "This tool is not available.")).ToString())</set-body>
        </return-response>
      </when>
    </choose>
    <!-- The headers the diagnostics log on the hop to the application (coding guidelines, tracking contract). The caller's own are overridden. -->
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@((string)context.Variables["correlationId"])</value>
    </set-header>
    <set-header name="X-Agent-ID" exists-action="override">
      <value>@((string)context.Variables["agentId"])</value>
    </set-header>
    <!-- Only a tools/call names a tool, so the caller's own is dropped and ours set only then. -->
    <set-header name="X-Tool-Name" exists-action="delete" />
    <choose>
      <when condition="@((string)context.Variables[&quot;toolName&quot;] != &quot;none&quot;)">
        <set-header name="X-Tool-Name" exists-action="override">
          <value>@((string)context.Variables["toolName"])</value>
        </set-header>
      </when>
    </choose>
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="X-Run-ID" exists-action="delete" />
    <choose>
      <when condition="@((string)context.Variables[&quot;runId&quot;] != &quot;none&quot;)">
        <set-header name="X-Run-ID" exists-action="override">
          <value>@((string)context.Variables["runId"])</value>
        </set-header>
      </when>
    </choose>
    <!-- A key that does not apply is left out, never sent with a stand-in value (tracking contract): the tool name is there only on a tools/call, the runId only when the caller sent one. -->
    <choose>
      <when condition="@((string)context.Variables[&quot;toolName&quot;] != &quot;none&quot; &amp;&amp; (string)context.Variables[&quot;runId&quot;] != &quot;none&quot;)">
        <trace source="norvia-agent-mcp" severity="information">
          <message>Accepted the agent's call.</message>
          <metadata name="correlationId" value="@((string)context.Variables[&quot;correlationId&quot;])" />
          <metadata name="flow" value="agent-mcp-__SERVER__" />
          <metadata name="agentId" value="@((string)context.Variables[&quot;agentId&quot;])" />
          <metadata name="toolName" value="@((string)context.Variables[&quot;toolName&quot;])" />
          <metadata name="runId" value="@((string)context.Variables[&quot;runId&quot;])" />
          <metadata name="outcome" value="Succeeded" />
        </trace>
      </when>
      <when condition="@((string)context.Variables[&quot;toolName&quot;] != &quot;none&quot;)">
        <trace source="norvia-agent-mcp" severity="information">
          <message>Accepted the agent's call.</message>
          <metadata name="correlationId" value="@((string)context.Variables[&quot;correlationId&quot;])" />
          <metadata name="flow" value="agent-mcp-__SERVER__" />
          <metadata name="agentId" value="@((string)context.Variables[&quot;agentId&quot;])" />
          <metadata name="toolName" value="@((string)context.Variables[&quot;toolName&quot;])" />
          <metadata name="outcome" value="Succeeded" />
        </trace>
      </when>
      <when condition="@((string)context.Variables[&quot;runId&quot;] != &quot;none&quot;)">
        <trace source="norvia-agent-mcp" severity="information">
          <message>Accepted the agent's call.</message>
          <metadata name="correlationId" value="@((string)context.Variables[&quot;correlationId&quot;])" />
          <metadata name="flow" value="agent-mcp-__SERVER__" />
          <metadata name="agentId" value="@((string)context.Variables[&quot;agentId&quot;])" />
          <metadata name="runId" value="@((string)context.Variables[&quot;runId&quot;])" />
          <metadata name="outcome" value="Succeeded" />
        </trace>
      </when>
      <otherwise>
        <trace source="norvia-agent-mcp" severity="information">
          <message>Accepted the agent's call.</message>
          <metadata name="correlationId" value="@((string)context.Variables[&quot;correlationId&quot;])" />
          <metadata name="flow" value="agent-mcp-__SERVER__" />
          <metadata name="agentId" value="@((string)context.Variables[&quot;agentId&quot;])" />
          <metadata name="outcome" value="Succeeded" />
        </trace>
      </otherwise>
    </choose>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@((string)context.Variables["correlationId"])</value>
    </set-header>
  </outbound>
  <on-error>
    <base />
    <!-- The token is validated in the inbound section, so a bad one ends here. -->
    <set-variable name="correlationId" value="@(context.Variables.ContainsKey(&quot;correlationId&quot;) ? (string)context.Variables[&quot;correlationId&quot;] : Guid.NewGuid().ToString())" />
    <!-- An MCP client closes its event stream when it is done with it (ClientConnectionFailure): nothing failed, so there is no hop to record. -->
    <choose>
      <when condition="@(context.LastError.Reason != &quot;ClientConnectionFailure&quot;)">
        <trace source="norvia-agent-mcp" severity="information">
          <message>@(context.LastError.Message)</message>
          <metadata name="correlationId" value="@((string)context.Variables[&quot;correlationId&quot;])" />
          <metadata name="flow" value="agent-mcp-__SERVER__" />
          <metadata name="outcome" value="@(context.Response.StatusCode == 401 || context.Response.StatusCode == 403 || context.Response.StatusCode == 429 ? &quot;Refused&quot; : &quot;Failed&quot;)" />
          <metadata name="failureCode" value="@(string.IsNullOrEmpty(context.LastError.Reason) ? context.LastError.Source : context.LastError.Reason)" />
        </trace>
      </when>
    </choose>
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@((string)context.Variables["correlationId"])</value>
    </set-header>
  </on-error>
</policies>
