<policies>
  <inbound>
    <base />
    <set-variable name="correlationId" value="@(Guid.NewGuid().ToString())" />
    <validate-azure-ad-token tenant-id="{{entra-tenant-id}}" output-token-variable-name="partnerToken">
      <audiences>
        <audience>{{partner-api-client-id}}</audience>
      </audiences>
    </validate-azure-ad-token>
    <choose>
      <when condition="@(!((Jwt)context.Variables[&quot;partnerToken&quot;]).Claims.GetValueOrDefault(&quot;roles&quot;, &quot;&quot;).Split(',').Contains(&quot;Tracking.Submit&quot;))">
        <trace source="norvia-partner-api" severity="information">
          <message>This client may not submit tracking.</message>
          <metadata name="correlationId" value="@((string)context.Variables[&quot;correlationId&quot;])" />
          <metadata name="flow" value="carrier-tracking" />
          <metadata name="outcome" value="Refused" />
          <metadata name="failureCode" value="NotAllowedToSubmitTracking" />
        </trace>
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="X-Correlation-ID" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
          </set-header>
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@(new JObject(
            new JProperty("messageId", (string)context.Variables["correlationId"]),
            new JProperty("text", "This client may not submit tracking.")).ToString())</set-body>
        </return-response>
      </when>
    </choose>
    <set-variable name="carrierId" value="@{
      var clientId = ((Jwt)context.Variables[&quot;partnerToken&quot;]).Claims.GetValueOrDefault(&quot;azp&quot;, &quot;&quot;);
      foreach (var entry in &quot;{{carriers-by-client-id}}&quot;.Split(';'))
      {
        var pair = entry.Split('=');
        if (pair.Length == 2 &amp;&amp; pair[0] == clientId) { return pair[1]; }
      }
      return &quot;&quot;;
    }" />
    <choose>
      <when condition="@(string.IsNullOrEmpty((string)context.Variables[&quot;carrierId&quot;]))">
        <trace source="norvia-partner-api" severity="information">
          <message>No Carrier is registered for this client.</message>
          <metadata name="correlationId" value="@((string)context.Variables[&quot;correlationId&quot;])" />
          <metadata name="flow" value="carrier-tracking" />
          <metadata name="outcome" value="Refused" />
          <metadata name="failureCode" value="NoCarrierForClient" />
        </trace>
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="X-Correlation-ID" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
          </set-header>
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@(new JObject(
            new JProperty("messageId", (string)context.Variables["correlationId"]),
            new JProperty("text", "No Carrier is registered for this client.")).ToString())</set-body>
        </return-response>
      </when>
    </choose>
    <!-- The Carrier's own event ID, when the body is JSON that has one. A body that isn't is still enqueued: the map fails the run and the message is dead-lettered. -->
    <set-variable name="sourceMessageId" value="@{
      try
      {
        var message = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
        var eventId = message[&quot;eventId&quot;];
        return eventId != null &amp;&amp; eventId.Type == JTokenType.String ? (string)eventId : &quot;&quot;;
      }
      catch (Exception)
      {
        return &quot;&quot;;
      }
    }" />
    <!-- Service Bus's REST send, as API Management's own identity. The queue's address is the namespace's, from the named values. -->
    <send-request mode="new" response-variable-name="enqueued" timeout="20" ignore-error="true">
      <set-url>https://{{service-bus-namespace}}.servicebus.windows.net/{{tracking-queue-name}}/messages</set-url>
      <set-method>POST</set-method>
      <set-header name="Content-Type" exists-action="override">
        <value>application/json</value>
      </set-header>
      <set-header name="BrokerProperties" exists-action="override">
        <value>@(new JObject(new JProperty("MessageId", (string)context.Variables["correlationId"])).ToString(Newtonsoft.Json.Formatting.None))</value>
      </set-header>
      <!-- Each of these headers becomes an application property of the message (coding guidelines §7). -->
      <set-header name="correlationId" exists-action="override">
        <value>@((string)context.Variables["correlationId"])</value>
      </set-header>
      <set-header name="flow" exists-action="override">
        <value>carrier-tracking</value>
      </set-header>
      <set-header name="partyId" exists-action="override">
        <value>@((string)context.Variables["carrierId"])</value>
      </set-header>
      <set-header name="sourceMessageId" exists-action="@(string.IsNullOrEmpty((string)context.Variables[&quot;sourceMessageId&quot;]) ? &quot;delete&quot; : &quot;override&quot;)">
        <value>@((string)context.Variables["sourceMessageId"])</value>
      </set-header>
      <set-body>@(context.Request.Body.As&lt;string&gt;(preserveContent: true))</set-body>
      <authentication-managed-identity resource="https://servicebus.azure.net" client-id="{{api-management-identity-client-id}}" />
    </send-request>
    <choose>
      <when condition="@(context.Variables[&quot;enqueued&quot;] == null || ((IResponse)context.Variables[&quot;enqueued&quot;]).StatusCode != 201)">
        <trace source="norvia-partner-api" severity="information">
          <message>The tracking message could not be put on the tracking queue.</message>
          <metadata name="correlationId" value="@((string)context.Variables[&quot;correlationId&quot;])" />
          <metadata name="flow" value="carrier-tracking" />
          <metadata name="partyId" value="@((string)context.Variables[&quot;carrierId&quot;])" />
          <metadata name="outcome" value="Failed" />
          <metadata name="failureCode" value="TrackingNotQueued" />
        </trace>
        <return-response>
          <set-status code="503" reason="Service Unavailable" />
          <set-header name="X-Correlation-ID" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
          </set-header>
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@(new JObject(
            new JProperty("messageId", (string)context.Variables["correlationId"]),
            new JProperty("text", "The tracking message was not accepted. Send it again.")).ToString())</set-body>
        </return-response>
      </when>
    </choose>
    <trace source="norvia-partner-api" severity="information">
      <message>Accepted: put on the tracking queue</message>
      <metadata name="correlationId" value="@((string)context.Variables[&quot;correlationId&quot;])" />
      <metadata name="flow" value="carrier-tracking" />
      <metadata name="partyId" value="@((string)context.Variables[&quot;carrierId&quot;])" />
      <metadata name="sourceMessageId" value="@((string)context.Variables[&quot;sourceMessageId&quot;])" />
      <metadata name="outcome" value="Succeeded" />
    </trace>
    <return-response>
      <set-status code="202" reason="Accepted" />
      <set-header name="X-Correlation-ID" exists-action="override">
        <value>@((string)context.Variables["correlationId"])</value>
      </set-header>
      <set-header name="Content-Type" exists-action="override">
        <value>application/json</value>
      </set-header>
      <set-body>@(new JObject(new JProperty("messageId", (string)context.Variables["correlationId"])).ToString())</set-body>
    </return-response>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
    <!-- API Management checks the subscription key before the inbound section runs. -->
    <set-variable name="correlationId" value="@(context.Variables.ContainsKey(&quot;correlationId&quot;) ? (string)context.Variables[&quot;correlationId&quot;] : Guid.NewGuid().ToString())" />
    <trace source="norvia-partner-api" severity="information">
      <message>@(context.LastError.Message)</message>
      <metadata name="correlationId" value="@((string)context.Variables[&quot;correlationId&quot;])" />
      <metadata name="flow" value="carrier-tracking" />
      <metadata name="outcome" value="@(context.Response.StatusCode == 401 || context.Response.StatusCode == 403 ? &quot;Refused&quot; : &quot;Failed&quot;)" />
      <metadata name="failureCode" value="@(string.IsNullOrEmpty(context.LastError.Reason) ? context.LastError.Source : context.LastError.Reason)" />
    </trace>
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@((string)context.Variables["correlationId"])</value>
    </set-header>
  </on-error>
</policies>
