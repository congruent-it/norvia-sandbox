<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P10" targetNamespace="https://norvia.example/processes/tms/p10">
  <bpmn:collaboration id="Collaboration_P10">
    <bpmn:participant id="Participant_P10" name="P10 Fleet capacity planning" processRef="Process_P10" />
    <bpmn:textAnnotation id="Ann_Rules"><bpmn:text>P3 only warns about Over capacity. P11 applies the availability rules as hard rules on every Trip change and at Dispatch.</bpmn:text></bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_P10" name="P10 Fleet capacity planning" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P10">
      <bpmn:lane id="L_Job" name="TMS horizon job">
        <bpmn:flowNodeRef>s_job</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_shift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_veh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_close</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Planner" name="Planner (TMS UI)">
        <bpmn:flowNodeRef>s_pl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_what</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_abs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_roster</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_pm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_see</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_p3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_pl</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Tms" name="TMS">
        <bpmn:flowNodeRef>t_rewrite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_tm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recalc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_trip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_flag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_p11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_tm2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_over</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_over</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_job" name="Daily at 00:00 Europe/Amsterdam">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_s_job" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_open" name="Open each missing day up to the end of the Planning horizon">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_shift" name="Give each active Driver a Shift from their Roster">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_veh" name="Mark each active Vehicle available">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_close" name="Close yesterday">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="s_pl" name="An availability change becomes known">
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw_what" name="What changed?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_abs" name="Record or remove an Absence or Off the road day">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_edit" name="Edit a single Shift (edited by hand)">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_roster" name="Change a Roster">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_pm">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_rewrite" name="Rewrite open days not edited by hand and without an Absence">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_tm">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_recalc" name="Recalculate availability and Driving-hour budgets">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_trip" name="Driver or Vehicle already on a Trip?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_flag" name="Flag Trip Needs a Driver or Needs a Vehicle">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="c_p11" name="P11: Planner Amends the Trip">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="gw_tm2">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_load" name="Load check: capacity vs Own fleet demand (kg, pallet places)">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_over" name="Over capacity?">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_over" name="Flag the day Over capacity">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_ok" name="Capacity OK">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t_see" name="See it in the capacity view (P3 also warns)">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="c_p3" name="P3: move Shipments to a Carrier, or find capacity">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="e_pl">
      <bpmn:incoming>Flow_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s_job" targetRef="t_open" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t_open" targetRef="t_shift" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t_shift" targetRef="t_veh" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="t_veh" targetRef="t_close" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="t_close" targetRef="gw_tm" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="s_pl" targetRef="gw_what" />
    <bpmn:sequenceFlow id="Flow_7" name="Absence / Off the road" sourceRef="gw_what" targetRef="t_abs" />
    <bpmn:sequenceFlow id="Flow_8" name="One Shift" sourceRef="gw_what" targetRef="t_edit" />
    <bpmn:sequenceFlow id="Flow_9" name="Roster" sourceRef="gw_what" targetRef="t_roster" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="t_abs" targetRef="gw_pm" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="t_edit" targetRef="gw_pm" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="t_roster" targetRef="t_rewrite" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="gw_pm" targetRef="gw_tm" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="t_rewrite" targetRef="gw_tm" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="gw_tm" targetRef="t_recalc" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="t_recalc" targetRef="gw_trip" />
    <bpmn:sequenceFlow id="Flow_17" name="Yes" sourceRef="gw_trip" targetRef="t_flag" />
    <bpmn:sequenceFlow id="Flow_18" name="No" sourceRef="gw_trip" targetRef="gw_tm2" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="t_flag" targetRef="c_p11" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="c_p11" targetRef="gw_tm2" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="gw_tm2" targetRef="t_load" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="t_load" targetRef="gw_over" />
    <bpmn:sequenceFlow id="Flow_23" name="Yes" sourceRef="gw_over" targetRef="t_over" />
    <bpmn:sequenceFlow id="Flow_24" name="No" sourceRef="gw_over" targetRef="e_ok" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="t_over" targetRef="t_see" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="t_see" targetRef="c_p3" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="c_p3" targetRef="e_pl" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P10">
    <bpmndi:BPMNPlane id="Plane_P10" bpmnElement="Collaboration_P10">
      <bpmndi:BPMNShape id="Participant_P10_di" bpmnElement="Participant_P10" isHorizontal="true">
