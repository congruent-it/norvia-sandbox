        <dc:Bounds x="130" y="980" width="2760" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SB_di" bpmnElement="SB" isHorizontal="true">
        <dc:Bounds x="100" y="1160" width="2790" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_send_di" bpmnElement="s_send">
        <dc:Bounds x="212" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_send_di" bpmnElement="t_send">
        <dc:Bounds x="325" y="90" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_edge_di" bpmnElement="t_edge">
        <dc:Bounds x="475" y="230" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_size_di" bpmnElement="gw_size" isMarkerVisible="true">
        <dc:Bounds x="655" y="245" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_413_di" bpmnElement="e_413">
        <dc:Bounds x="662" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_blob_di" bpmnElement="t_blob">
