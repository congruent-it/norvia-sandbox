        <dc:Bounds x="1225" y="370" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_dlq_di" bpmnElement="e_dlq">
        <dc:Bounds x="1412" y="512" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_rules_di" bpmnElement="t_rules">
        <dc:Bounds x="1375" y="630" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_rep_di" bpmnElement="gw_rep" isMarkerVisible="true">
        <dc:Bounds x="1555" y="645" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_repeat_di" bpmnElement="t_repeat">
        <dc:Bounds x="1675" y="870" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_store_di" bpmnElement="t_store">
        <dc:Bounds x="1675" y="630" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_current_di" bpmnElement="t_current">
        <dc:Bounds x="1825" y="630" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ev_pod_di" bpmnElement="ev_pod">
        <dc:Bounds x="2012" y="652" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_res_di" bpmnElement="gw_res" isMarkerVisible="true">
        <dc:Bounds x="2155" y="645" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_p7_di" bpmnElement="c_p7">
        <dc:Bounds x="2275" y="750" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_m_di" bpmnElement="gw_m" isMarkerVisible="true">
        <dc:Bounds x="2455" y="645" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_clean_di" bpmnElement="t_clean">
        <dc:Bounds x="2575" y="370" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_done_di" bpmnElement="e_done">
        <dc:Bounds x="2762" y="392" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_missing_di" bpmnElement="s_missing">
        <dc:Bounds x="212" y="652" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_flag_di" bpmnElement="t_flag">
        <dc:Bounds x="325" y="630" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_list_di" bpmnElement="t_list">
        <dc:Bounds x="475" y="1010" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_list_di" bpmnElement="e_list">
        <dc:Bounds x="662" y="1032" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="b_map_di" bpmnElement="b_map">
        <dc:Bounds x="1112" y="432" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="b_call_di" bpmnElement="b_call">
        <dc:Bounds x="1262" y="432" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="248" y="130" />
        <di:waypoint x="325" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="435" y="130" />
        <di:waypoint x="530" y="130" />
        <di:waypoint x="530" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="585" y="270" />
        <di:waypoint x="655" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="680" y="245" />
        <di:waypoint x="680" y="148" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="705" y="270" />
        <di:waypoint x="775" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="885" y="270" />
        <di:waypoint x="925" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1035" y="270" />
        <di:waypoint x="1130" y="270" />
        <di:waypoint x="1130" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1185" y="410" />
        <di:waypoint x="1225" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1130" y="468" />
        <di:waypoint x="1130" y="530" />
        <di:waypoint x="1412" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1280" y="468" />
        <di:waypoint x="1280" y="530" />
        <di:waypoint x="1412" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1335" y="410" />
        <di:waypoint x="1350" y="410" />
        <di:waypoint x="1350" y="670" />
        <di:waypoint x="1375" y="670" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1485" y="670" />
        <di:waypoint x="1555" y="670" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="1605" y="670" />
        <di:waypoint x="1675" y="670" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="1580" y="695" />
        <di:waypoint x="1580" y="910" />
        <di:waypoint x="1675" y="910" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <di:waypoint x="1785" y="670" />
        <di:waypoint x="1825" y="670" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16">
        <di:waypoint x="1935" y="670" />
        <di:waypoint x="2012" y="670" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17">
        <di:waypoint x="2048" y="670" />
        <di:waypoint x="2155" y="670" />
      </bpmndi:BPMNEdge>
