<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P6" targetNamespace="https://norvia.example/processes/tms/p6">
  <bpmn:collaboration id="Collaboration_P6">
    <bpmn:participant id="Participant_P6" name="P6 Proof of delivery" processRef="Process_P6" />
    <bpmn:participant id="SB" name="Service Bus: Shipment events topic" />
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="ev_pod" targetRef="SB" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P6" name="P6 Proof of delivery" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P6">
      <bpmn:lane id="L_Carrier" name="Carrier (Partner portal Persona)">
        <bpmn:flowNodeRef>s_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_413</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Apim" name="API Management">
        <bpmn:flowNodeRef>t_edge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_size</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_blob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_queue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_La" name="Carrier Proof of delivery Logic App">
        <bpmn:flowNodeRef>t_map</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_dlq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_map</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_call</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Tms" name="TMS">
        <bpmn:flowNodeRef>t_rules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_repeat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_current</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_pod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_p7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_flag</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Planner" name="Planner (TMS UI)">
        <bpmn:flowNodeRef>t_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_list</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_send" name="Carrier has a Proof of delivery">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t_send" name="Send Proof of delivery with files (by hand or auto-progress)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_edge" name="Check token (ProofsOfDelivery.Submit) and body size">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_size" name="Over 25 MB?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_413" name="Refused (413)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_blob" name="Store body unparsed as blob in inbound container">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_queue" name="Put claim check on queue, return 202 Accepted">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_map" name="Fetch blob, map to Canonical Model, decode files">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_call" name="Call TMS Proof of delivery API (multipart)">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_dlq" name="Dead-lettered, blob kept for replay">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="t_rules" name="Check Proof of delivery rules">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="gw_rep" name="Repeat of Carrier's document ID?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_repeat" name="Return original, flagged as repeat">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_store" name="Store files in TMS storage">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_current" name="Record as current, supersede earlier one">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="ev_pod" name="ProofOfDeliveryReceived">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_ev_pod" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="gw_res" name="With reservations?">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="c_p7" name="P7 opens Reservations Exception">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="gw_m">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_clean" name="Delete blob from inbound container">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_done" name="Proof of delivery stored">
      <bpmn:incoming>Flow_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s_missing" name="48 h after Delivered, no current Proof of delivery">
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_s_missing" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_flag" name="Flag Proof of delivery missing">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_list" name="See it in Delivered without Proof of delivery, chase Carrier">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_list">
      <bpmn:incoming>Flow_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="b_map" name="Invalid content or blob gone" attachedToRef="t_map">
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_b_map" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_call" name="Refused, or max delivery count" attachedToRef="t_call">
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_b_call" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s_send" targetRef="t_send" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t_send" targetRef="t_edge" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t_edge" targetRef="gw_size" />
    <bpmn:sequenceFlow id="Flow_4" name="Yes" sourceRef="gw_size" targetRef="e_413" />
    <bpmn:sequenceFlow id="Flow_5" name="No" sourceRef="gw_size" targetRef="t_blob" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="t_blob" targetRef="t_queue" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="t_queue" targetRef="t_map" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="t_map" targetRef="t_call" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="b_map" targetRef="e_dlq" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="b_call" targetRef="e_dlq" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="t_call" targetRef="t_rules" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="t_rules" targetRef="gw_rep" />
    <bpmn:sequenceFlow id="Flow_13" name="No" sourceRef="gw_rep" targetRef="t_store" />
    <bpmn:sequenceFlow id="Flow_14" name="Yes" sourceRef="gw_rep" targetRef="t_repeat" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="t_store" targetRef="t_current" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="t_current" targetRef="ev_pod" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="ev_pod" targetRef="gw_res" />
    <bpmn:sequenceFlow id="Flow_18" name="Yes" sourceRef="gw_res" targetRef="c_p7" />
    <bpmn:sequenceFlow id="Flow_19" name="No, clean" sourceRef="gw_res" targetRef="gw_m" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="c_p7" targetRef="gw_m" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="t_repeat" targetRef="gw_m" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="gw_m" targetRef="t_clean" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="t_clean" targetRef="e_done" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="s_missing" targetRef="t_flag" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="t_flag" targetRef="t_list" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="t_list" targetRef="e_list" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P6">
    <bpmndi:BPMNPlane id="Plane_P6" bpmnElement="Collaboration_P6">
      <bpmndi:BPMNShape id="Participant_P6_di" bpmnElement="Participant_P6" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="2790" height="1060" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Carrier_di" bpmnElement="L_Carrier" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="2760" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Apim_di" bpmnElement="L_Apim" isHorizontal="true">
        <dc:Bounds x="130" y="200" width="2760" height="140" />
