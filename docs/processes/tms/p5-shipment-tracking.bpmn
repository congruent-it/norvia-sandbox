        <dc:Bounds x="130" y="980" width="2460" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SB_di" bpmnElement="SB" isHorizontal="true">
        <dc:Bounds x="100" y="1160" width="2490" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_rep_di" bpmnElement="s_rep">
        <dc:Bounds x="212" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_send_di" bpmnElement="t_send">
