        <dc:Bounds x="1262" y="512" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_rules_di" bpmnElement="t_rules">
        <dc:Bounds x="1225" y="630" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_rep_di" bpmnElement="gw_rep" isMarkerVisible="true">
        <dc:Bounds x="1405" y="645" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_repeat_di" bpmnElement="t_repeat">
        <dc:Bounds x="1525" y="870" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_log_di" bpmnElement="t_log">
        <dc:Bounds x="1525" y="630" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_kind_di" bpmnElement="gw_kind" isMarkerVisible="true">
        <dc:Bounds x="1705" y="645" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_move_di" bpmnElement="t_move">
        <dc:Bounds x="1825" y="630" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ev_move_di" bpmnElement="ev_move">
        <dc:Bounds x="2012" y="652" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_exc_di" bpmnElement="t_exc">
        <dc:Bounds x="1825" y="750" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ev_exc_di" bpmnElement="ev_exc">
        <dc:Bounds x="2012" y="772" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_m_di" bpmnElement="gw_m" isMarkerVisible="true">
        <dc:Bounds x="2155" y="645" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_follow_di" bpmnElement="t_follow">
        <dc:Bounds x="2275" y="1010" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_done_di" bpmnElement="e_done">
        <dc:Bounds x="2462" y="1032" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_stale_di" bpmnElement="s_stale">
        <dc:Bounds x="212" y="652" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_stale_di" bpmnElement="t_stale">
        <dc:Bounds x="325" y="630" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_late_di" bpmnElement="t_late">
        <dc:Bounds x="475" y="630" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_stale_di" bpmnElement="e_stale">
        <dc:Bounds x="662" y="652" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="b_map_di" bpmnElement="b_map">
