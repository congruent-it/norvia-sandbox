      <bpmndi:BPMNEdge id="Flow_23_di" bpmnElement="Flow_23">
        <di:waypoint x="2480" y="90" />
        <di:waypoint x="2480" y="75" />
        <di:waypoint x="1730" y="75" />
        <di:waypoint x="1730" y="252" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Ann_Amend_di" bpmnElement="Ann_Amend">
        <dc:Bounds x="470" y="755" width="420" height="70" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
