        <di:waypoint x="2275" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_18_di" bpmnElement="Flow_18">
        <di:waypoint x="2385" y="270" />
        <di:waypoint x="2462" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_19_di" bpmnElement="Flow_19">
        <di:waypoint x="1880" y="588" />
        <di:waypoint x="1880" y="650" />
        <di:waypoint x="1975" y="650" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_20_di" bpmnElement="Flow_20">
        <di:waypoint x="2085" y="650" />
        <di:waypoint x="2100" y="650" />
        <di:waypoint x="2100" y="390" />
        <di:waypoint x="2125" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_21_di" bpmnElement="Flow_21">
        <di:waypoint x="2235" y="390" />
        <di:waypoint x="2312" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_22_di" bpmnElement="Flow_22">
        <di:waypoint x="2348" y="390" />
        <di:waypoint x="2400" y="390" />
        <di:waypoint x="2400" y="130" />
        <di:waypoint x="2425" y="130" />
