<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P9" targetNamespace="https://norvia.example/processes/tms/p9">
  <bpmn:collaboration id="Collaboration_P9">
    <bpmn:participant id="Participant_P9" name="P9 Freight settlement" processRef="Process_P9" />
    <bpmn:textAnnotation id="Ann_Final"><bpmn:text>Billable is final. Nothing flows back from the ERP. A wrong charge is corrected with a Credit note (E1).</bpmn:text></bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_P9" name="P9 Freight settlement" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P9">
      <bpmn:lane id="L_Cs" name="Customer service (TMS UI)">
        <bpmn:flowNodeRef>s_cs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_release</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Planner" name="Planner (TMS UI)">
        <bpmn:flowNodeRef>s_rel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_spot</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Tms" name="TMS">
        <bpmn:flowNodeRef>s_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rrec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_met</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_billable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_billable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_freeze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_p4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_deliv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_cost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_price</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Bill" name="Billing Logic App">
        <bpmn:flowNodeRef>t_bill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_bdlq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_bill</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Cost" name="Carrier cost Logic App">
        <bpmn:flowNodeRef>t_cost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cdlq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_cost</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Erp" name="ERP billing API">
        <bpmn:flowNodeRef>t_line</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_line</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ccost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_ccost</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_change" name="Delivered, Rated, POD recorded or Exception resolved (P5, P2, P6, P7)">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="s_cs" name="Delivered order blocked only by a missing POD">
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t_release" name="Release without Proof of delivery, with remark">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_rrec" name="Record release, lift NoProofOfDelivery">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_in">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="t_check" name="Check the four conditions (same transaction)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="gw_met" name="All met?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_block" name="Stay Not yet billable, with blocking reasons">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_block" name="Waits for the next change, listed for Customer service">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_billable" name="Set Billable (final)">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="ev_billable" name="TransportOrderBillable">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_ev_billable" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="t_bill" name="Call ERP billing API (retry on 5xx / timeout)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_bdlq" name="Dead-lettered, safe to resubmit">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_line" name="Add billable line for the Shipper (E1)">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_line" name="Handed to invoicing">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s_rel" name="Planner releases a Carrier Shipment (P3)">
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_price" name="Price from Carrier Rate Card (P2 steps 3 to 6)">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_spot" name="Release with Spot price and remark">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_freeze" name="Freeze Carrier cost on the new Carrier booking">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="c_p4" name="P4 Carrier booking (can reject with PriceNotAccepted)">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:intermediateCatchEvent id="ev_deliv" name="Shipment Delivered (P5)">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="ConditionalDef_ev_deliv" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="ev_cost" name="CarrierCostIncurred">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_ev_cost" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="t_cost" name="Call ERP billing API (retry on 5xx / timeout)">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_cdlq" name="Dead-lettered, safe to resubmit">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_ccost" name="Add Carrier cost for Matching (E2)">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_ccost" name="Ready for Matching">
      <bpmn:incoming>Flow_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="b_bill" name="Retries used up" attachedToRef="t_bill">
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_b_bill" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_price" name="Can't price" attachedToRef="t_price">
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_b_price" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_cost" name="Retries used up" attachedToRef="t_cost">
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_b_cost" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s_change" targetRef="gw_in" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="s_cs" targetRef="t_release" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t_release" targetRef="t_rrec" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="t_rrec" targetRef="gw_in" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="gw_in" targetRef="t_check" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="t_check" targetRef="gw_met" />
    <bpmn:sequenceFlow id="Flow_7" name="Yes" sourceRef="gw_met" targetRef="t_billable" />
    <bpmn:sequenceFlow id="Flow_8" name="No" sourceRef="gw_met" targetRef="t_block" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="t_block" targetRef="e_block" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="t_billable" targetRef="ev_billable" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="ev_billable" targetRef="t_bill" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="t_bill" targetRef="t_line" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="b_bill" targetRef="e_bdlq" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="t_line" targetRef="e_line" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="s_rel" targetRef="t_price" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="t_price" targetRef="t_freeze" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="b_price" targetRef="t_spot" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="t_spot" targetRef="t_freeze" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="t_freeze" targetRef="c_p4" />
    <bpmn:sequenceFlow id="Flow_20" name="Confirmed" sourceRef="c_p4" targetRef="ev_deliv" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="ev_deliv" targetRef="ev_cost" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="ev_cost" targetRef="t_cost" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="t_cost" targetRef="t_ccost" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="b_cost" targetRef="e_cdlq" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="t_ccost" targetRef="e_ccost" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P9">
    <bpmndi:BPMNPlane id="Plane_P9" bpmnElement="Collaboration_P9">
      <bpmndi:BPMNShape id="Participant_P9_di" bpmnElement="Participant_P9" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="3090" height="1200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Cs_di" bpmnElement="L_Cs" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="3060" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Planner_di" bpmnElement="L_Planner" isHorizontal="true">
        <dc:Bounds x="130" y="200" width="3060" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Tms_di" bpmnElement="L_Tms" isHorizontal="true">
        <dc:Bounds x="130" y="340" width="3060" height="260" />
      </bpmndi:BPMNShape>
