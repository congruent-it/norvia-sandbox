        <dc:Bounds x="955" y="385" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_block_di" bpmnElement="t_block">
        <dc:Bounds x="1075" y="490" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_block_di" bpmnElement="e_block">
        <dc:Bounds x="1262" y="512" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_billable_di" bpmnElement="t_billable">
        <dc:Bounds x="1075" y="370" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ev_billable_di" bpmnElement="ev_billable">
        <dc:Bounds x="1262" y="392" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_bill_di" bpmnElement="t_bill">
