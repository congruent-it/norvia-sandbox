      <bpmndi:BPMNShape id="s_rel_di" bpmnElement="s_rel">
        <dc:Bounds x="1862" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_price_di" bpmnElement="t_price">
        <dc:Bounds x="1975" y="370" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_spot_di" bpmnElement="t_spot">
        <dc:Bounds x="2125" y="230" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_freeze_di" bpmnElement="t_freeze">
        <dc:Bounds x="2125" y="370" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_p4_di" bpmnElement="c_p4">
        <dc:Bounds x="2275" y="370" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ev_deliv_di" bpmnElement="ev_deliv">
        <dc:Bounds x="2462" y="392" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ev_cost_di" bpmnElement="ev_cost">
        <dc:Bounds x="2612" y="392" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_cost_di" bpmnElement="t_cost">
        <dc:Bounds x="2725" y="890" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_cdlq_di" bpmnElement="e_cdlq">
        <dc:Bounds x="2912" y="1032" width="36" height="36" />
      </bpmndi:BPMNShape>
