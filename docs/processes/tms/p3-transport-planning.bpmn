<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P3" targetNamespace="https://norvia.example/processes/tms/p3">
  <bpmn:collaboration id="Collaboration_P3">
    <bpmn:participant id="Participant_P3" name="P3 Transport planning" processRef="Process_P3" />
    <bpmn:participant id="SB" name="Service Bus: Shipment events topic" />
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="ev_planned" targetRef="SB" />
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="ev_reass" targetRef="SB" />
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="ev_rel" targetRef="SB" />
    <bpmn:textAnnotation id="Ann_Back"><bpmn:text>A Carrier Shipment comes back to Planned when its booking ends Rejected, Not delivered, Withdrawn or Cancelled (P4, P7). The Planner reassigns or releases it again.</bpmn:text></bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_P3" name="P3 Transport planning" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P3">
      <bpmn:lane id="L_Planner" name="Planner (TMS UI)">
        <bpmn:flowNodeRef>s_to</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_see</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_re</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reassign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_spot</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Tms" name="TMS">
        <bpmn:flowNodeRef>t_rules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_rules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_refused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_planned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_reass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_who</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_rel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_to</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_p4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_p11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_p4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_p11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_price</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_to" name="Accepted Transport Order in list to plan">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t_see" name="Review Transport Orders to plan">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_assign" name="Assign to Own fleet or a Carrier">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="t_rules" name="Check assignment rules">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="gw_rules" name="Rules pass?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_refused" name="Refused with reason">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_create" name="Create Shipment, set both Planned">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="ev_planned" name="ShipmentPlanned">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_ev_planned" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="gw_re" name="Reassign?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_reassign" name="Reassign to Own fleet or another Carrier">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_rec" name="Record reassignment (same Shipment number)">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="ev_reass" name="ShipmentReassigned">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_ev_reass" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="t_release" name="Release Shipment">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_who" name="Assigned to?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_price" name="Price from Carrier Rate Card (P9)">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_spot" name="Release with Spot price and remark">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_book" name="Create Carrier booking, freeze Carrier cost">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_m">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_rel" name="Set Shipment Released">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="ev_rel" name="ShipmentReleased">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_ev_rel" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="gw_to">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="c_p4" name="P4 Carrier booking">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="c_p11" name="P11 Trip dispatch">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="e_p4">
      <bpmn:incoming>Flow_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e_p11">
      <bpmn:incoming>Flow_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="b_price" name="Can't price" attachedToRef="t_price">
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_b_price" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s_to" targetRef="t_see" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t_see" targetRef="t_assign" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t_assign" targetRef="t_rules" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="t_rules" targetRef="gw_rules" />
    <bpmn:sequenceFlow id="Flow_5" name="Yes" sourceRef="gw_rules" targetRef="t_create" />
    <bpmn:sequenceFlow id="Flow_6" name="No" sourceRef="gw_rules" targetRef="e_refused" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="t_create" targetRef="ev_planned" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="ev_planned" targetRef="gw_re" />
    <bpmn:sequenceFlow id="Flow_9" name="Yes" sourceRef="gw_re" targetRef="t_reassign" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="t_reassign" targetRef="t_rec" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="t_rec" targetRef="ev_reass" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="ev_reass" targetRef="gw_re" />
    <bpmn:sequenceFlow id="Flow_13" name="No" sourceRef="gw_re" targetRef="t_release" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="t_release" targetRef="gw_who" />
    <bpmn:sequenceFlow id="Flow_15" name="Carrier" sourceRef="gw_who" targetRef="t_price" />
    <bpmn:sequenceFlow id="Flow_16" name="Own fleet" sourceRef="gw_who" targetRef="gw_m" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="t_price" targetRef="t_book" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="b_price" targetRef="t_spot" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="t_spot" targetRef="t_book" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="t_book" targetRef="gw_m" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="gw_m" targetRef="t_rel" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="t_rel" targetRef="ev_rel" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="ev_rel" targetRef="gw_to" />
    <bpmn:sequenceFlow id="Flow_24" name="Carrier" sourceRef="gw_to" targetRef="c_p4" />
    <bpmn:sequenceFlow id="Flow_25" name="Own fleet" sourceRef="gw_to" targetRef="c_p11" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="c_p4" targetRef="e_p4" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="c_p11" targetRef="e_p11" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P3">
    <bpmndi:BPMNPlane id="Plane_P3" bpmnElement="Collaboration_P3">
      <bpmndi:BPMNShape id="Participant_P3_di" bpmnElement="Participant_P3" isHorizontal="true">
