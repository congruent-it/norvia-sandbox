        <dc:Bounds x="1581" y="585" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_any_di" bpmnElement="gw_any" isMarkerVisible="true">
        <dc:Bounds x="1753" y="585" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1628" y="552" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_none_di" bpmnElement="e_none">
        <dc:Bounds x="1760" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1800" y="485" width="150" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_issue_di" bpmnElement="t_issue">
        <dc:Bounds x="1885" y="570" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ev_issued_di" bpmnElement="ev_issued">
        <dc:Bounds x="2104" y="592" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2042" y="631" width="160" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_cn_di" bpmnElement="s_cn">
        <dc:Bounds x="1760" y="127" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1698" y="166" width="160" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_cnf_di" bpmnElement="t_cnf">
        <dc:Bounds x="1885" y="105" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_cn_di" bpmnElement="t_cn">
        <dc:Bounds x="2057" y="460" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ev_cn_di" bpmnElement="ev_cn">
        <dc:Bounds x="2276" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2214" y="521" width="160" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_map_di" bpmnElement="t_map">
        <dc:Bounds x="2401" y="745" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_send_di" bpmnElement="t_send">
        <dc:Bounds x="2573" y="745" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_ack_di" bpmnElement="gw_ack" isMarkerVisible="true">
        <dc:Bounds x="2785" y="760" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2660" y="727" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_rs_di" bpmnElement="t_rs">
        <dc:Bounds x="2917" y="690" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_rnd_di" bpmnElement="t_rnd">
        <dc:Bounds x="2917" y="800" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_rsent_di" bpmnElement="t_rsent">
        <dc:Bounds x="3089" y="460" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_sent_di" bpmnElement="e_sent">
        <dc:Bounds x="3308" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3246" y="521" width="160" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_flag_di" bpmnElement="t_flag">
        <dc:Bounds x="3089" y="570" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_again_di" bpmnElement="t_again">
        <dc:Bounds x="3433" y="105" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_again_di" bpmnElement="e_again">
        <dc:Bounds x="3652" y="127" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3590" y="166" width="160" height="30" />
