          <dc:Bounds x="1010" y="631" width="160" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_timer_di" bpmnElement="s_timer">
        <dc:Bounds x="1244" y="592" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1182" y="631" width="160" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_fin_di" bpmnElement="s_fin">
        <dc:Bounds x="1244" y="127" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1182" y="166" width="160" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
