        <dc:Bounds x="509" y="570" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_ok_di" bpmnElement="gw_ok" isMarkerVisible="true">
        <dc:Bounds x="721" y="585" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="596" y="552" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_ref_di" bpmnElement="e_ref">
        <dc:Bounds x="728" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="768" y="485" width="150" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_rec_di" bpmnElement="t_rec">
        <dc:Bounds x="853" y="570" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_wait_di" bpmnElement="e_wait">
        <dc:Bounds x="1072" y="592" width="36" height="36" />
