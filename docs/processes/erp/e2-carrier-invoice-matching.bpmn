<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_E2" targetNamespace="https://norvia.example/processes/erp/e2">
  <bpmn:collaboration id="Collaboration_E2">
    <bpmn:participant id="Participant_E2" name="E2 Carrier invoice matching" processRef="Process_E2" />
    <bpmn:participant id="Pool_ext" name="Partner portal: the Carrier Persona's draft invoice screen, invoice endpoint and outcome endpoint" />
    <bpmn:messageFlow id="MessageFlow_1" name="Submit a Carrier invoice" sourceRef="Pool_ext" targetRef="s_sub" />
    <bpmn:messageFlow id="MessageFlow_2" name="Received, with each line's result" sourceRef="e_ans" targetRef="Pool_ext" />
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="t_osend" targetRef="Pool_ext" />
    <bpmn:textAnnotation id="Ann_0"><bpmn:text>A Carrier invoice can arrive before the Carrier cost it names. Recording the cost matches the undecided Unknown booking lines again, in the same transaction.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_1"><bpmn:text>A Carrier with a Rejected line sends a new invoice with a new number. A Carrier cost is Invoiced once, so none is paid twice.</bpmn:text></bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_E2" name="E2 Carrier invoice matching" isExecutable="false">
    <bpmn:laneSet id="LaneSet_E2">
      <bpmn:lane id="L_Fin" name="Finance (ERP UI)">
        <bpmn:flowNodeRef>t_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_ph</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Erp" name="ERP">
        <bpmn:flowNodeRef>t_rcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_rules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_ref</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_all</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_appr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_appr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rtold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_told</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cflag</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Cost" name="Carrier cost Logic App">
        <bpmn:flowNodeRef>s_cc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_cc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cdlq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Inv" name="Carrier invoice Logic App">
        <bpmn:flowNodeRef>t_imap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_relay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_ans</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Out" name="Carrier invoice outcome Logic App">
        <bpmn:flowNodeRef>t_omap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_osend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_oack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_told</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ond</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Apim" name="API Management">
        <bpmn:flowNodeRef>s_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_edge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_role</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_403</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_cc" name="CarrierCostIncurred (P9)">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_s_cc" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_cc" name="Call ERP billing API (retry on 5xx / timeout)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="b_cc" name="Refused or retries used up" attachedToRef="t_cc">
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_b_cc" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="e_cdlq" name="Dead-lettered, safe to resubmit">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_rcc" name="Record the Carrier cost as Open (a repeat returns the original)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_rem" name="Match again the Unknown booking lines of this Carrier">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_cc" name="Carrier cost recorded">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s_sub" name="A Carrier Persona submits an invoice">
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_s_sub" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_edge" name="Check token and role, map azp to the Carrier ID, add a correlation ID">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_role" name="Role allowed?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_403" name="403 to a Shipper Persona">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_imap" name="Map to the Canonical Model, call the ERP billing API">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_rules" name="Rules met?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_ref" name="Refused with a stable code">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="t_match" name="Record the invoice and match each line (one transaction)">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:parallelGateway id="sp">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="t_relay" name="Relay the answer: received, with each line's result">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_ans" name="The Carrier knows its invoice arrived">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw_all" name="Every line Matched?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_appr" name="Approve the invoice in the same transaction">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_tw" name="Keep it Received: lines To decide, listed for Finance">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_dec" name="Accept, adjust or reject each line, with a remark or reason">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_rd" name="Record the decision; approve when the last line is decided">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_m">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="ev_appr" name="CarrierInvoiceApproved">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_ev_appr" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="t_omap" name="Map the outcome: result and accepted amount per line">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_osend" name="Send to the Carrier's outcome endpoint (retry on 5xx / timeout)">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_oack" name="Acknowledged?">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_told" name="Report the Carrier told to the ERP">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_ond" name="Report not delivered, with the cause">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_rtold" name="Record the time the Carrier was told">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_told" name="Approved and Carrier told">
      <bpmn:incoming>Flow_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_cflag" name="Flag the invoice Carrier not told, with the cause">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_phone" name="Phone the Carrier">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_ph" name="Carrier told by phone">
      <bpmn:incoming>Flow_33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s_cc" targetRef="t_cc" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t_cc" targetRef="t_rcc" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="b_cc" targetRef="e_cdlq" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="t_rcc" targetRef="t_rem" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="t_rem" targetRef="e_cc" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="s_sub" targetRef="t_edge" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="t_edge" targetRef="gw_role" />
    <bpmn:sequenceFlow id="Flow_8" name="No" sourceRef="gw_role" targetRef="e_403" />
    <bpmn:sequenceFlow id="Flow_9" name="Yes" sourceRef="gw_role" targetRef="t_imap" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="t_imap" targetRef="gw_rules" />
    <bpmn:sequenceFlow id="Flow_11" name="No" sourceRef="gw_rules" targetRef="e_ref" />
    <bpmn:sequenceFlow id="Flow_12" name="Yes" sourceRef="gw_rules" targetRef="t_match" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="t_match" targetRef="sp" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="sp" targetRef="t_relay" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="t_relay" targetRef="e_ans" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="sp" targetRef="gw_all" />
    <bpmn:sequenceFlow id="Flow_17" name="Yes" sourceRef="gw_all" targetRef="t_appr" />
    <bpmn:sequenceFlow id="Flow_18" name="No" sourceRef="gw_all" targetRef="t_tw" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="t_tw" targetRef="t_dec" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="t_dec" targetRef="t_rd" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="t_appr" targetRef="gw_m" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="t_rd" targetRef="gw_m" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="gw_m" targetRef="ev_appr" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="ev_appr" targetRef="t_omap" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="t_omap" targetRef="t_osend" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="t_osend" targetRef="gw_oack" />
    <bpmn:sequenceFlow id="Flow_27" name="Yes" sourceRef="gw_oack" targetRef="t_told" />
    <bpmn:sequenceFlow id="Flow_28" name="No" sourceRef="gw_oack" targetRef="t_ond" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="t_told" targetRef="t_rtold" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="t_rtold" targetRef="e_told" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="t_ond" targetRef="t_cflag" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="t_cflag" targetRef="t_phone" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="t_phone" targetRef="e_ph" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_E2">
    <bpmndi:BPMNPlane id="Plane_E2" bpmnElement="Collaboration_E2">
      <bpmndi:BPMNShape id="Participant_E2_di" bpmnElement="Participant_E2" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="3830" height="1240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Fin_di" bpmnElement="L_Fin" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="3800" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Erp_di" bpmnElement="L_Erp" isHorizontal="true">
        <dc:Bounds x="130" y="230" width="3800" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Cost_di" bpmnElement="L_Cost" isHorizontal="true">
        <dc:Bounds x="130" y="460" width="3800" height="210" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Inv_di" bpmnElement="L_Inv" isHorizontal="true">
        <dc:Bounds x="130" y="670" width="3800" height="210" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Out_di" bpmnElement="L_Out" isHorizontal="true">
        <dc:Bounds x="130" y="880" width="3800" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Apim_di" bpmnElement="L_Apim" isHorizontal="true">
        <dc:Bounds x="130" y="1110" width="3800" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_cc_di" bpmnElement="s_cc">
        <dc:Bounds x="212" y="527" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="150" y="566" width="160" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_cc_di" bpmnElement="t_cc">
        <dc:Bounds x="337" y="505" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="b_cc_di" bpmnElement="b_cc">
        <dc:Bounds x="384" y="567" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="290" y="571" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_cdlq_di" bpmnElement="e_cdlq">
        <dc:Bounds x="556" y="602" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="494" y="641" width="160" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_rcc_di" bpmnElement="t_rcc">
        <dc:Bounds x="509" y="360" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_rem_di" bpmnElement="t_rem">
        <dc:Bounds x="681" y="360" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_cc_di" bpmnElement="e_cc">
        <dc:Bounds x="900" y="382" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="838" y="421" width="160" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_sub_di" bpmnElement="s_sub">
        <dc:Bounds x="384" y="1172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="322" y="1211" width="160" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_edge_di" bpmnElement="t_edge">
        <dc:Bounds x="509" y="1150" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_role_di" bpmnElement="gw_role" isMarkerVisible="true">
        <dc:Bounds x="721" y="1165" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="596" y="1132" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_403_di" bpmnElement="e_403">
        <dc:Bounds x="728" y="1232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="666" y="1271" width="160" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_imap_di" bpmnElement="t_imap">
        <dc:Bounds x="853" y="735" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_rules_di" bpmnElement="gw_rules" isMarkerVisible="true">
        <dc:Bounds x="1065" y="375" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="940" y="342" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_ref_di" bpmnElement="e_ref">
        <dc:Bounds x="1072" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1112" y="275" width="150" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_match_di" bpmnElement="t_match">
        <dc:Bounds x="1197" y="360" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sp_di" bpmnElement="sp">
        <dc:Bounds x="1409" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_relay_di" bpmnElement="t_relay">
        <dc:Bounds x="1541" y="735" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_ans_di" bpmnElement="e_ans">
        <dc:Bounds x="1760" y="757" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1698" y="796" width="160" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_all_di" bpmnElement="gw_all" isMarkerVisible="true">
        <dc:Bounds x="1581" y="375" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1456" y="342" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_appr_di" bpmnElement="t_appr">
        <dc:Bounds x="1713" y="360" width="130" height="80" />
      </bpmndi:BPMNShape>
