{
  "openapi": "3.1.1",
  "info": {
    "title": "Norvia.DriverApp.Api | v1",
    "description": "",
    "version": "1"
  },
  "paths": {
    "/v1/trips": {
      "post": {
        "tags": [
          "Trips"
        ],
        "operationId": "ReceiveTripVersion",
        "parameters": [
          {
            "name": "X-Api-Key",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripVersionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/drivers/{driverId}/trips": {
      "get": {
        "tags": [
          "Drivers"
        ],
        "operationId": "ListTripsOfDriver",
        "parameters": [
          {
            "name": "driverId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/report-outcomes": {
      "post": {
        "tags": [
          "ReportOutcomes"
        ],
        "summary": "Tell the Driver app what became of a Driver's report: Recorded, Refused (with the TMS's code and message) or Not recorded.",
        "description": "Only the identity holding the app role DriverReports.ReportOutcome may call it. A report that has an outcome already is left as it is and acknowledged with result Ignored, so the Logic App can send an outcome again. An unknown report, or one of another Trip, is ReportNotFound (404).",
        "operationId": "ReportOutcome",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportOutcomeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/driver/trips": {
      "get": {
        "tags": [
          "DriverActions"
        ],
        "summary": "List the Driver's own Trips, the latest version of each, with their Stops in order and the Driver's reports on them.",
        "operationId": "ListMyTrips",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/driver/trips/{tripNumber}/start": {
      "post": {
        "tags": [
          "DriverActions"
        ],
        "summary": "Start a Dispatched Trip as its Driver.",
        "description": "A Trip that isn't the token's Driver's is TripNotFound (404). The report travels to the TMS as an event, and the TMS decides whether the Trip can start.",
        "operationId": "DriverStartTrip",
        "parameters": [
          {
            "name": "tripNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/driver/trips/{tripNumber}/end": {
      "post": {
        "tags": [
          "DriverActions"
        ],
        "summary": "End an In progress Trip as its Driver, once every Stop has an outcome.",
        "description": "TripNotFound (404), or ReportNotAvailable (409) while the Trip isn't started or a Stop has no outcome.",
        "operationId": "DriverEndTrip",
        "parameters": [
          {
            "name": "tripNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/driver/trips/{tripNumber}/stops/{shipmentNumber}/{kind}/{action}": {
      "post": {
        "tags": [
          "DriverActions"
        ],
        "summary": "Report Collected, Collection failed or Delivery failed at a Stop, or damage at any.",
        "description": "kind is collection or delivery and action is collected, collection-failed, delivery-failed or damaged, as on the Driver app's screens. A failure and damage need a remark. StopNotFound (404), ReportInvalid (400) or ReportNotAvailable (409) when the Stop can't be reported on now.",
        "operationId": "DriverReportStop",
        "parameters": [
          {
            "name": "tripNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "shipmentNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/StopReportRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/driver/trips/{tripNumber}/stops/{shipmentNumber}/delivery/deliver": {
      "post": {
        "tags": [
          "DriverActions"
        ],
        "summary": "Deliver a delivery Stop with a Proof of delivery.",
        "description": "receivedBy, condition and a PNG signature are required, with a remark when there are reservations, and 0 to 4 photos. StopNotFound (404), ReportInvalid (400) or ReportNotAvailable (409).",
        "operationId": "DriverDeliver",
        "parameters": [
          {
            "name": "tripNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "shipmentNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/DeliverRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/faults": {
      "get": {
        "tags": [
          "Faults"
        ],
        "summary": "List the faults this application owns, with whether each is on and how long it has left.",
        "operationId": "ListFaults",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/faults/{name}": {
      "put": {
        "tags": [
          "Faults"
        ],
        "summary": "Switch one of this application's faults on, for a duration after which it expires by itself, or off.",
        "description": "Only a caller holding the app role Demo.Fault may call it. A duration longer than the application allows (a few minutes by default) is refused with 400.",
        "operationId": "SwitchFault",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SwitchFaultRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/reset": {
      "get": {
        "tags": [
          "Reset"
        ],
        "summary": "Whether a reset would be taken now.",
        "description": "enabled is the Reset setting, which is off unless the estate switches it on. busySubscription names the first topic subscription that holds unprocessed messages, as topic/subscription, or is null when all are empty.",
        "operationId": "GetResetReadiness",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetReadiness"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Reset"
        ],
        "summary": "Delete the Driver app's Trips and reports.",
        "description": "Deletes the Trips the Driver app was sent, the Drivers' reports and the outbox Messages, and puts the demo settings back to their defaults. Refused, deleting nothing, with a 403 problem (code ResetDisabled) while the setting is off, and a 409 problem (code SubscriptionBusy) naming the subscription while one holds unprocessed messages.",
        "operationId": "ResetEstate",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetReport"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeletedKind": {
        "required": [
          "kind",
          "count"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "DeliverRequest": {
        "required": [
          "receivedBy",
          "condition",
          "remark",
          "signature",
          "photos"
        ],
        "type": "object",
        "properties": {
          "receivedBy": {
            "type": [
              "null",
              "string"
            ]
          },
          "condition": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DeliveryConditionDto"
              }
            ]
          },
          "remark": {
            "type": [
              "null",
              "string"
            ]
          },
          "signature": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ProofFileRequest"
              }
            ]
          },
          "photos": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/ProofFileRequest"
            }
          }
        }
      },
      "DeliveryConditionDto": {
        "enum": [
          "Clean",
          "Reservations",
          null
        ]
      },
      "ProofFileRequest": {
        "required": [
          "contentType",
          "content"
        ],
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "format": "byte"
          }
        }
      },
      "ReportOutcomeKind": {
        "enum": [
          "Recorded",
          "Refused",
          "NotRecorded"
        ]
      },
      "ReportOutcomeRequest": {
        "required": [
          "driverAppEventId",
          "tripNumber",
          "correlationId",
          "outcome",
          "failureCode",
          "message"
        ],
        "type": "object",
        "properties": {
          "driverAppEventId": {
            "type": "string",
            "format": "uuid"
          },
          "tripNumber": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/ReportOutcomeKind"
          },
          "failureCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ResetReadiness": {
        "required": [
          "enabled",
          "busySubscription"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "busySubscription": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ResetReport": {
        "required": [
          "deleted"
        ],
        "type": "object",
        "properties": {
          "deleted": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeletedKind"
            }
          }
        }
      },
      "StopAddressDto": {
        "required": [
          "street",
          "postcode",
          "city",
          "country"
        ],
        "type": "object",
        "properties": {
          "street": {
            "type": [
              "null",
              "string"
            ]
          },
          "postcode": {
            "type": [
              "null",
              "string"
            ]
          },
          "city": {
            "type": [
              "null",
              "string"
            ]
          },
          "country": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StopConsigneeDto": {
        "required": [
          "name",
          "contactName",
          "phone",
          "email"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "contactName": {
            "type": [
              "null",
              "string"
            ]
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StopDimensionsDto": {
        "required": [
          "length",
          "width",
          "height"
        ],
        "type": "object",
        "properties": {
          "length": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "width": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "height": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "StopDto": {
        "required": [
          "sequence",
          "kind",
          "shipmentNumber",
          "transportOrderNumber",
          "shipperId",
          "address",
          "window",
          "goodsLines",
          "consignee"
        ],
        "type": "object",
        "properties": {
          "sequence": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "kind": {
            "$ref": "#/components/schemas/StopKindDto"
          },
          "shipmentNumber": {
            "type": "string"
          },
          "transportOrderNumber": {
            "type": "string"
          },
          "shipperId": {
            "type": "string"
          },
          "address": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/StopAddressDto"
              }
            ]
          },
          "window": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/StopWindowDto"
              }
            ]
          },
          "goodsLines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StopGoodsLineDto"
            }
          },
          "consignee": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/StopConsigneeDto"
              }
            ]
          }
        }
      },
      "StopGoodsLineDto": {
        "required": [
          "packageType",
          "quantity",
          "weightKg",
          "dimensionsCm"
        ],
        "type": "object",
        "properties": {
          "packageType": {
            "type": [
              "null",
              "string"
            ]
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "weightKg": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "dimensionsCm": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/StopDimensionsDto"
              }
            ]
          }
        }
      },
      "StopKindDto": {
        "enum": [
          "Collection",
          "Delivery"
        ]
      },
      "StopReportRequest": {
        "required": [
          "remark"
        ],
        "type": "object",
        "properties": {
          "remark": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StopWindowDto": {
        "required": [
          "earliest",
          "latest"
        ],
        "type": "object",
        "properties": {
          "earliest": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "latest": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "SwitchFaultRequest": {
        "required": [
          "on"
        ],
        "type": "object",
        "properties": {
          "on": {
            "type": "boolean"
          },
          "durationSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "TripDriverRequest": {
        "required": [
          "driverId",
          "name"
        ],
        "type": "object",
        "properties": {
          "driverId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "TripVehicleDto": {
        "required": [
          "vehicleId",
          "registration",
          "vehicleType"
        ],
        "type": "object",
        "properties": {
          "vehicleId": {
            "type": "string"
          },
          "registration": {
            "type": "string"
          },
          "vehicleType": {
            "type": "string"
          }
        }
      },
      "TripVersionRequest": {
        "required": [
          "tripNumber",
          "version",
          "correlationId",
          "day",
          "plannedStart",
          "plannedDrivingDuration",
          "vehicle",
          "driver",
          "stops"
        ],
        "type": "object",
        "properties": {
          "tripNumber": {
            "type": "string"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "correlationId": {
            "type": "string"
          },
          "day": {
            "type": "string",
            "format": "date"
          },
          "plannedStart": {
            "type": "string",
            "format": "time"
          },
          "plannedDrivingDuration": {
            "type": "string"
          },
          "vehicle": {
            "$ref": "#/components/schemas/TripVehicleDto"
          },
          "driver": {
            "$ref": "#/components/schemas/TripDriverRequest"
          },
          "stops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StopDto"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Trips"
    },
    {
      "name": "Drivers"
    },
    {
      "name": "ReportOutcomes"
    },
    {
      "name": "DriverActions"
    },
    {
      "name": "Faults"
    },
    {
      "name": "Reset"
    }
  ]
}
