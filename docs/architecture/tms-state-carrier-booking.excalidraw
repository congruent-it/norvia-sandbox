      "boundElements": [],
      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "A Shipment can have several Carrier bookings over its life, but only one open at a time. Every end except Confirmed puts the Shipment back to Planned.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "A Shipment can have several Carrier bookings over its life, but only one open at a time. Every end except Confirmed puts the Shipment back to Planned.",
      "autoResize": false,
      "lineHeight": 1.25
    },
