      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "A Shipper books, the TMS accepts and rates the order, the Planner assigns and releases it, and the Carrier confirms. P1 to P4. An Own fleet Shipment leaves this path at the release: see lifecycles\n2 and 3.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "A Shipper books, the TMS accepts and rates the order, the Planner assigns and releases it, and the Carrier confirms. P1 to P4. An Own fleet Shipment leaves this path at the release: see lifecycles\n2 and 3.",
      "autoResize": false,
      "lineHeight": 1.25
    },
