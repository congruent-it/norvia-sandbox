      "boundElements": [],
      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "The ERP and the Shipper invoice Logic App never decide twice:\nthe invoice number is the key at the Partner portal, and a\nreport for a document already reported is ignored.",
      "fontSize": 11,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "The ERP and the Shipper invoice Logic App never decide twice:\nthe invoice number is the key at the Partner portal, and a\nreport for a document already reported is ignored.",
