      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "One invoice per Shipper per run. A Shipper invoice is\nnever changed after it is issued: corrections are Credit\nnotes.",
      "fontSize": 11,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "One invoice per Shipper per run. A Shipper invoice is\nnever changed after it is issued: corrections are Credit\nnotes.",
      "autoResize": false,
      "lineHeight": 1.25
    },
