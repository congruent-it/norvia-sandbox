      "link": null,
      "locked": false,
      "text": "How a message moves between the applications. An application takes commands as HTTP calls and publishes what happened to Service Bus; it never consumes from it. Each Logic App runs one Flow and ends in a call to the TMS API.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "How a message moves between the applications. An application takes commands as HTTP calls and publishes what happened to Service Bus; it never consumes from it. Each Logic App runs one Flow and ends in a call to the TMS API.",
      "autoResize": false,
      "lineHeight": 1.25
