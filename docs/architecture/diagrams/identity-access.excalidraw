      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "Every caller is a managed identity. Each row holds only the roles its job needs: a Logic App calls one thin operation, reads its own subscription and a few secrets.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Every caller is a managed identity. Each row holds only the roles its job needs: a Logic App calls one thin operation, reads its own subscription and a few secrets.",
