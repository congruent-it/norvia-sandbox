      "link": null,
      "locked": false,
      "text": "Lines To decide wait for Finance, who accepts them at the invoiced or an\nadjusted amount, or rejects them with a reason. An unknown booking is matched\nagain when its Carrier cost arrives",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Lines To decide wait for Finance, who accepts them at the invoiced or an\nadjusted amount, or rejects them with a reason. An unknown booking is matched\nagain when its Carrier cost arrives",
      "autoResize": false,
      "lineHeight": 1.25
