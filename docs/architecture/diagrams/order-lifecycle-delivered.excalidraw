      "link": null,
      "locked": false,
      "text": "Notifying the Shipper and cancelling a booking go out through the Shipper\nnotification and Carrier cancellation Logic Apps, and the TMS records what\nbecame of each",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Notifying the Shipper and cancelling a booking go out through the Shipper\nnotification and Carrier cancellation Logic Apps, and the TMS records what\nbecame of each",
      "autoResize": false,
      "lineHeight": 1.25
    },
