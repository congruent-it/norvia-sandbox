      "link": null,
      "locked": false,
      "text": "No Easy Auth: the AppHost signs the developer\nin as a local operator with both roles. It\nrefuses those settings outside Development",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "No Easy Auth: the AppHost signs the developer\nin as a local operator with both roles. It\nrefuses those settings outside Development",
      "autoResize": false,
      "lineHeight": 1.25
    },
