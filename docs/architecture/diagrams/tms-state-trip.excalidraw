      "isDeleted": false,
      "boundElements": [],
      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "A Trip's status follows the Planner and then the Driver. Each version the Planner sends has its own delivery state, so a Trip the Driver app never received is visible.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "A Trip's status follows the Planner and then the Driver. Each version the Planner sends has its own delivery state, so a Trip the Driver app never received is visible.",
      "autoResize": false,
      "lineHeight": 1.25
    },
