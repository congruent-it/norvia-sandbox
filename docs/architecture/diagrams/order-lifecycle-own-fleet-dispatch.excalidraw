      "boundElements": [],
      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "Solid arrows are calls, dashed arrows are replies and events. Every call between applications goes through the integration layer. Source of truth: docs/processes/tms (P3, P10, P11).",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
