      "boundElements": [],
      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "The version is Delivered to the Driver app. If\nthe Logic App gives up, it is Not delivered\nand the Planner sees it and sends it again",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "The version is Delivered to the Driver app. If\nthe Logic App gives up, it is Not delivered\nand the Planner sees it and sends it again",
      "autoResize": false,
      "lineHeight": 1.25
    },
