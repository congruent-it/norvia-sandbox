      "seed": 531748802,
      "version": 1,
      "versionNonce": 854478761,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "Amend sends the Driver a new version of the whole Trip. Once the Trip is under way, the only change allowed\nis taking off a Shipment that has not been collected, which puts it back to Planned",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Amend sends the Driver a new version of the whole Trip. Once the Trip is under way, the only change allowed\nis taking off a Shipment that has not been collected, which puts it back to Planned",
      "autoResize": false,
      "lineHeight": 1.25
    },
