      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "Finance corrects an issued invoice with a Credit\nnote, which takes the same path as\nCreditNoteIssued. An Own fleet order is invoiced\nthe same way and has no Carrier cost, so lifecycle\n6 does not apply to it",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Finance corrects an issued invoice with a Credit\nnote, which takes the same path as\nCreditNoteIssued. An Own fleet order is invoiced\nthe same way and has no Carrier cost, so lifecycle\n6 does not apply to it",
      "autoResize": false,
      "lineHeight": 1.25
    },
