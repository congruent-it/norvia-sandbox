      "link": null,
      "locked": false,
      "text": "Source of truth: er-driver-app.json, which Norvia.Docs.Generator writes from the EF Core model. An arrow runs from the referenced table to the table that holds the\nforeign key, labelled with its foreign key column and its cardinality: 1 to n, with 0..1 in place of 1 for a nullable key and in place of n for a unique one. Tables\nwith no foreign key to or from them sit in the rows below.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Source of truth: er-driver-app.json, which Norvia.Docs.Generator writes from the EF Core model. An arrow runs from the referenced table to the table that holds the\nforeign key, labelled with its foreign key column and its cardinality: 1 to n, with 0..1 in place of 1 for a nullable key and in place of n for a unique one. Tables\nwith no foreign key to or from them sit in the rows below.",
      "autoResize": false,
      "lineHeight": 1.25
    }
