      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "One namespace, norvia, on a shared cluster. The chart installs no ingress controller, issuer or storage class, and nothing in it reaches Azure (ADR 0053).",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "One namespace, norvia, on a shared cluster. The chart installs no ingress controller, issuer or storage class, and nothing in it reaches Azure (ADR 0053).",
      "autoResize": false,
      "lineHeight": 1.25
    },
