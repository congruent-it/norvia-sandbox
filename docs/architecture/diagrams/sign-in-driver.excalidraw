      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "No Entra: a sign-in page lists the seeded\nDrivers and signs the chosen one in with a\ncookie holding the same driverId claim.\nDevelopment only",
      "autoResize": false,
      "lineHeight": 1.25
    },
