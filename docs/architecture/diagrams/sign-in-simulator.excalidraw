      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "Solid arrows are calls, dashed arrows are replies. No sign-in holds a client secret. Source of truth: ADR 0042, ADR 0005 and ADR 0037.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Solid arrows are calls, dashed arrows are replies. No sign-in holds a client secret. Source of truth: ADR 0042, ADR 0005 and ADR 0037.",
