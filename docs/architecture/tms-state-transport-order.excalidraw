      "versionNonce": 847877000,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "Three separate dimensions on one aggregate: where the order stands (status), what rating made of it, and whether it can be billed. A rating failure never rejects an order.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Three separate dimensions on one aggregate: where the order stands (status), what rating made of it, and whether it can be billed. A rating failure never rejects an order.",
      "autoResize": false,
      "lineHeight": 1.25
    },
