      "boundElements": [],
      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "Own fleet and Carrier Shipments share one status. Tracking events move a Shipment forward only, and never past what they report. Awaiting re-delivery is a flag, not a status.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Own fleet and Carrier Shipments share one status. Tracking events move a Shipment forward only, and never past what they report. Awaiting re-delivery is a flag, not a status.",
      "autoResize": false,
      "lineHeight": 1.25
    },
