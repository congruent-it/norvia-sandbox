<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Include>[Norvia.Branding]*</Include>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="bunit" />
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <Using Include="Bunit" />
    <ProjectReference Include="..\..\..\src\Norvia.Branding\Norvia.Branding.csproj" />
  </ItemGroup>
  <!-- The icon files themselves are checked: their formats and sizes are what browsers rely on. -->
  <ItemGroup>
    <None Include="..\..\..\src\Norvia.Branding\wwwroot\*" Link="icons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
