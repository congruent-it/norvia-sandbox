<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\..\src\Norvia.AppHost\Norvia.AppHost.csproj" />
    <ProjectReference Include="..\..\Tms\Norvia.Tms.TestSupport\Norvia.Tms.TestSupport.csproj" />
    <ProjectReference Include="..\..\Erp\Norvia.Erp.TestSupport\Norvia.Erp.TestSupport.csproj" />
    <Using Include="Norvia.Tms.TestSupport" />
  </ItemGroup>
  <ItemGroup>
    <!-- The proxy the worker reaches the TMS through is the integration tests' own, so a test can make the TMS refuse a call. -->
    <Compile Include="..\Norvia.Integration.MasterDataSync.IntegrationTests\TmsProxy.cs" Link="TmsProxy.cs" />
    <!-- One fixture starts an AppHost (SQL Server and two Service Bus emulators in Docker, the ERP, the TMS, the master-data sync worker and the Integration console); the tests share it and run one at a time. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\seed\norvia.seed.json" Link="norvia.seed.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
