<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <ProjectReference Include="..\..\..\src\Norvia.AppHost\Norvia.AppHost.csproj" />
    <!-- Aliased: the AppHost, the ERP API, the ERP UI, the Carrier invoice worker and the Partner API each have a Program, and the ERP API and UI each generate their own AddMediator. -->
    <ProjectReference Include="..\..\..\src\Erp\Norvia.Erp.Api\Norvia.Erp.Api.csproj" Aliases="ErpApi" />
    <ProjectReference Include="..\..\..\src\Erp\Norvia.Erp.Web\Norvia.Erp.Web.csproj" Aliases="ErpWeb" />
    <ProjectReference Include="..\..\..\src\Integration\Norvia.Integration.LocalCarrierInvoiceWorker\Norvia.Integration.LocalCarrierInvoiceWorker.csproj" Aliases="InvoiceWorker" />
    <ProjectReference Include="..\..\..\src\Integration\Norvia.Integration.LocalPartnerApi\Norvia.Integration.LocalPartnerApi.csproj" Aliases="PartnerApi" />
  </ItemGroup>
  <ItemGroup>
    <!-- One fixture starts an AppHost (SQL Server in Docker); the tests share its database and run one at a time. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\seed\norvia.seed.json" Link="norvia.seed.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
