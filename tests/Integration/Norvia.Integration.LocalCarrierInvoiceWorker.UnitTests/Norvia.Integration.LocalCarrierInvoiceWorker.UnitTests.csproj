<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Include>[Norvia.Integration.LocalCarrierInvoiceWorker]*</Include>
    <!-- Program.cs is the composition root (coding guidelines §10). -->
    <ExcludeByFile>**/Program.cs</ExcludeByFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Norvia.Integration.UnitTests" />
    <Compile Include="..\Shared\StubHttp.cs" Link="StubHttp.cs" />
    <Using Include="AwesomeAssertions" />
    <ProjectReference Include="..\..\..\src\Integration\Norvia.Integration.LocalCarrierInvoiceWorker\Norvia.Integration.LocalCarrierInvoiceWorker.csproj" />
  </ItemGroup>
  <!-- Embedded, so the tests read the contracts without touching the file system (coding guidelines §10). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\contracts\partner-api\samples\carrier-invoices\*.json" LogicalName="PartnerApi/samples/carrier-invoices/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
