<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Include>[Norvia.Integration.CarrierBooking]*</Include>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <ProjectReference Include="..\..\..\src\Integration\Norvia.Integration.CarrierBooking\Norvia.Integration.CarrierBooking.csproj" />
  </ItemGroup>
  <!-- Embedded, so the unit tests read the contracts and the workflow without touching the file system (coding guidelines §10). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\contracts\partner-api\*.schema.json" LogicalName="PartnerApi/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\canonical-model\*.json" LogicalName="CanonicalModel/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\partner-api\samples\carrier-bookings\*.json" LogicalName="PartnerApi/samples/carrier-bookings/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\partner-api\samples\carrier-answers\*.json" LogicalName="PartnerApi/samples/carrier-answers/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\partner-api\samples\carrier-answer-responses\*.json" LogicalName="PartnerApi/samples/carrier-answer-responses/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\partner-api\samples\carrier-tracking\*.json" LogicalName="PartnerApi/samples/carrier-tracking/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\partner-api\samples\carrier-proofs-of-delivery\*.json" LogicalName="PartnerApi/samples/carrier-proofs-of-delivery/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\infra\estate\partner-api\answer-carrier-booking.policy.xml" LogicalName="PartnerApiPolicies/answer-carrier-booking.policy.xml" />
    <EmbeddedResource Include="..\..\..\infra\estate\partner-api\submit-carrier-tracking.policy.xml" LogicalName="PartnerApiPolicies/submit-carrier-tracking.policy.xml" />
    <EmbeddedResource Include="..\..\..\src\Integration\TrackingLogicApp\*.json" LogicalName="TrackingLogicApp/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\src\Integration\TrackingLogicApp\carrier-tracking\workflow.json" LogicalName="TrackingLogicApp/carrier-tracking/workflow.json" />
    <EmbeddedResource Include="..\..\..\src\Integration\AnswerLogicApp\*.json" LogicalName="AnswerLogicApp/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\src\Integration\AnswerLogicApp\carrier-answer\workflow.json" LogicalName="AnswerLogicApp/carrier-answer/workflow.json" />
    <EmbeddedResource Include="..\..\..\src\Integration\BookingLogicApp\*.json" LogicalName="BookingLogicApp/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\src\Integration\BookingLogicApp\carrier-booking\workflow.json" LogicalName="BookingLogicApp/carrier-booking/workflow.json" />
  </ItemGroup>
</Project>
