<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Include>[Norvia.Integration.TransportOrderIntake]*</Include>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <ProjectReference Include="..\..\..\src\Integration\Norvia.Integration.TransportOrderIntake\Norvia.Integration.TransportOrderIntake.csproj" />
  </ItemGroup>
  <!-- Embedded, so the unit tests read the contracts without touching the file system (coding guidelines §10). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\contracts\canonical-model\*.json" LogicalName="CanonicalModel/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\partner-api\*.json" LogicalName="PartnerApi/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\partner-api\samples\bookings\*.json" LogicalName="PartnerApi/samples/bookings/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\partner-api\samples\responses\*.json" LogicalName="PartnerApi/samples/responses/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\src\Integration\IntakeLogicApp\*.json" LogicalName="IntakeLogicApp/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\src\Integration\IntakeLogicApp\transport-order-intake\workflow.json" LogicalName="IntakeLogicApp/transport-order-intake/workflow.json" />
  </ItemGroup>
</Project>
