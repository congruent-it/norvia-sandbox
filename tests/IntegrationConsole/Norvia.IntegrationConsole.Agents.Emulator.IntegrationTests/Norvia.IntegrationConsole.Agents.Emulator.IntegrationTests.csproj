<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <ProjectReference Include="..\..\..\src\Norvia.AppHost\Norvia.AppHost.csproj" />
    <!-- Aliased: the console and the MCP stand-in each have a Program. -->
    <ProjectReference Include="..\..\..\src\IntegrationConsole\Norvia.IntegrationConsole.Web\Norvia.IntegrationConsole.Web.csproj" Aliases="ConsoleWeb" />
    <ProjectReference Include="..\..\..\src\Integration\Norvia.Integration.LocalAgentMcp\Norvia.Integration.LocalAgentMcp.csproj" Aliases="AgentMcp" />
  </ItemGroup>
  <ItemGroup>
    <!-- The in-memory pair of applications is the Agents integration tests' (they share a namespace); this project adds the Service Bus emulator behind the console. -->
    <Compile Include="..\Norvia.IntegrationConsole.Agents.IntegrationTests\AgentHost.cs" Link="AgentHost.cs" />
    <Compile Include="..\Norvia.IntegrationConsole.Agents.IntegrationTests\TrackedLogs.cs" Link="TrackedLogs.cs" />
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
