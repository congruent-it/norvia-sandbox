<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Include>[Norvia.DriverApp.Application]*</Include>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>
  <!-- Embedded, so the unit tests read the contracts without touching the file system (coding guidelines §10). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\contracts\canonical-model\*.schema.json" LogicalName="CanonicalModel/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\canonical-model\samples\trip-start-reported\*.json" LogicalName="CanonicalModel/samples/trip-start-reported/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\canonical-model\samples\stop-completed-reported\*.json" LogicalName="CanonicalModel/samples/stop-completed-reported/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\canonical-model\samples\proof-of-delivery-captured\*.json" LogicalName="CanonicalModel/samples/proof-of-delivery-captured/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\canonical-model\samples\driver-report-outcome\*.json" LogicalName="CanonicalModel/samples/driver-report-outcome/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <ProjectReference Include="..\..\..\src\DriverApp\Norvia.DriverApp.Application\Norvia.DriverApp.Application.csproj" />
  </ItemGroup>
</Project>
