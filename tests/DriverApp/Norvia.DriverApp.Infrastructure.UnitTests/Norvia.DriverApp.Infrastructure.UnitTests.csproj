<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Only the outbox is gated: the rest of the Driver app's Infrastructure is EF Core and SQL, which the Driver app's integration tests run against
      real containers (coding guidelines §10).
    -->
    <Include>[Norvia.DriverApp.Infrastructure]Norvia.DriverApp.Infrastructure.Outbox.*</Include>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <Using Include="NSubstitute" />
    <ProjectReference Include="..\..\..\src\DriverApp\Norvia.DriverApp.Infrastructure\Norvia.DriverApp.Infrastructure.csproj" />
  </ItemGroup>
</Project>
