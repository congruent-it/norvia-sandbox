<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <ProjectReference Include="..\..\..\src\Norvia.AppHost\Norvia.AppHost.csproj" />
    <ProjectReference Include="..\..\..\src\Norvia.Agents\Norvia.Agents.csproj" />
    <ProjectReference Include="..\..\..\src\Tms\Norvia.Tms.Api\Norvia.Tms.Api.csproj" />
    <ProjectReference Include="..\Norvia.Tms.TestSupport\Norvia.Tms.TestSupport.csproj" />
    <Using Include="Norvia.Tms.TestSupport" />
    <Using Include="Norvia.Tms.TestSupport.Planning" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Agent's definition, which the tests run the in-process runner with, as the TMS UI does. -->
    <None Include="..\..\..\agents\planner.agent.yaml" Link="agents\planner.agent.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\agents\planner-exception-note.agent.yaml" Link="agents\planner-exception-note.agent.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\agents\planner-notification.agent.yaml" Link="agents\planner-notification.agent.yaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- The tool lists of every Agent server, so the tests refuse each tool of the others. -->
    <None Include="..\..\..\contracts\agent-mcp\*.tools.json" Link="contracts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- One AppHost for the whole project (SQL Server and the Service Bus emulator in Docker). -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
