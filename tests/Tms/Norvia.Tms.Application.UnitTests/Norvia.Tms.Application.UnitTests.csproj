<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Include>[Norvia.Tms.Application]*</Include>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>
  <!-- Embedded, so the unit tests read the contracts without touching the file system (coding guidelines §10). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\contracts\canonical-model\*.schema.json" LogicalName="CanonicalModel/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\canonical-model\samples\trip-dispatched\*.json" LogicalName="CanonicalModel/samples/trip-dispatched/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\canonical-model\samples\trip-not-delivered\*.json" LogicalName="CanonicalModel/samples/trip-not-delivered/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\canonical-model\samples\trip-started\*.json" LogicalName="CanonicalModel/samples/trip-started/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\canonical-model\samples\shipment-taken-off-trip\*.json" LogicalName="CanonicalModel/samples/shipment-taken-off-trip/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <ProjectReference Include="..\..\..\src\Tms\Norvia.Tms.Application\Norvia.Tms.Application.csproj" />
  </ItemGroup>
</Project>
