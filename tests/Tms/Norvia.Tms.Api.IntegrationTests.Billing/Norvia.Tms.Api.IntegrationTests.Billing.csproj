<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Storage.Blobs" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <ProjectReference Include="..\..\..\src\Norvia.AppHost\Norvia.AppHost.csproj" />
    <ProjectReference Include="..\..\..\src\Tms\Norvia.Tms.Api\Norvia.Tms.Api.csproj" />
    <ProjectReference Include="..\Norvia.Tms.TestSupport\Norvia.Tms.TestSupport.csproj" />
    <Using Include="Norvia.Tms.TestSupport" />
    <Using Include="Norvia.Tms.TestSupport.Billing" />
    <Using Include="Norvia.Tms.TestSupport.Capacity" />
    <Using Include="Norvia.Tms.TestSupport.CarrierBookings" />
    <Using Include="Norvia.Tms.TestSupport.Exceptions" />
    <Using Include="Norvia.Tms.TestSupport.Planning" />
    <Using Include="Norvia.Tms.TestSupport.ProofsOfDelivery" />
    <Using Include="Norvia.Tms.TestSupport.Reset" />
    <Using Include="Norvia.Tms.TestSupport.ShipperTracking" />
    <Using Include="Norvia.Tms.TestSupport.TrackingEvents" />
    <Using Include="Norvia.Tms.TestSupport.TransportOrders" />
  </ItemGroup>
  <ItemGroup>
    <!-- Each test class with a fixture of its own starts an AppHost (SQL Server and the Service Bus emulator in Docker). xUnit runs
         one test collection per core, so a many-core machine started a few dozen at once, and containers failed to start. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
