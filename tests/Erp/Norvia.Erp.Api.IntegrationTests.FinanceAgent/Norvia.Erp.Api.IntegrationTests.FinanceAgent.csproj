<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <ProjectReference Include="..\..\..\src\Norvia.AppHost\Norvia.AppHost.csproj" />
    <ProjectReference Include="..\..\..\src\Norvia.Agents\Norvia.Agents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Agent's definition, which the tests run the in-process runner with, as the ERP UI does. -->
    <None Include="..\..\..\agents\finance-matching.agent.yaml" Link="agents\finance-matching.agent.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\agents\finance-rejection-reason.agent.yaml" Link="agents\finance-rejection-reason.agent.yaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- The tool lists of every Agent's MCP server (the contract files the Bicep reads too), so the tests refuse each tool of the other servers. -->
    <None Include="..\..\..\contracts\agent-mcp\*.tools.json" Link="contracts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- One AppHost for the whole project (SQL Server and the Service Bus emulator in Docker). -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
