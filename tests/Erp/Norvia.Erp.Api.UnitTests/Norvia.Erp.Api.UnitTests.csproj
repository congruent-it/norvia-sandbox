<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Only the billing API's own hand-written logic is gated; Program.cs is the composition root (coding guidelines §10). -->
    <Include>[Norvia.Erp.Api]Norvia.Erp.Api.BillableLines.*,[Norvia.Erp.Api]Norvia.Erp.Api.CarrierCosts.*</Include>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>
  <!-- Embedded, so the unit tests read the Billing Logic App's sample messages without touching the file system (coding guidelines §10). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\contracts\canonical-model\samples\transport-order-billable\*.json" LogicalName="samples/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <Using Include="NSubstitute" />
    <ProjectReference Include="..\..\..\src\Erp\Norvia.Erp.Api\Norvia.Erp.Api.csproj" />
  </ItemGroup>
</Project>
