<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Include>[Norvia.PartnerPortal.Infrastructure]*</Include>
    <!-- EF migrations are generated; the composition root is covered by the UI tests (coding guidelines §10). -->
    <ExcludeByFile>**/Norvia.PartnerPortal.Infrastructure/Data/Migrations/*.cs</ExcludeByFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <Using Include="NSubstitute" />
    <ProjectReference Include="..\..\..\src\PartnerPortal\Norvia.PartnerPortal.Infrastructure\Norvia.PartnerPortal.Infrastructure.csproj" />
  </ItemGroup>
  <!-- Embedded, so the unit tests read the contracts and the seed file without touching the file system (coding guidelines §10). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\contracts\partner-api\*.json" LogicalName="PartnerApi/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\partner-api\samples\responses\*.json" LogicalName="PartnerApi/samples/responses/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\partner-api\samples\carrier-answer-responses\*.json" LogicalName="PartnerApi/samples/carrier-answer-responses/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\partner-api\samples\shipper-invoices\*.shipper-invoice.json" LogicalName="PartnerApi/samples/shipper-invoices/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\partner-api\samples\shipper-tracking\*.shipper-tracking.json" LogicalName="PartnerApi/samples/shipper-tracking/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\partner-api\samples\shipper-tracking-lists\*.shipper-tracking-list.json" LogicalName="PartnerApi/samples/shipper-tracking-lists/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\seed\norvia.seed.json" LogicalName="seed/norvia.seed.json" />
  </ItemGroup>
</Project>
