<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Include>[Norvia.PartnerPortal.Web]*</Include>
    <!-- The composition root has no behaviour to unit test (coding guidelines §10). -->
    <ExcludeByFile>**/Norvia.PartnerPortal.Web/Program.cs</ExcludeByFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="bunit" />
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <Using Include="Bunit" />
    <Using Include="NSubstitute" />
    <ProjectReference Include="..\..\..\src\PartnerPortal\Norvia.PartnerPortal.Web\Norvia.PartnerPortal.Web.csproj" />
  </ItemGroup>
  <!-- Embedded, so the unit tests read the sample notifications the Shipper notification map produces without touching the file system (coding guidelines §10). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\contracts\partner-api\samples\shipper-notifications\*.shipper-notification.json" LogicalName="shipper-notifications/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\partner-api\samples\carrier-invoice-outcomes\*.carrier-invoice-outcome.json" LogicalName="carrier-invoice-outcomes/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\contracts\partner-api\samples\shipper-invoices\*.shipper-invoice.json" LogicalName="shipper-invoices/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
